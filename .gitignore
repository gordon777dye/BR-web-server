# Whitelist: ignore everything at the top level, then re-include what belongs in the repo.
# Not included: .svn/, .claude-primary/, logs, http_client/, tmp/, older 4.32/2.04 files,
# generated web_server*.tmp* procs, and the other vendor binaries.
#
# context/ has its own .gitignore (the kit's). It was added with "git add -f" to include
# all of it; files added to context/ later need "git add -f" too.
/*
!/.gitignore

!/03 BR WEB SERVER.md
!/05 DATA STORE LIBRARY.md
!/REDIRECT.md
!/07 RE-LOGIN.pptx
!/allow.brs
!/brclient*
!/brserver*
# Debug symbols for the BR build: large (up to ~100 MB) and not needed to run it.
/*.pdb
!/brconfig.svc
!/brconfig.sys
!/br_redirect.html
!/BR_service.txt
!/challenge.bootstrap.html
!/challenge.html
!/challenge.relogin.html
!/CLAUDE.md
!/context/
!/cust_inq.br
!/cust_inq.br.brs
!/data/
!/dim.proc
!/fileio.br
!/fileio.br.brs
!/fileio.ini
!/FileIO Online Documentation.url
!/filelay/
# ScreenIO, ported from qsmrp 2026-10-26: the library, its screen definitions (screen\),
# compiled screens (screenio\), event functions (function\), and its clock and images.
!/screenio.br
!/screenio.br.brs
!/screenio/
!/screen/
!/function/
!/clocks/
!/Images/
# Harness procedures: br_mcp_driver starts BR on these, from BR's start folder (the app root).
!/BR_dev.prc
!/BR_user.prc
# Claude Code's MCP entry for the harness; it runs context\app\br_mcp.cmd.
!/.mcp.json
!/filetypes.txt
!/HTTPS Certificate Creation and Use.txt
!/json_analyze.br
!/json_analyze.br.brs
!/login.br
!/login.brs
!/nssm.exe
!/relogin.html
!/sample.br
!/sample.brs
!/self.crt
!/self.key
!/self.phrase
!/sessions/
!/spool/
!/unauthorized.html
!/wbcmd.wbh
!/wbcmd2.wbh
!/wbcmd3.wbh
!/webform.br
!/webform.br.brs
!/webout.htm
!/web_server.br
!/web_server.br.brs
!/web_server.ini
!/web_server_unattended.zip
!/www/

# BR's headless log (LOGGING in context\dev\tools\brconfig.ai_*), rewritten on every AI run.
/context/app/startlog.txt

# Runtime contents of the session and spool folders; only the folders themselves are kept.
/sessions/*
!/sessions/.gitkeep
/spool/*
!/spool/.gitkeep
!/.gitattributes
