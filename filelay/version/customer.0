CUST_STATE$,            Customer State,                         C 3,      128 -  130
CUST_ZIP$,              Customer Postal Code,                   C 9,      131 -  139
CUST_PHONE$,            Customer Phone,                         C 10,     140 -  149
COMMUN$,                Communication Code,                     C 4,      150 -  153
TERR$,                  Territory,                              C 3,      154 -  156
CONTACT$,               Contact,                                C 20,     157 -  176
TERMS$,                 Terms,                                  C 2,      177 -  178
TAX_STATUS$,            Tax Status,                             C 1,      179 -  179
SEND$,                  Send Statement,                         C 1,      180 -  180
LATE_CHARGE$,           Late Charge,                            C 1,      181 -  181
CARRIER$,               Carrier,                                C 4,      182 -  185
TRANS_TIME$,            Transportation Time,                    C 6,      186 -  191
