45210 Colorfieldsactive: !  Colors The Debug Window Yellow If Its Active
45215    def FNCOLORFIELDSACTIVE(;ACTIVE,_,ROWCOUNT)
45220       if ACTIVE then 
45225          if STATIC_FIELDSACTIVE then ! Do Nothing
45230          else 
45235             let STATIC_FIELDSACTIVE=1
45240             input #STATIC_WFIELDS, fields STATIC_FIELDSLISTVIEW$ & ",ROWCNT,ALL,NOWAIT" : ROWCOUNT
45245             if ROWCOUNT then 
45250                let FIELDS_START(1)=1
45255                let FIELDS_END(1)=ROWCOUNT
45260                let FIELDS_COLOR$(1)="/#000000:#FFFF77"
45265                print #STATIC_WFIELDS, fields STATIC_FIELDSLISTVIEW$ & ",ATTR,1300" : (MAT FIELDS_START, MAT FIELDS_END, MAT FIELDS_COLOR$)
45270             end if 
45275          end if 
45280       else 
45285          if STATIC_FIELDSACTIVE then 
45290             let STATIC_FIELDSACTIVE=0
45295             input #STATIC_WFIELDS, fields STATIC_FIELDSLISTVIEW$ & ",ROWCNT,ALL,NOWAIT" : ROWCOUNT
45300             if ROWCOUNT then 
45305                let FIELDS_START(1)=1 !:
                     let FIELDS_END(1)=ROWCOUNT
45310                let FIELDS_COLOR$(1)="/#000000:#FFFFFF"
45315                print #STATIC_WFIELDS, fields STATIC_FIELDSLISTVIEW$ & ",ATTR,1300" : (MAT FIELDS_START, MAT FIELDS_END, MAT FIELDS_COLOR$)
45320             end if 
45325          else ! Do Nothing
45330          end if 
45335       end if 
45340    fnend 
