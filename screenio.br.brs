39368 Addlistview: ! Add A Listview
39369    def FNADDLISTVIEW(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;SKIPEMPTYCHILD,___,INDEX)
39370       let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39371       let FIELDTYPE$(INDEX)="LISTVIEW"
39372       let WIDTH(INDEX)=40
39373       let HEIGHT(INDEX)=11
39374       let PARENT$(INDEX)=FNGENERATEUNIQUELVNAME$(MAT PARENT$)
