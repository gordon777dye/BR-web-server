39393 Addsearchbox: ! Add A Searchbox Field
39394    def FNADDSEARCHBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;MODE,CONTROL,___,INDEX,LISTVIEWINDEX,CAPTIONINDEX)
39395 ! 
39396       let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39397       let FIELDTYPE$(INDEX)="SEARCH"
39398       let SPECWIDTH(INDEX)=WIDTH(INDEX)
39399       let HPOSITION(INDEX)=3
39400 ! 
39401       if (MODE=INPUTEDITORMODE OR MODE=INPUTEDITORMOVEMODE OR MODE=INPUTLISTVIEWMODE) AND FIELDTYPE$(CONTROL)="LISTVIEW" then 
39402          let PARENT$(INDEX)=PARENT$(CONTROL)
39403          let FNSETSEARCHLISTVIEW(INDEX,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39404       else 
39405          let LISTVIEWINDEX=SRCH(MAT FIELDTYPE$,"LISTVIEW")
39406          if LISTVIEWINDEX>0 then 
39407             let FNSETSEARCHLISTVIEW(INDEX,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39408          else 
39409             let VPOSITION(INDEX)=FNFINDAVAILABLEVPOSITION(HPOSITION(INDEX),WIDTH(INDEX))
39410          end if 
39411       end if 
39412 ! 
39413       let CAPTIONINDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39414       let FIELDTYPE$(CAPTIONINDEX)="P"
39415       let PICTURE$(CAPTIONINDEX)=SETTING_IMAGEPATH$&"\search.png"
39416       let WIDTH(CAPTIONINDEX)=2
39417       let HEIGHT(CAPTIONINDEX)=1
39418       let HPOSITION(CAPTIONINDEX)=HPOSITION(INDEX)-2
39419       let VPOSITION(CAPTIONINDEX)=VPOSITION(INDEX)
39420 ! 
39421       let CONTROLNAME$(CAPTIONINDEX)=FNGENERATEUNIQUELVNAME$(MAT CONTROLNAME$,"SearchPic_")
39422       let DESCRIPTION$(INDEX)=CONTROLNAME$(CAPTIONINDEX)
39423 ! 
39424       let FNADDSEARCHBOX=INDEX
39425    fnend 
39426 ! 
39427 Addfilterbox: ! Add A Filter Box Field
39428    def FNADDFILTERBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;MODE,CONTROL,___,INDEX,LISTVIEWINDEX,CAPTIONINDEX)
39429       if FN43 then 
39430 ! .     ! Add field, make it a filter
39431          let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39432          let FIELDTYPE$(INDEX)="FILTER"
39433          let SPECWIDTH(INDEX)=WIDTH(INDEX)
39434          let HPOSITION(INDEX)=3
39435 ! .!
39436 ! .     ! Find listview
39437          if CONTROL AND (MODE=INPUTEDITORMODE OR MODE=INPUTEDITORMOVEMODE OR MODE=INPUTLISTVIEWMODE) AND FIELDTYPE$(CONTROL)="LISTVIEW" then 
39438             let PARENT$(INDEX)=PARENT$(CONTROL)
39439             let FNSETSEARCHLISTVIEW(INDEX,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39440          else 
39441             let LISTVIEWINDEX=SRCH(MAT FIELDTYPE$,"LISTVIEW")
39442             if LISTVIEWINDEX>0 then 
39443                let FNSETSEARCHLISTVIEW(INDEX,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39444             else 
39445                let VPOSITION(INDEX)=FNFINDAVAILABLEVPOSITION(HPOSITION(INDEX),WIDTH(INDEX))
39446             end if 
39447          end if 
39448 ! .!
39449 ! .     ! Set default parameters
39450          let PICTURE$(INDEX)="0,ALL"  !Column, Filter Type, Case
39451 ! 
39452 ! .     ! Add magnifying glass icon
39453          let CAPTIONINDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39454          let FIELDTYPE$(CAPTIONINDEX)="P"
39455          let PICTURE$(CAPTIONINDEX)=SETTING_IMAGEPATH$&"\search.png"
39456          let WIDTH(CAPTIONINDEX)=2
39457          let HEIGHT(CAPTIONINDEX)=1
39458          let HPOSITION(CAPTIONINDEX)=HPOSITION(INDEX)-2
39459          let VPOSITION(CAPTIONINDEX)=VPOSITION(INDEX)
39460 ! .!
39461 ! .     ! Tie magnifying glass icon to Filter Box so they move together
39462          let CONTROLNAME$(CAPTIONINDEX)=FNGENERATEUNIQUELVNAME$(MAT CONTROLNAME$,"SearchPic_")
39463          let DESCRIPTION$(INDEX)=CONTROLNAME$(CAPTIONINDEX)
39464 ! .!
39465          let FNADDFILTERBOX=INDEX
39466       else 
39467          let MSGBOX("Filters are only available in BR 4.3 and higher.")
39468       end if 
39469    fnend 
39470 ! 
39471 ! 
39472 Addcalendar: ! Add A Calendar
39473    def FNADDCALENDAR(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX)
39474       let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39475       let FIELDTYPE$(INDEX)="CALENDAR"
