65006 ! 
65007    dim PSLV_SPEC$
65008    dim PSLV_CAP$(5)*30,PSLV_WIDTH(5),PSLV_SPEC$(5)
65009    dim PS_CAPSPEC$(26)*30, PS_CAPTION$(26)*30, PS_HELPTEXT$(26)*255
65010    dim PS_SPEC$(15)*30, PS_DATA$(14)*255, PS_DATA(1), PS_DATAHELP$(15)*255
65011    dim PSLV_SOURCE$(1)*30
65012    dim PSLV_PATH$(1)*255
65013    dim PSLV_TEXT$(1)*255
65014    dim PSLV_COLOR$(1)
65015    dim PSLV_REFNUMBER(1)
65016    dim PSLV_SELECTED(1)
65017 ! 
65018    dim SCREENIO_SSUBS$(1)*255
65019    dim SCREENIO_NSUBS$(1)*255
65020 ! 
65021    dim SCREENFLD_SSUBS$(1)*255
65022    dim SCREENFLD_NSUBS$(1)*255
65023 ! 
65024    def FNSAVEINIFILE(MAT PS_DATA$)
65025       open #(INIFILE:=FNGETFILENUMBER) : "name="&SETTING_SCREENFOLDER$&"\powersearch.ini, recl="&STR$(UDIM(MAT PS_DATA$)*255)&", replace",internal,output 
65026       write #INIFILE, using "form "&STR$(UDIM(MAT PS_DATA$))&"*V 255" : MAT PS_DATA$
65027       close #INIFILE: 
65028    fnend 
65029 ! 
65030 ! .! Define the Search Screen Here
65031    dim PS_INITIALIZE
65032 ! 
65033    def FNINITIALIZEPOWERSEARCH(&PSLV_SPEC$,MAT PS_SPEC$,MAT PS_CAPSPEC$,MAT PS_DATA$,MAT PS_DATAHELP$,MAT PS_CAPTION$,MAT PSLV_CAP$,MAT PSLV_WIDTH,MAT PSLV_SPEC$;___,DUMMY$,INIFILE)
65034       if ~PS_INITIALIZE then 
65035 ! .     ! Read ScreenIO Column Numbers
65036          let FNREADSUBS("screenio",MAT SCREENIO_SSUBS$,MAT SCREENIO_NSUBS$,DUMMMY$)
65037          let FNREADSUBS("screenfld",MAT SCREENFLD_SSUBS$,MAT SCREENFLD_NSUBS$,DUMMY$)
65038 ! 
65039          execute "config userlevel 0"
65040 ! 
65041 ! .     ! Initialize PowerSearch Results Listview
65042          let PSLV_SPEC$="7,3,LIST 20/83"
65043 ! 
65044 ! .     ! Initialize PowerSearch Results Listview Columns
65045          let PSLV_CAP$(1)="Source"
65046          let PSLV_WIDTH(1)=9
65047          let PSLV_SPEC$(1)="C 30"
65048 ! 
65049          let PSLV_CAP$(2)="Path"
65050          let PSLV_WIDTH(2)=25
65051          let PSLV_SPEC$(2)="C 255"
65052 ! 
65053          let PSLV_CAP$(3)="Text"
65054          let PSLV_WIDTH(3)=80
65055          let PSLV_SPEC$(3)="C 255"
65056 ! 
65057          let PSLV_CAP$(4)="Color"
65058          let PSLV_WIDTH(4)=0
65059          let PSLV_SPEC$(4)="C 15"
65060 ! 
65061          let PSLV_CAP$(5)="Ref"
65062          let PSLV_WIDTH(5)=0
65063          let PSLV_SPEC$(5)="N 20"
65064 ! 
65065          mat PSLV_SOURCE$(0)
65066          mat PSLV_PATH$(0)
65067          mat PSLV_TEXT$(0)
65068          mat PSLV_COLOR$(0)
65069          mat PSLV_REFNUMBER(0)
65070 ! 
65071          mat PSLV_SELECTED(0)
65072 ! 
65073 ! .     ! Initialize PowerSearch Subscripts
65074          let _PS_SEARCHTEXT=1
65075          let _PS_FOLDER=2
65076          let _PS_INCLUDESUBS=3
65077          let _PS_MASK=4
65078          let _PS_SEARCHALLEXT=5
65079          let _PS_USEALTEXT=6
65080          let _PS_ALTEXT=7
65081          let _PS_ALTEXTOBJECT=8
65082          let _PS_ALTEXTSOURCE=9
65083          let _PS_SCREEN=10
65084          let _PS_LAYOUT=11
65085          let _PS_FUNCTION=12
65086          let _PS_PATH=13
65087          let _PS_HELPERLIB=14
65088          let _PS_SEARCHRESULTS=15
65089 ! 
65090 ! .     ! Initialize PowerSearch Input Specs
65091          let PS_SPEC$(_PS_SEARCHTEXT)="5,24,42/SEARCH 255,/W:W,7,3"
65092          let PS_SPEC$(_PS_FOLDER)="4,24,15/V 255,/W:W"
65093          let PS_SPEC$(_PS_INCLUDESUBS)="4,40,12/CHECK 18"
65094          let PS_SPEC$(_PS_MASK)="4,59,7/V 80,/W:W"
65095 ! 
65096          let PS_SPEC$(_PS_SEARCHALLEXT)="3,24,12/CHECK 18"
65097          let PS_SPEC$(_PS_USEALTEXT)="3,40,6/CHECK 25"
65098          let PS_SPEC$(_PS_ALTEXT)="3,47,CU 3,/W:W"
65099          let PS_SPEC$(_PS_ALTEXTOBJECT)="3,51,7/RADIO 25,1"
65100          let PS_SPEC$(_PS_ALTEXTSOURCE)="3,59,7/RADIO 25,1"
65101 ! 
65102          let PS_SPEC$(_PS_SCREEN)="1,4,13/CHECK 25"
65103          let PS_SPEC$(_PS_LAYOUT)="2,4,13/CHECK 25"
65104          let PS_SPEC$(_PS_FUNCTION)="3,4,13/CHECK 25"
65105          let PS_SPEC$(_PS_PATH)="4,4,13/CHECK 25"
65106          let PS_SPEC$(_PS_HELPERLIB)="5,4,13/CHECK 25"
65107 ! 
65108          let PS_SPEC$(_PS_SEARCHRESULTS)=PSLV_SPEC$&",ROWCNT,SEL"
65109 ! 
65110          let PS_DATAHELP$(_PS_SEARCHTEXT)="3;Enter the text to search for.;"
65111          let PS_DATAHELP$(_PS_FOLDER)="3;Enter an alternate path to search. Use the BR "":"" operator to specify an absolute path. When using an absolute path, we are limited to a Text Only Search. If you want to search inside BR Object Files, you must specify a relative path.;"
65112          let PS_DATAHELP$(_PS_INCLUDESUBS)="3;Search in Subdirectories. May take a while. Modify dirlist.sch to filter the search directories.;"
65113          let PS_DATAHELP$(_PS_MASK)="3;This is the mask. Do not enter anything other then letters and the traditional * and ? mask operators. Do not enter a file extension or a path in this field.;"
65114          let PS_DATAHELP$(_PS_SEARCHALLEXT)="3;Search all other files of all extensions. The program will test each file to if it is an ASCII file, and it will only search them if they are ascii files.;"
65115          let PS_DATAHELP$(_PS_USEALTEXT)="3;Search inside the specified folder for files of this alternate extension.;"
65116          let PS_DATAHELP$(_PS_ALTEXT)="3;Alternate Extension to Search\nEnter extension only (LIB and not *.LIB);"
65117          let PS_DATAHELP$(_PS_ALTEXTOBJECT)="3;Treat Alternate Extension files as BR Program Files;"
65118          let PS_DATAHELP$(_PS_ALTEXTSOURCE)="3;Treat Alternate Extension files as Text Files;"
65119          let PS_DATAHELP$(_PS_SCREEN)="3;Search the Screen Files;"
65120          let PS_DATAHELP$(_PS_LAYOUT)="3;Search the File Layouts;"
65121          let PS_DATAHELP$(_PS_FUNCTION)="3;Search the Screen Functions;"
65122          let PS_DATAHELP$(_PS_PATH)="3;Search the specified folder for .brs, .wbs, .br and .wb files.;"
65123          let PS_DATAHELP$(_PS_HELPERLIB)="3;Search your compiled Screen Helper Functions. You shouldn't really be searching for these. Search your ScreenIO Screen Functions instead.;"
65124          let PS_DATAHELP$(_PS_SEARCHRESULTS)="3;;"
65125 ! 
65126 ! .     ! Initialize PowerSearch Input Data
65127          if EXISTS(""&SETTING_SCREENFOLDER$&"\powersearch.ini") then 
65128             open #(INIFILE:=FNGETFILENUMBER) : "name="&SETTING_SCREENFOLDER$&"\powersearch.ini",internal,input,sequential 
65129             read #INIFILE, using "form "&STR$(UDIM(MAT PS_DATA$))&"*V 255" : MAT PS_DATA$ error IGNORE
65130             if FILE(INIFILE)<>0 then 
65131                close #INIFILE: 
65132                goto Usedefaults
65133             end if 
65134             close #INIFILE: 
65135          else 
65136 Usedefaults: ! use default settings, read failed.
65137             let PS_DATA$(_PS_FOLDER)="."
65138             let PS_DATA$(_PS_INCLUDESUBS)="^Incl Subfolders"
65139             let PS_DATA$(_PS_MASK)="*"
65140             let PS_DATA$(_PS_SEARCHALLEXT)="Search All Exts"
65141             let PS_DATA$(_PS_SCREEN)="^Screen Files"
65142             let PS_DATA$(_PS_LAYOUT)="^File Layouts"
65143             let PS_DATA$(_PS_FUNCTION)="^Screen Functions"
65144             let PS_DATA$(_PS_PATH)="^Folder"
65145             let PS_DATA$(_PS_HELPERLIB)="Compiled Screens"
65146             let PS_DATA$(_PS_USEALTEXT)="Alt Ext: "
65147             let PS_DATA$(_PS_ALTEXT)="LIB"
65148             let PS_DATA$(_PS_ALTEXTOBJECT)="^BR File"
65149             let PS_DATA$(_PS_ALTEXTSOURCE)="Text File"
65150          end if 
65151 ! 
65152 ! .     ! Initialize PowerSearch Buttons and Caption Specs
65153          let PS_CAPSPEC$(1)="1,30,CC 26"  !Power Search
65154          let PS_CAPSPEC$(2)="5,17,6/CR 8"  !Search:
65155          let PS_CAPSPEC$(3)="4,17,6/CR 8"  !Folder:
65156          let PS_CAPSPEC$(4)="5,67,CC 9,/W:W,B35"  !Search
65157          let PS_CAPSPEC$(5)="5,77,9/CC 9,/W:W,B34"  !Clear All
65158          let PS_CAPSPEC$(6)="28,3,10/CC 17,/W:W,B36"  !Launch Item
65159          let PS_CAPSPEC$(7)="28,14,17/CC 26,/W:W,B37"  !Affected Screen List
65160 ! 
65161          let PS_CAPSPEC$(8)="28,68,8/CC 11,/W:W,B38"  !Export List
65162          let PS_CAPSPEC$(9)="28,77,CC 8,/W:W,B39"  !Print List
65163 ! 
65164          let PS_CAPSPEC$(10)="28,37,8/CC 14,/W:W,B40"  !Load Results
65165          let PS_CAPSPEC$(11)="28,46,8/CC 12,/W:W,B41"  !Save Results
65166          let PS_CAPSPEC$(12)="28,55,8/CC 11,/W:W,B42"  !Save As...
65167 ! 
65168          let PS_CAPSPEC$(13)="3,67,CC 1,/#000000:#00FF00,B43"  !Mark Green
65169          let PS_CAPSPEC$(14)="3,69,CC 1,/#000000:#FFFF00,B51"  !Mark Yellow
65170          let PS_CAPSPEC$(15)="3,71,CC 1,/#000000:#FF0000,B53"  !Mark Red
65171          let PS_CAPSPEC$(16)="3,73,CC 1,/#000000:#0000FF,B54"  !Mark Blue
65172          let PS_CAPSPEC$(17)="3,75,CC 1,/#000000:#FFFFFF,B45"  !Mark White
65173 ! 
65174          let PS_CAPSPEC$(18)="3,77,CC 1,/#FFFFFF:#008000,B46"  !Clear Green
65175          let PS_CAPSPEC$(19)="3,79,CC 1,/#FFFFFF:#808000,B47"  !Clear Yellow
65176          let PS_CAPSPEC$(20)="3,81,CC 1,/#FFFFFF:#800000,B55"  !Clear Red
65177          let PS_CAPSPEC$(21)="3,83,CC 1,/#FFFFFF:#000080,B56"  !Clear Blue
65178          let PS_CAPSPEC$(22)="3,85,CC 1,/#000000:#FFFFFF,B48"  !Clear White
65179 ! 
65180          let PS_CAPSPEC$(23)="4,77,9/CC 7,/W:W,B49"  !Clear Item
65181          let PS_CAPSPEC$(24)="4,67,9/CC 11,/W:W,B50"  !Sort Colors
65182 ! 
65183          let PS_CAPSPEC$(25)="4,54,4/CR 6"  !Mask:
65184          let PS_CAPSPEC$(26)="2,69,14/CC 15,/W:W,B52"  !Save Ini
65185 ! 
65186 ! .     ! Initialize PowerSearch Buttons and Captions
65187          let PS_CAPTION$(1)="Power Search"
65188          let PS_CAPTION$(2)="Search: "
65189          let PS_CAPTION$(3)="Folder: "
65190          let PS_CAPTION$(4)="Search"
65191          let PS_CAPTION$(5)="Clear All"
65192          let PS_CAPTION$(6)="Launch"
65193          let PS_CAPTION$(7)="Affected Screens"
65194          let PS_CAPTION$(8)="Export"
65195          let PS_CAPTION$(9)="Print"
65196          let PS_CAPTION$(10)="Load.."
65197          let PS_CAPTION$(11)="Save"
65198          let PS_CAPTION$(12)="Save As.."
65199          let PS_CAPTION$(13)=" "      !Mark Green
65200          let PS_CAPTION$(14)=" "      !Mark Yellow
65201          let PS_CAPTION$(15)=" "      !Mark Red
65202          let PS_CAPTION$(16)=" "      !Mark Blue
65203          let PS_CAPTION$(17)=" "      !Mark White
65204          let PS_CAPTION$(18)="x"      !Clear Green
65205          let PS_CAPTION$(19)="x"      !Clear Yellow
65206          let PS_CAPTION$(20)="x"      !Clear Red
65207          let PS_CAPTION$(21)="x"      !Clear Blue
65208          let PS_CAPTION$(22)="x"      !Clear White
65209          let PS_CAPTION$(23)="Clear"
65210          let PS_CAPTION$(24)="Sort Colors"
65211          let PS_CAPTION$(25)="Mask: "
65212          let PS_CAPTION$(26)="Set Defaults"
65213 ! 
65214          mat PS_HELPTEXT$(1:3)=("3;;")
65215          let PS_HELPTEXT$(4)="3;Search. Search without clearing to add to the previous results.;"
65216          let PS_HELPTEXT$(5)="3;Clear the list to preform a new search.;"
65217          let PS_HELPTEXT$(6)="3;Launches the selected items. If the item is a file, launch it in your BR Code Editor of choice. If its a screen, Load it in the background.;"
65218          let PS_HELPTEXT$(7)="3;Opens a window showing all the screens that use the currently selected items.;"
65219          let PS_HELPTEXT$(8)="3;Exports the Search Results to a Text File.;"
65220          let PS_HELPTEXT$(9)="3;Prints the Search Results to the Printer.;"
65221          let PS_HELPTEXT$(10)="3;Loads a previously saved Search Results file so you can work with it.;"
65222          let PS_HELPTEXT$(11)="3;Saves the Results to an internal file so you can work with them later.;"
65223          let PS_HELPTEXT$(12)="3;Saves the Results to an internal file so you can work with them later.;"
65224          let PS_HELPTEXT$(13)="3;Mark these lines Green.;"
65225          let PS_HELPTEXT$(14)="3;Mark these lines Yellow.;"
65226          let PS_HELPTEXT$(15)="3;Mark these lines Red.;"
65227          let PS_HELPTEXT$(16)="3;Mark these lines Blue.;"
65228          let PS_HELPTEXT$(17)="3;Mark these lines White.;"
65229          let PS_HELPTEXT$(18)="3;Clear all Green Items.;"
65230          let PS_HELPTEXT$(19)="3;Clear all Yellow Items.;"
65231          let PS_HELPTEXT$(20)="3;Clear all Red Items.;"
65232          let PS_HELPTEXT$(21)="3;Clear all Blue Items.;"
65233          let PS_HELPTEXT$(22)="3;Clear all White Items.;"
65234          let PS_HELPTEXT$(23)="3;Clear Selected Items.;"
65235          let PS_HELPTEXT$(24)="3;Sort the list based on color.;"
65236          let PS_HELPTEXT$(25)="3;;"
65237          let PS_HELPTEXT$(26)="3;Save the Search Settings to be used as defaults later.;"
65238 ! 
65239          let PS_INITIALIZE=1
65240       end if 
65241    fnend 
65242 ! 
65243    def FNPOWERSEARCH(;___,FUNCTION,POWERSEARCH,ROWCOUNT)
65244 ! 
65245 ! .  ! Open the child window
65246       open #(POWERSEARCH:=FNGETFILENUMBER): "srow=4,scol=10,rows=29,cols=87,Border=s", display, outin 
65247 ! 
65248       let FNINITIALIZEPOWERSEARCH(PSLV_SPEC$,MAT PS_SPEC$,MAT PS_CAPSPEC$,MAT PS_DATA$,MAT PS_DATAHELP$,MAT PS_CAPTION$,MAT PSLV_CAP$,MAT PSLV_WIDTH,MAT PSLV_SPEC$)
65249 ! 
65250       print #POWERSEARCH, fields MAT PS_CAPSPEC$, help MAT PS_HELPTEXT$ : MAT PS_CAPTION$
65251       print #POWERSEARCH, fields PSLV_SPEC$&",HEADERS,/W:W" : (MAT PSLV_CAP$, MAT PSLV_WIDTH, MAT PSLV_SPEC$)
65252 ! 
65253 ! .  ! Predraw listview if any data belongs in it
65254       let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65255       do 
65256          print #POWERSEARCH, fields MAT PS_SPEC$(1:UDIM(MAT PS_SPEC$)-1) : MAT PS_DATA$
65257          if UDIM(MAT PSLV_SOURCE$) then 
65258             input #POWERSEARCH, fields MAT PS_SPEC$, help MAT PS_DATAHELP$ : MAT PS_DATA$,ROWCOUNT
65259             mat PSLV_SELECTED(ROWCOUNT)
65260             input #POWERSEARCH, fields PSLV_SPEC$&",ROWSUB,SEL,NOWAIT" : MAT PSLV_SELECTED
65261          else 
65262             input #POWERSEARCH, fields MAT PS_SPEC$(1:UDIM(MAT PS_SPEC$)-1), help MAT PS_DATAHELP$ : MAT PS_DATA$
65263          end if 
65264 ! 
65265          let FUNCTION=FKEY
65266 ! 
65267          if FUNCTION = 34 then ! #Select# Function #Case# 34
65268 ! .        ! Clear List
65269             let FNCLEARRESULTS(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65270             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65271 ! 
65272          else if FUNCTION = 35 then ! #Case# 35
65273 ! .        ! Search
65274             let FNSEARCH(MAT PS_DATA$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65275             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65276 ! 
65277          else if FUNCTION = 0 then ! #Case# 0
65278             if UDIM(MAT PSLV_SOURCE$)=0 then 
65279                let FNSEARCH(MAT PS_DATA$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65280                let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65281             end if 
65282 ! 
65283          else if FUNCTION = 36 then ! #Case# 36
65284 ! .        ! Jump To Item
65285             let FNJUMPTO(MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65286 ! 
65287          else if FUNCTION = 37 then ! #Case# 37
65288 ! .        ! Affected Screen List
65289             let FNAFFECTEDSCREENLIST(MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65290 ! 
65291          else if FUNCTION = 38 then ! #Case# 38
65292 ! .        ! Export
65293             let FNPRINTLISTTOFILE(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65294          else if FUNCTION = 39 then ! #Case# 39
65295 ! .        ! Print
65296             let FNPRINTLISTTOPRINTER(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65297 ! 
65298          else if FUNCTION = 40 then ! #Case# 40
65299 ! .        ! Load
65300             let FNLOADRESULTSFILE(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65301             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65302          else if FUNCTION = 41 then ! #Case# 41
65303 ! .        ! Save
65304             let FNSAVERESULTSFILE(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65305          else if FUNCTION = 42 then ! #Case# 42
65306 ! .        ! Save As..
65307             let FNSAVERESULTSFILEAS(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65308 ! 
65309          else if FUNCTION = 43 then ! #Case# 43
65310 ! .        ! Mark Green
65311             let FNMARKSELECTION("#00FF00",MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65312             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,1)
65313          else if FUNCTION = 51 then ! #Case# 51
65314 ! .        ! Mark Yellow
65315             let FNMARKSELECTION("#FFFF00",MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65316             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,1)
65317          else if FUNCTION = 53 then ! #Case# 53
65318 ! .        ! Mark Red
65319             let FNMARKSELECTION("#FF0000",MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65320             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,1)
65321          else if FUNCTION = 54 then ! #Case# 54
65322 ! .        ! Mark Blue
65323             let FNMARKSELECTION("#0050FF",MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65324             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,1)
65325          else if FUNCTION = 45 then ! #Case# 45
65326 ! .        ! Mark White
65327             let FNMARKSELECTION("#FFFFFF",MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65328             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,1)
65329          else if FUNCTION = 46 then ! #Case# 46
65330 ! .        ! Clear Green
65331             let FNCLEARSELECTION("#00FF00",MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65332             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65333          else if FUNCTION = 47 then ! #Case# 47
65334 ! .        ! Clear Yellow
65335             let FNCLEARSELECTION("#FFFF00",MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65336             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65337          else if FUNCTION = 55 then ! #Case# 55
65338 ! .        ! Clear Red
65339             let FNCLEARSELECTION("#FF0000",MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65340             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65341          else if FUNCTION = 56 then ! #Case# 56
65342 ! .        ! Clear Blue
65343             let FNCLEARSELECTION("#0050FF",MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65344             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65345          else if FUNCTION = 48 then ! #Case# 48
65346 ! .        ! Clear White
65347             let FNCLEARSELECTION("#FFFFFF",MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65348             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65349          else if FUNCTION = 49 then ! #Case# 49
65350 ! .        ! Clear Item
65351             let FNCLEARITEM(MAT PSLV_SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65352             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65353          else if FUNCTION = 50 then ! #Case# 50
65354 ! .        ! Sort Colors
65355             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65356             print #POWERSEARCH, fields PSLV_SPEC$&",SORT" : 4
65357 ! 
65358          else if FUNCTION = 52 then ! #Case# 52
65359             let FNSAVEINIFILE(MAT PS_DATA$)
65360 ! 
65361          end if                       !#End Select#
65362 ! 
65363       loop UNTIL FUNCTION=99 OR FUNCTION=93 OR FKEY=93
65364 ! 
65365       close #POWERSEARCH: 
65366    fnend 
65367 ! 
65368    dim PSLV_START(1)
65369    dim PSLV_END(1)
65370    dim PSLV_ATTR$(1)
65371    dim PSLV_OUTCOLOR$(1)
65372 ! 
65373    def FNUPDATERESULTS(LISTSPEC$*30,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;COLORONLY,___,INDEX,BOLD,LASTSOURCE$*30,LASTPATH$*255)
65374       if ~COLORONLY then 
65375          print #POWERSEARCH, fields LISTSPEC$&",=" : (MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65376       end if 
65377 ! 
65378       mat PSLV_START(0) : mat PSLV_END(0) : mat PSLV_ATTR$(0) : let LASTINDEX=0
65379       mat PSLV_OUTCOLOR$(UDIM(MAT PSLV_COLOR$))=PSLV_COLOR$
65380 ! 
65381       for INDEX=1 to UDIM(MAT PSLV_COLOR$)
65382 ! .     ! Alternate bold and not bold every time source changes.
65383          if LASTSOURCE$<>PSLV_SOURCE$(INDEX) OR LASTPATH$<>FNCOMPAREPATH$(PSLV_SOURCE$(INDEX),PSLV_PATH$(INDEX)) then 
65384             let LASTSOURCE$=PSLV_SOURCE$(INDEX)
65385             let LASTPATH$=FNCOMPAREPATH$(PSLV_SOURCE$(INDEX),PSLV_PATH$(INDEX))
65386             let BOLD=~BOLD
65387          end if 
65388 ! 
65389 ! .     ! Specify the color from color$
65390          if BOLD then 
65391             let PSLV_OUTCOLOR$(INDEX)="/#000000:"&PSLV_COLOR$(INDEX)
65392          else 
65393             let PSLV_OUTCOLOR$(INDEX)="/#000000:"&SREP$(PSLV_COLOR$(INDEX),"FF","E0")
65394          end if 
65395       next INDEX
65396 ! 
65397 ! .  ! Borrow the SetColors function from ScreenIO
65398       let FNSETCOLORS(MAT PSLV_OUTCOLOR$,MAT PSLV_START,MAT PSLV_END,MAT PSLV_ATTR$)
65399 ! 
65400       print #POWERSEARCH, fields LISTSPEC$&",attr" : (MAT PSLV_START,MAT PSLV_END,MAT PSLV_ATTR$)
65401 ! 
65402       print #POWERSEARCH, fields "27,3,C 30" : STR$(UDIM(MAT PSLV_SOURCE$))&" results found..."
65403    fnend 
65404 ! 
65405    def FNCOMPAREPATH$*255(SOURCE$*30,PATH$*255)
65406       if LWRC$(SOURCE$)="screen" then 
65407          let FNCOMPAREPATH$=PATH$(1:POS(PATH$,"\"))
65408       else 
65409          let FNCOMPAREPATH$=PATH$
65410       end if 
65411    fnend 
65412 ! 
65413    def FNMARKSELECTION(COLOR$,MAT SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX)
65414       for INDEX=1 to UDIM(MAT SELECTED)
65415          let PSLV_COLOR$(SELECTED(INDEX))=COLOR$
65416       next INDEX
65417    fnend 
65418    def FNCLEARSELECTION(COLOR$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX)
65419       if (2==MSGBOX("This will remove any "&FNCOLORNAME$(COLOR$)&" items from the list. Are you sure?","Delete All"&FNCOLORNAME$(COLOR$),"yN","QST")) then 
65420          let INDEX=0
65421          do WHILE INDEX<UDIM(MAT PSLV_COLOR$)
65422             let INDEX+=1
65423             if PSLV_COLOR$(INDEX)=COLOR$ then 
65424 ! .           ! Remove Entry from List
65425                let FNREMOVEITEM(INDEX,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65426                let INDEX-=1
65427             end if 
65428          loop 
65429       end if 
65430       mat PSLV_SELECTED(0)
65431    fnend 
65432    def FNCLEARITEM(MAT SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX,JNDEX)
65433       if (2==MSGBOX("This will remove all the currently selected items from the list. Are you sure?","Delete Current Selection","yN","QST")) then 
65434          for INDEX=1 to UDIM(MAT SELECTED)
65435 ! .        ! Remove Selected(Index) from list
65436             let FNREMOVEITEM(SELECTED(INDEX),MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65437             for JNDEX=INDEX+1 to UDIM(MAT SELECTED)
65438                let SELECTED(JNDEX)-=1
65439             next JNDEX
65440          next INDEX
65441       end if 
65442       mat SELECTED(0)
65443    fnend 
65444 ! 
65445    dim ALREADYDONE$(1)*255
65446 ! .! Jump To Item
65447    def FNJUMPTO(MAT SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX,DONEASCREEN,DONEAHELPERLIB,SCREEN$,FIRSTSLASHPOS)
65448       mat ALREADYDONE$(0)
65449       for INDEX=1 to UDIM(MAT SELECTED)
65450          if LWRC$(TRIM$(PSLV_SOURCE$(SELECTED(INDEX))))="screen" then 
65451             let SCREEN$=PSLV_PATH$(SELECTED(INDEX))(1:(FIRSTSLASHPOS:=POS(PSLV_PATH$(SELECTED(INDEX)),"\"))-1)
65452             let FNLAUNCHSCREEN(TRIM$(SCREEN$))
65453 ! 
65454 ! .        !if ~DoneAScreen then
65455 ! .        !   ! if this item is a screen, load the screen, redraw it, then come back here.
65456 ! .        !   if Fnoktoproceed(Mat Screenio$,Mat Screenio,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines) then
65457 ! .        !      let Screen$=PSLV_Path$(Selected(Index))(1:(FirstSlashPos:=pos(PSLV_Path$(Selected(Index)),"\"))-1)
65458 ! .        !      if Trim$(Screen$)<>"" then
65459 ! .        !         if Fnreadscreen(Screen$,Mat Screenio$,Mat Screenio,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines) then
65460 ! .        !            let fnRedrawScreen(mat ScreenIO$,mat ScreenIO,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines)
65461 ! .        !
65462 ! .        !            if pos(PSLV_Path$(Selected(Index)),"\",FirstSlashPos+1) then ! Its from screenflds
65463 ! .        !               let Mode=Inputeditormode
65464 ! .        !               let Control=PSLV_RefNumber(Selected(Index))
65465 ! .        !            else ! its from ScreenIO
65466 ! .        !               if pos(lwrc$(PSLV_Path$(Selected(Index))),"fn$") then
65467 ! .        !                  let Mode=SelectEventsMode
65468 ! .        !               else 
65469 ! .        !                  let Mode=InputAttributesMode
65470 ! .        !                  let Control=PSLV_RefNumber(Selected(Index))
65471 ! .        !               end if
65472 ! .        !            end if
65473 ! .        !            let DoneAScreen=1
65474 ! .        !         else 
65475 ! .        !            let Msgbox("Error Reading Screen - Screen not  found","Error","OK","ERR")
65476 ! .        !         end if
65477 ! .        !      end if
65478 ! .        !   end if
65479 ! .        !end if
65480          else if LWRC$(TRIM$(PSLV_SOURCE$(SELECTED(INDEX))))="helper library" then 
65481             if ~DONEAHELPERLIB then 
65482                let MSGBOX("Don't Edit your Compiled Helper Libraries. Instead, edit the functions they're built from.","Warning","Ok","EXCL")
65483                let DONEAHELPERLIB=1
65484             end if 
65485          else if LWRC$(TRIM$(PSLV_SOURCE$(SELECTED(INDEX))))="layout" AND ~POS(PSLV_PATH$(SELECTED(INDEX)),".") then 
65486 ! .        ! if this item is a function, launch it in editor
65487             if SRCH(MAT ALREADYDONE$,LWRC$(TRIM$(PSLV_PATH$(SELECTED(INDEX)))))<1 then 
65488 ! .        ! Launch it in notepad
65489                let SLEEP(.1)
65490                execute "system -C -M start notepad "&OS_FILENAME$(TRIM$(PSLV_PATH$(SELECTED(INDEX)))) error IGNORE
65491 ! 
65492                mat ALREADYDONE$(UDIM(MAT ALREADYDONE$)+1)
65493                let ALREADYDONE$(UDIM(MAT ALREADYDONE$))=LWRC$(TRIM$(PSLV_PATH$(SELECTED(INDEX))))
65494             end if 
65495          else 
65496 ! .        ! if this item is a function, launch it in editor
65497             if SRCH(MAT ALREADYDONE$,LWRC$(TRIM$(PSLV_PATH$(SELECTED(INDEX)))))<1 then 
65498                let SLEEP(.1)
65499 ! .           ! if its a .BR file then
65500                if ".br"=TRIM$(LWRC$(PSLV_PATH$(SELECTED(INDEX)))(POS(PSLV_PATH$(SELECTED(INDEX)),".",-1):LEN(PSLV_PATH$(SELECTED(INDEX))))) OR ".wb"=TRIM$(LWRC$(PSLV_PATH$(SELECTED(INDEX)))(POS(PSLV_PATH$(SELECTED(INDEX)),".",-1):LEN(PSLV_PATH$(SELECTED(INDEX))))) then 
65501 ! .              ! Launch it in BR
65502                   execute "system -C -M "&FNGETBREXE$&" -"&FNGETWBCFG$&" load "&TRIM$(PSLV_PATH$(SELECTED(INDEX)))
65503                else if LWRC$("."&PS_DATA$(_PS_ALTEXT))=TRIM$(LWRC$(PSLV_PATH$(SELECTED(INDEX)))(POS(PSLV_PATH$(SELECTED(INDEX)),".",-1):LEN(PSLV_PATH$(SELECTED(INDEX))))) AND PS_DATA$(_PS_ALTEXTOBJECT)(1:1)="^" then 
65504 ! .              ! Its a BR file with the alt ext
65505                   execute "system -C -M "&FNGETBREXE$&" -"&FNGETWBCFG$&" load "&TRIM$(PSLV_PATH$(SELECTED(INDEX)))
65506                else 
65507 ! .              ! Launch it in default editor
65508                   execute "system -C -M start "&OS_FILENAME$(TRIM$(PSLV_PATH$(SELECTED(INDEX)))) error IGNORE
65509                end if 
65510 ! 
65511                mat ALREADYDONE$(UDIM(MAT ALREADYDONE$)+1)
65512                let ALREADYDONE$(UDIM(MAT ALREADYDONE$))=LWRC$(TRIM$(PSLV_PATH$(SELECTED(INDEX))))
65513             end if 
65514          end if 
65515       next INDEX
65516    fnend 
65517 ! 
65518    def FNREDRAWSCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;NOTPOWERSEARCH)
65519       if ~(FNSAMEAS(MAT DISPLAYREF_SCREENIO$,MAT SCREENIO$) AND FNSAMEA(MAT DISPLAYREF_SCREENIO,MAT SCREENIO)) then 
65520 ! 
65521          close #POWERSEARCH: 
65522          let FNREDRAWENTIRESCREEN(WTOOLBAR,WDEBUG,WEDITOR,MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
65523 ! 
65524          mat DISPLAYREF_SCREENIO$=SCREENIO$
65525          mat DISPLAYREF_SCREENIO=SCREENIO
65526 ! 
65527          let FNREPOPULATEFIELDSLISTVIEW(SCREENIO$(SI_FILELAY))
65528          let DISPLAYREF_SCREENIO$(SI_FILELAY)=SCREENIO$(SI_FILELAY)
65529 ! 
65530          if ~NOTPOWERSEARCH then 
65531 ! .        ! Open the child window
65532             open #(POWERSEARCH:=FNGETFILENUMBER): "srow=4,scol=10,rows=29,cols=87,Border=s", display, outin 
65533 ! 
65534             let FNINITIALIZEPOWERSEARCH(PSLV_SPEC$,MAT PS_SPEC$,MAT PS_CAPSPEC$,MAT PS_DATA$,MAT PS_DATAHELP$,MAT PS_CAPTION$,MAT PSLV_CAP$,MAT PSLV_WIDTH,MAT PSLV_SPEC$)
65535 ! 
65536             print #POWERSEARCH, fields MAT PS_CAPSPEC$, help MAT PS_HELPTEXT$ : MAT PS_CAPTION$
65537             print #POWERSEARCH, fields PSLV_SPEC$&",HEADERS,/W:W" : (MAT PSLV_CAP$, MAT PSLV_WIDTH, MAT PSLV_SPEC$)
65538 ! 
65539 ! .        ! Predraw listview if any data belongs in it
65540             let FNUPDATERESULTS(PSLV_SPEC$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65541          end if 
65542       end if 
65543       let FNRENDERSCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
65544    fnend 
65545 ! 
65546    dim AFFECTEDSCREENS$(1)
65547    dim AS_CAPTION$(1)
65548    dim AS_WIDTH(1)
65549    dim AS_SPEC$(1)
65550 ! 
65551    dim AF_SELECTION(1)
65552 ! 
65553    def FNAFFECTEDSCREENLIST(MAT SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX,WINDOW,AFSELCOUNT,FUNCTION,SAVESCREENCODE$,FILENAME$*255)
65554 ! 
65555 ! .  ! Build list of affected screens
65556       mat AFFECTEDSCREENS$(0)
65557       let FNFINDAFFECTEDSCREENS(MAT AFFECTEDSCREENS$,MAT SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65558 ! 
65559       if UDIM(MAT AFFECTEDSCREENS$)=0 then 
65560          let MSGBOX("No screens are affected.","Nothing Found")
65561       else 
65562 ! .     ! Define Listview
65563          let AS_CAPTION$(1)="Affected Screens"
65564          let AS_WIDTH(1)=30
65565          let AS_SPEC$(1)="CC 18"
65566 ! 
65567 ! .     ! Open Window
65568          open #(WINDOW:=FNGETFILENUMBER) : "srow=5,scol=30,rows=15,cols=30,border=s",display,outin 
65569 ! 
65570 ! .     ! Paint Window
65571          print #WINDOW, fields "1,1,LIST 14/30,HEADERS,/W:W" : (MAT AS_CAPTION$,MAT AS_WIDTH,MAT AS_SPEC$)
65572          print #WINDOW, fields "1,1,LIST 14/30,=" : (MAT AFFECTEDSCREENS$)
65573          print #WINDOW, fields "15,1,14/CC 16,/W:W,B30;15,16,CC 14,/W:W,B31" : "Recompile Screen","Load Screen"
65574 ! 
65575          do 
65576             input #WINDOW, fields "1,1,LIST 14/30,ROWCNT,SEL" : AFSELCOUNT
65577             let FUNCTION=FKEY
65578             mat AF_SELECTION(AFSELCOUNT)
65579             input #WINDOW, fields "1,1,LIST 14/30,ROWSUB,SEL,NOWAIT" : MAT AF_SELECTION
65580 ! 
65581             if FUNCTION=30 then ! Recompile Selected Screens
65582                let SAVESCREENCODE$=STATIC_SCREENNAME$
65583 ! 
65584                if EXISTS("compile[SESSION].$$$") then 
65585                   execute "free compile[SESSION].$$$"
65586                end if 
65587 ! 
65588                let FAILEDLIST$=""
65589                for INDEX=1 to UDIM(MAT AF_SELECTION)
65590                   if FNREADSCREEN(AFFECTEDSCREENS$(AF_SELECTION(INDEX)),MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
65591                      let FNCOMPILEHELPERLIBRARY(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,FILENAME$)
65592                      let FNWAITFORFILE(FAILEDLIST$,AFFECTEDSCREENS$(AF_SELECTION(INDEX)),FILENAME$)
65593                   end if 
65594                next INDEX
65595 ! 
65596                if LEN(FAILEDLIST$) then 
65597                   let MSGBOX("The following screens took a long time and may have had errors:"&CHR$(13)&CHR$(13)&FAILEDLIST$(3:9999))
65598                end if 
65599 ! 
65600                let FNREADSCREEN(SAVESCREENCODE$,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
65601             end if 
65602 ! 
65603             if FUNCTION=31 then ! Load Screen
65604                let FNLAUNCHSCREEN(TRIM$(AFFECTEDSCREENS$(AF_SELECTION(1))))
65605 ! 
65606 ! .        !   if Fnoktoproceed(Mat Screenio$,Mat Screenio,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines) then
65607 ! .        !      if Fnreadscreen(AffectedScreens$(AF_Selection(1)),Mat Screenio$,Mat Screenio,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines) then
65608 ! .        !         let fnRedrawScreen(mat ScreenIO$,mat ScreenIO,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines)
65609 ! 
65610 ! .        !         ! Repaint Window
65611 ! .        !         open #(Window:=fnGetFileNumber) : "srow=5,scol=30,rows=15,cols=30,border=s",display,outin
65612 ! .        !         print #Window, fields "1,1,LIST 14/30,HEADERS" : (mat AS_Caption$,mat AS_Width,mat AS_Spec$)
65613 ! .        !         print #Window, fields "1,1,LIST 14/30,=" : (mat AffectedScreens$)
65614 ! .        !         print #Window, fields "15,1,14/CC 16,/W:W,B30;15,16,CC 14,/W:W,B31" : "Recompile Screen","Load Screen"
65615 ! 
65616 ! .        !      else 
65617 ! .        !         let Msgbox("Error Reading Screen - Screen not  found","Error","OK","ERR")
65618 ! .        !      end if
65619 ! .        !   end if
65620             end if 
65621 ! 
65622          loop UNTIL FUNCTION=99 OR FUNCTION=93 OR FKEY=93
65623          close #WINDOW: 
65624       end if 
65625    fnend 
65626 ! 
65627    def FNFINDAFFECTEDSCREENS(MAT AFFECTEDSCREENS$,MAT SELECTED,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,FUNCTION$*255,INDEX,JNDEX)
65628       for INDEX=1 to UDIM(MAT SELECTED)
65629          if LWRC$(TRIM$(PSLV_SOURCE$(SELECTED(INDEX)))) = "screen" then ! #Select# lwrc$(trim$(PSLV_Source$(Selected(Index)))) #Case# "screen"
65630 ! .        ! if its a screen, throw it on the list
65631             let FNADDAFSCREEN(PSLV_PATH$(SELECTED(INDEX))(1:POS(PSLV_PATH$(SELECTED(INDEX)),"\")-1),MAT AFFECTEDSCREENS$)
65632 ! 
65633          else if LWRC$(TRIM$(PSLV_SOURCE$(SELECTED(INDEX)))) = "function" then ! #Case# "function"
65634 ! .        ! If its a function, search for it in all the screens
65635             let FUNCTION$=FNFUNCTIONSTRING$(PSLV_PATH$(SELECTED(INDEX)))
65636 ! 
65637             mat SEARCHSCREENIO$(UDIM(MAT SCREENIO$))
65638             mat SEARCHSCREENIO(UDIM(MAT SCREENIO))
65639             mat SEARCHSCREENFLD$(UDIM(MAT SCREENFLD$))
65640             mat SEARCHSCREENFLD(UDIM(MAT SCREENFLD))
65641 ! 
65642             restore #FSCREENIO: 
65643             restore #FSCREENFLD: 
65644 ! 
65645             do UNTIL FILE(FSCREENIO)
65646                read #FSCREENIO, using FORM$(FSCREENIO), release: MAT SEARCHSCREENIO$, MAT SEARCHSCREENIO eof IGNORE
65647                if FILE(FSCREENIO)=0 then 
65648                   for JNDEX=SI_ENTERFN to SI_EXITFN
65649                      if LWRC$(TRIM$(SEARCHSCREENIO$(JNDEX)))=LWRC$(TRIM$(FUNCTION$)) then 
65650                         let FNADDAFSCREEN(SEARCHSCREENIO$(SI_SCREENCODE),MAT AFFECTEDSCREENS$)
65651                      end if 
65652                   next JNDEX
65653                end if 
65654             loop 
65655             do UNTIL FILE(FSCREENFLD)
65656                read #FSCREENFLD, using FORM$(FSCREENFLD), release: MAT SEARCHSCREENFLD$, MAT SEARCHSCREENFLD eof IGNORE
65657                if FILE(FSCREENFLD)=0 then 
65658                   if LWRC$(TRIM$(SEARCHSCREENFLD$(SF_FUNCTION)))=LWRC$(TRIM$(FUNCTION$)) then 
65659                      let FNADDAFSCREEN(SEARCHSCREENFLD$(SF_SCREENCODE),MAT AFFECTEDSCREENS$)
65660                   end if 
65661                   if LWRC$(TRIM$(SEARCHSCREENFLD$(SF_CNVRTIN)))=LWRC$(TRIM$(FUNCTION$)) then 
65662                      let FNADDAFSCREEN(SEARCHSCREENFLD$(SF_SCREENCODE),MAT AFFECTEDSCREENS$)
65663                   end if 
65664                   if LWRC$(TRIM$(SEARCHSCREENFLD$(SF_CNVRTOUT)))=LWRC$(TRIM$(FUNCTION$)) then 
65665                      let FNADDAFSCREEN(SEARCHSCREENFLD$(SF_SCREENCODE),MAT AFFECTEDSCREENS$)
65666                   end if 
65667                end if 
65668             loop 
65669 ! 
65670          else if LWRC$(TRIM$(PSLV_SOURCE$(SELECTED(INDEX)))) = "helper library" then ! #Case# "helper library"
65671 ! .        ! if its a helper lib throw the screen on the list
65672             let FNADDAFSCREEN(PSLV_PATH$(SELECTED(INDEX))(POS(PSLV_PATH$(SELECTED(INDEX)),"\",-1)+1:POS(PSLV_PATH$(SELECTED(INDEX)),".",-1)-1),MAT AFFECTEDSCREENS$)
65673 ! 
65674          else if LWRC$(TRIM$(PSLV_SOURCE$(SELECTED(INDEX)))) = "layout" then ! #Case# "layout"
65675 ! .        ! If its a file layout Search ScreenIO, add all screens that have a match in ScreenIO(si_filelay)
65676             let FUNCTION$=PSLV_PATH$(SELECTED(INDEX))(POS(PSLV_PATH$(SELECTED(INDEX)),"\",-1)+1:LEN(PSLV_PATH$(SELECTED(INDEX))))
65677 ! 
65678             mat SEARCHSCREENIO$(UDIM(MAT SCREENIO$))
65679             mat SEARCHSCREENIO(UDIM(MAT SCREENIO))
65680 ! 
65681             restore #FSCREENIO: 
65682             restore #FSCREENFLD: 
65683 ! 
65684             do UNTIL FILE(FSCREENIO)
65685                read #FSCREENIO, using FORM$(FSCREENIO), release: MAT SEARCHSCREENIO$, MAT SEARCHSCREENIO eof IGNORE
65686                if FILE(FSCREENIO)=0 then 
65687                   if LWRC$(TRIM$(SEARCHSCREENIO$(SI_FILELAY)))=LWRC$(TRIM$(FUNCTION$)) then 
65688                      let FNADDAFSCREEN(SEARCHSCREENIO$(SI_SCREENCODE),MAT AFFECTEDSCREENS$)
65689                   end if 
65690                end if 
65691             loop 
65692 ! 
65693          end if                       !#End Select#
65694       next INDEX
65695    fnend 
65696 ! 
65697    def FNADDAFSCREEN(SCREEN$,MAT SCREENS$)
65698       if SRCH(MAT SCREENS$,LWRC$(TRIM$(SCREEN$)))<1 then 
65699          mat SCREENS$(UDIM(MAT SCREENS$)+1)
65700          let SCREENS$(UDIM(MAT SCREENS$))=LWRC$(TRIM$(SCREEN$))
65701       end if 
65702    fnend 
65703 ! 
65704    def FNLOADRESULTSFILE(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65705 ! .  ! Browse for a file
65706       open #(FILENUMBER:=FNGETFILENUMBER): "name=open:.\*.res", internal, input, sequential error IGNORE
65707       if FILENUMBER AND FILE(FILENUMBER)>-1 then 
65708          let FNLOADRESULTS(FILENUMBER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65709          let RESULTSFILENAME$=FILE$(FILENUMBER)
65710          close #FILENUMBER: 
65711       end if 
65712    fnend 
65713    def FNSAVERESULTSFILE(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,FILENUMBER)
65714       if TRIM$(RESULTSFILENAME$)="" then 
65715          let FNSAVERESULTSFILEAS(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65716       else 
65717          open #(FILENUMBER:=FNGETFILENUMBER): "name="&RESULTSFILENAME$&", recl=1024, replace", internal, output, sequential 
65718          if FILENUMBER AND FILE(FILENUMBER)>-1 then 
65719             let FNSAVERESULTS(FILENUMBER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65720             close #FILENUMBER: 
65721          end if 
65722       end if 
65723    fnend 
65724    dim RESULTSFILENAME$*255
65725    def FNSAVERESULTSFILEAS(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,FILENUMBER)
65726 ! .  ! Browse for a file
65727       open #(FILENUMBER:=FNGETFILENUMBER): "name=save:.\*.res, recl=1024,replace", internal, output, sequential error IGNORE
65728       if FILENUMBER AND FILE(FILENUMBER)>-1 then 
65729          let FNSAVERESULTS(FILENUMBER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65730          let RESULTSFILENAME$=FILE$(FILENUMBER)
65731          close #FILENUMBER: 
65732       end if 
65733    fnend 
65734    def FNSAVERESULTS(FILENUMBER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX)
65735       write #FILENUMBER, using "form BH 3" : UDIM(MAT PSLV_SOURCE$)
65736       for INDEX=1 to UDIM(MAT PSLV_SOURCE$)
65737          write #FILENUMBER, using "form V 30,V 255,V 255,V 15,N 20" : PSLV_SOURCE$(INDEX),PSLV_PATH$(INDEX),PSLV_TEXT$(INDEX),PSLV_COLOR$(INDEX),PSLV_REFNUMBER(INDEX)
65738       next INDEX
65739    fnend 
65740    def FNLOADRESULTS(FILENUMBER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,COUNT,INDEX)
65741       read #FILENUMBER, using "form BH 3" : COUNT
65742       mat PSLV_SOURCE$(COUNT)
65743       mat PSLV_PATH$(COUNT)
65744       mat PSLV_TEXT$(COUNT)
65745       mat PSLV_COLOR$(COUNT)
65746       mat PSLV_REFNUMBER(COUNT)
65747       for INDEX=1 to COUNT
65748          read #FILENUMBER, using "form V 30,V 255,V 255,V 15,N 20" : PSLV_SOURCE$(INDEX),PSLV_PATH$(INDEX),PSLV_TEXT$(INDEX),PSLV_COLOR$(INDEX),PSLV_REFNUMBER(INDEX)
65749       next INDEX
65750    fnend 
65751 ! 
65752    def FNCLEARRESULTS(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65753       if (2==MSGBOX("This will remove all results from the list. Are you sure?","Clear all Results","yN","QST")) then 
65754          mat PSLV_SOURCE$(0)
65755          mat PSLV_PATH$(0)
65756          mat PSLV_TEXT$(0)
65757          mat PSLV_COLOR$(0)
65758          mat PSLV_REFNUMBER(0)
65759          mat PSLV_SELECTED(0)
65760       end if 
65761    fnend 
65762 ! 
65763    def FNREMOVEITEM(ITEM,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX)
65764       for INDEX=ITEM to UDIM(MAT PSLV_SOURCE$)-1
65765          let PSLV_SOURCE$(INDEX)=PSLV_SOURCE$(INDEX+1)
65766          let PSLV_PATH$(INDEX)=PSLV_PATH$(INDEX+1)
65767          let PSLV_TEXT$(INDEX)=PSLV_TEXT$(INDEX+1)
65768          let PSLV_COLOR$(INDEX)=PSLV_COLOR$(INDEX+1)
65769          let PSLV_REFNUMBER(INDEX)=PSLV_REFNUMBER(INDEX+1)
65770       next INDEX
65771       mat PSLV_SOURCE$(UDIM(MAT PSLV_SOURCE$)-1)
65772       mat PSLV_PATH$(UDIM(MAT PSLV_SOURCE$))
65773       mat PSLV_TEXT$(UDIM(MAT PSLV_SOURCE$))
65774       mat PSLV_COLOR$(UDIM(MAT PSLV_SOURCE$))
65775       mat PSLV_REFNUMBER(UDIM(MAT PSLV_SOURCE$))
65776    fnend 
65777 ! 
65778    dim WARNED
65779 ! 
65780    def FNADDRESULT(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,SOURCE$*30,PATH$*255,TEXT$*255;REFNUMBER,COLOR$,___,INDEX)
65781       let INDEX=UDIM(MAT PSLV_SOURCE$)+1
65782       if FN42 OR INDEX<4100 then 
65783          mat PSLV_SOURCE$(INDEX)
65784          mat PSLV_PATH$(INDEX)
65785          mat PSLV_TEXT$(INDEX)
65786          mat PSLV_COLOR$(INDEX)
65787          mat PSLV_REFNUMBER(INDEX)
65788 ! 
65789          if COLOR$="" then let COLOR$="#FFFFFF"
65790 ! 
65791          let PSLV_SOURCE$(INDEX)=TRIM$(SOURCE$)
65792          let PSLV_PATH$(INDEX)=TRIM$(PATH$)
65793          let PSLV_TEXT$(INDEX)=TRIM$(TEXT$)
65794          let PSLV_COLOR$(INDEX)=TRIM$(COLOR$)
65795          let PSLV_REFNUMBER(INDEX)=REFNUMBER
65796       else 
65797          if ~WARNED then 
65798             let MSGBOX("We ran out of memory to display all the results we found. Try running your search under BR 4.2 or Higher.","BR Data Structure Limitation","Ok","ERR")
65799             let WARNED=1
65800          end if 
65801       end if 
65802    fnend 
65803 ! 
65804 ! .! Execute the Search based on PS_Data$ and populate mat PSLV_Source$,mat PSLV_Path$,mat PSLV_Text$,mat PSLV_Color$,mat PSLV_RefNumber
65805    def FNSEARCH(MAT PS_DATA$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,MWINDOW)
65806       open #(MWINDOW:=FNGETFILENUMBER) : "SROW=14,SCOL=20,ROWS=3,COLS=60,BORDER=S",display,outin 
65807       print #MWINDOW, fields "2,2,CC 58" : "Searching. Please wait..."
65808 ! 
65809       let WARNED=0
65810       if PS_DATA$(_PS_SCREEN)(1:1)="^" then 
65811          print #MWINDOW, fields "2,2,CC 58" : "Searching Screens. Please wait..."
65812          let FNSEARCHSCREEN(PS_DATA$(_PS_SEARCHTEXT),MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65813       end if 
65814       if PS_DATA$(_PS_LAYOUT)(1:1)="^" then 
65815          print #MWINDOW, fields "2,2,CC 58" : "Searching File Layouts. Please wait..."
65816          let FNSEARCHFILELAY(PS_DATA$(_PS_SEARCHTEXT),MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65817       end if 
65818       if PS_DATA$(_PS_FUNCTION)(1:1)="^" then 
65819          print #MWINDOW, fields "2,2,CC 58" : "Searching Screen Functions. Please wait..."
65820          let FNSEARCHFUNCTIONS(PS_DATA$(_PS_SEARCHTEXT),MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65821       end if 
65822       if PS_DATA$(_PS_HELPERLIB)(1:1)="^" then 
65823          print #MWINDOW, fields "2,2,CC 58" : "Searching Compiled Helper Libraries. Please wait..."
65824          let FNSEARCHHELPERLIBS(PS_DATA$(_PS_SEARCHTEXT),MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
65825       end if 
65826       if PS_DATA$(_PS_PATH)(1:1)="^" OR PS_DATA$(_PS_USEALTEXT)(1:1)="^" then 
65827          if LEN(TRIM$(PS_DATA$(_PS_FOLDER))) AND EXISTS(TRIM$(PS_DATA$(_PS_FOLDER))) AND TRIM$(PS_DATA$(_PS_FOLDER))<>"\" then 
65828             if PS_DATA$(_PS_INCLUDESUBS)(1:1)=="^" then 
65829                print #MWINDOW, fields "2,2,CC 58" : "Searching Folder and Subfolders. Please wait..."
65830             else 
65831                print #MWINDOW, fields "2,2,CC 58" : "Searching Folder. Please wait..."
65832             end if 
65833             let FNSEARCHPROGRAMS(PS_DATA$(_PS_SEARCHTEXT),PS_DATA$(_PS_FOLDER),PS_DATA$(_PS_MASK),PS_DATA$(_PS_ALTEXT),(PS_DATA$(_PS_PATH)(1:1)=="^"),(PS_DATA$(_PS_USEALTEXT)(1:1)=="^"),(PS_DATA$(_PS_ALTEXTOBJECT)(1:1)=="^"),(PS_DATA$(_PS_INCLUDESUBS)(1:1)=="^"),(PS_DATA$(_PS_SEARCHALLEXT)(1:1)=="^"),(PS_DATA$(_PS_FUNCTION)(1:1)=="^"),MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,MWINDOW)
65834          end if 
65835       end if 
65836       close #MWINDOW: 
65837    fnend 
65838 ! 
65839 ! 
65840    dim SEARCHSCREENIO$(1)*1023, SEARCHSCREENIO(1)
65841    dim SEARCHSCREENFLD$(1)*1023, SEARCHSCREENFLD(1)
65842 ! 
65843    def FNSEARCHSCREEN(&TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,I,CONTROL,LASTSCREEN$,PREFIX$)
65844       mat SEARCHSCREENIO$(UDIM(MAT SCREENIO$))
65845       mat SEARCHSCREENIO(UDIM(MAT SCREENIO))
65846       mat SEARCHSCREENFLD$(UDIM(MAT SCREENFLD$))
65847       mat SEARCHSCREENFLD(UDIM(MAT SCREENFLD))
65848 ! 
65849       restore #FSCREENIO: 
65850       restore #FSCREENFLD: 
65851 ! 
65852       do UNTIL FILE(FSCREENIO)
65853          read #FSCREENIO, using FORM$(FSCREENIO), release: MAT SEARCHSCREENIO$, MAT SEARCHSCREENIO eof IGNORE
65854          if FILE(FSCREENIO)=0 then 
65855             for I=1 to UDIM(MAT SEARCHSCREENIO$)
65856                if POS(LWRC$(SEARCHSCREENIO$(I)),LWRC$(TRIM$(TEXT$))) then 
65857                   let FNADDRESULT(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Screen",LWRC$(SEARCHSCREENIO$(SI_SCREENCODE))&"\"&LWRC$(SCREENIO_SSUBS$(I))&"$",SEARCHSCREENIO$(I),FNFIELDONSCREEN(I))  !Match Found
65858                end if 
65859             next I
65860          end if 
65861       loop 
65862       do UNTIL FILE(FSCREENFLD)
65863          read #FSCREENFLD, using FORM$(FSCREENFLD), release: MAT SEARCHSCREENFLD$, MAT SEARCHSCREENFLD eof IGNORE
65864          if LASTSCREEN$<>SEARCHSCREENFLD$(SF_SCREENCODE) then 
65865             let CONTROL=0
65866             let LASTSCREEN$=SEARCHSCREENFLD$(SF_SCREENCODE)
65867             read #FSCREENIO, using FORM$(FSCREENIO), key=FNKEY$(FSCREENIO,LASTSCREEN$), release: MAT SEARCHSCREENIO$, MAT SEARCHSCREENIO nokey IGNORE
65868             if FILE(FSCREENIO)=0 then 
65869                let FNREADLAYOUTARRAYS(SEARCHSCREENIO$(SI_FILELAY),PREFIX$)
65870             else 
65871                let PREFIX$=""
65872             end if 
65873          end if 
65874          let CONTROL+=1
65875          if FILE(FSCREENFLD)=0 then 
65876             for I=1 to UDIM(MAT SEARCHSCREENFLD$)
65877                if ((I><SF_FIELDNAME) AND POS(LWRC$(SEARCHSCREENFLD$(I)),LWRC$(TRIM$(TEXT$)))) OR ((I=SF_FIELDNAME) AND POS(LWRC$(TRIM$(PREFIX$)&TRIM$(SEARCHSCREENFLD$(I))),LWRC$(TRIM$(TEXT$)))) then 
65878                   let FNADDRESULT(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Screen",LWRC$(SEARCHSCREENFLD$(SF_SCREENCODE))&"\"&FNFIELDHANDLE$(MAT SEARCHSCREENFLD$,MAT SEARCHSCREENFLD)&"\"&LWRC$(SCREENFLD_SSUBS$(I))&"$",SEARCHSCREENFLD$(I),CONTROL)  !Match Found
65879                end if 
65880             next I
65881          end if 
65882       loop 
65883    fnend 
65884 ! 
65885    def FNFIELDHANDLE$*200(MAT SCREENFLD$,MAT SCREENFLD)
65886       if TRIM$(SCREENFLD$(SF_CONTROLNAME))<>"" then 
65887          let FNFIELDHANDLE$=LWRC$(SCREENFLD$(SF_FIELDTYPE))&":"&SCREENFLD$(SF_CONTROLNAME)
65888       else if TRIM$(SCREENFLD$(SF_FIELDNAME))<>"" then 
65889          let FNFIELDHANDLE$=LWRC$(SCREENFLD$(SF_FIELDTYPE))&":<"&SCREENFLD$(SF_FIELDNAME)&">"
65890       else if TRIM$(SCREENFLD$(SF_DESCRIPTION))<>"" AND LWRC$(SCREENFLD$(SF_FIELDTYPE))=="caption" OR LWRC$(SCREENFLD$(SF_FIELDTYPE))=="button" then 
65891          let FNFIELDHANDLE$=LWRC$(SCREENFLD$(SF_FIELDTYPE))&":"""&SCREENFLD$(SF_DESCRIPTION)&""""
65892       else if TRIM$(SCREENFLD$(SF_PICTURE))<>"" AND LWRC$(SCREENFLD$(SF_FIELDTYPE))=="p" then 
65893          let FNFIELDHANDLE$=LWRC$(SCREENFLD$(SF_FIELDTYPE))&":"""&SCREENFLD$(SF_PICTURE)&""""
65894       else if TRIM$(SCREENFLD$(SF_FUNCTION))<>"" AND LWRC$(SCREENFLD$(SF_FIELDTYPE))=="caption" OR LWRC$(SCREENFLD$(SF_FIELDTYPE))=="button" then 
65895          let FNFIELDHANDLE$=LWRC$(SCREENFLD$(SF_FIELDTYPE))&":"""&SCREENFLD$(SF_DESCRIPTION)&""""
65896       else 
65897          if LWRC$(SCREENFLD$(SF_FIELDTYPE))="listchld" OR LWRC$(SCREENFLD$(SF_FIELDTYPE))="listview" then 
65898             let FNFIELDHANDLE$=LWRC$(SCREENFLD$(SF_FIELDTYPE))&":["&STR$(SCREENFLD(SF_VPOSITION))&","&STR$(SCREENFLD(SF_HPOSITION))&",list "&STR$(SCREENFLD(SF_WIDTH))&"/"&STR$(SCREENFLD(SF_HEIGHT))&"]"
65899          else 
65900             let FNFIELDHANDLE$=LWRC$(SCREENFLD$(SF_FIELDTYPE))&":["&STR$(SCREENFLD(SF_VPOSITION))&","&STR$(SCREENFLD(SF_HPOSITION))&","&FNCALCULATEFIELDTYPE$(SCREENFLD$(SF_FIELDTYPE),SCREENFLD$(SF_JUSTIFY),SCREENFLD(SF_WIDTH),SCREENFLD(SF_SPECWIDTH),SCREENFLD(SF_HEIGHT))&"]"
65901          end if 
65902       end if 
65903    fnend 
65904 ! 
65905    dim D1$(1)*36, D2$(1)*36, D3$(1)*36, D4$(1)*36, D5$(1)*255
65906    dim AS_REFERENCE(1), READFIELDONSCREEN
65907    def FNFIELDONSCREEN(I)
65908       if ~READFIELDONSCREEN then 
65909          let FNDEFINEATTRIBUTESWINDOW(MAT D1$,MAT D2$,MAT D3$,MAT D4$,MAT D5$,MAT AS_REFERENCE)
65910          let READFIELDONSCREEN=1
65911       end if 
65912       let FNFIELDONSCREEN=MAX(0,SRCH(MAT AS_REFERENCE,I))
65913    fnend 
65914 ! 
65915    dim STRINGOFTEXT$*10000
65916    def FNSEARCHTEXTFILE(FILENAME$*255,&TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,TYPE$*40;PATH$*255,___,TEXTFILE)
65917       open #(TEXTFILE:=FNGETFILENUMBER): "name="&FILENAME$, display, input error IGNORE
65918       if FILE(TEXTFILE)=0 then 
65919          if PATH$="" then let PATH$=FILENAME$
65920          do UNTIL FILE(TEXTFILE)
65921             linput #TEXTFILE: STRINGOFTEXT$ error IGNORE
65922             if FILE(TEXTFILE)=0 then 
65923                if POS(LWRC$(STRINGOFTEXT$),LWRC$(TRIM$(TEXT$))) then 
65924                   let FNSHRINKAROUND(STRINGOFTEXT$,TRIM$(TEXT$),150)
65925                   let FNADDRESULT(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,TYPE$,PATH$,STRINGOFTEXT$)
65926                end if 
65927             end if 
65928          loop 
65929          close #TEXTFILE: 
65930       end if 
65931    fnend 
65932 ! 
65933    def FNSHRINKAROUND(&LONGSTRING$,SEARCHSTRING$*255,SIZE;___,X,Q,S,E)
65934       let LONGSTRING$=TRIM$(LONGSTRING$)
65935       if LEN(LONGSTRING$)>SIZE then 
65936          let Q=INT(SIZE/4)
65937          let X=POS(LWRC$(LONGSTRING$),LWRC$(SEARCHSTRING$))
65938          if X>0 then 
65939             let S=MAX(1,X-Q)
65940             let E=MIN(LEN(LONGSTRING$),S+SIZE-1)
65941             let S=MAX(1,E-SIZE+1)
65942             let LONGSTRING$=LONGSTRING$(S:E)
65943          else 
65944             let LONGSTRING$=LONGSTRING$(1:SIZE)
65945          end if 
65946       end if 
65947    fnend 
65948 ! 
65949    dim FILELIST$(1)*255
65950    dim SEARCHSSUBS$(1)*255, SEARCHNSUBS$(1)*255
65951    def FNSEARCHFILELAY(&TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX,LAYOUTPATH$*255,PREFIX$,JNDEX)
65952 ! .  ! Text File Search
65953       let LAYOUTPATH$=FNREADLAYOUTPATH$
65954       let FNREADLAYOUTS(MAT FILELIST$)
65955 ! 
65956       for INDEX=1 to UDIM(MAT FILELIST$)
65957          let FNSEARCHTEXTFILE(LAYOUTPATH$&FILELIST$(INDEX),TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Layout")
65958          let FNREADLAYOUTARRAYS(FILELIST$(INDEX),PREFIX$,MAT SEARCHSSUBS$,MAT SEARCHNSUBS$)
65959          for JNDEX=1 to UDIM(MAT SEARCHSSUBS$)
65960             if POS(LWRC$(TRIM$(PREFIX$)&TRIM$(SEARCHSSUBS$(JNDEX))),LWRC$(TRIM$(TEXT$))) then 
65961                let FNADDRESULT(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Layout",LWRC$("filelay\"&FILELIST$(INDEX))&"\"&LWRC$(TRIM$(PREFIX$)&TRIM$(SEARCHSSUBS$(JNDEX)))&"$",LWRC$(TRIM$(PREFIX$)&TRIM$(SEARCHSSUBS$(JNDEX)))&"$")  !Match Found
65962             end if 
65963          next JNDEX
65964          for JNDEX=1 to UDIM(MAT SEARCHNSUBS$)
65965             if POS(LWRC$(TRIM$(PREFIX$)&TRIM$(SEARCHNSUBS$(JNDEX))),LWRC$(TRIM$(TEXT$))) then 
65966                let FNADDRESULT(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Layout",LWRC$("filelay\"&FILELIST$(INDEX))&"\"&LWRC$(TRIM$(PREFIX$)&TRIM$(SEARCHNSUBS$(JNDEX))),LWRC$(TRIM$(PREFIX$)&TRIM$(SEARCHNSUBS$(JNDEX))))  !Match Found
65967             end if 
65968          next JNDEX
65969       next INDEX
65970    fnend 
65971 ! 
65972    def FNSEARCHFUNCTIONS(&TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX)
65973 ! .  ! Text File Search
65974       let FNREADFILES(MAT FILELIST$,SETTING_FUNCTIONFOLDER$,"brs",1,0,1)
65975 ! 
65976       for INDEX=1 to UDIM(MAT FILELIST$)
65977          let FNSEARCHTEXTFILE(SETTING_FUNCTIONFOLDER$&FILELIST$(INDEX),TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Function")
65978       next INDEX
65979 ! 
65980       if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
65981          let FNREADFILES(MAT FILELIST$,SETTING_FUNCTIONFOLDER$&"defaults\","brs",1,0,1)
65982          for INDEX=1 to UDIM(MAT FILELIST$)
65983             let FNSEARCHTEXTFILE(SETTING_FUNCTIONFOLDER$&"defaults\"&FILELIST$(INDEX),TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Function")
65984          next INDEX
65985       end if 
65986    fnend 
65987 ! 
65988    def FNSEARCHHELPERLIBS(&TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX)
65989 ! .  ! Text File Search
65990       let FNREADFILES(MAT FILELIST$,"screenio","brs",1,0,1)
65991 ! 
65992       for INDEX=1 to UDIM(MAT FILELIST$)
65993          let FNSEARCHTEXTFILE(""&SETTING_SCREENFOLDER$&"\"&FILELIST$(INDEX),TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Helper Library")
65994       next INDEX
65995    fnend 
65996 ! 
65997    def FNNEWEXT(FILENAME$*128;ALTEXT$,___,EXT$,POSITION)
65998       let POSITION=POS(FILENAME$,".",-1)
65999       if POSITION then let EXT$=FILENAME$(POSITION+1:LEN(FILENAME$))
66000       if LWRC$(TRIM$(EXT$)) = "brs" OR LWRC$(TRIM$(EXT$)) = "wbs" OR LWRC$(TRIM$(EXT$)) = "br" OR LWRC$(TRIM$(EXT$)) = "wb" OR LWRC$(TRIM$(EXT$)) = LWRC$(TRIM$(ALTEXT$)) OR LWRC$(TRIM$(EXT$)) = "bak" then ! #Select# lwrc$(trim$(Ext$)) #Case# "brs" # "wbs" # "br" # "wb" # lwrc$(trim$(AltExt$)) # "bak"
66001       else ! #Case Else#
66002          if ~POS(LWRC$(FILENAME$),"brlog.txt") AND ~POS(LWRC$(FILENAME$),"fileio.log") AND ~POS(LWRC$(FILENAME$),"dir.doc") then 
66003             let FNNEWEXT=1
66004          end if 
66005       end if                          !#End Select#
66006    fnend 
66007 ! 
66008    dim TASTRING$*2000
66009    def FNVALIDASCIIFILE(FILENAME$*128;___,FILEN)
66010       open #(FILEN:=FNGETFILENUMBER): "name="&FILENAME$&", recl=2000", display, input error Skipthisfile
66011       if FILE(FILEN)=0 then 
66012          linput #FILEN: TASTRING$ error IGNORE
66013          if FILE(FILEN)=0 then 
66014             let FNVALIDASCIIFILE=FNASCII(STRING$)
66015          end if 
66016       end if 
66017       close #FILEN: 
66018 Skipthisfile: ! Jumps here if we can't even open it
66019    fnend 
66020 ! 
66021    def FNASCII(&STRING$;___,CHAR,INDEX)
66022       let FNASCII=1
66023       do WHILE (INDEX:=INDEX+1)<=LEN(STRING$)
66024          let CHAR=ORD(STRING$(INDEX:INDEX))
66025          if (CHAR<32 AND CHAR><10 AND CHAR><13 AND CHAR><26) OR CHAR>=127 then 
66026             let FNASCII=0
66027             exit do 
66028          end if 
66029       loop 
66030    fnend 
66031 ! 
66032    dim DIRECTORY$*9999
66033    def FNBUILDFOLDERLIST(MAT LIST$;FOLDER$*255,___,FOLDERFILE,LASTCHAR)
66034       if FOLDER$="" then let FOLDER$=BR_FILENAME$(OS_FILENAME$("."))  !Current dir first
66035       let LASTCHAR=LEN(FOLDER$)
66036       if FOLDER$(LASTCHAR:LASTCHAR)="\" then let FOLDER$=FOLDER$(1:LASTCHAR-1)
66037       mat LIST$(1)
66038       let LIST$(1)=FOLDER$            !Current dir first
66039       if ~EXISTS("dirlist.sch") then execute "system -M dir """&OS_FILENAME$(FOLDER$)&""" /s /b /ad >dirlist.sch"
66040       open #(FOLDERFILE:=FNGETFILENUMBER): "name=dirlist.sch, recl=2000", display, input 
66041       do UNTIL FILE(FOLDERFILE)
66042          linput #FOLDERFILE : DIRECTORY$ eof IGNORE
66043          if FILE(FOLDERFILE)=0 then 
66044             if BR_FILENAME$(TRIM$(DIRECTORY$))(1:1)<>":" AND POS(BR_FILENAME$(TRIM$(DIRECTORY$))," ")=0 AND POS(DIRECTORY$,".svn")=0 AND POS(DIRECTORY$,"filelay\version")=0 then 
66045                mat LIST$(UDIM(MAT LIST$)+1)
66046                let LIST$(UDIM(MAT LIST$))=BR_FILENAME$(DIRECTORY$)
66047             end if 
66048          end if 
66049       loop 
66050 ! 
66051       close #FOLDERFILE: 
66052 ! .  ! execute "*free dirlist.sch"
66053    fnend 
66054 ! 
66055 ! 
66056    dim ALREADYSEARCHED$(1)*255
66057    dim WARNEDABOUTFOLDER
66058    dim SEARCHFOLDERS$(1)*255
66059    dim FILEFOLDERLIST$(1)*255
66060 ! 
66061    dim ALLEXTFILES$(1)*255
66062    def FNSEARCHPROGRAMS(&TEXT$,&FOLDER$,&MASK$,&ALTEXT$,USESTANDARD,USEALTEXT,ALTEXTOBJECT,INCLUDESUBFOLDERS,INCLUDEALLEXT,SUPPRESSFUNCTIONFOLDER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;MWINDOW,___,INDEX,WAITCOUNT,COMPILENUMBER,WAITTIME,SAIDSOMETHING,PROCFILE,DIRINDEX,FOLDERLISTINDEX,TESTALTEXT$,NUMBEROFFILES)
66063       if INCLUDESUBFOLDERS then 
66064 ! .     ! Build a DirList$
66065          let FNBUILDFOLDERLIST(MAT SEARCHFOLDERS$,FOLDER$)
66066       else 
66067          mat SEARCHFOLDERS$(1)
66068          let SEARCHFOLDERS$(1)=FOLDER$
66069       end if 
66070 ! 
66071       if MWINDOW then print #MWINDOW, fields "2,2,CC 58" : "Searching Folder: Finding Files. Please wait..."
66072 ! 
66073 ! .  ! Text File Search
66074       mat FILELIST$(0) : mat FILEFOLDERLIST$(0)
66075       for DIRINDEX=1 to UDIM(MAT SEARCHFOLDERS$)
66076          if ~SUPPRESSFUNCTIONFOLDER OR OS_FILENAME$(SEARCHFOLDERS$(DIRINDEX))><OS_FILENAME$(SETTING_FUNCTIONFOLDER$) then 
66077             if USESTANDARD then 
66078                let FNREADFILES(MAT FILELIST$,TRIM$(SEARCHFOLDERS$(DIRINDEX)),"brs",0,0,1,MASK$)
66079                let FNREADFILES(MAT FILELIST$,TRIM$(SEARCHFOLDERS$(DIRINDEX)),"wbs",0,0,1,MASK$)
66080             end if 
66081             if USEALTEXT AND ~ALTEXTOBJECT then 
66082                let FNREADFILES(MAT FILELIST$,TRIM$(SEARCHFOLDERS$(DIRINDEX)),LWRC$(ALTEXT$),0,0,1,MASK$)
66083             end if 
66084 ! 
66085             if INCLUDEALLEXT then ! Then check for all extensions and add the others in here if they're valid text files.
66086                if USEALTEXT then let TESTALTEXT$=ALTEXT$ else let TESTALTEXT$=""
66087                mat ALLEXTFILES$(0)
66088                let FNREADFILES(MAT ALLEXTFILES$,TRIM$(SEARCHFOLDERS$(DIRINDEX)),"",0,0,1,MASK$)
66089                for INDEX=1 to UDIM(MAT ALLEXTFILES$)
66090                   if FNNEWEXT(ALLEXTFILES$(INDEX),TESTALTEXT$) AND FNVALIDASCIIFILE(SEARCHFOLDERS$(DIRINDEX)&"\"&ALLEXTFILES$(INDEX)) then 
66091                      mat FILELIST$(UDIM(MAT FILELIST$)+1)
66092                      let FILELIST$(UDIM(MAT FILELIST$))=ALLEXTFILES$(INDEX)
66093                   end if 
66094                next INDEX
66095             end if 
66096 ! 
66097 ! .        ! Record which folder to use later.
66098             let FOLDERINDEX=UDIM(MAT FILEFOLDERLIST$)+1
66099             mat FILEFOLDERLIST$(UDIM(MAT FILELIST$))
66100 ! 
66101             if UDIM(MAT FILEFOLDERLIST$)>=FOLDERINDEX then 
66102                mat FILEFOLDERLIST$(FOLDERINDEX:UDIM(MAT FILEFOLDERLIST$))=(SEARCHFOLDERS$(DIRINDEX))
66103             end if 
66104          end if 
66105       next DIRINDEX
66106 ! 
66107       mat ALREADYSEARCHED$(UDIM(MAT FILELIST$))
66108 ! 
66109       if MWINDOW then print #MWINDOW, fields "2,2,CC 58" : "Searching Folder: Searching Ascii Files. Please wait..."
66110       for INDEX=1 to UDIM(MAT FILELIST$)
66111          let ALREADYSEARCHED$(INDEX)=LWRC$(TRIM$(FILEFOLDERLIST$(INDEX)&"\"&FILELIST$(INDEX)))
66112          let FNSEARCHTEXTFILE(TRIM$(FILEFOLDERLIST$(INDEX))&"\"&FILELIST$(INDEX),TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Program")
66113       next INDEX
66114 ! 
66115       if MWINDOW then print #MWINDOW, fields "2,2,CC 58" : "Searching Folder: Finding BR Object Files. Please wait..."
66116 ! 
66117 ! .  ! Also search for .br and .wb files
66118       if FOLDER$(1:1)=":" then 
66119          if ~WARNEDABOUTFOLDER then 
66120             let MSGBOX("Warning: It is not possible to search for BR Object files outside of your BR path. Only Source files will be searched.","Warning:")
66121             let WARNEDABOUTFOLDER=1
66122          end if 
66123       else 
66124          mat FILELIST$(0) : mat FILEFOLDERLIST$(0)
66125          for DIRINDEX=1 to UDIM(MAT SEARCHFOLDERS$)
66126             if ~SUPPRESSFUNCTIONFOLDER OR OS_FILENAME$(SEARCHFOLDERS$(DIRINDEX))><OS_FILENAME$(SETTING_FUNCTIONFOLDER$) then 
66127                if USESTANDARD then 
66128                   let FNREADFILES(MAT FILELIST$,TRIM$(SEARCHFOLDERS$(DIRINDEX)),"br ",0,0,1,MASK$)
66129                   let FNREADFILES(MAT FILELIST$,TRIM$(SEARCHFOLDERS$(DIRINDEX)),"wb ",0,0,1,MASK$)
66130                end if 
66131                if USEALTEXT AND ALTEXTOBJECT then 
66132                   let FNREADFILES(MAT FILELIST$,TRIM$(SEARCHFOLDERS$(DIRINDEX)),LWRC$(ALTEXT$),0,0,1,MASK$)
66133                end if 
66134 ! 
66135                let FOLDERINDEX=UDIM(MAT FILEFOLDERLIST$)+1
66136                mat FILEFOLDERLIST$(UDIM(MAT FILELIST$))
66137 ! 
66138                if UDIM(MAT FILEFOLDERLIST$)>=FOLDERINDEX then 
66139                   mat FILEFOLDERLIST$(FOLDERINDEX:UDIM(MAT FILEFOLDERLIST$))=(SEARCHFOLDERS$(DIRINDEX))
66140                end if 
66141             end if 
66142          next DIRINDEX
66143 ! 
66144          if MWINDOW then print #MWINDOW, fields "2,2,CC 58" : "Searching Folder: Building Decompile Proc. Please wait..."
66145          for INDEX=1 to UDIM(MAT FILELIST$)
66146             if SRCH(MAT ALREADYSEARCHED$,LWRC$(TRIM$(FILEFOLDERLIST$(INDEX)&"\"&FILELIST$(INDEX)))&"s")<1 AND SRCH(MAT ALREADYSEARCHED$,LWRC$(TRIM$(FILEFOLDERLIST$(INDEX)&"\"&SREP$(FILELIST$(INDEX),".wb",".brs"))))<1 then 
66147                if LWRC$(TRIM$(FILELIST$(INDEX)))<>"screenio.br" then 
66148                   if ~PROCFILE then let PROCFILE=FNOPENDECOMPILEPROC(COMPILENUMBER)
66149                   let FNBUILDDECOMPILEPROC(FILELIST$(INDEX),FILEFOLDERLIST$(INDEX),PROCFILE)
66150                   let NUMBEROFFILES+=1
66151                end if 
66152             end if 
66153          next INDEX
66154          if MWINDOW then print #MWINDOW, fields "2,2,CC 58" : "Searching Folder: Decompiling BR Programs. Please wait..."
66155          if PROCFILE then let FNCLOSEDECOMPILEPROC(PROCFILE,COMPILENUMBER)
66156 ! 
66157          let WAITCOUNT=TIMER
66158          let WAITTIME=NUMBEROFFILES*.3  !seconds
66159          let SAIDSOMETHING=0
66160          do WHILE EXISTS("compile"&STR$(COMPILENUMBER)&".$$$")
66161             let SLEEP(.1)
66162             if TIMER-WAITCOUNT>WAITTIME then 
66163                if (2==MSGBOX("We've been waiting a long time. There were "&STR$(NUMBEROFFILES)&" files to decompile. Could something have gotten stuck, perhaps? Do you want to wait longer?","Wait Longer?","Yn")) then 
66164                   let WAITCOUNT=TIMER
66165                   let SAIDSOMETHING=1
66166                end if 
66167             end if 
66168          loop UNTIL TIMER-WAITCOUNT>WAITTIME
66169 ! 
66170          if EXISTS("compile"&STR$(COMPILENUMBER)&".$$$") then 
66171             let MSGBOX("Search Failed for .BR files","Error")
66172             execute "free compile"&STR$(COMPILENUMBER)&".$$$" error IGNORE
66173             if EXISTS("compile"&STR$(COMPILENUMBER)&".$$$") then let COMPILENUMBER+=1
66174          else if SAIDSOMETHING then 
66175             let MSGBOX("We were able to recover the search.")
66176          end if 
66177 ! 
66178          if MWINDOW then print #MWINDOW, fields "2,2,CC 58" : "Searching Folder: Searching BR Programs. Please wait..."
66179          for INDEX=1 to UDIM(MAT FILELIST$)
66180             if EXISTS("temp_"&LWRC$(TRIM$(FILELIST$(INDEX)))&".brs") then 
66181                let FNSEARCHTEXTFILE("temp_"&LWRC$(TRIM$(FILELIST$(INDEX)))&".brs",TEXT$,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER,"Program",TRIM$(FILEFOLDERLIST$(INDEX))&"\"&FILELIST$(INDEX))
66182                execute "free ""temp_"&LWRC$(TRIM$(FILELIST$(INDEX)))&".brs"""
66183             end if 
66184          next INDEX
66185       end if 
66186    fnend 
66187 ! 
66188    def FNOPENDECOMPILEPROC(&COMPILENUMBER;___,FILENUMBER)
66189       open #(FILENUMBER:=FNGETFILENUMBER): "name=compile"&STR$(COMPILENUMBER)&".$$$, replace", display, output error Trynextnumber
66190       print #FILENUMBER: "proc noecho"
66191       let FNOPENDECOMPILEPROC=FILENUMBER
66192    fnend 
66193 ! 
66194 Trynextnumber: ! Try a new number
66195    let COMPILENUMBER+=1
66196    retry 
66197 ! 
66198    def FNCLOSEDECOMPILEPROC(FILENUMBER,COMPILENUMBER)
66199       print #FILENUMBER: "system"
66200       close #FILENUMBER: 
66201 ! 
66202 ! .   ! Extract Source Code
66203       execute "system -C -M "&FNGETBREXE$&" -"&FNGETWBCFG$&" proc compile"&STR$(COMPILENUMBER)&".$$$"
66204    fnend 
66205 ! 
66206    def FNBUILDDECOMPILEPROC(FILENAME$*255,FOLDER$*255,FILENUMBER)
66207       print #FILENUMBER: "load """&TRIM$(FOLDER$)&"\"&TRIM$(FILENAME$)&""""
66208       print #FILENUMBER: "list >""temp_"&LWRC$(TRIM$(FILENAME$))&".brs"""
66209    fnend 
66210 ! 
66211    def FNPRINTLISTTOFILE(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,FILENUMBER,FILENAME$*255)
66212 ! .  ! Browse for a file
66213       open #(FILENUMBER:=FNGETFILENUMBER): "name=save:.\*.txt, recl=1024,replace", display, output error IGNORE
66214       if FILENUMBER AND FILE(FILENUMBER)>-1 then 
66215          let FNPRINTLIST(FILENUMBER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
66216          let FILENAME$=FILE$(FILENUMBER)
66217          close #FILENUMBER: 
66218          execute "system -M -C start ""Launching"" """&OS_FILENAME$(FILENAME$)&""""
66219       end if 
66220    fnend 
66221 ! 
66222    def FNPRINTLISTTOPRINTER(MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
66223 ! .  ! Open the printer
66224       let FNPRINTERSYS
66225       open #255: "name=preview:/default, recl=1024", display, output 
66226       print #255: "[LANDSCAPE][A4PAPER][SETFONT(SystemPC)][LPI(8)][CPI(16)]";
66227       let FNPRINTLIST(255, MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER)
66228       close #255: 
66229    fnend 
66230 ! 
66231    def FNPRINTLIST(FILENUMBER,MAT PSLV_SOURCE$,MAT PSLV_PATH$,MAT PSLV_TEXT$,MAT PSLV_COLOR$,MAT PSLV_REFNUMBER;___,INDEX,SOURCELEN,PATHLEN,TEXTLEN,PRINTER)
66232       if FILENUMBER=255 then let PRINTER=1
66233       let SOURCELEN=7
66234       let PATHLEN=5
66235       let TEXTLEN=5
66236       for INDEX=1 to UDIM(MAT PSLV_SOURCE$)
66237          let SOURCELEN=MAX(SOURCELEN,LEN(PSLV_SOURCE$(INDEX)))
66238          let PATHLEN=MAX(PATHLEN,LEN(PSLV_PATH$(INDEX)))
66239          let TEXTLEN=MAX(TEXTLEN,LEN(PSLV_TEXT$(INDEX)))
66240       next INDEX
66241       print #FILENUMBER: "PowerSearch: """&TRIM$(PS_DATA$(_PS_SEARCHTEXT))&""" Folder: """&TRIM$(PS_DATA$(_PS_FOLDER))&""" "&DATE$("Day, Month dd, ccyy")&", "&TIME$
66242       print #FILENUMBER: 
66243       print #FILENUMBER: SREP$(RPAD$(" Source",SOURCELEN)," ","_")&" "&SREP$(RPAD$(" Path",PATHLEN)," ","_")&" "&SREP$(RPAD$(" Text",TEXTLEN)," ","_")
66244       for INDEX=1 to UDIM(MAT PSLV_SOURCE$)
66245          if PRINTER then 
66246             if PSLV_COLOR$(INDEX)="#FFFFFF" then 
66247                print #FILENUMBER: "[SETCOLOR(#000000)]";
66248             else 
66249                print #FILENUMBER: "[SETCOLOR("&PSLV_COLOR$(INDEX)&")]";
66250             end if 
66251          end if 
66252          print #FILENUMBER: RPAD$(TRIM$(PSLV_SOURCE$(INDEX)),SOURCELEN)&" "&RPAD$(TRIM$(PSLV_PATH$(INDEX)),PATHLEN)&" "&RPAD$(TRIM$(PSLV_TEXT$(INDEX)),TEXTLEN);
66253          if ~PRINTER then 
66254             print #FILENUMBER: " "&FNCOLORNAME$(PSLV_COLOR$(INDEX))
66255          else 
66256             print #FILENUMBER: 
66257          end if 
66258       next INDEX
66259    fnend 
66260 ! 
66261    def FNPRINTLISTTOPRINTERSIMPLE(MAT DATA$)
66262 ! .  ! Open the printer
66263       open #255: "name=preview:/default, recl=1024", display, output 
66264       let FNPRINTLISTSIMPLE(255, MAT DATA$)
66265       close #255: 
66266    fnend 
66267 ! 
66268    def FNPRINTLISTSIMPLE(FILENUMBER,MAT DATA$;___,INDEX)
66269       for INDEX=1 to UDIM(MAT DATA$)
66270          print #FILENUMBER: DATA$(INDEX)
66271       next INDEX
66272    fnend 
66273 ! 
66274 ! 
66275    def FNCOLORNAME$(COLOR$)
66276       if UPRC$(TRIM$(COLOR$(2:7))) = "FFFFFF" then ! #Select# uprc$(trim$(color$(2:7))) #Case# "FFFFFF"
66277          let FNCOLORNAME$="White"
66278       else if UPRC$(TRIM$(COLOR$(2:7))) = "FFFF00" then ! #Case# "FFFF00"
66279          let FNCOLORNAME$="Yellow"
66280       else if UPRC$(TRIM$(COLOR$(2:7))) = "00FF00" then ! #Case# "00FF00"
66281          let FNCOLORNAME$="Green"
66282       end if                          !#End select#
66283    fnend 
66284 ! 
66285    dim PRINTERSYSSET
66286    def FNPRINTERSYS                   !Activate Printer.Sys commands
66287       if ~PRINTERSYSSET then 
66288          execute "config PRINTER TYPE NWP select WIN:"
66289          execute "config PRINTER TYPE NWP select PREVIEW:"
66290 ! 
66291          execute 'config PRINTER NWP [SETCOLOR(CCCCCCC)], "\Ecolor=''CCCCCCC''"'
66292          execute 'config PRINTER NWP [CPI(NNN)], "\E(sNNNH"'
66293          execute 'config PRINTER NWP [LPI(NNN)], "\E&lNNND"'
66294          execute 'config PRINTER NWP [SETFONT(FontName)], "\Efont=''FontName''"'
66295          execute 'config PRINTER NWP [A4PAPER], "\E&l26A" ! 210mm x 297mm'
66296          execute 'config PRINTER NWP [LANDSCAPE], "\E&l1O"'
66297          let PRINTERSYSSET=1
66298       end if 
66299    fnend 
66300 ! 
68000 !  #AutoNumber# 68000,2
68002 !  =================================================
68004 !  ================= Code Explorer =================
68006 !  =================================================
68008 ! 
68010    dim CELV_SPEC$
68012    dim CELV_CAP$(2)*30,CELV_WIDTH(2),CELV_SPEC$(2)
68014    dim CE_CAPSPEC$(2)*30, CE_CAPTION$(2)*30
68016 ! 
68018    dim CELV_PATH$(1)*255
68020    dim CELV_LOCATION$(1)*255
68022    dim CELV_SELECTED(1)
68024 ! 
68026    def FNCODEEXPLORE(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,FUNCTION,CODEEXPLORE,ROWCOUNT,DONE)
68028 ! .  ! Initialize PowerSearch Results Listview
68030       let CELV_SPEC$="1,1,LIST 22/50"
68032 ! 
68034 ! .  ! Initialize PowerSearch Results Listview Columns
68036       let CELV_CAP$(1)="Function"
68038       let CELV_WIDTH(1)=20
68040       let CELV_SPEC$(1)="C 255"
68042 ! 
68044       let CELV_CAP$(2)="Location"
68046       let CELV_WIDTH(2)=10
68048       let CELV_SPEC$(2)="C 255"
68050 ! 
68052       mat CELV_PATH$(0)
68054       mat CELV_LOCATION$(0)
68056 ! 
68058 ! .  ! Initialize Code Explorer Buttons and Caption Specs
68060       mat CE_CAPSPEC$(2) : mat CE_CAPTION$(2)
68062       let CE_CAPSPEC$(1)="23,3,10/CC 17,/W:W,B36"  !Jump To Item
68064       let CE_CAPSPEC$(2)="23,14,15/CC 26,/W:W,B37"  !Affected Screen List
68066 ! 
68068       let CE_CAPTION$(1)="Launch"
68070       let CE_CAPTION$(2)="Affected Screens"
68072 ! 
68074       open #(CODEEXPLORE:=FNGETFILENUMBER): "srow=4,scol=30,rows=23,cols=50,Border=s,Caption=Code Explorer", display, outin 
68076 ! 
68078       print #CODEEXPLORE, fields MAT CE_CAPSPEC$ : MAT CE_CAPTION$
68080       print #CODEEXPLORE, fields CELV_SPEC$&",HEADERS,/W:W" : (MAT CELV_CAP$, MAT CELV_WIDTH, MAT CELV_SPEC$)
68082 ! 
68084       let FNPOPULATECODEEXPLORE(MAT CELV_PATH$,MAT CELV_LOCATION$,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
68086 ! 
68088       if UDIM(MAT CELV_PATH$) then 
68090 ! .     ! Predraw listview if any data belongs in it
68092          print #CODEEXPLORE, fields CELV_SPEC$&",=" : (MAT CELV_PATH$,MAT CELV_LOCATION$)
68094          do 
68096             input #CODEEXPLORE, fields CELV_SPEC$&",ROWCNT,SEL" : ROWCOUNT
68098             mat CELV_SELECTED(ROWCOUNT)
68100             input #CODEEXPLORE, fields CELV_SPEC$&",ROWSUB,SEL,NOWAIT" : MAT CELV_SELECTED
68102 ! 
68104             let FUNCTION=FKEY
68106 ! 
68108             if FUNCTION = 36 then ! #Select# Function #Case# 36
68110 ! .           ! Jump To Item
68112                let FNCEJUMPTO(MAT CELV_SELECTED,MAT CELV_PATH$)
68114 ! 
68116             else if FUNCTION = 37 then ! #Case# 37
68118 ! .           ! Affected Screen List
68120                let DONE=FNCEAFFECTEDSCREENLIST(MAT CELV_SELECTED,MAT CELV_PATH$)
68122 ! 
68124             end if                    !#End Select#
68126 ! 
68128          loop UNTIL FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR ((FUNCTION>1100) AND (FUNCTION<1699)) OR FUNCTION=19 OR FKEY=93 OR DONE
68130       else 
68132          let MSGBOX("No functions are defined in the current screen.","Nothing to display")
68134       end if 
68136       if CODEEXPLORE AND FILE(CODEEXPLORE)>-1 then close #CODEEXPLORE: 
68138    fnend 
68140 ! 
68142    def FNPOPULATECODEEXPLORE(MAT PATH$,MAT LOCATION$,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,LOC$*255)
68144       for INDEX=SI_ENTERFN to SI_EXITFN
68146          if LEN(TRIM$(SCREENIO$(INDEX))) then 
68148             let FNADDCERESULT(TRIM$(SCREENIO$(INDEX)),MAT PATH$,MAT LOCATION$,FNEVENTNAME$(-1,INDEX))
68150          end if 
68152       next INDEX
68154 ! 
68156       for INDEX=1 to UDIM(MAT CONTROLNAME$)
68158          if LEN(TRIM$(FUNCTION$(INDEX))) then 
68160             let FNADDCERESULT(TRIM$(FUNCTION$(INDEX)),MAT PATH$,MAT LOCATION$,FNEVENTNAME$(INDEX,1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
68162          end if 
68164          if LEN(TRIM$(CNVRTIN$(INDEX))) then 
68166             let FNADDCERESULT(TRIM$(FUNCTION$(INDEX)),MAT PATH$,MAT LOCATION$,FNEVENTNAME$(INDEX,2,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
68168          end if 
68170          if LEN(TRIM$(CNVRTOUT$(INDEX))) then 
68172             let FNADDCERESULT(TRIM$(FUNCTION$(INDEX)),MAT PATH$,MAT LOCATION$,FNEVENTNAME$(INDEX,3,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
68174          end if 
68176       next INDEX
68178 ! 
68180       if EXISTS(SETTING_FUNCTIONFOLDER$) then 
68182          if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
68184             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\enter.brs") then 
68186                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\enter.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Enter Event")
68188             end if 
68190             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\init.brs") then 
68192                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\init.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Init Event")
68194             end if 
68196             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\read.brs") then 
68198                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\read.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Read Event")
68200             end if 
68202             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\load.brs") then 
68204                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\load.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Load Event")
68206             end if 
68208             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\write.brs") then 
68210                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\write.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Write Event")
68212             end if 
68214             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\wait.brs") then 
68216                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\wait.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Wait Event")
68218             end if 
68220             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\locked.brs") then 
68222                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\locked.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Locked Event")
68224             end if 
68226             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\merge.brs") then 
68228                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\merge.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Merge Event")
68230             end if 
68232             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\mainloop.brs") then 
68234                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\mainloop.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Mainloop Event")
68236             end if 
68238             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\nokey.brs") then 
68240                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\nokey.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Nokey Event")
68242             end if 
68244             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\prelist.brs") then 
68246                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\prelist.brs"),MAT PATH$,MAT LOCATION$,"Default Screen PreList Event")
68248             end if 
68250             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\postlist.brs") then 
68252                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\postlist.brs"),MAT PATH$,MAT LOCATION$,"Default Screen PostList Event")
68254             end if 
68256             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\exit.brs") then 
68258                let FNADDCERESULT(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\exit.brs"),MAT PATH$,MAT LOCATION$,"Default Screen Exit Event")
68260             end if 
68262          end if 
68264       end if 
68266 ! 
68268    fnend 
68270    def FNEVENTNAME$*255(CONTROL,TYPE;MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
68272       if CONTROL<0 then 
68274 ! .     ! Window Level Event, no Control Given
68276          let FNEVENTNAME$="Screen "&FNWINDOWFUNCTION$(TYPE)&" Event"
68278       else 
68280 ! .     ! Control Given. Check its type to get Verb.
68282 ! .     !  Pull Description out of its name or whatever is available.
68284          if LEN(TRIM$(CONTROLNAME$(CONTROL))) then 
68286             let FNEVENTNAME$=CONTROLNAME$(CONTROL)&" control's "&FNEVENTVERB$(FIELDTYPE$(CONTROL),TYPE)&" Event"
68288          else if LEN(TRIM$(FIELDNAME$(CONTROL))) then 
68290             let FNEVENTNAME$=FIELDNAME$(CONTROL)&" field's "&FNEVENTVERB$(FIELDTYPE$(CONTROL),TYPE)&" Event"
68292          else 
68294             let FNEVENTNAME$="Control "&STR$(CONTROL)&"'s "&FNEVENTVERB$(FIELDTYPE$(CONTROL),TYPE)&" Event"
68296          end if 
68298       end if 
68300    fnend 
68302 ! 
68304    def FNWINDOWFUNCTION$*64(TYPE)
68306       if TYPE = SI_ENTERFN then ! #Select# Type #Case# si_ENTERFN
68308          let FNWINDOWFUNCTION$="Enter"
68310       else if TYPE = SI_INITFN then ! #Case# si_INITFN
68312          let FNWINDOWFUNCTION$="Initialize"
68314       else if TYPE = SI_READFN then ! #Case# si_READFN
68316          let FNWINDOWFUNCTION$="Read"
68318       else if TYPE = SI_LOADFN then ! #Case# si_LOADFN
68320          let FNWINDOWFUNCTION$="Load"
68322       else if TYPE = SI_WRITEFN then ! #Case# si_WRITEFN
68324          let FNWINDOWFUNCTION$="Write"
68326       else if TYPE = SI_WAITFN then ! #Case# si_WAITFN
68328          let FNWINDOWFUNCTION$="Wait"
68330       else if TYPE = SI_LOCKEDFN then ! #Case# si_LOCKEDFN
68332          let FNWINDOWFUNCTION$="Record Locked"
68334       else if TYPE = SI_MERGEFN then ! #Case# si_MERGEFN
68336          let FNWINDOWFUNCTION$="Merge Function"
68338       else if TYPE = SI_LOOPFN then ! #Case# si_LOOPFN
68340          let FNWINDOWFUNCTION$="Main Loop"
68342       else if TYPE = SI_NOKEYFN then ! #Case# si_NOKEYFN
68344          let FNWINDOWFUNCTION$="Nokey"
68346       else if TYPE = SI_PRELISTVIEWFN then ! #Case# si_PRELISTVIEWFN
68348          let FNWINDOWFUNCTION$="Listview Prepopulate"
68350       else if TYPE = SI_POSTLISTVIEWFN then ! #Case# si_POSTLISTVIEWFN
68352          let FNWINDOWFUNCTION$="Listview Postpopulate"
68354       else if TYPE = SI_EXITFN then ! #Case# si_EXITFN
68356          let FNWINDOWFUNCTION$="Exit"
68358       end if                          !#End Select#
68360    fnend 
68362 ! 
68364    def FNEVENTVERB$*64(TYPE$*255,TYPE)
68366 ! .  ! Check Control Type for Basic Verb
68368       if LWRC$(TRIM$(TYPE$)) = "button" OR LWRC$(TRIM$(TYPE$)) = "p" OR LWRC$(TRIM$(TYPE$)) = "caption" OR LWRC$(TRIM$(TYPE$)) = "screen" then ! #Select# lwrc$(trim$(Type$)) #Case# "button" # "p" # "caption" # "screen"
68370          let FNEVENTVERB$="Click"
68372       else if LWRC$(TRIM$(TYPE$)) = "c" OR LWRC$(TRIM$(TYPE$)) = "search" OR LWRC$(TRIM$(TYPE$)) = "filter" then ! #Case# "c" # "search" # "filter"
68374          let FNEVENTVERB$="Validate"
68376       else if LWRC$(TRIM$(TYPE$)) = "listview" then ! #Case# "listview"
68378          let FNEVENTVERB$="Filter"
68380       end if                          !#End Select#
68382 ! 
68384 ! .  ! Apply Type Override
68386       if TYPE = 2 then ! #Select# Type #Case# 2
68388          let FNEVENTVERB$="ConvertIn"
68390       else if TYPE = 3 then ! #Case# 3
68392          let FNEVENTVERB$="ConvertOut"
68394       end if                          !#End Select#
68396    fnend 
68398 ! 
68400    def FNADDCERESULT(FUNCTION$*255,MAT PATH$;MAT LOCATION$,LOC$*255,___,INDEX)
68402       let INDEX=UDIM(MAT PATH$)+1
68404 ! 
68406       mat PATH$(INDEX)
68408       mat LOCATION$(INDEX)
68410 ! 
68412       let PATH$(INDEX)=TRIM$(FUNCTION$)
68414       let LOCATION$(INDEX)=TRIM$(LOC$)
68416    fnend 
68418 ! 
68420 ! .! Jump To Item
68422    def FNCEJUMPTO(MAT SELECTED,MAT PATH$;___,INDEX,DONEASCREEN,DONEAHELPERLIB,SCREEN$)
68424       for INDEX=1 to UDIM(MAT SELECTED)
68426          if TRIM$(PATH$(SELECTED(INDEX)))(1:1)="{" then 
68428 ! .        ! if this item is a function, launch it in editor
68430             let SLEEP(.1)
68432             execute "system -C -M start "&OS_FILENAME$(FNCUSTOMFILENAMEOF$(TRIM$(PATH$(SELECTED(INDEX))))) error IGNORE
68434          end if 
68436       next INDEX
68438    fnend 
68440 ! 
68442 ! 
68444    def FNCEAFFECTEDSCREENLIST(MAT SELECTED,MAT PATH$;___,INDEX,WINDOW,AFSELCOUNT,FUNCTION,SAVESCREENCODE$,DONE,FILENAME$*255)
68446 ! .  ! Build list of affected screens
68448       mat AFFECTEDSCREENS$(0)
68450       let FNCEFINDAFFECTEDSCREENS(MAT AFFECTEDSCREENS$,MAT SELECTED,MAT PATH$)
68452 ! 
68454       if UDIM(MAT AFFECTEDSCREENS$)=0 then 
68456          let MSGBOX("No screens are affected.","Nothing Found")
68458       else 
68460 ! .     ! Define Listview
68462          let AS_CAPTION$(1)="Affected Screens"
68464          let AS_WIDTH(1)=30
68466          let AS_SPEC$(1)="CC 18"
68468 ! 
68470 ! .     ! Open Window
68472          open #(WINDOW:=FNGETFILENUMBER) : "srow=5,scol=30,rows=15,cols=30,border=s",display,outin 
68474 ! 
68476 ! .     ! Paint Window
68478          print #WINDOW, fields "1,1,LIST 14/30,HEADERS,/W:W" : (MAT AS_CAPTION$,MAT AS_WIDTH,MAT AS_SPEC$)
68480          print #WINDOW, fields "1,1,LIST 14/30,=" : (MAT AFFECTEDSCREENS$)
68482          print #WINDOW, fields "15,1,14/CC 16,/W:W,B30;15,16,CC 14,/W:W,B31" : "Recompile Screen","Load Screen"
68484 ! 
68486          do 
68488             input #WINDOW, fields "1,1,LIST 14/30,ROWCNT,SEL" : AFSELCOUNT
68490             let FUNCTION=FKEY
68492             mat AF_SELECTION(AFSELCOUNT)
68494             input #WINDOW, fields "1,1,LIST 14/30,ROWSUB,SEL,NOWAIT" : MAT AF_SELECTION
68496 ! 
68498             if FUNCTION=30 then ! Recompile Selected Screens
68500                let SAVESCREENCODE$=STATIC_SCREENNAME$
68502 ! 
68504                if EXISTS("compile[SESSION].$$$") then 
68506                   execute "free compile[SESSION].$$$"
68508                end if 
68510 ! 
68512                let FAILEDLIST$=""
68514                for INDEX=1 to UDIM(MAT AF_SELECTION)
68516                   if FNREADSCREEN(AFFECTEDSCREENS$(AF_SELECTION(INDEX)),MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
68518                      let FNCOMPILEHELPERLIBRARY(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,FILENAME$)
68520                      let FNWAITFORFILE(FAILEDLIST$,AFFECTEDSCREENS$(AF_SELECTION(INDEX)),FILENAME$)
68522                   end if 
68524                next INDEX
68526 ! 
68528                if LEN(FAILEDLIST$) then 
68530                   let MSGBOX("The following screens took a long time and may have had errors:"&CHR$(13)&CHR$(13)&FAILEDLIST$(3:9999))
68532                end if 
68534 ! 
68536                let FNREADSCREEN(SAVESCREENCODE$,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
68538             end if 
68540 ! 
68542 ! 
68544             if FUNCTION=31 then ! Load Screen
68546                let FNLAUNCHSCREEN(TRIM$(AFFECTEDSCREENS$(AF_SELECTION(1))))
68548 ! .        !   if Fnoktoproceed(Mat Screenio$,Mat Screenio,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines) then
68550 ! .        !      if Fnreadscreen(AffectedScreens$(AF_Selection(1)),Mat Screenio$,Mat Screenio,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines) then
68552 ! .        !         let fnRedrawScreen(mat ScreenIO$,mat ScreenIO,mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines,1)
68554 ! .        !
68556 ! .        !         let Done=1
68558 ! .        !      else 
68560 ! .        !         let Msgbox("Error Reading Screen - Screen not  found","Error","OK","ERR")
68562 ! .        !      end if
68564 ! .        !   end if
68566             end if 
68568          loop UNTIL FUNCTION=99 OR FUNCTION=93 OR FKEY=93 OR DONE
68570          if FUNCTION=93 OR FKEY=93 OR DONE then let FNCEAFFECTEDSCREENLIST=1
68572 ! 
68574          if WINDOW AND FILE(WINDOW)>-1 then close #WINDOW: 
68576       end if 
68578    fnend 
68580 ! 
68582    def FNCEFINDAFFECTEDSCREENS(MAT AFFECTEDSCREENS$,MAT SELECTED,MAT PATH$;___,FUNCTION$*255,INDEX,JNDEX)
68584       for INDEX=1 to UDIM(MAT SELECTED)
68586 ! 
68588 ! .     ! If its a function, search for it in all the screens
68590          let FUNCTION$=PATH$(SELECTED(INDEX))
68592 ! 
68594          mat SEARCHSCREENIO$(UDIM(MAT SCREENIO$))
68596          mat SEARCHSCREENIO(UDIM(MAT SCREENIO))
68598          mat SEARCHSCREENFLD$(UDIM(MAT SCREENFLD$))
68600          mat SEARCHSCREENFLD(UDIM(MAT SCREENFLD))
68602 ! 
68604          restore #FSCREENIO: 
68606          restore #FSCREENFLD: 
68608 ! 
68610          do UNTIL FILE(FSCREENIO)
68612             read #FSCREENIO, using FORM$(FSCREENIO), release: MAT SEARCHSCREENIO$, MAT SEARCHSCREENIO eof IGNORE
68614             if FILE(FSCREENIO)=0 then 
68616                for JNDEX=SI_ENTERFN to SI_EXITFN
68618                   if LWRC$(TRIM$(SEARCHSCREENIO$(JNDEX)))=LWRC$(TRIM$(FUNCTION$)) then 
68620                      let FNADDAFSCREEN(SEARCHSCREENIO$(SI_SCREENCODE),MAT AFFECTEDSCREENS$)
68622                   end if 
68624                next JNDEX
68626             end if 
68628          loop 
68630          do UNTIL FILE(FSCREENFLD)
68632             read #FSCREENFLD, using FORM$(FSCREENFLD), release: MAT SEARCHSCREENFLD$, MAT SEARCHSCREENFLD eof IGNORE
68634             if FILE(FSCREENFLD)=0 then 
68636                if LWRC$(TRIM$(SEARCHSCREENFLD$(SF_FUNCTION)))=LWRC$(TRIM$(FUNCTION$)) then 
68638                   let FNADDAFSCREEN(SEARCHSCREENFLD$(SF_SCREENCODE),MAT AFFECTEDSCREENS$)
68640                end if 
68642                if LWRC$(TRIM$(SEARCHSCREENFLD$(SF_CNVRTIN)))=LWRC$(TRIM$(FUNCTION$)) then 
68644                   let FNADDAFSCREEN(SEARCHSCREENFLD$(SF_SCREENCODE),MAT AFFECTEDSCREENS$)
68646                end if 
68648                if LWRC$(TRIM$(SEARCHSCREENFLD$(SF_CNVRTOUT)))=LWRC$(TRIM$(FUNCTION$)) then 
68650                   let FNADDAFSCREEN(SEARCHSCREENFLD$(SF_SCREENCODE),MAT AFFECTEDSCREENS$)
68652                end if 
68654             end if 
68656          loop 
68658 ! 
68660       next INDEX
68662    fnend 
68664 ! 
68666    dim OF_SELECTED(1)
68668    dim OF_FUNCTIONS$(1)*255
68670    dim OF_FUNCTION$*255
68672    def FNPOPULATEORPHANEDFUNCTIONS(MAT FUNCTIONS$;___,INDEX,JNDEX)
68674 ! .  ! Search functions folder and grab all the functions
68676       let FNREADAVAILABLEFUNCTIONS(MAT FUNCTIONS$)
68678 ! 
68680 ! .  ! Add the {}s
68682       for INDEX=1 to UDIM(MAT FUNCTIONS$)
68684          if FUNCTIONS$(INDEX)(1:1)<>"{" then let FUNCTIONS$(INDEX)(1:0)="{"
68686          if FUNCTIONS$(INDEX)(LEN(FUNCTIONS$(INDEX)):LEN(FUNCTIONS$(INDEX)))<>"}" then let FUNCTIONS$(INDEX)=FUNCTIONS$(INDEX)&"}"
68688       next INDEX
68690 ! 
68692 ! .  ! Duplicate that list.
68694       mat OF_FUNCTIONS$(UDIM(MAT FUNCTIONS$))=FUNCTIONS$
68696 ! 
68698 ! .  !  Loop through the duplicated list and delete any functions that are NOT used, in the end you'll have a list of all functions that ARE used
68700       let INDEX=0
68702       do WHILE (INDEX+=1)<=UDIM(MAT FUNCTIONS$)
68704          mat AFFECTEDSCREENS$(0)
68706          let OF_SELECTED(1)=INDEX
68708          let FNCEFINDAFFECTEDSCREENS(MAT AFFECTEDSCREENS$,MAT OF_SELECTED,MAT FUNCTIONS$)
68710 ! 
68712          if UDIM(MAT AFFECTEDSCREENS$)=0 then 
68714 ! .        ! If it is not used, remove it from the list
68716             for JNDEX=INDEX to UDIM(MAT FUNCTIONS$)-1
68718                let FUNCTIONS$(JNDEX)=FUNCTIONS$(JNDEX+1)
68720             next JNDEX
68722             mat FUNCTIONS$(UDIM(MAT FUNCTIONS$)-1)
68724             let INDEX-=1              !Go back down one because we removed one.
68726          end if 
68728       loop 
68730 ! 
68732 ! .  !  Go through those functions with a parser written off of the Function Loading technology that searches for any functions that are #included. if they're not there, add them to the list.
68734       let INDEX=0
68736       do WHILE (INDEX+=1)<=UDIM(MAT FUNCTIONS$)
68738          let OF_FUNCTION$=FUNCTIONS$(INDEX)
68740          let FNFINDINCLUDES(OF_FUNCTION$,MAT FUNCTIONS$)
68742       loop 
68744 ! 
68746 ! .  ! Go through the first list and delete any found in the second list, what you're left with is just the ones that are orphaned.
68748       let INDEX=0
68750       do WHILE (INDEX+=1)<=UDIM(MAT OF_FUNCTIONS$)
68752          if SRCH(MAT FUNCTIONS$,OF_FUNCTIONS$(INDEX))>0 then 
68754 ! .        ! remove it from the list
68756             for JNDEX=INDEX to UDIM(MAT OF_FUNCTIONS$)-1
68758                let OF_FUNCTIONS$(JNDEX)=OF_FUNCTIONS$(JNDEX+1)
68760             next JNDEX
68762             mat OF_FUNCTIONS$(UDIM(MAT OF_FUNCTIONS$)-1)
68764             let INDEX-=1              !Go back down one because we removed one.
68766          end if 
68768       loop 
68770 ! 
68772       mat FUNCTIONS$(UDIM(MAT OF_FUNCTIONS$))=OF_FUNCTIONS$  !Copy it back to return it
68774    fnend 
68776 ! 
68778    dim OF_FUNCTION$(1)*255
68780 ! 
68782    dim OFLV_SPEC$
68784    dim OFLV_CAP$(1)*30,OFLV_WIDTH(1),OFLV_SPEC$(1)
68786 ! 
68788    def FNORPHANEDFUNCTIONS(;___,FUNCTION,ORPHANEDFUNCTIONS,OF_SELECTED,LOADMESSAGE)
68790 ! .  ! Initialize PowerSearch Results Listview
68792       let OFLV_SPEC$="1,1,LIST 22/30"
68794 ! 
68796 ! .  ! Initialize PowerSearch Results Listview Columns
68798       let OFLV_CAP$(1)="Function"
68800       let OFLV_WIDTH(1)=25
68802       let OFLV_SPEC$(1)="C 255"
68804 ! 
68806       mat OF_FUNCTION$(0)
68808 ! 
68810 ! .  ! ! Initialize PowerSearch Buttons and Caption Specs
68812       mat CE_CAPSPEC$(1) : mat CE_CAPTION$(1)
68814       let CE_CAPSPEC$(1)="23,11,10/CC 17,/W:W,B36"  !Print List
68816 ! 
68818       let CE_CAPTION$(1)="Print"
68820 ! 
68822       open #(ORPHANEDFUNCTIONS:=FNGETFILENUMBER): "srow=4,scol=40,rows=23,cols=30,Border=s", display, outin 
68824 ! 
68826       print #ORPHANEDFUNCTIONS, fields MAT CE_CAPSPEC$ : MAT CE_CAPTION$
68828       print #ORPHANEDFUNCTIONS, fields OFLV_SPEC$&",HEADERS,/W:W" : (MAT OFLV_CAP$, MAT OFLV_WIDTH, MAT OFLV_SPEC$)
68830 ! 
68832       open #(LOADMESSAGE:=FNGETFILENUMBER): "srow=13,scol=32,rows=3,cols=46,Border=s", display, outin 
68834       print #LOADMESSAGE, fields "2,1,CC 40": "Loading .. Please Wait .."
68836 ! 
68838       let FNPOPULATEORPHANEDFUNCTIONS(MAT OF_FUNCTION$)
68840 ! 
68842       close #LOADMESSAGE: 
68844 ! 
68846       if UDIM(MAT OF_FUNCTION$) then 
68848 ! .     ! Predraw listview if any data belongs in it
68850          print #ORPHANEDFUNCTIONS, fields OFLV_SPEC$&",=" : (MAT OF_FUNCTION$)
68852          do 
68854             input #ORPHANEDFUNCTIONS, fields OFLV_SPEC$&",ROWSUB,SELONE" : OF_SELECTED
68856 ! 
68858             let FUNCTION=FKEY
68860 ! 
68862             if FUNCTION = 36 then ! #Select# Function #Case# 36
68864 ! .           ! Print List
68866                let FNPRINTLISTTOPRINTERSIMPLE(MAT OF_FUNCTION$)
68868             end if                    !#End Select#
68870 ! 
68872          loop UNTIL FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR ((FUNCTION>1100) AND (FUNCTION<1699)) OR FUNCTION=19 OR FKEY=93
68874       else 
68876          let MSGBOX("No Orphaned Functions found.","Nothing to display")
68878       end if 
68880       if ORPHANEDFUNCTIONS AND FILE(ORPHANEDFUNCTIONS)>-1 then close #ORPHANEDFUNCTIONS: 
68882    fnend 
68884 ! 
70000 !  #Autonumber# 70000,20
70020 !  =================================================
70040 !  =============== Screen Io Library ===============
70060 !  =================================================
70080 !   !                                             !
70100 Fm: !    This Is Where All The Magic Happens      !
70120 ! .!                                             !
70140 ! .!  *************               *************  !
70160 ! 
70180    def library FNFM$*255(SCREENNAME$;KEYVAL$*255,SROW,SCOL,PARENT_KEY$*255,PARENT_WINDOW,DISPLAY_ONLY,DONTREDOLISTVIEW,RECORDVAL,MAT PASSEDDATA$,USEMYF,MAT MYF$,MAT MYF,PATH$*255,SELECTING,SAVEDONTASK)
70200 ! 
70220 ! .  ! This function contains hidden code that prepares the memory and reticulates the splines.
70240 ! .  !  then calls fnScreenIO to run your screen.
70260 ! 
70420    fnend 
70440 ! 
75000 !  #Autonumber# 75000,2
75002 ! 
75004 Screeniodims: ! 
75006    dim F$(1)*1000,F(1),S$(1)*1000
75008    dim SCREENSUBS$(1)*80
75010    dim READ_F$(1)*1000,READ_F(1)
75012    dim DISK_F$(1)*1000,DISK_F(1)
75014 ! 
75016    dim SAVE_F$(1)*1000,SAVE_F(1),SAVE_S$(1)*1000
75018 ! 
75020    dim SELECTEDKEYS$(1)*255
75022    dim SELECTEDRECORDS(1)
75024 ! 
75026    dim VISIBLEKEYS$(1)*255
75028    dim VISIBLERECORDS(1)
75030 ! 
75032    dim S_DATA$(1)*1000,S_DATA(1),S_SPEC$(1)*255, S_HELP$(1)*1050, S_OLD$(1)*1000
75034    dim TEMP_S_SPEC$(1)*255
75036    dim OLD_DATA(1)
75038 ! 
75040    dim SAVE_S_DATA$(1)*1000
75042    dim SAVE_S_SUBS(1)
75044    dim CHANGED_S_DATA$(1)*1000
75046    dim CHANGED_S_SUBS(1)
75048    dim OTHER_S_DATA$(1)*1000
75050    dim OTHER_S_SUBS(1)
75052    dim OTHERCHANGED_S_DATA$(1)*1000
75054    dim OTHERCHANGED_S_SUBS(1)
75056 ! 
75058    dim RETURNDATA$(1)*255
75060    dim CONTROLSPEC$(1)*128
75062    dim SCREENIOSSUBS$(1)*40
75064    dim SCREENIONSUBS$(1)*40
75066 ! 
75068    dim TEMPINDEX
75070    dim TEMPCONTROL
75072    dim TEMPFIELD
75074    dim FOUNDALREADY
75076 Endscreeniodims: ! 
75078 ! 
75080    dim LOADEDSCREENCOUNT
75082    def library FNFUNCTIONBASE=FNKEYBASE
75084    def FNSTICKYBASE=FNKEYBASE+500
75086    def FNKEYBASE=(FNBASE+(200*LOADEDSCREENCOUNT))
75088    def FNBASE=1500
75090 ! 
75092    dim PASSEDINF$(1)*1023,PASSEDINF(1)
75094    dim ANOTHERTEMPMYF$(1)*1023,ANOTHERTEMPMYF(1)
75096 ! 
75098 ! 
75100    def FNSCREENIO$*255(ROUTINENAME$,&EXITMODE;&KEY$,ROW,COL,&PARENTKEY$,PARENTWINDOW,DISPLAYONLY,RECORD,&PATH$,SELECTING,ACTIVE,FORCETHISINDEX,EDITING,MAT PASSEDDATA$,USEMYF,MAT MYF$,MAT MYF,&SAVEDONTASK,___,FDATAFILE,WWINDOW,FUNCTION,KP$,PREFIX$,INDEX,CURRENTFIELD,CURRENTFIELD$*50,S_CURRENTFIELD$*50,SCREENROWS,SCREENCOLS,TURNGUIBACKOFF,LIBRARYLINKAGE,OLDROWS,OLDCOLS,OLDWINDOWCAPTION$*255,FSCREENIO,FSCREENFLD,SCREENIOPREFIX$,SUBSCRIPTSALREADYSET,CURRENTKEY$*255,CURRENTREC,S_CURRENTREC,LISTVIEWINDEX,RETURNWINDOWNUMBER,_BORDERSIZE,CURRENTROW,S_CURRENTROW,MYFREAD,FORCEINDEX,X,FORCEVISIBILITY,REDRAWFRAMES,REDRAWSCREENS,REPOPULATECOMBO,NEXTROW)
75102       let FNESTABLISHLIBRARYLINKAGE
75104 ! 
75106       mat F(0)=(0)
75108       mat F$(0)=("")
75110       mat S$(0)=("")
75112 ! 
75114       let EXITMODE=0
75116 ! 
75118       let FNREADLAYOUTARRAYS("screenio",SCREENIOPREFIX$,MAT SCREENIOSSUBS$,MAT SCREENIONSUBS$)
75120 ! 
75122 !     If Exists(Lwrc$(Routinename$)&".br") Then
75124 !        Execute "LOAD "&Lwrc$(Routinename$)&", RESIDENT"
75126 !     End If
75128 ! 
75130       let ROUTINENAME$=UPRC$(TRIM$(ROUTINENAME$))
75132 ! 
75134       let FNOPENSCREENFILES(MAT SCREENIO$,MAT SCREENIO)
75136       if FNREADSCREEN(ROUTINENAME$, MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1) then !  Successful Read
75138          let FNCLOSESCREENFILES
75140 ! 
75142          let FNINITIALIZESCREEN
75144          if DISPLAYONLY then 
75146             if TRYTOCONTINUE then ! if we forced the continue then
75148 ! .           ! We must be in ReadOnly mode because we forced the continue
75150 ! .           !  rather then because of the DisplayOnly parameter,
75152 ! .           !  so screenio locking is off, and we should just pause
75154                input #0, fields STR$(ROW+1)&","&STR$(COL+1)&",C 1,AEX" : KP$
75156             else 
75158 ! .           ! We're here because of DisplayOnly parameter. Pass back
75160 ! .           !  the window number and then suppress it to keep the window
75162 ! .           !  from being closed. The Calling Program will close it later.
75164                let RETURNWINDOWNUMBER=WWINDOW
75166                let WWINDOW=0
75168             end if 
75170          else 
75172             let FNRUNSCREEN
75174          end if 
75176          let FNCLOSESCREEN
75178          if RETURNWINDOWNUMBER then 
75180             let KEY$=STR$(RETURNWINDOWNUMBER)
75182          end if 
75184       else 
75186          let FNCLOSESCREENFILES
75188 ! 
75190          let MSGBOX("The screen "&TRIM$(ROUTINENAME$)&" could not be found.")
75192       end if 
75194       let FNSCREENIO$=KEY$
75196    fnend 
75198 ! 
75200    dim QUITONLY,SAVEANDQUIT,SELECTANDQUIT,QUITOTHER,ASKSAVEANDQUIT,RELOAD,AUTORELOAD
75202    def FNDEFINEEXITMODES              !Configure Exit Value Constants
75204       let QUITONLY=1
75206       let SAVEANDQUIT=2
75208       let SELECTANDQUIT=3
75210       let QUITOTHER=4
75212       let ASKSAVEANDQUIT=5
75214       let RELOAD=6
75216       let AUTORELOAD=7
75218    fnend 
75220 ! 
75222 ! .! =================================================================
75224 Initializescreen: ! This Function Contains The Portion Of The Runtime Engine For Loading And Displaying Your Screen
75226 ! .! =================================================================
75228    def FNINITIALIZESCREEN(;___,R_,C_,WARNWINDOW,POPULATEROWONE)
75230 ! 
75232       mat SELECTEDKEYS$(0)
75234       mat SELECTEDRECORDS(0)
75236 ! 
75238       mat VISIBLEKEYS$(0)
75240       mat VISIBLERECORDS(0)
75242 ! 
75244       if SCREENIO(SI_BORDER) OR POS(UPRC$(SCREENIO$(SI_ATTRIBUTES)),"BORDER") then 
75246          let _BORDERSIZE=2
75248       end if 
75250 ! 
75252       if ENV$("guimode")<>"" then 
75254          if FNREQUIRESGUI(MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
75256             if ENV$("guimode")="OFF" then 
75258                let FNPRESERVENONGUI
75260                let TURNGUIBACKOFF=1
75262             end if 
75264 ! 
75266             let FNREADSCREENSIZE(ROWS,COLS,PARENTWINDOW)
75268 ! 
75270             if ROW AND COL then 
75272                let R_=ROW-1-(_BORDERSIZE/2)
75274                let C_=COL-1-(_BORDERSIZE/2)
75276             end if 
75278             if POS(LWRC$(SCREENIO$(SI_ATTRIBUTES)),"parent=none")<1 then 
75280                if (R_+SCREENIO(SI_VSIZE)+_BORDERSIZE)>ROWS OR (C_+SCREENIO(SI_HSIZE)+_BORDERSIZE)>COLS then 
75282                   if PARENTWINDOW then 
75284                      if (2==MSGBOX("This window ("&TRIM$(SCREENIO$(SI_SCREENCODE))&") is bigger then its parent window (#"&STR$(PARENTWINDOW)&"). Do you wish to debug?","Error","yN")) then 
75286                         pause 
75288                      end if 
75290                      let EXITMODE=1
75292                   else 
75294                      let OLDROWS=ROWS
75296                      let OLDCOLS=COLS
75298                      let ROWS=MAX(R_+SCREENIO(SI_VSIZE)+_BORDERSIZE,ROWS)
75300                      let COLS=MAX(C_+SCREENIO(SI_HSIZE)+_BORDERSIZE,COLS)
75302                      open #0: "rows="&STR$(ROWS)&", cols="&STR$(COLS),display,outin 
75304                   end if 
75306                end if 
75308             end if 
75310             if TRIM$(SCREENIO$(SI_CAPTION))<>"" then 
75312                if LEN(TRIM$(ENV$("Window_Caption"))) then 
75314                   let OLDWINDOWCAPTION$=TRIM$(ENV$("Window_Caption"))
75316                end if 
75318                print #0, border: TRIM$(SCREENIO$(SI_CAPTION))
75320                let SETENV("Window_Caption",TRIM$(SCREENIO$(SI_CAPTION)))
75322             end if 
75324 !            Let Fnclearwindowsmenu
75326          end if 
75328       else 
75330          if FNREQUIRESGUI(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
75332             print "This screen requires a new gui version of BR"
75334             let EXITMODE=1
75336          end if 
75338       end if 
75340 ! 
75342       if ~ROW OR ~COL then 
75344          if ROWS=0 OR COLS=0 then 
75346             let FNREADSCREENSIZE(ROWS,COLS,PARENTWINDOW)
75348          end if 
75350          let ROW=INT((ROWS-(SCREENIO(SI_VSIZE)+_BORDERSIZE))/2)+1+INT(_BORDERSIZE/2)
75352          let COL=INT((COLS-(SCREENIO(SI_HSIZE)+_BORDERSIZE))/2)+1+INT(_BORDERSIZE/2)
75354       end if 
75356 ! 
75358       if ~EXITMODE then 
75360          let FNSETFORCEVISIBILITY(0)
75362 ! 
75364          let WWINDOW=FNOPENWINDOW(ROW,COL,MAT SCREENIO$,MAT SCREENIO,PARENTWINDOW,DISPLAYONLY,FORCETHISINDEX,ACTIVE,EDITING)
75366 ! 
75368          let FNRESETFORCEVISIBILITY
75370          let FNINITIALIZEMATS(MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
75372          let FNEXECUTESETSUBSCRIPTS(MAT SCREENSUBS$,"sio_")
75374          let FNEXECUTESETSUBSCRIPTS(MAT CONTROLNAME$,"ctl_")
75376          let FNEXECUTEUNIQUESUBSCRIPTS(MAT CONTROLNAME$,"ctl_")
75378 ! 
75380          mat FIELDSSSUBS$(0)
75382          mat FIELDSNSUBS$(0)
75384 ! 
75386          if ~EDITING OR POS(UPRC$(ENV$("filter")),"Y") then 
75388             if ~EDITING AND SETTING_ENABLELOGGING then 
75390                let FNLOG("ScreenIO: Entering "&SCREENIO$(SI_SCREENCODE)&" screen.",SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
75392             end if 
75394 ! 
75396             if TRIM$(SCREENIO$(SI_FILELAY))<>"" AND FNDOESLAYOUTEXIST(TRIM$(SCREENIO$(SI_FILELAY))) then 
75398                if USEMYF then 
75400                   mat F$(UDIM(MAT MYF$))
75402                   mat F(UDIM(MAT MYF))
75404                   if ~SUM(MYF) then 
75406                      for INDEX=1 to UDIM(MAT MYF$)
75408                         if LEN(TRIM$(MYF$(INDEX))) then 
75410                            let MYFREAD=1
75412                         end if 
75414                      next INDEX
75416                   else 
75418                      let MYFREAD=1
75420                   end if 
75422                else 
75424                   let FDATAFILE=FNOPEN(TRIM$(SCREENIO$(SI_FILELAY)),MAT F$,MAT F,MAT FORM$,0,SCREENIO(SI_READINDEX),0,PATH$)
75426                end if 
75428 ! 
75430 !    .         ! Read the Layout
75432                let FNREADLAYOUTARRAYS(TRIM$(SCREENIO$(SI_FILELAY)),PREFIX$,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT FIELDSSSPEC$,MAT FIELDSNSPEC$,MAT FIELDSSDESCRIPTION$,MAT FIELDSNDESCRIPTION$,MAT FIELDSSPOS,MAT FIELDSNPOS,0,MAT FIELDSSDATESPEC$,MAT FIELDSNDATESPEC$)
75434                for INDEX=1 to UDIM(MAT FIELDSSSUBS$)
75436                   let FIELDSSSUBS$(INDEX)=LWRC$(TRIM$(FIELDSSSUBS$(INDEX)))
75438                next INDEX
75440                for INDEX=1 to UDIM(MAT FIELDSNSUBS$)
75442                   let FIELDSNSUBS$(INDEX)=LWRC$(TRIM$(FIELDSNSUBS$(INDEX)))
75444                next INDEX
75446 ! 
75448 !    .         ! Here is where we link to our DEFAULT ENTER event
75450                if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
75452                   if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\enter.brs") then 
75454                      let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\enter.brs"))
75456                   end if 
75458                end if 
75460 ! 
75462 !    .         ! Here is where we link to our ENTER event
75464                if LEN(TRIM$(SCREENIO$(SI_ENTERFN))) then 
75466                   let FNEXECUTE(SCREENIO$(SI_ENTERFN))
75468                end if 
75470 ! 
75472                let TRYTOCONTINUE=0
75474 ! 
75476 ! .           ! Read the File
75478                if KEY$<>"" then 
75480                   if DISPLAYONLY then 
75482                      read #FDATAFILE, using FORM$(FDATAFILE), key=FNKEY$(FDATAFILE,KEY$), release: MAT F$, MAT F nokey IGNORE
75484                   else if SCREENIO(SI_SCREENIOLOCKING) then 
75486 ! .                 ! We have to read the record first to ensure the record isn't locked by any legacy applications.
75488                      let WARNWINDOW=FNDISPLAYLOADMESSAGE
75490 ! 
75492                      let FNSETRETRYPOINT("ErrorLocked1")
75494 Errorlocked1retry: ! Error Locked Retry Point
75496                      read #FDATAFILE, using FORM$(FDATAFILE), key=FNKEY$(FDATAFILE,KEY$) : MAT F$, MAT F nokey IGNORE locked Errorfileislocked
75498 Errorlocked1continue: ! Error Locked Continue Point
75500 ! 
75502                      close #WARNWINDOW: 
75504                      if TRYTOCONTINUE then 
75506                         read #FDATAFILE, using FORM$(FDATAFILE), key=FNKEY$(FDATAFILE,KEY$), release: MAT F$, MAT F nokey IGNORE
75508                      end if 
75510                      if ~EXITMODE then 
75512                         reread #FDATAFILE, using FORM$(FDATAFILE), release: MAT F$, MAT F nokey IGNORE
75514                      end if 
75516                   else 
75518                      let WARNWINDOW=FNDISPLAYLOADMESSAGE
75520 ! 
75522                      let FNSETRETRYPOINT("ErrorLocked2")
75524 Errorlocked2retry: ! Error Locked Retry Point
75526                      read #FDATAFILE, using FORM$(FDATAFILE), key=FNKEY$(FDATAFILE,KEY$) : MAT F$, MAT F nokey IGNORE locked Errorfileislocked
75528 Errorlocked2continue: ! Error Locked Continue Point
75530 ! 
75532                      close #WARNWINDOW: 
75534                      if TRYTOCONTINUE then 
75536                         read #FDATAFILE, using FORM$(FDATAFILE), key=FNKEY$(FDATAFILE,KEY$), release: MAT F$, MAT F nokey IGNORE
75538                         let DISPLAYONLY=1
75540                      end if 
75542                   end if 
75544                   mat READ_F$(UDIM(MAT F$))=F$
75546                   mat READ_F(UDIM(MAT F))=F
75548 ! 
75550                   if FILE(FDATAFILE)<>0 then ! Key Not Found
75552                      if EXITMODE=0 then 
75554 ! 
75556 ! .                    ! .   ! Here's where we link to our NoKey event
75558                         if LEN(TRIM$(SCREENIO$(SI_NOKEYFN))) then 
75560                            let FNEXECUTE(SCREENIO$(SI_NOKEYFN))
75562                         else 
75564 ! 
75566                            if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
75568                               if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\nokey.brs") then 
75570                                  let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\nokey.brs"))
75572                               else 
75574                                  let MSGBOX("The '"&KEY$&"' record could not be found.","Not Found","Ok","Err")
75576                                  let EXITMODE=1
75578                               end if 
75580                            else 
75582                               let MSGBOX("The '"&KEY$&"' record could not be found.","Not Found","Ok","Err")
75584                               let EXITMODE=1
75586                            end if 
75588                         end if 
75590                      end if 
75592                   else 
75594                      let CURRENTKEY$=FNBUILDKEY$(TRIM$(SCREENIO$(SI_FILELAY)),MAT F$,MAT F,SCREENIO(SI_RETURNINDEX))
75596                      let CURRENTREC=REC(FDATAFILE)
75598 ! 
75600                      if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
75602                         if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\read.brs") then 
75604                            let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\read.brs"))
75606                         end if 
75608                      end if 
75610 ! 
75612 !    .               ! Here is where we link to our READ event
75614                      if ~EDITING AND SETTING_ENABLELOGGING then let FNLOGARRAY(MAT F$,MAT F,"ScreenIO: Reading "&SCREENIO$(SI_FILELAY)&" file, Record: "&STR$(CURRENTREC),SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
75616                      if LEN(TRIM$(SCREENIO$(SI_READFN))) then 
75618                         let FNEXECUTE(SCREENIO$(SI_READFN))
75620                      end if 
75622                   end if 
75624                else if RECORD>0 then 
75626                   if DISPLAYONLY then 
75628                      read #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD, release: MAT F$, MAT F norec IGNORE
75630                   else if SCREENIO(SI_SCREENIOLOCKING) then 
75632 ! .                 ! We have to read the record first to ensure the record isn't locked by any legacy applications.
75634                      let WARNWINDOW=FNDISPLAYLOADMESSAGE
75636 ! 
75638                      let FNSETRETRYPOINT("ErrorLocked3")
75640 Errorlocked3retry: ! Error Locked Retry Point
75642                      read #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD : MAT F$, MAT F norec IGNORE locked Errorfileislocked
75644 Errorlocked3continue: ! Error Locked Continue Point
75646 ! 
75648                      close #WARNWINDOW: 
75650                      if TRYTOCONTINUE then 
75652                         read #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD, release: MAT F$, MAT F norec IGNORE
75654                      end if 
75656                      if ~EXITMODE then 
75658                         reread #FDATAFILE, using FORM$(FDATAFILE), release: MAT F$, MAT F norec IGNORE
75660                      end if 
75662                   else 
75664                      let WARNWINDOW=FNDISPLAYLOADMESSAGE
75666 ! 
75668                      let FNSETRETRYPOINT("ErrorLocked4")
75670 Errorlocked4retry: ! Error Locked Retry Point
75672                      read #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD : MAT F$, MAT F norec IGNORE locked Errorfileislocked
75674 Errorlocked4continue: ! Error Locked Continue Point
75676 ! 
75678                      close #WARNWINDOW: 
75680                      if TRYTOCONTINUE then 
75682                         read #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD, release: MAT F$, MAT F nokey IGNORE
75684                         let DISPLAYONLY=1
75686                      end if 
75688                   end if 
75690 ! 
75692                   mat READ_F$(UDIM(MAT F$))=F$
75694                   mat READ_F(UDIM(MAT F))=F
75696 ! 
75698                   if FILE(FDATAFILE)<>0 then ! Key Not Found
75700                      if EXITMODE=0 then 
75702                         if LEN(TRIM$(SCREENIO$(SI_NOKEYFN))) then 
75704                            let FNEXECUTE(SCREENIO$(SI_NOKEYFN))
75706                         else 
75708                            if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
75710                               if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\nokey.brs") then 
75712                                  let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\nokey.brs"))
75714                               else 
75716                                  let MSGBOX("The '"&KEY$&"' record could not be found.","Not Found","Ok","Err")
75718                                  let EXITMODE=1
75720                               end if 
75722                            else 
75724                               let MSGBOX("The '"&KEY$&"' record could not be found.","Not Found","Ok","Err")
75726                               let EXITMODE=1
75728                            end if 
75730                         end if 
75732                      end if 
75734                   else 
75736 !    .               ! Here is where we link to our READ event
75738                      let CURRENTKEY$=FNBUILDKEY$(TRIM$(SCREENIO$(SI_FILELAY)),MAT F$,MAT F,SCREENIO(SI_RETURNINDEX))
75740                      let CURRENTREC=REC(FDATAFILE)
75742                      if ~EDITING AND SETTING_ENABLELOGGING then let FNLOGARRAY(MAT F$,MAT F,"ScreenIO: Reading "&SCREENIO$(SI_FILELAY)&" file, Record: "&STR$(CURRENTREC)&" Key: "&CURRENTKEY$,SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
75744 ! 
75746                      if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
75748                         if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\read.brs") then 
75750                            let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\read.brs"))
75752                         end if 
75754                      end if 
75756 ! 
75758                      if LEN(TRIM$(SCREENIO$(SI_READFN))) then 
75760                         let FNEXECUTE(SCREENIO$(SI_READFN))
75762                      end if 
75764                   end if 
75766                else if USEMYF AND MYFREAD then 
75768                   mat F$=MYF$
75770                   mat F=MYF
75772 ! 
75774                   mat READ_F$(UDIM(MAT F$))=F$
75776                   mat READ_F(UDIM(MAT F))=F
75778 ! 
75780                   if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
75782                      if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\read.brs") then 
75784                         let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\read.brs"))
75786                      end if 
75788                   end if 
75790 ! 
75792 !    .            ! Here is where we link to our READ event
75794                   if ~EDITING AND SETTING_ENABLELOGGING then let FNLOGARRAY(MAT F$,MAT F,"ScreenIO: Data passed in",SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
75796                   if LEN(TRIM$(SCREENIO$(SI_READFN))) then 
75798                      let FNEXECUTE(SCREENIO$(SI_READFN))
75800                   end if 
75802                else 
75804                   mat READ_F$(UDIM(MAT F$))=F$
75806                   mat READ_F(UDIM(MAT F))=F
75808 ! 
75810 !    .            ! Here is where we link to our INITIALIZE event
75812                   if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults") then 
75814                      if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\init.brs") then 
75816                         let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\init.brs"))
75818                      end if 
75820                   end if 
75822 ! 
75824                   if LEN(TRIM$(SCREENIO$(SI_INITFN))) then 
75826                      let FNEXECUTE(SCREENIO$(SI_INITFN))
75828                   end if 
75830                   if ~EDITING AND SETTING_ENABLELOGGING then let FNLOGARRAY(MAT F$,MAT F,"ScreenIO: Initializing Record for "&SCREENIO$(SI_FILELAY)&" file.",SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
75832                end if 
75834             else 
75836                mat READ_F$(UDIM(MAT F$))=F$
75838                mat READ_F(UDIM(MAT F))=F
75840 ! 
75842                if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
75844                   if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\enter.brs") then 
75846                      let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\enter.brs"))
75848                   end if 
75850                end if 
75852 ! 
75854 !    .         ! Here is where we link to our ENTER event
75856                if LEN(TRIM$(SCREENIO$(SI_ENTERFN))) then 
75858                   let FNEXECUTE(SCREENIO$(SI_ENTERFN))
75860                end if 
75862             end if 
75864          end if 
75866       end if 
75868 ! 
75870 ! .   ! Draw the screen and populate any listviews
75872       if ~EXITMODE then 
75874          if DISPLAYONLY then let FORCEINDEX=WWINDOW+1000
75876          if FORCETHISINDEX then let FORCEINDEX=FORCETHISINDEX
75878 ! 
75880          let FNPOPULATECOMBO(WWINDOW,FDATAFILE,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,(EDITING AND ~POS(UPRC$(ENV$("filter")),"Y")),EDITING)
75882 ! 
75884 ! .      Predisplay Output Specs
75886          let FNCHANGEFORCEVISIBILITY(0)
75888          let FNDRAWFRAMES(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,FORCEINDEX)
75890          if ~EDITING then let FNDRAWSCREENS(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,FORCEINDEX)
75892          let FNGENERATEOUTPUTSPECS(WWINDOW,MAT S_DATA$,MAT S_SPEC$,MAT S_HELP$,MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$,FORCEINDEX)
75894          let FNCHANGEFORCEVISIBILITY(1)
75896          if UDIM(MAT S_SPEC$) then 
75898             print #WWINDOW, fields MAT S_SPEC$, help MAT S_HELP$ : MAT S_DATA$
75900          end if 
75902          mat TEMP_S_SPEC$(UDIM(MAT S_SPEC$))=S_SPEC$
75904 ! 
75906 ! .      Predisplay Input Specs
75908          let FNGENERATEINPUTSPECS(WWINDOW,MAT S_DATA$,MAT S_DATA,MAT S_SPEC$,MAT S_SUBS,MAT S_HELP$,MAT S_OLD$,MAT F$,MAT F,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$,FORCEINDEX)
75910          if ~(UDIM(MAT S_DATA)) then 
75912             print #WWINDOW, fields MAT S_SPEC$, help MAT S_HELP$ : MAT S_DATA$
75914          end if 
75916 ! 
75918          if FNTHERESALISTVIEW(MAT FIELDTYPE$) then 
75920             let FNDRAWALLLISTVIEWS(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,FORCEINDEX)
75922             let LASTROW=FNPOPULATEALLLISTVIEWS(WWINDOW,FDATAFILE,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT LISTVIEWRECORDS,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,(EDITING AND ~POS(UPRC$(ENV$("filter")),"Y")),EDITING,POPULATEROWONE,DISPLAYONLY)
75924             mat OLD_DATA=(0)          !Clear information so it forces read again.
75926             mat RLV_SAVEREADDATA$=("")
75928             if FN43 then let CURRENTROW=POPULATEROWONE  !In 4.3, sorted listviews don't start at the top, so we have to force them.
75930             let S_CURRENTROW=0
75932             if LISTVIEWINDEX AND CURRENTROW<>S_CURRENTROW then 
75934                let CURFLD(UDIM(MAT S_DATA$)+1,CURRENTROW)
75936             end if 
75938             mat OLD_DATA(UDIM(MAT S_DATA))
75940 ! 
75942 ! .        ! Preread the listview in case they have a read event, so it runs the currently selected item first
75944             if LISTVIEWINDEX AND UDIM(MAT S_DATA) AND (~DISPLAYONLY OR LEN(TRIM$(SCREENIO$(SI_READFN)))) then 
75946                let S_DATA(1)=1
75948                let FNREADLISTVIEWS(FUNCTION,MAT F$, MAT F, CURRENTKEY$,CURRENTREC,MAT SELECTEDKEYS$,MAT SELECTEDRECORDS,MAT VISIBLEKEYS$,MAT VISIBLERECORDS,MAT S_DATA,MAT S_SPEC$,LISTVIEWINDEX,MAT OLD_DATA,WWINDOW,FDATAFILE,MAT FORM$, MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,NEXTROW)
75950             end if 
75952          end if 
75954 ! 
75956          if ~EDITING OR POS(UPRC$(ENV$("filter")),"Y") OR LEN(TRIM$(SCREENIO$(SI_LOADFN))) then 
75958             if DISPLAYONLY then 
75960 ! .            redisplay Output Specs
75962                if REDRAWFRAMES OR REDRAWSCREENS then let SCR_FREEZE
75964                if REPOPULATECOMBO then let FNPOPULATECOMBO(WWINDOW,FDATAFILE,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,0,0,REPOPULATECOMBO) : let REPOPULATECOMBO=0
75966                if REDRAWFRAMES then let FNDRAWFRAMES(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,FORCEINDEX, REDRAWFRAMES) : let REDRAWFRAMES=0
75968                if REDRAWSCREENS then let FNDRAWSCREENS(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,FORCEINDEX, REDRAWSCREENS) : let REDRAWSCREENS=0
75970 ! 
75972                let FNGENERATEOUTPUTSPECS(WWINDOW,MAT S_DATA$,MAT S_SPEC$,MAT S_HELP$,MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$,FORCEINDEX)
75974                if UDIM(MAT S_SPEC$) then 
75976                   print #WWINDOW, fields MAT S_SPEC$, help MAT S_HELP$ : MAT S_DATA$
75978                end if 
75980                mat TEMP_S_SPEC$(UDIM(MAT S_SPEC$))=S_SPEC$
75982 ! 
75984 ! .!    .      redisplay Input Specs
75986                let FNGENERATEINPUTSPECS(WWINDOW,MAT S_DATA$,MAT S_DATA,MAT S_SPEC$,MAT S_SUBS,MAT S_HELP$,MAT S_OLD$,MAT F$,MAT F,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$,FORCEINDEX)
75988                if ~(UDIM(MAT S_DATA)) then 
75990                   print #WWINDOW, fields MAT S_SPEC$, help MAT S_HELP$ : MAT S_DATA$
75992                end if 
75994             end if 
75996          end if 
75998 ! 
76000 ! .     ! Link to the default Load event.
76002          if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
76004             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\load.brs") then 
76006                let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\load.brs"))
76008             end if 
76010          end if 
76012 ! 
76014 !       ! Here is where we link to our LOAD event
76016          if LEN(TRIM$(SCREENIO$(SI_LOADFN))) then 
76018             let FNEXECUTE(SCREENIO$(SI_LOADFN))
76020          end if 
76022       end if 
76024 ! 
76026    fnend 
76028 ! 
76030 ! .! =================================================================
76032 Runscreen: ! This Function Contains The Portion Of The Runtime Engine For Actually Using Your Screen.
76034 ! .! =================================================================
76036    def FNRUNSCREEN(;___,WAITTIME,CH,THERESANL,SAVESCREENDATA,LOOPAGAIN,WARNWINDOW,FINDSTICKIES,POSITION,LISTVIEWSPEC$*40,MAXROW,DEFAULTMAINLOOPFUNCTION,DEBUGYN)
76038 ! 
76040       if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
76042          if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\mainloop.brs") then 
76044             let DEFAULTMAINLOOPFUNCTION=1
76046          end if 
76048       end if 
76050 ! 
76052       let FKEY(-1)
76054 ! 
76056       mat SAVE_F(UDIM(MAT F))=F
76058       mat SAVE_F$(UDIM(MAT F$))=F$
76060       mat SAVE_S$(UDIM(MAT S$))=S$
76062 ! 
76064       do UNTIL EXITMODE
76066 ! .! .   If There's Output Specs, Generate Output Specs And Print Output Controls (Buttons, Pictures, Captions)
76068          if REPOPULATECOMBO then 
76070             let FNPOPULATECOMBO(WWINDOW,FDATAFILE,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,0,0,REPOPULATECOMBO)
76072             let REPOPULATECOMBO=0
76074          end if 
76076          if REDRAWFRAMES then 
76078             let SCR_FREEZE
76080             let FNDRAWFRAMES(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,FORCEINDEX,REDRAWFRAMES)
76082             let REDRAWFRAMES=0
76084          end if 
76086          if REDRAWSCREENS then 
76088             let SCR_FREEZE
76090             let FNDRAWSCREENS(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,FORCEINDEX,REDRAWSCREENS)
76092             let REDRAWSCREENS=0
76094          end if 
76096 ! 
76098          let FNERASEINVISIBLE(WWINDOW,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
76100 ! 
76102          let FNGENERATEOUTPUTSPECS(WWINDOW,MAT S_DATA$,MAT S_SPEC$,MAT S_HELP$,MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$)
76104          if UDIM(MAT S_SPEC$) then 
76106             let FNCHANGEFORCEVISIBILITY(1)
76108             let FNBLANKOLDSFIELDS$(MAT S_SPEC$,MAT TEMP_S_SPEC$,WWINDOW)
76110             print #WWINDOW, fields MAT S_SPEC$, help MAT S_HELP$ : MAT S_DATA$
76112             let FNRESETFORCEVISIBILITY
76114          end if 
76116          mat TEMP_S_SPEC$(UDIM(MAT S_SPEC$))=S_SPEC$
76118 ! 
76120 ! .     ! we need to do the same thing for input specs that we do for output specs, in case invisible changed.
76122 ! .     !  but we need to make sure this only happens if it has to.
76124 ! .     ! dim Temp_SI_Spec$(1)*255
76126          let FNGENERATEINPUTSPECS(WWINDOW,MAT S_DATA$,MAT S_DATA,MAT S_SPEC$,MAT S_SUBS,MAT S_HELP$,MAT S_OLD$,MAT F$,MAT F,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$)
76128 ! .     ! if udim(mat Temp_SI_Spec$) then
76130 ! .     !    let Fnblankoldsfields$(Mat S_Spec$,Mat Temp_SI_Spec$,Wwindow)
76132 ! .     ! end if
76134 ! .     ! mat Temp_SI_Spec$(Udim(Mat S_Spec$))=S_Spec$
76136 ! 
76138 ! 
76140          if LISTVIEWINDEX then let THERESANL=FNATTRIBUTE("L",LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
76142 ! 
76144          if SCREENIO(SI_WAITTIME) then 
76146             let WAITTIME=SCREENIO(SI_WAITTIME)
76148          else 
76150             let WAITTIME=-1
76152          end if 
76154 ! 
76156          if UDIM(MAT S_DATA$) + UDIM(MAT S_DATA) then 
76158 ! 
76160 ! 
76162 ! .        ! Handle repositioning of Current Row by Record or by Row if either is given.
76164             if LISTVIEWINDEX then 
76166 ! 
76168 ! .           ! If CurrentRow is negative, treat like CurrentRec is negative.
76170                if CURRENTROW<>S_CURRENTROW AND CURRENTREC=S_CURRENTREC AND CURRENTROW<0 then 
76172                   let CURRENTREC=CURRENTROW
76174                   let CURRENTROW=S_CURRENTROW
76176                end if 
76178 ! 
76180                if CURRENTREC<>S_CURRENTREC then 
76182                   if CURRENTREC<0 then 
76184                      let LISTVIEWSPEC$=S_SPEC$(UDIM(MAT S_SPEC$))
76186                      let LISTVIEWSPEC$=LISTVIEWSPEC$(1:POS(LISTVIEWSPEC$,",",-1)-1)
76188                      let LISTVIEWSPEC$=LISTVIEWSPEC$(1:POS(LISTVIEWSPEC$,",",-1)-1)
76190 ! 
76192                      if FN43 then 
76194                         input #WWINDOW, fields LISTVIEWSPEC$&",ROWSUB,ALL,DISPLAYED_ORDER,NOWAIT" : MAT POPULATESORTEDSUBS
76196                         let MAXROW=UDIM(MAT POPULATESORTEDSUBS)
76198 ! 
76200                         if CURRENTREC=-1 then 
76202                            let CURRENTROW=POPULATESORTEDSUBS(1)
76204                         else if CURRENTREC<=-2 then 
76206                            let CURRENTROW=POPULATESORTEDSUBS(MAXROW)
76208                         else if CURRENTREC>-2 AND CURRENTREC<-1 then 
76210                            let CURRENTROW=POPULATESORTEDSUBS(MAX(MIN(1,INT(MAXROW*(CURRENTREC+1)*(-1))),MAXROW))
76212                         else if CURRENTREC>-1 AND CURRENTREC<0 then 
76214                            let CURRENTROW=POPULATESORTEDSUBS(MAX(MIN(1,INT(MAXROW*CURRENTREC*(-1))),MAXROW))
76216                         end if 
76218                      else 
76220                         input #WWINDOW, fields LISTVIEWSPEC$&",ROWCNT,ALL" : MAXROW
76222 ! 
76224                         if CURRENTREC=-1 then 
76226                            let CURRENTROW=1
76228                         else if CURRENTREC<=-2 then 
76230                            let CURRENTROW=MAXROW
76232                         else if CURRENTREC>-2 AND CURRENTREC<-1 then 
76234                            let CURRENTROW=MAX(MIN(1,INT(MAXROW*(CURRENTREC+1)*(-1))),MAXROW)
76236                         else if CURRENTREC>-1 AND CURRENTREC<0 then 
76238                            let CURRENTROW=MAX(MIN(1,INT(MAXROW*CURRENTREC*(-1))),MAXROW)
76240                         end if 
76242                      end if 
76244                   else if CURRENTREC>0 then 
76246                      if SRCH(MAT LV_RECORDS,CURRENTREC)>0 then 
76248                         let CURRENTROW=SRCH(MAT LISTVIEWRECORDS,CURRENTREC)
76250                      end if 
76252                   end if 
76254                end if 
76256                if CURRENTROW<>S_CURRENTROW then 
76258                   let CURFLD(UDIM(MAT S_DATA$)+1,CURRENTROW)
76260                end if 
76262             end if 
76264 ! 
76266             mat OLD_DATA(UDIM(MAT S_DATA))
76268 ! .        ! mat Old_Data(Udim(Mat S_Data))=S_Data
76270 ! .        ! let msgbox("Setting Old_Data(1)="&str$(Old_Data(1))&" : S_Data(1)="&str$(S_Data(1)))
76272 ! 
76274 ! .        ! Apply CurrentField$ if its been changed.
76276             if CURRENTFIELD$<>S_CURRENTFIELD$ then 
76278                if CURRENTFIELD$<>"" then 
76280                   let TEMPCONTROL=0
76282                   let TEMPFIELD=0
76284                   let FOUNDALREADY=0
76286                   let FUNCTION=0
76288 ! 
76290                   for TEMPINDEX=1 to UDIM(MAT CONTROLNAME$)
76292                      if LWRC$(TRIM$(CURRENTFIELD$))=LWRC$(FNUNIQUENAME$(MAT CONTROLNAME$,TEMPINDEX)) then 
76294                         let TEMPCONTROL=TEMPINDEX
76296                         let FOUNDALREADY=1
76298                      else if ((~FOUNDALREADY) AND (LWRC$(TRIM$(CURRENTFIELD$))=LWRC$(TRIM$(CONTROLNAME$(TEMPINDEX))))) then 
76300                         let TEMPCONTROL=TEMPINDEX
76302                      end if 
76304                   next TEMPINDEX
76306                   if TEMPCONTROL then 
76308                      let TEMPFIELD=SRCH(MAT S_SUBS,TEMPCONTROL)
76310                   end if 
76312                   if TEMPFIELD>0 then let CURRENTFIELD=TEMPFIELD
76314                end if 
76316             end if 
76318 ! 
76320             if LISTVIEWINDEX AND CURRENTFIELD=UDIM(MAT S_SPEC$) then 
76322                if FUNCTION=106 OR FUNCTION=105 then 
76324                   let CURFLD(CURRENTFIELD,CURRENTROW)
76326                end if 
76328             else ! If Current Field Is Not The Listview Then Update Current Field Too.
76330                if CURRENTFIELD then let CURFLD(CURRENTFIELD,FUNCTION)
76332             end if 
76334 ! 
76336 ! .        ! Draw the Record Locking information on the screen
76338             if UDIM(MAT OTHER_S_DATA$) then 
76340 ! .           ! Check to see if the other user changed anything
76342                let FNFINDCHANGES(MAT OTHER_S_DATA$,MAT OTHER_S_SUBS,MAT S_DATA$,MAT S_SUBS,MAT OTHERCHANGED_S_DATA$,MAT OTHERCHANGED_S_SUBS)
76344                mat OTHER_S_DATA$(0)
76346                mat OTHER_S_SUBS(0)
76348             end if 
76350 ! 
76352             if UDIM(MAT OTHERCHANGED_S_SUBS) then 
76354 ! .           ! If they did, then color their changes pink. (Make color defineable)
76356                let FNGENERATEINPUTSPECS(WWINDOW,MAT S_DATA$,MAT S_DATA,MAT S_SPEC$,MAT S_SUBS,MAT S_HELP$,MAT S_OLD$,MAT F$,MAT F,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$,0,MAT OTHERCHANGED_S_SUBS)
76358             end if 
76360 ! 
76362 ! .        ! Draw the Yellow stickynotes that contain the users changes.
76364             mat CHANGEWINDOWNUMBERS(UDIM(MAT CHANGED_S_SUBS))
76366             for INDEX=1 to UDIM(MAT CHANGED_S_SUBS)
76368                if CHANGED_S_SUBS(INDEX)>0 then 
76370                   if CHANGEWINDOWNUMBERS(INDEX)=0 then 
76372                      let FNOPENSTICKY(INDEX,CHANGED_S_DATA$(INDEX),CHANGEWINDOWNUMBERS(INDEX),CHANGED_S_SUBS(INDEX),ROWS,COLS,ROW,COL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
76374                   end if 
76376                end if 
76378             next INDEX
76380 ! 
76382 ! .        ! Save Screen Data for later
76384             if ~SAVESCREENDATA then 
76386                mat SAVE_S_DATA$(UDIM(MAT S_DATA$))=S_DATA$
76388                mat SAVE_S_SUBS(UDIM(MAT S_SUBS))=S_SUBS
76390                let SAVESCREENDATA=1
76392             end if 
76394 ! 
76396 ! .        ! Print Screen Data
76398             let FNCHANGEFORCEVISIBILITY(1)
76400             do 
76402                let LOOPAGAIN=0
76404 ! 
76406                let FNSETRETRYPOINT("Timeout1")
76408 Timeout1retry: ! Timeout Retry Point
76410                if ~(UDIM(MAT S_DATA$)) then 
76412                   if LEN(TRIM$(SCREENIO$(SI_INPUTATTR))) then 
76414                      rinput #WWINDOW, fields MAT S_SPEC$, attr SCREENIO$(SI_INPUTATTR), wait=WAITTIME : MAT S_DATA timeout Timeouterror error IGNORE
76416                   else 
76418                      rinput #WWINDOW, fields MAT S_SPEC$, wait=WAITTIME : MAT S_DATA timeout Timeouterror error IGNORE
76420                   end if 
76422                else 
76424                   if LEN(TRIM$(SCREENIO$(SI_INPUTATTR))) then 
76426                      rinput #WWINDOW, fields MAT S_SPEC$, attr SCREENIO$(SI_INPUTATTR), wait=WAITTIME, help MAT S_HELP$ : MAT S_DATA$, MAT S_DATA timeout Timeouterror error IGNORE
76428                   else 
76430                      rinput #WWINDOW, fields MAT S_SPEC$, wait=WAITTIME, help MAT S_HELP$ : MAT S_DATA$, MAT S_DATA timeout Timeouterror error IGNORE
76432                   end if 
76434                end if 
76436 Timeout1continue: ! Timeout Continue Point
76438 ! 
76440                if UDIM(S_DATA)<1 then 
76442                   mat S_DATA(1)
76444                   if LISTVIEWINDEX AND MULTISELECT(LISTVIEWINDEX) then 
76446                      let S_DATA(1)=0
76448                   else 
76450                      let S_DATA(1)=CURRENTROW
76452                   end if 
76454                end if 
76456 ! .           ! print nxtfld; curfld : fkey linput X$
76458                let FUNCTION=FKEY
76460                let CURRENTFIELD=CURFLD
76462                let NEXTFIELD=NXTFLD
76464 ! 
76466 ! .           ! Make L Attribute Work In Listviews - Special Thanks To Susan Smith (Possibly deprecated, looks like BR just works this way by default now.)
76468 ! .           ! If there's an L, and they're in the listview, at the top or bottom, and we're here cause they pressed Up or Dn, then go back in the loop, don't let it loop around.
76470                if (THERESANL AND UDIM(MAT S_DATA) AND CURRENTFIELD=UDIM(MAT S_DATA$)+1 AND (((FUNCTION=105 OR FUNCTION=90) AND CURROW=1) OR ((FUNCTION=106 OR FUNCTION=91) AND CURROW=LASTROW))) then 
76472                   let LOOPAGAIN=1
76474                end if 
76476 ! 
76478 ! .           ! If they press escape, erase all the yellow stickies and make them go away.
76480                if FUNCTION=99 AND UDIM(MAT CHANGEWINDOWNUMBERS) then 
76482                   let FNCLOSEALLSTICKIES(MAT CHANGEWINDOWNUMBERS,MAT CHANGED_S_SUBS,MAT CHANGED_S_DATA$)
76484                   let LOOPAGAIN=1
76486                end if 
76488 ! 
76490 ! .           ! If they click on one of the stickies, then put their changes
76492 ! .           !  into mat s_data and go back up again.
76494                if FUNCTION>FNSTICKYBASE AND FUNCTION<=FNSTICKYBASE+UDIM(MAT CHANGED_S_SUBS) then 
76496                   let INDEX=SRCH(MAT S_SUBS,CHANGED_S_SUBS(FUNCTION-FNSTICKYBASE))
76498                   if INDEX>0 AND INDEX<UDIM(MAT S_DATA$) then 
76500                      let S_DATA$(INDEX)=CHANGED_S_DATA$(FUNCTION-FNSTICKYBASE)
76502                      close #CHANGEWINDOWNUMBERS(FUNCTION-FNSTICKYBASE): 
76504                      let FNCONSOLIDATEDIRECT(MAT CHANGEWINDOWNUMBERS,FUNCTION-FNSTICKYBASE)
76506                      let FNCONSOLIDATEDIRECT(MAT CHANGED_S_SUBS,FUNCTION-FNSTICKYBASE)
76508                      let FNCONSOLIDATEDIRECTS(MAT CHANGED_S_DATA$,FUNCTION-FNSTICKYBASE)
76510                   end if 
76512                   let LOOPAGAIN=1
76514                end if 
76516 ! 
76518                if ~FN42IA then ! after this version we handle multiline textboxes another way
76520                   if CURRENTFIELD<=UDIM(MAT S_SUBS) AND (FUNCTION=0 OR FUNCTION=FNKEYBASE+S_SUBS(CURRENTFIELD)) AND FNMULTILINETEXTBOX(S_SUBS(CURRENTFIELD),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then ! enter in a multi-line textbox
76522                      let POSITION=(((CURROW-1)*WIDTH(S_SUBS(CURRENTFIELD)))+CURCOL)  !Find The Position
76524                      if LEN(TRIM$(S_DATA$(CURRENTFIELD)))<=SPECWIDTH(S_SUBS(CURRENTFIELD))-3 then ! if there's room for an Enter
76526                         let S_DATA$(CURRENTFIELD)(POSITION:POSITION-1)=CHR$(13)&CHR$(10)
76528                         let POSITION+=2  !Move to after the crlf$
76530                         let S_DATA$(CURRENTFIELD)=SREP$(TRIM$(S_DATA$(CURRENTFIELD)),CHR$(1),"")&CHR$(1)
76532                      else 
76534                         print BELL
76536                      end if 
76538                      let POSITION=MIN(POSITION,SPECWIDTH(S_SUBS(CURRENTFIELD)))
76540                      let S_SPEC$(CURRENTFIELD)=FNSETCURSERPOSITION$(S_SPEC$(CURRENTFIELD),POSITION)
76542                      let LOOPAGAIN=1
76544                      let CURFLD(CURRENTFIELD)
76546                   end if 
76548                end if 
76550             loop WHILE LOOPAGAIN
76552 ! 
76554             if ~FN42IA then ! after this version we handle multiline textboxes another way
76556                for INDEX=1 to UDIM(MAT S_SUBS)
76558                   if FNMULTILINETEXTBOX(S_SUBS(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
76560                      let S_DATA$(INDEX)=SREP$(S_DATA$(INDEX),CHR$(1),"")
76562                   end if 
76564                next INDEX
76566             end if 
76568 ! 
76570             let FNRESETFORCEVISIBILITY
76572             if CURRENTFIELD>0 AND CURRENTFIELD<=UDIM(MAT S_SUBS) then 
76574                let CURRENTFIELD$=FNUNIQUENAME$(MAT CONTROLNAME$,S_SUBS(CURRENTFIELD))
76576                let S_CURRENTFIELD$=CURRENTFIELD$
76578             else 
76580                let CURRENTFIELD$=FNUNIQUENAME$(MAT CONTROLNAME$,LISTVIEWINDEX)
76582                let S_CURRENTFIELD$=CURRENTFIELD$
76584             end if 
76586 ! 
76588 ! .         ! Read the listviews if there are any
76590 ! .        ! This function breaks curfld by inputting from the grid. this means we have to monkey around a lot more above.
76592 ! .        !  At this point, s_data(1) represents the count.
76594 ! .        ! let TempCurfld=Curfld ! this logic didn't work, because 2d controls
76596             let FNREADLISTVIEWS(FUNCTION,MAT F$, MAT F, CURRENTKEY$,CURRENTREC,MAT SELECTEDKEYS$,MAT SELECTEDRECORDS,MAT VISIBLEKEYS$,MAT VISIBLERECORDS,MAT S_DATA,MAT S_SPEC$,LISTVIEWINDEX,MAT OLD_DATA,WWINDOW,FDATAFILE,MAT FORM$, MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,NEXTROW)
76598 ! .        ! let Curfld(TempCurfld)
76600 ! .        ! At this point, s_data(1) represents the current row.
76602             if LISTVIEWINDEX then 
76604                let CURRENTROW=S_CURRENTROW=S_DATA(1)
76606                let S_CURRENTREC=CURRENTREC
76608             end if 
76610 ! 
76612             if FUNCTION=99 AND FNSEARCHCLOSELY(MAT FUNCTION$,"exitmode","quitonly") then 
76614 ! .            ! They pressed esc but the program already has exit buttons, so simply ignore latest changes
76616             else 
76618                let FNVALIDATEANDSAVE(MAT S_DATA$,MAT S_SPEC$,MAT S_SUBS,MAT S_OLD$,MAT F$,MAT F,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
76620             end if 
76622 ! 
76624          else ! Nothing Is Selected
76626 ! .         ! so preform a hidden input
76628             let FNCHANGEFORCEVISIBILITY(0)
76630 ! 
76632             let FNSETRETRYPOINT("Timeout2")
76634 Timeout2retry: ! Timeout Retry Point
76636             input #0, fields STR$(ROW+1)&","&STR$(COL+1)&",C 1,AEX", wait=WAITTIME : KP$ error Timeouterror
76638 Timeout2continue: ! Timeout Continue Point
76640 ! 
76642             let FUNCTION=FKEY
76644             let FNRESETFORCEVISIBILITY
76646          end if 
76648 ! 
76650          let FNRESPONDTOUSERACTION(FUNCTION,EXITMODE,CURRENTFIELD,CURRENTFIELD$,MAT S_SUBS,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,WWINDOW,SAVEDONTASK)
76652 ! 
76654          if EXITMODE=ASKSAVEANDQUIT then 
76656             if ~FNSAMEA(MAT SAVE_F,MAT F) OR ~FNSAMEAS(MAT SAVE_F$,MAT F$) OR ~FNSAMEAS(MAT SAVE_S$,MAT S$) then 
76658                if LEN(TRIM$(SCREENIO$(SI_FILELAY))) then 
76660                   if USEMYF then 
76662                      let CH=MSGBOX("The data has changed. Do you want to accept the changes?","Save?","ynC","QST")
76664                   else 
76666                      let CH=MSGBOX("The record has changed. Would you like to save the record?","Save?","ynC","QST")
76668                   end if 
76670                else ! No file layout, can't save
76672                   let CH=3
76674                end if 
76676                let EXITMODE=0
76678                if CH=2 then let EXITMODE=SAVEANDQUIT
76680                if CH=3 then let EXITMODE=QUITONLY
76682             else 
76684                let EXITMODE=QUITONLY
76686             end if 
76688          end if 
76690          if EXITMODE=SAVEANDQUIT then 
76692 ! .         ! Execute our preWRITE Event Here
76694             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
76696                if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\write.brs") then 
76698                   let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\write.brs"))
76700                end if 
76702             end if 
76704 ! 
76706             if LEN(TRIM$(SCREENIO$(SI_WRITEFN))) then 
76708                let FNEXECUTE(SCREENIO$(SI_WRITEFN))
76710                if EXITMODE=0 AND PARENTWINDOW AND FKEY=92 then ! Probably Tabs and the exit was cancelled
76712 ! .              ! Set the current tab back
76714                   input #PARENTWINDOW, fields STR$(ROW+1)&","&STR$(COL+1)&",C 1,,NOWAIT" : DUMMY$
76716                   print #PARENTWINDOW, fields STR$(ROW+1)&","&STR$(COL+1)&",C 1" : ""
76718                end if 
76720             end if 
76722          end if 
76724 ! 
76726          if EXITMODE=SAVEANDQUIT then 
76728             if USEMYF then 
76730                mat MYF$=F$
76732                mat MYF=F
76734             else if UDIM(S_DATA$)>0 AND FDATAFILE AND FILE(FDATAFILE)>=0 then 
76736                mat DISK_F$(UDIM(READ_F$))=("")
76738                mat DISK_F(UDIM(READ_F))=(0)
76740                let WARNWINDOW=FNDISPLAYLOADMESSAGE
76742                if KEY$<>"" then 
76744 ! 
76746                   let FNSETRETRYPOINT("ErrorLocked1exit")
76748 Errorlocked1exitretry: ! Error Locked Retry Point
76750                   read #FDATAFILE, using FORM$(FDATAFILE), key=FNKEY$(FDATAFILE,KEY$) : MAT DISK_F$, MAT DISK_F locked Errorfilelockedonexit
76752 Errorlocked1exitcontinue: ! Error Locked Continue Point
76754 ! 
76756                   let FNSETLOGCHANGES(MAT READ_F$,MAT DISK_F)
76758                else if RECORD<>0 then 
76760 ! 
76762                   let FNSETRETRYPOINT("ErrorLocked2exit")
76764 Errorlocked2exitretry: ! Error Locked Retry Point
76766                   read #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD : MAT DISK_F$,MAT DISK_F locked Errorfilelockedonexit
76768 Errorlocked2exitcontinue: ! Error Locked Continue Point
76770 ! 
76772                   let FNSETLOGCHANGES(MAT READ_F$,MAT DISK_F)
76774                end if 
76776                close #WARNWINDOW: 
76778                if ~FNSAMEAS(MAT DISK_F$,MAT READ_F$) OR ~FNSAMEA(MAT DISK_F,MAT READ_F) then 
76780                   if SETTING_ENABLELOGGING then 
76782                      let FNLOGCHANGES(MAT DISK_F$,MAT DISK_F,"ScreenIO: "&SCREENIO$(SI_SCREENCODE)&" screen attempting to Merge changes in "&SCREENIO$(SI_FILELAY)&" file, Record: "&STR$(REC(FDATAFILE))&" Key: "&KEY$&" Other User",PROGRAM$&"\Screen: "&SCREENIO$(SI_SCREENCODE),SCREENIO$(SI_FILELAY))
76784                      let FNLOGCHANGES(MAT F$,MAT F,"ScreenIO: "&SCREENIO$(SI_SCREENCODE)&" screen attempting to Merge changes in "&SCREENIO$(SI_FILELAY)&" file, Record: "&STR$(REC(FDATAFILE))&" Key: "&KEY$&" My Changes",PROGRAM$&"\Screen: "&SCREENIO$(SI_SCREENCODE),SCREENIO$(SI_FILELAY))
76786                   end if 
76788                   if LEN(TRIM$(SCREENIO$(SI_MERGEFN))) then ! If a merge function is given
76790                      let FNEXECUTE(SCREENIO$(SI_MERGEFN))  !use it
76792                   else if SCREENIO(SI_SCREENIOMERGE) then ! If we selected "Auto Merge"
76794                      for INDEX=1 to UDIM(MAT F$)  !take my changes and merge them into Other's Changes
76796                         if TRIM$(F$(INDEX))<>TRIM$(READ_F$(INDEX)) then 
76798                            let DISK_F$(INDEX)=F$(INDEX)
76800                         end if 
76802                      next INDEX
76804                      for INDEX=1 to UDIM(MAT F)
76806                         if F(INDEX)<>READ_F(INDEX) then 
76808                            let DISK_F(INDEX)=F(INDEX)
76810                         end if 
76812                      next INDEX
76814                      mat F$=DISK_F$
76816                      mat F=DISK_F
76818                   else if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") AND EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\merge.brs") then 
76820                      let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\merge.brs"))
76822                   else ! Otherwise, allow the user to merge the records.
76824 ! .                 ! here we need to check if there's an ini setting for Debug then allow them to debug here.
76826                      let DEBUGYN=0
76828                      if SETTING_DEBUG_LOCKED_MSG then 
76830                         let DEBUGYN=MSGBOX("We detected changes to this record that were made by another user. You have to make your changes again. Would you like to debug this message?","Debug??","Yn","QST")
76832                      else 
76834                         let MSGBOX("We detected changes to this record that were made by another user. You have to make your changes again.","Record Changed by Another User")
76836                      end if 
76838 ! 
76840                      if DEBUGYN=2 then pause 
76842 ! 
76844                      let CURRENTKEY$=KEY$
76846                      let EXITMODE=RELOAD
76848 ! 
76850 ! .                 ! Save old record to detect what other user changed
76852                      mat OTHER_S_DATA$(UDIM(MAT SAVE_S_DATA$))=SAVE_S_DATA$
76854                      mat OTHER_S_SUBS(UDIM(MAT SAVE_S_SUBS))=SAVE_S_SUBS
76856 ! 
76858 ! .                 ! Detect what I changed
76860                      let FINDSTICKIES=1
76862                   end if 
76864                end if 
76866 ! 
76868                if EXITMODE=SAVEANDQUIT then 
76870                   if KEY$<>"" then 
76872                      rewrite #FDATAFILE, using FORM$(FDATAFILE), key=FNKEY$(FDATAFILE,KEY$) : MAT F$, MAT F
76874                      if SETTING_ENABLELOGGING then let FNLOGCHANGES(MAT F$,MAT F,"ScreenIO: Updating "&SCREENIO$(SI_FILELAY)&" file, Record: "&STR$(REC(FDATAFILE))&" Key: "&KEY$,SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
76876                   else if RECORD<>0 then 
76878                      rewrite #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD : MAT F$, MAT F
76880                      if SETTING_ENABLELOGGING then let FNLOGCHANGES(MAT F$,MAT F,"ScreenIO: Updating "&SCREENIO$(SI_FILELAY)&" file, Record: "&STR$(REC(FDATAFILE)),SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
76882                   else 
76884                      write #FDATAFILE, using FORM$(FDATAFILE) : MAT F$, MAT F
76886                      if SETTING_ENABLELOGGING then let FNLOGARRAY(MAT F$,MAT F,"ScreenIO: Writing "&SCREENIO$(SI_FILELAY)&" file, Record: "&STR$(REC(FDATAFILE)),SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
76888                   end if 
76890                end if 
76892             end if 
76894          end if 
76896       loop 
76898 ! 
76900 ! .   ! Set Return Key
76902       if EXITMODE>QUITONLY AND EXITMODE<>QUITOTHER AND EXITMODE<>RELOAD AND TRIM$(SCREENIO$(SI_FILELAY))<>"" then 
76904          let CURRENTKEY$=FNBUILDKEY$(TRIM$(SCREENIO$(SI_FILELAY)),MAT F$,MAT F,SCREENIO(SI_RETURNINDEX))
76906          if CURRENTKEY$="" then 
76908             if FDATAFILE then 
76910                let CURRENTKEY$=STR$(REC(FDATAFILE))  !Pass Back Record If Key Doesn't exist
76912             else if USEMYF then 
76914                let CURRENTKEY$="1"    !If there's no data file, if its a UseMyF screen, can't pass back record, just return true.
76916             end if 
76918          end if 
76920       end if 
76922 ! 
76924       let FNCLOSEALLSTICKIES(MAT CHANGEWINDOWNUMBERS,MAT CHANGED_S_SUBS,MAT CHANGED_S_DATA$)
76926       if FINDSTICKIES then let FNFINDCHANGES(MAT S_DATA$,MAT S_SUBS,MAT SAVE_S_DATA$,MAT SAVE_S_SUBS,MAT CHANGED_S_DATA$,MAT CHANGED_S_SUBS)
76928 ! 
76930    fnend 
76932 ! 
76934 ! .! =================================================================
76936 Closescreen: ! This Function Contains The Portion Of The Runtime Engine That Closes Your Screen And Returns.
76938 ! .! =================================================================
76940    def FNCLOSESCREEN
76942       if ~EDITING AND SETTING_ENABLELOGGING then 
76944          let FNLOG("ScreenIO: Leaving Screen "&SCREENIO$(SI_SCREENCODE),SETTING_SCREENFOLDER$&"\"&SCREENIO$(SI_SCREENCODE))
76946       end if 
76948       if ~EDITING OR POS(UPRC$(ENV$("filter")),"Y") then 
76950 ! .   ! Execute our EXIT Event Here
76952          if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
76954             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\exit.brs") then 
76956                let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\exit.brs"))
76958             end if 
76960          end if 
76962 ! 
76964          if LEN(TRIM$(SCREENIO$(SI_EXITFN))) then 
76966             let FNEXECUTE(SCREENIO$(SI_EXITFN))
76968          end if 
76970       end if 
76972 ! 
76974       if EXITMODE>QUITONLY then 
76976          let KEY$=CURRENTKEY$
76978       else 
76980          let KEY$=""                  !Cancel Forces No Return Value
76982       end if 
76984 ! 
76986 ! .   ! Close Data Files
76988       if FDATAFILE AND FILE(FDATAFILE)>=0 then 
76990          let FNCLOSEFILE(FDATAFILE,TRIM$(SCREENIO$(SI_FILELAY)),PATH$,1)
76992       end if 
76994 ! 
76996 ! .   ! Close Child Window
76998       if WWINDOW AND FILE(WWINDOW)<>-1 then 
77000          close #WWINDOW: 
77002       end if 
77004 ! 
77006 !      If Librarylinkage Then
77008 !         Execute "clear "&Lwrc$(Routinename$)&" status"
77010 !      End If
77012 ! 
77014 ! .   ! Restore all screen settings to previous values
77016       if OLDROWS AND OLDCOLS then 
77018          open #0: "rows="&STR$(OLDROWS)&",cols="&STR$(OLDCOLS), display, outin 
77020       end if 
77022       if LEN(OLDWINDOWCAPTION$) then 
77024          print #0, border: OLDWINDOWCAPTION$
77026          let SETENV("Window_Caption",OLDWINDOWCAPTION$)
77028       end if 
77030       let FNRESETFORCEVISIBILITY
77032       if TURNGUIBACKOFF then 
77034          let FNRESTORENONGUI
77036       end if 
77038    fnend 
77040 ! 
77042    def FNMULTILINETEXTBOX(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
77044       if HEIGHT(INDEX)>1 AND FIELDTYPE$(INDEX)="C" then 
77046          let FNMULTILINETEXTBOX=1
77048       end if 
77050    fnend 
77052 ! 
77054    def FNSETCURSERPOSITION$*255(SPEC$*255,POSITION;___,ATTRPOS,ENDPOS)
77056       let ENDPOS=ATTRPOS=POS(SPEC$,",",POS(SPEC$,",",POS(SPEC$,",")+1)+1)+1
77058       do WHILE POS("0123456789",SPEC$(ENDPOS:ENDPOS))
77060          let ENDPOS+=1
77062       loop 
77064       let ENDPOS-=1
77066       let SPEC$(ATTRPOS:ENDPOS)=STR$(POSITION)
77068       let FNSETCURSERPOSITION$=SPEC$
77070    fnend 
77072 ! 
77074 Findchanges: ! Examine two arrays and find the differences, adding them to a third array
77076    def FNFINDCHANGES(MAT S_DATA$,MAT S_SUBS,MAT SAVE_S_DATA$,MAT SAVE_S_SUBS,MAT CHANGED_S_DATA$,MAT CHANGED_S_SUBS;___,INDEX,X,Z)
77078       for INDEX=1 to UDIM(MAT S_SUBS)
77080          let X=SRCH(MAT SAVE_S_SUBS,S_SUBS(INDEX))
77082          if X<1 OR TRIM$(SAVE_S_DATA$(X))<>TRIM$(S_DATA$(INDEX)) then 
77084             let Z=UDIM(MAT CHANGED_S_DATA$)+1
77086             mat CHANGED_S_DATA$(Z)
77088             mat CHANGED_S_SUBS(Z)
77090 ! 
77092             let CHANGED_S_DATA$(Z)=S_DATA$(INDEX)
77094             let CHANGED_S_SUBS(Z)=S_SUBS(INDEX)
77096          end if 
77098       next INDEX
77100    fnend 
77102 ! 
77104 ! 
77106 Uniquename: ! Return a unique name for the control by adding the count
77108    def FNUNIQUENAME$*54(MAT CONTROLNAME$,CONTROL;___,INDEX,ENUMERATOR,COUNT)
77110       for INDEX=1 to UDIM(MAT CONTROLNAME$)
77112          if LWRC$(TRIM$(CONTROLNAME$(INDEX)))=LWRC$(TRIM$(CONTROLNAME$(CONTROL))) then 
77114             let COUNT+=1
77116             if INDEX<=CONTROL then 
77118                let ENUMERATOR+=1
77120             end if 
77122          end if 
77124       next INDEX
77126       if COUNT>1 OR TRIM$(CONTROLNAME$(CONTROL))="" then 
77128          let FNUNIQUENAME$=TRIM$(CONTROLNAME$(CONTROL))&STR$(ENUMERATOR)
77130       else 
77132          let FNUNIQUENAME$=TRIM$(CONTROLNAME$(CONTROL))
77134       end if 
77136    fnend 
77138    def library FNGETUNIQUENAME$*54(MAT CONTROLNAME$,CONTROL)=FNUNIQUENAME$(MAT CONTROLNAME$,CONTROL)
77140 ! 
77142    dim RLV_SUBS(1)
77144    dim RLV_READDATA$(1)*1000
77146    dim RLV_SAVEREADDATA$(1)*1000
77148    dim LISTVIEWRECORDS(1)
77150    dim RLV_VISIBLEDATA$(1)*1000
77152    dim RLV_START(1),RLV_END(1),RLV_SORTORDER(1)
77154    dim VISIBLEF$(1)*1023,VISIBLEF(1)
77156    dim RLV_OLDVISIBLE(1),RLV_OLDVISIBLEMASK(1)
77158 ! 
77160    dim VISIBLEMASK(1)
77162 ! 
77164 Readlistviews: ! This Function Reads The Listview On The Screen If There Is One.
77166    def FNREADLISTVIEWS(FUNCTION,MAT F$, MAT F, &CURRENTKEY$,&CURRENTREC,MAT SELECTEDKEYS$,MAT SELECTEDRECORDS,MAT VISIBLEKEYS$,MAT VISIBLERECORDS,MAT S_DATA,MAT S_SPEC$,LISTVIEWINDEX,MAT OLD_DATA,WWINDOW,FDATAFILE,MAT FORM$, MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,&NEXTROW;___,LISTVIEWSPEC$*40,INDEX,ANYTHINGCHANGED,MULTISELECT,NUMBEROFCOLUMNS,NUMOFROWS,VISIBLEROWS)
77168 ! 
77170       if LISTVIEWINDEX AND LISTVIEWINDEX<=UDIM(MAT MULTISELECT) AND ~PROTECTED(LISTVIEWINDEX) AND ~INVISIBLE(LISTVIEWINDEX) then ! If There's a listview
77172          let LISTVIEWSPEC$=S_SPEC$(UDIM(MAT S_SPEC$))
77174          let LISTVIEWSPEC$=LISTVIEWSPEC$(1:POS(LISTVIEWSPEC$,",",-1)-1)
77176          let LISTVIEWSPEC$=LISTVIEWSPEC$(1:POS(LISTVIEWSPEC$,",",-1)-1)
77178          let NUMBEROFCOLUMNS=FNCOUNTCOLUMNS(PARENT$(LISTVIEWINDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)+1
77180 ! 
77182 ! .      ! If its multiselect then read mat SelectedKeys$ and mat SelectedRecords
77184          if MULTISELECT(LISTVIEWINDEX) then 
77186 ! .         ! Read the selected records from the listview
77188             mat RLV_READDATA$(S_DATA(1)*NUMBEROFCOLUMNS)
77190             input #WWINDOW, fields LISTVIEWSPEC$&",ROW,SEL,NOWAIT" : MAT RLV_READDATA$
77192 ! 
77194 ! .        ! $$$$$ Discuss with Gordon, why is this necessary?
77196 ! .        !  This is happening because when nothing is selected, s_data(1) has 40 in it. Easy to reproduce, just unselect everything
77198 ! .        !  on expense listview.
77200 ! .        !  The ROWCNT,SEL is returning 40 but the ROW,SEL,NOWAIT is returning 0 elements.
77202 ! .        ! For now, the following code should hopefully keep it from bombing.
77204 ! .        ! Seems like ROWCNT,SEL returns ROWSUB,SELONE for last thing selected if nothing is selected.
77206 ! 
77208 ! .        ! if udim(mat Rlv_ReadData$)<S_Data(1)*NumberOfColumns then
77210 ! .        !    let S_Data(1)=int(udim(mat Rlv_ReadData$)/NumberOfColumns)
77212 ! .        ! end if
77214 ! 
77216 ! .         ! Read the keys array from the data file
77218             if ~FNSAMEAS(MAT RLV_SAVEREADDATA$,MAT RLV_READDATA$) then 
77220                mat RLV_SAVEREADDATA$(UDIM(MAT RLV_READDATA$))=RLV_READDATA$
77222                mat SELECTEDKEYS$(S_DATA(1))
77224                mat SELECTEDRECORDS(S_DATA(1))
77226 ! 
77228                if FDATAFILE AND FILE(FDATAFILE)>=0 then 
77230                   for INDEX=1 to UDIM(MAT SELECTEDRECORDS)
77232                      let SELECTEDRECORDS(INDEX)=VAL(RLV_READDATA$((INDEX*NUMBEROFCOLUMNS)))
77234                      let SELECTEDKEYS$(INDEX)=FNREADCURRENTKEY$(SELECTEDRECORDS(INDEX),FDATAFILE,MAT F$,MAT F,MAT FORM$,MAT SCREENIO$)
77236                   next INDEX
77238                else 
77240                   mat RLV_SUBS(S_DATA(1))
77242                   input #WWINDOW, fields LISTVIEWSPEC$&",ROWSUB,SEL,NOWAIT" : MAT RLV_SUBS
77244                   for INDEX=1 to UDIM(MAT SELECTEDRECORDS)
77246                      let SELECTEDRECORDS(INDEX)=VAL(RLV_READDATA$((INDEX*NUMBEROFCOLUMNS)))
77248                      let SELECTEDKEYS$(INDEX)=STR$(RLV_SUBS(INDEX))
77250                   next INDEX
77252                end if 
77254                let ANYTHINGCHANGED=1
77256             end if 
77258 ! 
77260             let MULTISELECT=1
77262          end if 
77264 ! 
77266          if FN42 then ! Use fn42+ NEXT for greater control over the listview
77268             input #WWINDOW, fields LISTVIEWSPEC$&",ROWSUB,NEXT,NOWAIT" : S_DATA(1)
77270          else 
77272             input #WWINDOW, fields LISTVIEWSPEC$&",ROWSUB,CUR,NOWAIT" : S_DATA(1)
77274          end if 
77276 ! 
77278          if FN43 AND FNUSESVISIBLEVARS then 
77280 ! .        ! Read VisibleKeys$ And VisibleRecords
77282             input #WWINDOW, fields LISTVIEWSPEC$&",rowcnt,all,nowait" : NUMOFROWS
77284 ! 
77286             mat VISIBLEMASK(NUMOFROWS)
77288 ! 
77290             input #WWINDOW, fields LISTVIEWSPEC$&",mask,,nowait" : MAT VISIBLEMASK
77292 ! 
77294             let VISIBLEROWS=SUM(MAT VISIBLEMASK)
77296             if VISIBLEROWS then 
77298                if (VISIBLEROWS*NUMBEROFCOLUMNS) <= 268400 then 
77300 ! 
77302 ! .              ! 268 MB is the max size of an array in BR 4.3. If there's more data than that in the listview,
77304 ! .              ! then we can't read mat VisibleKeys$ or mat VisibleRows.
77306 ! .              ! They're probably not useful for listviews that large anyway.
77308 ! 
77310                   mat RLV_READDATA$(VISIBLEROWS*NUMBEROFCOLUMNS)
77312                   mat RLV_SORTORDER(NUMOFROWS)
77314 ! 
77316 ! .              ! let Rlv_Start(1)=(NumOfRows-VisibleRows)+1
77318 ! .              ! let Rlv_Endn(1)=NumOfRows
77320 ! .              ! input #Wwindow, fields Listviewspec$&",row,range,displayed_order,nowait" : Rlv_Start(1),Rlv_End(1),Mat Rlv_Readdata$
77322 ! 
77324 ! .              ! Calculate the mat Start and mat End necessary to read the data
77326 ! .              ! We're using a trick here. Looks like BR Returns displayed_order with all the
77328 ! .              !  filter-showing rows at the end. So we just read the last however many rows
77330 ! .              !  of our mat SortOrder and use it for our Starts and Ends, and they're already in
77332 ! .              !  displayed order for us
77334                   input #WWINDOW, fields LISTVIEWSPEC$&",rowsub,all,displayed_order,nowait": MAT RLV_SORTORDER
77336 ! 
77338                   if ~FNSAMEA(MAT RLV_OLDVISIBLEMASK,MAT VISIBLEMASK) OR ~FNSAMEA(MAT RLV_OLDVISIBLE,MAT RLV_SORTORDER) then 
77340                      mat RLV_OLDVISIBLEMASK(UDIM(MAT VISIBLEMASK))=VISIBLEMASK
77342                      mat RLV_OLDVISIBLE(UDIM(MAT RLV_SORTORDER))=RLV_SORTORDER
77344 ! 
77346                      mat RLV_START(VISIBLEROWS)=RLV_SORTORDER(UDIM(MAT RLV_SORTORDER)-VISIBLEROWS+1:UDIM(MAT RLV_SORTORDER))
77348                      mat RLV_END(VISIBLEROWS)=RLV_START
77350 ! 
77352                      input #WWINDOW, fields LISTVIEWSPEC$&",row,range,nowait" : MAT RLV_START, MAT RLV_END, (MAT RLV_READDATA$)
77354 ! 
77356                      mat VISIBLEKEYS$(SUM(MAT VISIBLEMASK))
77358                      mat VISIBLERECORDS(SUM(MAT VISIBLEMASK))
77360                      mat VISIBLEF$(UDIM(MAT F$)) : mat VISIBLEF(UDIM(MAT F))
77362                      for INDEX=1 to UDIM(MAT VISIBLERECORDS)
77364                         let VISIBLERECORDS(INDEX)=VAL(RLV_READDATA$(INDEX*NUMBEROFCOLUMNS))
77366                         let VISIBLEKEYS$(INDEX)=FNREADCURRENTKEY$(VISIBLERECORDS(INDEX),FDATAFILE,MAT VISIBLEF$,MAT VISIBLEF,MAT FORM$,MAT SCREENIO$)
77368                      next INDEX
77370                   end if 
77372                end if 
77374             end if 
77376          end if 
77378 ! 
77380 ! .      ! Read CurrentKey$
77382          if ~FNSAMEA(MAT OLD_DATA,MAT S_DATA) then 
77384             if FDATAFILE AND FILE(FDATAFILE)>=0 then 
77386                mat RLV_READDATA$(NUMBEROFCOLUMNS)
77388                if FN42 then 
77390                   input #WWINDOW, fields LISTVIEWSPEC$&",ROW,NEXT,NOWAIT" : MAT RLV_READDATA$
77392                else 
77394                   input #WWINDOW, fields LISTVIEWSPEC$&",ROW,CUR,NOWAIT" : MAT RLV_READDATA$
77396                end if 
77398                let CURRENTKEY$=FNREADCURRENTKEY$(VAL(RLV_READDATA$(NUMBEROFCOLUMNS)),FDATAFILE,MAT F$,MAT F,MAT FORM$,MAT SCREENIO$)
77400                let CURRENTREC=VAL(RLV_READDATA$(NUMBEROFCOLUMNS))
77402             else 
77404                let CURRENTKEY$=STR$(S_DATA(1))
77406                let CURRENTREC=S_DATA(1)
77408             end if 
77410 ! 
77412             let ANYTHINGCHANGED=1
77414             mat OLD_DATA(UDIM(MAT S_DATA))=S_DATA
77416 ! 
77418             if ~MULTISELECT then 
77420                mat SELECTEDKEYS$(1) : mat SELECTEDRECORDS(1)
77422                let SELECTEDKEYS$(1)=CURRENTKEY$
77424                let SELECTEDRECORDS(1)=CURRENTREC
77426             end if 
77428          end if 
77430 ! 
77432          if ANYTHINGCHANGED then 
77434 ! .         ! Here is where we link to our READ event for Listviews
77436             if LEN(TRIM$(SCREENIO$(SI_READFN))) then 
77438                let FNEXECUTE(SCREENIO$(SI_READFN))
77440             end if 
77442          end if 
77444       end if 
77446    fnend 
77448 ! 
77450    def FNUSESVISIBLEVARS
77452 ! .  ! This function should check if the screen uses VisibleRecords or VisibleKeys$ maybe.
77454 ! .  !  or it should check some faster way if the screen needs them or not. Or just leave this out.
77456 ! 
77458       let FNUSESVISIBLEVARS=1
77460    fnend 
77462 ! 
77464 Readcurrentkey: ! Read The Current Record And Build Currentkey$
77466    def FNREADCURRENTKEY$*255(RECORD,FDATAFILE,MAT F$,MAT F,MAT FORM$,MAT SCREENIO$)
77468       if RECORD then 
77470 ! .      ! Read new record
77472          read #FDATAFILE, using FORM$(FDATAFILE), rec=RECORD, release: MAT F$, MAT F norec IGNORE
77474          let FNREADCURRENTKEY$=FNBUILDKEY$(TRIM$(SCREENIO$(SI_FILELAY)),MAT F$,MAT F,SCREENIO(SI_RETURNINDEX))
77476       end if 
77478    fnend 
77480 ! 
77482 Requiresgui: ! Returns True If Any Control Requires Gui
77484    def FNREQUIRESGUI(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
77486       let FNREQUIRESGUI=1             !Non-Gui Compatability Doesn't work yet
77488    fnend 
77490 ! 
77492 Initializemats: ! Initialize The Mat S Array For Dumb (Mute) Screen Controls
77494    def FNINITIALIZEMATS(MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX)
77496       mat S$(0)
77498       mat SCREENSUBS$(0)
77500 ! 
77502       for INDEX=1 to UDIM(MAT CONTROLNAME$)
77504          if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "p" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "combo" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "caption" # "button" # "p" # "combo"
77506             if TRIM$(FIELDNAME$(INDEX))="" then 
77508                if LEN(TRIM$(CONTROLNAME$(INDEX))) then 
77510                   if SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(INDEX))))<1 then 
77512                      mat S$(UDIM(MAT S$)+1)
77514                      mat SCREENSUBS$(UDIM(MAT S$))
77516                      let S$(UDIM(MAT S$))=FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
77518                      let SCREENSUBS$(UDIM(MAT S$))=LWRC$(TRIM$(CONTROLNAME$(INDEX)))
77520                   end if 
77522                end if 
77524             end if 
77526          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listchld" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "check" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "search" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "filter" then ! #Case# "c" # "listchld" # "check" # "search" # "filter"
77528             if TRIM$(FIELDNAME$(INDEX))="" then 
77530                if LEN(TRIM$(CONTROLNAME$(INDEX))) then 
77532                   if SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(INDEX))))<1 then 
77534                      mat S$(UDIM(MAT S$)+1)
77536                      mat SCREENSUBS$(UDIM(MAT S$))
77538                      let SCREENSUBS$(UDIM(MAT S$))=LWRC$(TRIM$(CONTROLNAME$(INDEX)))
77540                   end if 
77542                end if 
77544             end if 
77546          end if                       !#End Select#
77548       next INDEX
77550    fnend 
77552 ! 
77554    dim OLDINVISIBLE
77556    dim ERASESPEC$(1)*255, ERASEDATA$(1)
77558    def FNERASEINVISIBLE(WINDOW,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,JNDEX)
77560       mat ERASESPEC$(UDIM(MAT FIELDTYPE$))
77562       mat OLDINVISIBLE(UDIM(MAT INVISIBLE))
77564 ! 
77566       for INDEX=1 to UDIM(MAT FIELDTYPE$)
77568          if INVISIBLE(INDEX) AND ~OLDINVISIBLE(INDEX) then ! If its invisible and it used to not be
77570             if FNISINPUT(FIELDTYPE$(INDEX)) then ! We only care about input controls, output are handled elsewhere.
77572                let JNDEX+=1
77574                let ERASESPEC$(JNDEX)=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&",C 1"
77576             end if 
77578          end if 
77580       next INDEX
77582 ! 
77584       mat OLDINVISIBLE=INVISIBLE
77586 ! 
77588       if JNDEX then ! If anything found, then erase it.
77590          mat ERASESPEC$(JNDEX)
77592          mat ERASEDATA$(JNDEX)
77594          print #WINDOW, fields MAT ERASESPEC$ : MAT ERASEDATA$
77596       end if 
77598    fnend 
77600 ! 
77602    dim BLANKDATA$(1)
77604    def FNBLANKOLDSFIELDS$(MAT SPEC$,MAT OLDSPEC$,WINDOW;___,INDEX,OUTDEX,H,V,W,T$,OH,OV,OW,OT$)
77606       if UDIM(MAT SPEC$)=UDIM(MAT OLDSPEC$) then 
77608          for INDEX=1 to UDIM(MAT SPEC$)
77610 ! 
77612             let FNPARSESPEC(OLDSPEC$(INDEX),OH,OV,OW,OT$)
77614             let FNPARSESPEC(SPEC$(INDEX),H,V,W,T$)
77616 ! 
77618             if UPRC$(T$)="C" AND UPRC$(OT$)="C" AND (OH<>H OR OV<>V OR OW>W) then 
77620 ! .            ! Save it
77622                let OUTDEX+=1
77624                let OLDSPEC$(OUTDEX)=OLDSPEC$(INDEX)(1:POS(OLDSPEC$(INDEX),",",POS(OLDSPEC$(INDEX),",",POS(OLDSPEC$(INDEX),",")+1)+1)-1)&",/W:W"
77626             end if 
77628          next INDEX
77630          mat OLDSPEC$(OUTDEX)
77632       end if 
77634       for INDEX=1 to UDIM(MAT OLDSPEC$)
77636          let OLDSPEC$(INDEX)=OLDSPEC$(INDEX)(1:POS(OLDSPEC$(INDEX),",",POS(OLDSPEC$(INDEX),",",POS(OLDSPEC$(INDEX),",")+1)+1)-1)&",/W:W"
77638       next INDEX
77640 ! 
77642       if UDIM(MAT OLDSPEC$) then 
77644          mat BLANKDATA$(UDIM(MAT OLDSPEC$))=("")
77646          print #WWINDOW, fields MAT OLDSPEC$ : MAT BLANKDATA$
77648       end if 
77650    fnend 
77652 ! 
77654 !  $$$$$ The following code doesn't support Radio Buttons or Listviews
77656    def FNPARSESPEC(SPEC$*255,&H,&V,&W,&TYPE$)
77658       let H=V=W=0
77660       let V=VAL(SPEC$(1:POS(SPEC$,",")-1)) conv IGNORE
77662       let SPEC$=SPEC$(POS(SPEC$,",")+1:LEN(SPEC$))
77664       let H=VAL(SPEC$(1:POS(SPEC$,",")-1)) conv IGNORE
77666       let SPEC$=SPEC$(POS(SPEC$,",")+1:LEN(SPEC$))
77668       let SPEC$=SPEC$(POS(SPEC$,"/")+1:LEN(SPEC$))
77670       let TYPE$=SPEC$(1:1)
77672       if POS(SPEC$,",",3) then let SPEC$=SPEC$(3:POS(SPEC$,",",3))
77674       let W=VAL(SPEC$) conv IGNORE
77676    fnend 
77678 ! 
77680    dim TEMPFILENAME$*1023
77682 Generateoutputspecs: ! Generate The Specs For Output Only Controls
77684    def FNGENERATEOUTPUTSPECS(WINDOW,MAT S_DATA$,MAT S_SPEC$,MAT S_HELP$,MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$;FORCEINDEX,___,INDEX,OUTDEX,SUBINDEX,POSITION)
77686       mat S_DATA$(0) : mat S_SPEC$(0) : mat S_HELP$(0)
77688       mat CONTROLSPEC$(UDIM(MAT CONTROLNAME$))
77690       for INDEX=1 to UDIM(MAT CONTROLNAME$)
77692          if ~INVISIBLE(INDEX) then 
77694             if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "p" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "caption" # "button" # "p"
77696                let OUTDEX=UDIM(MAT S_DATA$)+1
77698                mat S_DATA$(OUTDEX)
77700                mat S_SPEC$(OUTDEX)
77702                mat S_HELP$(OUTDEX)
77704 ! 
77706 ! .           ! Read from mat S$ if its S$, or F$ and F if its them. If its neither, set it from description.
77708                if TRIM$(FIELDNAME$(INDEX))="" AND TRIM$(CONTROLNAME$(INDEX))<>"" AND (SUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(INDEX)))))>0 then 
77710                   let S_DATA$(OUTDEX)=S$(SUBINDEX)
77712                else if TRIM$(FIELDNAME$(INDEX))><"" then 
77714                   if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(INDEX)) then 
77716                      let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
77718                      if POSITION>0 then 
77720                         let S_DATA$(OUTDEX)=STR$(F(POSITION))
77722                      end if 
77724                   else 
77726                      let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
77728                      if POSITION>0 then 
77730                         let S_DATA$(OUTDEX)=F$(POSITION)
77732                      end if 
77734                   end if 
77736                else 
77738                   let S_DATA$(OUTDEX)=FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
77740                end if 
77742 ! 
77744 ! .            ! Apply Conversion in if possible
77746                if CNVRTIN$(INDEX)(1:1)="{" OR CNVRTIN$(INDEX)(1:1)="#" then 
77748                   let TEMPDATA$=S_DATA$(OUTDEX)
77750                   let FNCONVERTIN(TEMPDATA$,CNVRTIN$(INDEX),INDEX,OUTDEX)
77752                   if TEMPDATA$<>S_DATA$(OUTDEX) then let S_DATA$(OUTDEX)=TEMPDATA$
77754                else if LEN(TRIM$(CNVRTIN$(INDEX))) then 
77756                   let S_DATA$(OUTDEX)=TRIM$(CNVRT$(FNUNPACKCONVERTSPEC$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES),VAL(S_DATA$(OUTDEX)))) error IGNORE
77758                end if 
77760 ! 
77762 ! .           ! After 4.2 and Higher, we now have to check to ensure the image file exists because BR now gives error 760 if it doesnt.
77764 ! .           !  we have to do this in a painful and slow way in order to preserve the case of the file name while stripping off
77766 ! .           !  the optional image parameters that cause the exists function to fail
77768                if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="p" AND FN42 then 
77770                   let TEMPFILENAME$=S_DATA$(OUTDEX)
77772                   if POS(LWRC$(TEMPFILENAME$),":isotropic") then let TEMPFILENAME$=TEMPFILENAME$(1:POS(LWRC$(TEMPFILENAME$),":isotropic")-1)
77774                   if POS(LWRC$(TEMPFILENAME$),":noresize") then let TEMPFILENAME$=TEMPFILENAME$(1:POS(LWRC$(TEMPFILENAME$),":noresize")-1)
77776                   if POS(LWRC$(TEMPFILENAME$),":tile") then let TEMPFILENAME$=TEMPFILENAME$(1:POS(LWRC$(TEMPFILENAME$),":tile")-1)
77778                   if ~LEN(TRIM$(TEMPFILENAME$)) OR ~EXISTS(TEMPFILENAME$) then 
77780                      let S_DATA$(OUTDEX)=SETTING_IMAGEPATH$&"\nothing.gif"
77782                   end if 
77784                end if 
77786 ! 
77788                let SPECWIDTH(INDEX)=LEN(S_DATA$(OUTDEX))
77790 ! 
77792                let S_SPEC$(OUTDEX)=FNCALCULATESPEC$(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
77794                if (TRIM$(FUNCTION$(INDEX))="" OR PROTECTED(INDEX)) AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"button" then 
77796                   let S_SPEC$(OUTDEX)=S_SPEC$(OUTDEX)(1:POS(S_SPEC$(OUTDEX),",",-1)-1)&",-1"
77798                end if 
77800                if FORCEINDEX then 
77802                   if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="button" then 
77804                      let S_SPEC$(OUTDEX)=S_SPEC$(OUTDEX)(1:POS(S_SPEC$(OUTDEX),",",-1)-1)&",B"&STR$(FORCEINDEX)
77806                   else 
77808                      let S_SPEC$(OUTDEX)=S_SPEC$(OUTDEX)(1:POS(S_SPEC$(OUTDEX),",",-1)-1)&","&STR$(FORCEINDEX)
77810                   end if 
77812                end if 
77814 ! 
77816                let S_HELP$(OUTDEX)=FNCALCULATEHELP$(TOOLTIP$(INDEX))
77818                let CONTROLSPEC$(INDEX)=S_SPEC$(OUTDEX)
77820 ! 
77822             else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "search" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "combo" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "filter" then ! #Case# "c" # "search" # "combo" # "filter"
77824                if PROTECTED(INDEX) then ! Show Input Controls As Output Controls If They Are Protected.
77826                   let OUTDEX=UDIM(MAT S_DATA$)+1
77828                   mat S_DATA$(OUTDEX)
77830                   mat S_SPEC$(OUTDEX)
77832                   mat S_HELP$(OUTDEX)
77834 ! 
77836 ! .              ! Read from mat S$ if its S$, or F$ and F if its them. If its neither, leave it blank.
77838                   if TRIM$(FIELDNAME$(INDEX))="" AND TRIM$(CONTROLNAME$(INDEX))<>"" AND (SUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(INDEX)))))>0 then 
77840                      let S_DATA$(OUTDEX)=S$(SUBINDEX)
77842                   else if TRIM$(FIELDNAME$(INDEX))><"" then 
77844                      if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(INDEX)) then 
77846                         let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
77848                         if POSITION>0 then 
77850                            let S_DATA$(OUTDEX)=STR$(F(POSITION))
77852                         end if 
77854                      else 
77856                         let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
77858                         if POSITION>0 then 
77860                            let S_DATA$(OUTDEX)=F$(POSITION)
77862                         end if 
77864                      end if 
77866                   else 
77868                      let S_DATA$(OUTDEX)=""
77870                   end if 
77872 ! 
77874 !                 ! Apply Conversion From Disk
77876 ! .              ! Only implemented for Dates in C fields and Listview Children
77878                   if LWRC$(CNVRTOUT$(INDEX))(1:5)="date(" AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))="c" then 
77880                      if FNISDIGIT(S_DATA$(OUTDEX)) then 
77882                         let S_DATA$(OUTDEX)=STR$(DAYS(VAL(S_DATA$(OUTDEX)),FNDATEMASK$(CNVRTOUT$(INDEX)))) error IGNORE
77884                      else 
77886                         let S_DATA$(OUTDEX)=STR$(DAYS(S_DATA$(OUTDEX),FNDATEMASK$(CNVRTOUT$(INDEX)))) error IGNORE
77888                      end if 
77890                   end if 
77892 ! 
77894 ! .               ! Apply Conversion in if possible
77896                   if CNVRTIN$(INDEX)(1:1)="{" OR CNVRTIN$(INDEX)(1:1)="#" then 
77898                      let TEMPDATA$=S_DATA$(OUTDEX)
77900                      let FNCONVERTIN(TEMPDATA$,CNVRTIN$(INDEX),INDEX,OUTDEX)
77902                      if TEMPDATA$<>S_DATA$(OUTDEX) then let S_DATA$(OUTDEX)=TEMPDATA$
77904                   else if LEN(TRIM$(CNVRTIN$(INDEX))) then 
77906                      let S_DATA$(OUTDEX)=TRIM$(CNVRT$(FNUNPACKCONVERTSPEC$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES),VAL(S_DATA$(OUTDEX)))) error IGNORE
77908                   end if 
77910 ! .!
77912                   let S_SPEC$(OUTDEX)=FNCALCULATESPEC$(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
77914                   let S_HELP$(OUTDEX)=FNCALCULATEHELP$(TOOLTIP$(INDEX))
77916                   if FORCEINDEX then 
77918                      let S_SPEC$(OUTDEX)=S_SPEC$(OUTDEX)(1:POS(S_SPEC$(OUTDEX),",",-1)-1)&","&STR$(FORCEINDEX)
77920                   end if 
77922                   let CONTROLSPEC$(INDEX)=S_SPEC$(OUTDEX)
77924                end if 
77926 ! .!
77928             else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "check" then ! #Case# "check"
77930                if PROTECTED(INDEX) then ! Show Input Controls As Output Controls If They Are Protected.
77932                   let OUTDEX=UDIM(MAT S_DATA$)+1
77934                   mat S_DATA$(OUTDEX)
77936                   mat S_SPEC$(OUTDEX)
77938                   mat S_HELP$(OUTDEX)
77940 ! .   !
77942                   if TRIM$(FIELDNAME$(INDEX))="" AND TRIM$(CONTROLNAME$(INDEX))<>"" AND (SUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(INDEX)))))>0 then 
77944                      let S_DATA$(OUTDEX)=FNINCHECKED$(S$(SUBINDEX),TRUEVALUE$(INDEX))&FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
77946                      let SPECWIDTH(INDEX)=LEN(S_DATA$(OUTDEX))+1  !(1 For The Checkmark)
77948                   else 
77950                      if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(INDEX)) then 
77952                         let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
77954                         if POSITION>0 then 
77956                            let S_DATA$(OUTDEX)=FNINCHECKED$(STR$(F(POSITION)),TRUEVALUE$(INDEX))&FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
77958                         end if 
77960                      else 
77962                         let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
77964                         if POSITION>0 then 
77966                            let S_DATA$(OUTDEX)=FNINCHECKED$(F$(POSITION),TRUEVALUE$(INDEX))&FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
77968                         end if 
77970                      end if 
77972                   end if 
77974 ! .   !
77976                   let S_SPEC$(OUTDEX)=FNCALCULATESPEC$(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
77978                   let S_HELP$(OUTDEX)=FNCALCULATEHELP$(TOOLTIP$(INDEX))
77980                   if FORCEINDEX then 
77982                      let S_SPEC$(OUTDEX)=S_SPEC$(OUTDEX)(1:POS(S_SPEC$(OUTDEX),",",-1)-1)&","&STR$(FORCEINDEX)
77984                   end if 
77986                   let CONTROLSPEC$(INDEX)=S_SPEC$(OUTDEX)
77988                end if 
77990 ! 
77992             else ! #Case Else#
77994 ! .           ! Ignore all non-protected or Invisible controls
77996 ! 
77998             end if                    !#End Select#
78000          end if 
78002       next INDEX
78004    fnend 
78006 ! 
78008    def FNDATEMASK$*64(SPEC$*64;___,P)  !Pulls the Date Mask out of a Date Spec
78010       let SPEC$=TRIM$(SPEC$(6:70))
78012       let P=LEN(SPEC$)
78014       if SPEC$(P:P)=")" then let SPEC$=SPEC$(1:P-1)
78016       let FNDATEMASK$=SPEC$
78018    fnend 
78020 ! 
78022    def library FNISOUTPUTSPEC(TYPE$)=FNISOUTPUT(TYPE$)
78024    def FNISOUTPUT(TYPE$)
78026       if LWRC$(TRIM$(TYPE$)) = "caption" OR LWRC$(TRIM$(TYPE$)) = "button" OR LWRC$(TRIM$(TYPE$)) = "p" OR LWRC$(TRIM$(TYPE$)) = "frame" OR LWRC$(TRIM$(TYPE$)) = "screen" then ! #Select# lwrc$(trim$(type$)) #Case# "caption" # "button" # "p" # "frame" # "screen"
78028          let FNISOUTPUT=1
78030       else ! #Case Else#
78032          let FNISOUTPUT=0
78034       end if                          !#End Select#
78036    fnend 
78038 ! 
78040    def library FNISINPUTSPEC(TYPE$)=FNISINPUT(TYPE$)
78042    def FNISINPUT(TYPE$)
78044       if LWRC$(TRIM$(TYPE$)) = "c" OR LWRC$(TRIM$(TYPE$)) = "search" OR LWRC$(TRIM$(TYPE$)) = "check" OR LWRC$(TRIM$(TYPE$)) = "combo" OR LWRC$(TRIM$(TYPE$)) = "filter" then ! #Select# lwrc$(trim$(type$)) #Case# "c" # "search" # "check" # "combo" # "filter"
78046          let FNISINPUT=1
78048       else ! #Case Else#
78050          let FNISINPUT=0
78052       end if                          !#End Select#
78054    fnend 
78056 ! 
78058 Generateinputspecs: ! Generate The Specs For Input From All Io Controls
78060    def FNGENERATEINPUTSPECS(WINDOW,MAT S_DATA$,MAT S_DATA,MAT S_SPEC$,MAT S_SUBS,MAT S_HELP$,MAT S_OLD$,MAT F$,MAT F,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,&LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT CONTROLSPEC$;FORCEINDEX,MAT OTHERCHANGED_S_SUBS,___,INDEX,OUTDEX,SUBINDEX,POSITION,DATEFORMAT$,P)
78062 ! 
78064       mat S_DATA$(0) : mat S_SPEC$(0) : mat S_SUBS(0) : mat S_DATA(0) : mat S_HELP$(0)
78066       mat CONTROLSPEC$(UDIM(MAT CONTROLNAME$))
78068 ! 
78070       for INDEX=1 to UDIM(MAT CONTROLNAME$)  !Loop Once For Regular Fields
78072          if ~PROTECTED(INDEX) AND ~INVISIBLE(INDEX) then 
78074             if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "search" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "combo" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "filter" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "c" # "search" # "combo" # "filter"
78076                let OUTDEX=UDIM(MAT S_DATA$)+1
78078                mat S_DATA$(OUTDEX)
78080                mat S_SPEC$(OUTDEX)
78082                mat S_SUBS(OUTDEX)
78084                mat S_HELP$(OUTDEX)
78086 ! 
78088                if TRIM$(FIELDNAME$(INDEX))="" AND TRIM$(CONTROLNAME$(INDEX))<>"" AND (SUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(INDEX)))))>0 then 
78090                   let S_DATA$(OUTDEX)=S$(SUBINDEX)
78092                else 
78094                   if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(INDEX)) then 
78096                      let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
78098                      if POSITION>0 then 
78100                         let S_DATA$(OUTDEX)=STR$(F(POSITION))
78102                      end if 
78104                   else 
78106                      let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
78108                      if POSITION>0 then 
78110                         let S_DATA$(OUTDEX)=F$(POSITION)
78112                      end if 
78114                   end if 
78116                end if 
78118 ! 
78120 ! .            ! Apply Conversion From Disk
78122 ! .           ! Only implemented for Dates in C fields and Listview Children
78124                if LWRC$(CNVRTOUT$(INDEX))(1:5)="date(" AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))="c" then 
78126                   if FNISDIGIT(S_DATA$(OUTDEX)) then 
78128                      let S_DATA$(OUTDEX)=STR$(DAYS(VAL(S_DATA$(OUTDEX)),FNDATEMASK$(CNVRTOUT$(INDEX)))) error IGNORE
78130                   else 
78132                      let S_DATA$(OUTDEX)=STR$(DAYS(S_DATA$(OUTDEX),FNDATEMASK$(CNVRTOUT$(INDEX)))) error IGNORE
78134                   end if 
78136                end if 
78138 ! 
78140 ! .            ! Apply Conversion if possible...
78142                if CNVRTIN$(INDEX)(1:1)="{" OR CNVRTIN$(INDEX)(1:1)="#" then 
78144                   let TEMPDATA$=S_DATA$(OUTDEX)
78146                   let FNCONVERTIN(TEMPDATA$,CNVRTIN$(INDEX),INDEX,OUTDEX)
78148                   if TEMPDATA$<>S_DATA$(OUTDEX) then let S_DATA$(OUTDEX)=TEMPDATA$
78150                else if LEN(TRIM$(CNVRTIN$(INDEX))) then 
78152                   let S_DATA$(OUTDEX)=TRIM$(CNVRT$(FNUNPACKCONVERTSPEC$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES),VAL(S_DATA$(OUTDEX)))) error IGNORE
78154                end if 
78156 ! 
78158 ! 
78160                let S_SPEC$(OUTDEX)=FNCALCULATESPEC$(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,0,(SRCH(MAT OTHERCHANGED_S_SUBS,INDEX)>0))
78162                let S_SUBS(OUTDEX)=INDEX
78164                let S_HELP$(OUTDEX)=FNCALCULATEHELP$(TOOLTIP$(INDEX))
78166                if FORCEINDEX then 
78168                   let S_SPEC$(OUTDEX)=S_SPEC$(OUTDEX)(1:POS(S_SPEC$(OUTDEX),",",-1)-1)&","&STR$(FORCEINDEX)
78170                end if 
78172                let CONTROLSPEC$(INDEX)=S_SPEC$(OUTDEX)
78174 ! .!
78176             else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "check" then ! #Case# "check"
78178                let OUTDEX=UDIM(MAT S_DATA$)+1
78180                mat S_DATA$(OUTDEX)
78182                mat S_SPEC$(OUTDEX)
78184                mat S_SUBS(OUTDEX)
78186                mat S_HELP$(OUTDEX)
78188 ! .!
78190                if TRIM$(FIELDNAME$(INDEX))="" AND TRIM$(CONTROLNAME$(INDEX))<>"" AND (SUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(INDEX)))))>0 then 
78192                   let S_DATA$(OUTDEX)=FNINCHECKED$(S$(SUBINDEX),TRUEVALUE$(INDEX))&FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
78194                   let SPECWIDTH(INDEX)=LEN(S_DATA$(OUTDEX))+1  !(1 For The Checkmark)
78196                else 
78198                   if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(INDEX)) then 
78200                      let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
78202                      if POSITION>0 then 
78204                         let S_DATA$(OUTDEX)=FNINCHECKED$(STR$(F(POSITION)),TRUEVALUE$(INDEX))&FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
78206                      end if 
78208                   else 
78210                      let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(INDEX))))
78212                      if POSITION>0 then 
78214                         let S_DATA$(OUTDEX)=FNINCHECKED$(F$(POSITION),TRUEVALUE$(INDEX))&FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
78216                      end if 
78218                   end if 
78220                end if 
78222 ! .!
78224                let S_SPEC$(OUTDEX)=FNCALCULATESPEC$(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,0,(SRCH(MAT OTHERCHANGED_S_SUBS,INDEX)>0))
78226                let S_SUBS(OUTDEX)=INDEX
78228                let S_HELP$(OUTDEX)=FNCALCULATEHELP$(TOOLTIP$(INDEX))
78230                if FORCEINDEX then 
78232                   let S_SPEC$(OUTDEX)=S_SPEC$(OUTDEX)(1:POS(S_SPEC$(OUTDEX),",",-1)-1)&","&STR$(FORCEINDEX)
78234                end if 
78236 ! 
78238                let CONTROLSPEC$(INDEX)=S_SPEC$(OUTDEX)
78240 ! .!
78242             else ! #Case Else#
78244 ! .! .         Ignore All Output Controls
78246 ! .!
78248             end if                    !#End Select#
78250          end if 
78252       next INDEX
78254       for INDEX=1 to UDIM(MAT CONTROLNAME$)  !Loop Again For Listviews - They Must Come Last
78256          if ~PROTECTED(INDEX) AND ~INVISIBLE(INDEX) then 
78258             if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listview" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "listview"
78260                mat S_DATA(UDIM(MAT S_DATA)+1)
78262                mat S_SPEC$(UDIM(MAT S_SPEC$)+1)
78264 ! 
78266                let LISTVIEWINDEX=INDEX
78268                let S_SPEC$(UDIM(MAT S_SPEC$))=FNCALCULATELISTVIEWSPEC$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
78270                if MULTISELECT(INDEX) then 
78272                   let S_SPEC$(UDIM(MAT S_SPEC$))=S_SPEC$(UDIM(MAT S_SPEC$))&",ROWCNT,SEL"
78274                else 
78276                   let S_SPEC$(UDIM(MAT S_SPEC$))=S_SPEC$(UDIM(MAT S_SPEC$))&",ROWSUB,SELONE"
78278                end if 
78280                let CONTROLSPEC$(INDEX)=S_SPEC$(UDIM(MAT S_SPEC$))
78282 ! 
78284             else ! #Case Else#
78286 ! .            Ignore All other Controls
78288 ! 
78290             end if                    !#End Select#
78292          end if 
78294       next INDEX
78296       mat S_OLD$(UDIM(MAT S_DATA$))=S_DATA$
78298    fnend 
78300 ! 
78302    def FNINCHECKED$(TEST$*255,TRUEVALUE$*255)
78304       if TRIM$(TEST$)=TRIM$(TRUEVALUE$) then 
78306          let FNINCHECKED$="^"
78308       end if 
78310    fnend 
78312 ! 
78314    def FNOUTCHECKED$(TEST$*255,TRUEVALUE$*255,FALSEVALUE$*255,&RETURN$)
78316       if TEST$(1:1)="^" then 
78318          let RETURN$=TRUEVALUE$
78320       else 
78322          if LWRC$(TRIM$(FALSEVALUE$))<>"~ignore~" then 
78324             let RETURN$=FALSEVALUE$
78326          end if 
78328       end if 
78330    fnend 
78332 ! 
78334    dim TEMPDATA$*8000
78336 ! 
78338 Validateandsave: ! Validate And Save The Controls
78340    def FNVALIDATEANDSAVE(MAT S_DATA$,MAT S_SPEC$,MAT S_SUBS,MAT S_OLD$,MAT F$,MAT F,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,POSITION,SUBINDEX,RETURN$*255,NUMBER$*1000)
78342       for INDEX=1 to UDIM(MAT S_SUBS)
78344          if ~PROTECTED(S_SUBS(INDEX)) then ! Should Never Be Protected Because Protected Is Never Added To The Input In The First Place.
78346             if TRIM$(S_OLD$(INDEX))<>TRIM$(S_DATA$(INDEX)) then 
78348                if LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX)))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX)))) = "search" OR LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX)))) = "combo" OR LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX)))) = "filter" then ! #Select# Lwrc$(Trim$(Fieldtype$(S_Subs(Index)))) #Case# "c" # "search" # "combo" # "filter"
78350 ! .   ! .         ! First apply screencontrol validation to data value
78352                   let TEMPDATA$=S_DATA$(INDEX)
78354                   if TRIM$(FUNCTION$(S_SUBS(INDEX)))="" OR FNVALIDATECONTROL(TEMPDATA$,FUNCTION$(S_SUBS(INDEX)),INDEX,S_SUBS(INDEX)) then 
78356                      if TEMPDATA$<>S_DATA$(INDEX) then let S_DATA$(INDEX)=TEMPDATA$
78358                      if TRIM$(FIELDNAME$(S_SUBS(INDEX)))="" AND TRIM$(CONTROLNAME$(S_SUBS(INDEX)))<>"" AND (SUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(S_SUBS(INDEX))))))>0 then 
78360                         if UPRC$(CNVRTIN$(S_SUBS(INDEX))(1:5))="DATE(" AND POS(CNVRTIN$(S_SUBS(INDEX)),")")>0 then 
78362                            let NUMBER=FNCHECKDAYS(S_DATA$(INDEX),CNVRTIN$(S_SUBS(INDEX)))
78364                            if NUMBER then 
78366                               let S$(SUBINDEX)=STR$(NUMBER)
78368                            end if 
78370                         else 
78372                            let NUMBER$=S_DATA$(INDEX)
78374                            if UPRC$(CNVRTIN$(S_SUBS(INDEX))(1:4))="PIC(" AND POS(CNVRTIN$(S_SUBS(INDEX)),")")>0 then 
78376 ! .                          ! If its pic, we want to ignore all the insertion characters when we turn it back into a number.
78378                               let NUMBER$=FNUNCNVRT$(NUMBER$(1:255),CNVRTIN$(S_SUBS(INDEX)))
78380                            end if 
78382                            if FNENFORCENUMBER(CNVRTIN$(S_SUBS(INDEX))) then 
78384                               let NUMBER=VAL(NUMBER$) conv Ignorenumber_Sfield
78386                               let S$(SUBINDEX)=STR$(NUMBER)
78388 Ignorenumber_Sfield: ! Jump here when bad number entered
78390                            else 
78392                               let S$(SUBINDEX)=NUMBER$
78394                            end if 
78396                         end if 
78398 ! 
78400 ! .                    ! Apply Conversion To Disk
78402 ! .                    ! Only implemented for Dates in C fields and Listview Children
78404                         if LWRC$(CNVRTOUT$(S_SUBS(INDEX)))(1:5)="date(" AND LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX))))="c" then 
78406                            let S$(SUBINDEX)=DATE$(VAL(S$(SUBINDEX)),FNDATEMASK$(CNVRTOUT$(S_SUBS(INDEX)))) error IGNORE
78408                         end if 
78410 ! 
78412                      else 
78414                         if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(S_SUBS(INDEX))) then 
78416                            let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(S_SUBS(INDEX)))))
78418                            if POSITION>0 then 
78420                               if UPRC$(CNVRTIN$(S_SUBS(INDEX))(1:5))="DATE(" AND POS(CNVRTIN$(S_SUBS(INDEX)),")")>0 then 
78422                                  let NUMBER=FNCHECKDAYS(S_DATA$(INDEX),CNVRTIN$(S_SUBS(INDEX)))
78424                                  if NUMBER then 
78426                                     let F(POSITION)=NUMBER
78428                                  end if 
78430                               else 
78432                                  let NUMBER$=S_DATA$(INDEX)
78434                                  if UPRC$(CNVRTIN$(S_SUBS(INDEX))(1:4))="PIC(" AND POS(CNVRTIN$(S_SUBS(INDEX)),")")>0 then 
78436 ! .                                ! If its pic, we want to ignore all the insertion characters when we turn it back into a number.
78438                                     let NUMBER$=FNUNCNVRT$(NUMBER$(1:255),CNVRTIN$(S_SUBS(INDEX)))
78440                                  end if 
78442 ! 
78444                                  let NUMBER=VAL(NUMBER$) conv Ignorenumber
78446                                  let F(POSITION)=NUMBER
78448 Ignorenumber: ! Jump here when bad number entered
78450                               end if 
78452 ! 
78454 ! .                          ! Apply Conversion To Disk
78456 ! .                          ! Only implemented for Dates in C fields and Listview Children
78458                               if LWRC$(CNVRTOUT$(S_SUBS(INDEX)))(1:5)="date(" AND LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX))))="c" then 
78460                                  let F(POSITION)=DATE(F(POSITION),FNDATEMASK$(CNVRTOUT$(S_SUBS(INDEX)))) error IGNORE
78462                               end if 
78464 ! 
78466                            end if 
78468                         else 
78470                            let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(S_SUBS(INDEX)))))
78472                            if POSITION>0 then 
78474 ! 
78476 ! 
78478                               if UPRC$(CNVRTIN$(S_SUBS(INDEX))(1:5))="DATE(" AND POS(CNVRTIN$(S_SUBS(INDEX)),")")>0 then 
78480                                  let NUMBER=FNCHECKDAYS(S_DATA$(INDEX),CNVRTIN$(S_SUBS(INDEX)))
78482                                  if NUMBER then 
78484                                     let F$(POSITION)=STR$(NUMBER)
78486                                  end if 
78488                               else 
78490 ! 
78492                                  if UPRC$(CNVRTIN$(S_SUBS(INDEX))(1:4))="PIC(" AND POS(CNVRTIN$(S_SUBS(INDEX)),")")>0 then 
78494 ! .                                ! If its pic, we want to ignore all the insertion characters when we turn it back into a number.
78496                                     let S_DATA$(INDEX)=FNUNCNVRT$(S_DATA$(INDEX),CNVRTIN$(S_SUBS(INDEX)))
78498                                  end if 
78500 ! 
78502                                  if FNENFORCENUMBER(CNVRTIN$(S_SUBS(INDEX))) then 
78504                                     let NUMBER=VAL(S_DATA$(INDEX)) conv Ignorenumber_Instring
78506                                     let F$(POSITION)=STR$(NUMBER)
78508 Ignorenumber_Instring: ! Jump here when bad number entered
78510                                  else 
78512                                     let F$(POSITION)=S_DATA$(INDEX)
78514                                  end if 
78516                               end if 
78518 ! 
78520 ! .                          ! Apply Conversion To Disk
78522 ! .                          ! Only implemented for Dates in C fields and Listview Children
78524                               if LWRC$(CNVRTOUT$(S_SUBS(INDEX)))(1:5)="date(" AND LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX))))="c" then 
78526                                  let F$(POSITION)=DATE$(VAL(F$(POSITION)),FNDATEMASK$(CNVRTOUT$(S_SUBS(INDEX)))) error IGNORE
78528                               end if 
78530 ! 
78532                            end if 
78534                         end if 
78536                      end if 
78538                   else 
78540                      if TEMPDATA$<>S_DATA$(INDEX) then let S_DATA$(INDEX)=TEMPDATA$
78542                   end if 
78544                else if LWRC$(TRIM$(FIELDTYPE$(S_SUBS(INDEX)))) = "check" then ! #Case# "check"
78546                   let TEMPDATA$=S_DATA$(INDEX)
78548                   if TRIM$(FUNCTION$(S_SUBS(INDEX)))="" OR FNVALIDATECONTROL(TEMPDATA$,FUNCTION$(S_SUBS(INDEX)),INDEX,S_SUBS(INDEX)) then 
78550                      if TEMPDATA$<>S_DATA$(INDEX) then let S_DATA$(INDEX)=TEMPDATA$
78552                      if TRIM$(FIELDNAME$(S_SUBS(INDEX)))="" AND TRIM$(CONTROLNAME$(S_SUBS(INDEX)))<>"" AND (SUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(S_SUBS(INDEX))))))>0 then 
78554                         let FNOUTCHECKED$(S_DATA$(INDEX),TRUEVALUE$(S_SUBS(INDEX)),FALSEVALUE$(S_SUBS(INDEX)),S$(SUBINDEX))
78556                      else 
78558 ! 
78560                         if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(S_SUBS(INDEX))) then 
78562                            let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(S_SUBS(INDEX)))))
78564                            if POSITION>0 then 
78566                               let RETURN$=STR$(F(POSITION))
78568                               let FNOUTCHECKED$(S_DATA$(INDEX),TRUEVALUE$(S_SUBS(INDEX)),FALSEVALUE$(S_SUBS(INDEX)),RETURN$)
78570                               let F(POSITION)=FNRETURNVALUE(RETURN$)
78572                            end if 
78574                         else 
78576                            let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(S_SUBS(INDEX)))))
78578                            if POSITION>0 then 
78580                               let FNOUTCHECKED$(S_DATA$(INDEX),TRUEVALUE$(S_SUBS(INDEX)),FALSEVALUE$(S_SUBS(INDEX)),F$(POSITION))
78582                            end if 
78584                         end if 
78586                      end if 
78588                   else 
78590                      if TEMPDATA$<>S_DATA$(INDEX) then let S_DATA$(INDEX)=TEMPDATA$
78592                   end if 
78594 ! .   !
78596                else ! #Case Else#
78598 ! .   ! .         Ignore All Output Controls
78600 ! .   !
78602                end if                 !#End Select#
78604             end if 
78606          end if 
78608       next INDEX
78610    fnend 
78612 ! 
78614    def FNENFORCENUMBER(CNVRTIN$*255)
78616       let CNVRTIN$=UPRC$(TRIM$(CNVRTIN$))
78618       if CNVRTIN$="N" OR CNVRTIN$(1:2)="N " then 
78620          let FNENFORCENUMBER=1
78622       end if 
78624    fnend 
78626 ! 
78628    def FNUNCNVRT$*255(NUMBER$*255,PICSPEC$*255;___,CHECKFOR$*255,CONTAINSB,CONTAINSD,CONTAINSS,CONTAINSPM,INDEX)
78630       if POS(UPRC$(CHECKFOR$),"B") then let CONTAINSB=1
78632       if POS(UPRC$(CHECKFOR$),"D") then let CONTAINSD=1
78634 ! .  ! if pos(uprc$(CheckFor$),"$") then let ContainsS=1
78636 ! .  ! if pos(uprc$(CheckFor$),"-") then let ContainsPM=1
78638 ! .  ! if pos(uprc$(CheckFor$),"+") then let ContainsPM=1
78640 ! 
78642       let CHECKFOR$=PICSPEC$(5:POS(PICSPEC$,")")-1)
78644       let CHECKFOR$=SREP$(CHECKFOR$,"Z","")
78646       let CHECKFOR$=SREP$(CHECKFOR$,"z","")
78648       let CHECKFOR$=SREP$(CHECKFOR$,".","")
78650       let CHECKFOR$=SREP$(CHECKFOR$,"#","")
78652       let CHECKFOR$=SREP$(CHECKFOR$,"-","")
78654       let CHECKFOR$=SREP$(CHECKFOR$,"^","")
78656       let CHECKFOR$=SREP$(CHECKFOR$,"B","")
78658       let CHECKFOR$=SREP$(CHECKFOR$,"b","")
78660       let CHECKFOR$=SREP$(CHECKFOR$,"D","")
78662       let CHECKFOR$=SREP$(CHECKFOR$,"d","")
78664       let CHECKFOR$=TRIM$(CHECKFOR$)
78666       let NUMBER$=TRIM$(NUMBER$)
78668 ! 
78670       for INDEX=1 to LEN(CHECKFOR$)
78672          let NUMBER$=SREP$(NUMBER$,CHECKFOR$(INDEX:INDEX),"")
78674       next INDEX
78676 ! 
78678       if CONTAINSB then let NUMBER$=SREP$(NUMBER$," ","")
78680       if CONTAINSD then let NUMBER$=SREP$(NUMBER$,"-","")
78682 ! 
78684 ! .  ! Right now we're handling $,+,- in another way, but this other way has the problem mentioned below.
78686 ! .  ! if ContainsS then let Number$=srep$(Number$,"$","")
78688 ! .  ! if ContainsPM then
78690 ! .  !    if pos(Number$,"-") then
78692 ! .  !       let Number$="-"&srep$(Number$,"-","")
78694 ! .  !    end if
78696 ! .  !    let Number$=srep$(Number$,"+","")
78698 ! .  ! end if
78700 ! .  ! $$$$$ The above code won't work when pic forces display of a trailing sign. This logic will still think the trailing sign was an operator error.
78702 ! 
78704       let FNUNCNVRT$=NUMBER$
78706    fnend 
78708 ! 
78710 ! 
78712 Convertin: ! Call Custom Conversion Functions
78714    def FNCONVERTIN(&FIELDTEXT$,FUNCTION$*255;CONTROLINDEX,FIELDINDEX)
78716       let FNCONVERTIN=FNEXECUTE(FUNCTION$,CONTROLINDEX,FIELDTEXT$,FIELDINDEX)
78718    fnend 
78720 ! 
78722 Validatecontrol: ! Validate A Control Based On Its Validation Routine Or Function Routine
78724    def FNVALIDATECONTROL(&DATA$,VALIDATEFUNCTION$*255;FIELDINDEX,CONTROLINDEX)
78726       if VALIDATEFUNCTION$(1:1)="|" then 
78728 ! .      ! Preform Predefined Validation Routines Here
78730       else 
78732          let FNVALIDATECONTROL=FNEXECUTE(VALIDATEFUNCTION$,CONTROLINDEX,DATA$,FIELDINDEX)
78734       end if 
78736    fnend 
78738 ! 
78740 Passfilter: ! Test To See If This Record Passes The Filter For A Listview
78742    def FNPASSFILTER$(MAT F$, MAT F,FILTERFUNCTION$*255;CONTROLINDEX)
78744       if LEN(TRIM$(FILTERFUNCTION$)) then 
78746          let FNPASSFILTER$=FNEXECUTE$(FILTERFUNCTION$,CONTROLINDEX)
78748       else 
78750          let FNPASSFILTER$="1"
78752       end if 
78754    fnend 
78756 ! 
78758 Isnumber: ! Returns True If Control Is A Number
78760    def FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$*50)
78762       if SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$)))>0 then 
78764          let FNISNUMBER=1
78766       end if 
78768    fnend 
78770 ! 
78772 ! ************************************************
78774 ! *   Date Parser Routine - BR's is too picky    *
78776 ! ************************************************
78778 ! 
78780    def library FNDAYS(STRING$*255;DATESPEC$*255)
78782       let FNDAYS=FNCHECKDAYS(STRING$,DATESPEC$)
78784    fnend 
78786 ! 
78788    dim NUMBER(3)
78790    dim FORMAT(3)
78792    dim ORDER(3)
78794    dim DATES(3)
78796    dim F_DAY, F_MONTH, F_YEAR
78798 ! 
78800    def FNCHECKDAYS(STRING$*255;DATESPEC$*255,___,MONTH,DAY,YEAR,DELIMIT$,I,NUMBER,FAILED,FORCEYEAR,TEMPSPEC$*255,TEMP$*255,TEMPNUM,TEMPMONTH,TEMPYEAR,TESTYEAR)  !Function to extract the date value out of a text file
78802 ! .  ! Thank you CLS for the idea to do relative days with + and -
78804       if STRING$(1:1) = "-" then ! #Select# String$(1:1) #Case# "-"
78806          let TEMP$=TRIM$(LWRC$(STRING$))
78808          let TEMPNUM=-123456789
78810          let TEMPNUM=VAL(TEMP$(2:LEN(TEMP$)-1)) conv IGNORE
78812          if TEMPNUM><-123456789 then 
78814             let TEMP$=TEMP$(LEN(TEMP$):LEN(TEMP$))
78816 ! 
78818             if TEMP$="w" then 
78820                let FNCHECKDAYS=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")-(TEMPNUM*7) conv IGNORE
78822             else if TEMP$="y" then 
78824                let FNCHECKDAYS=DAYS(DATE$("mm/dd")&"/"&STR$(VAL(DATE$("ccyy"))-TEMPNUM),"mm/dd/ccyy") conv IGNORE
78826             else if TEMP$="m" then 
78828                let TEMPYEAR=VAL(DATE$("ccyy"))
78830 ! 
78832                let TEMPMONTH=VAL(DATE$("mm"))
78834                let TEMPMONTH-=TEMPNUM
78836                if TEMPMONTH<1 then let TEMPMONTH+=12 : let TEMPYEAR-=1
78838 ! 
78840                let FNCHECKDAYS=DAYS(CNVRT$("PIC(##)",TEMPMONTH)&"/"&DATE$("dd")&"/"&STR$(TEMPYEAR),"mm/dd/ccyy") conv IGNORE
78842             else if TEMP$="d" then 
78844                let FNCHECKDAYS=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")-TEMPNUM conv IGNORE
78846             else 
78848                let FNCHECKDAYS=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")-VAL(STRING$(2:999)) conv IGNORE
78850             end if 
78852          end if 
78854       else if STRING$(1:1) = "+" then ! #Case# "+"
78856          let TEMP$=TRIM$(LWRC$(STRING$))
78858          let TEMPNUM=-123456789
78860          let TEMPNUM=VAL(TEMP$(2:LEN(TEMP$)-1)) conv IGNORE
78862          if TEMPNUM><-123456789 then 
78864             let TEMP$=TEMP$(LEN(TEMP$):LEN(TEMP$))
78866 ! 
78868             if TEMP$="w" then 
78870                let FNCHECKDAYS=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")+(TEMPNUM*7) conv IGNORE
78872             else if TEMP$="y" then 
78874                let FNCHECKDAYS=DAYS(DATE$("mm/dd")&"/"&STR$(VAL(DATE$("ccyy"))+TEMPNUM),"mm/dd/ccyy") conv IGNORE
78876             else if TEMP$="m" then 
78878                let TEMPYEAR=VAL(DATE$("ccyy"))
78880 ! 
78882                let TEMPMONTH=VAL(DATE$("mm"))
78884                let TEMPMONTH+=TEMPNUM
78886                if TEMPMONTH>12 then let TEMPMONTH-=12 : let TEMPYEAR+=1
78888 ! 
78890                let FNCHECKDAYS=DAYS(CNVRT$("PIC(##)",TEMPMONTH)&"/"&DATE$("dd")&"/"&STR$(TEMPYEAR),"mm/dd/ccyy") conv IGNORE
78892             else if TEMP$="d" then 
78894                let FNCHECKDAYS=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")+TEMPNUM conv IGNORE
78896             else 
78898                let FNCHECKDAYS=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")+VAL(STRING$(2:999)) conv IGNORE
78900             end if 
78902          end if 
78904       else ! #Case Else#
78906          let F_DAY=1
78908          let F_MONTH=2
78910          let F_YEAR=3
78912 ! 
78914          let NOT_READ=-1
78916          let NOT_GIVEN=-2
78918 ! 
78920          mat NUMBER(3)
78922          mat ORDER(3)
78924 ! 
78926 ! .     ! Detect order of date spec
78928          if POS(DATESPEC$,"(") AND POS(DATESPEC$,")") then 
78930             let DATESPEC$=UPRC$(DATESPEC$(POS(DATESPEC$,"(")+1:POS(DATESPEC$,")")-1))  !Trim out Parens
78932             let TEMPSPEC$=SREP$(DATESPEC$,"DAY","")  !Ignore Day Spec
78934             let FORMAT(F_MONTH)=POS(TEMPSPEC$,"M")
78936             let FORMAT(F_DAY)=POS(TEMPSPEC$,"D")
78938             let FORMAT(F_YEAR)=POS(TEMPSPEC$,"Y")
78940          else 
78942 ! .        ! default to month, day, year
78944             let FORMAT(F_MONTH)=1
78946             let FORMAT(F_DAY)=4
78948             let FORMAT(F_YEAR)=7
78950          end if 
78952 ! 
78954 ! .     ! Sort them to get relative order
78956          mat ORDER=AIDX(FORMAT)
78958 ! 
78960 ! .     ! Consolidate them, we don't care about ones that weren't there
78962          let FNCONSOLIDATEBLANKS(MAT ORDER,MAT FORMAT)
78964 ! 
78966          mat DATES=(NOT_GIVEN)
78968 ! 
78970 ! .     ! Detect Delimiter used, if any
78972          if POS(STRING$,"/") then 
78974             let DELIMIT$="/"
78976          else if POS(STRING$,"-") then 
78978             let DELIMIT$="-"
78980          else if POS(STRING$,",") then 
78982             let DELIMIT$=","
78984          else if POS(STRING$,".") then 
78986             let DELIMIT$="."
78988          end if 
78990 ! 
78992 ! .     ! Are there delimiters?
78994          if POS(STRING$,DELIMIT$) then ! There are. So check if theres a year
78996 ! 
78998             let STRING$=TRIM$(STRING$)
79000             mat NUMBER=(NOT_READ)
79002 ! 
79004             if POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1) then 
79006 ! .           ! There are three delimiters
79008                let NUMBER(1)=VAL(STRING$(1:POS(STRING$,DELIMIT$)-1)) conv IGNORE
79010                let NUMBER(2)=VAL(STRING$(POS(STRING$,DELIMIT$)+1:POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)-1)) conv IGNORE
79012                let NUMBER(3)=VAL(STRING$(POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)+1:LEN(STRING$))) conv IGNORE
79014                if NUMBER(3)=NOT_READ then 
79016                   let NUMBER(3)=VAL(STRING$(POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)+1:POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)+4)) conv IGNORE
79018                end if 
79020                if NUMBER(3)=NOT_READ then 
79022                   let NUMBER(3)=VAL(STRING$(POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)+1:POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)+2)) conv IGNORE
79024                end if 
79026                if NUMBER(3)=NOT_READ then 
79028                   let NUMBER(3)=VAL(STRING$(POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)+1:POS(STRING$,DELIMIT$,POS(STRING$,DELIMIT$)+1)+1)) conv IGNORE
79030                end if 
79032             else 
79034 ! .           ! There are only 2 values
79036                let NUMBER(1)=VAL(STRING$(1:POS(STRING$,DELIMIT$)-1)) conv IGNORE
79038                let NUMBER(2)=VAL(STRING$(POS(STRING$,DELIMIT$)+1:LEN(STRING$))) conv IGNORE
79040                if NUMBER(2)=NOT_READ then 
79042                   let NUMBER(2)=VAL(STRING$(POS(STRING$,DELIMIT$)+1:POS(STRING$,DELIMIT$)+4)) conv IGNORE
79044                end if 
79046                if NUMBER(2)=NOT_READ then 
79048                   let NUMBER(2)=VAL(STRING$(POS(STRING$,DELIMIT$)+1:POS(STRING$,DELIMIT$)+2)) conv IGNORE
79050                end if 
79052                if NUMBER(2)=NOT_READ then 
79054                   let NUMBER(2)=VAL(STRING$(POS(STRING$,DELIMIT$)+1:POS(STRING$,DELIMIT$)+1)) conv IGNORE
79056                end if 
79058                let NUMBER(3)=NOT_GIVEN
79060             end if 
79062 ! 
79064 ! .        ! Here, we go from mat Number to Year Month and Day
79066             for I=1 to UDIM(MAT NUMBER)
79068                if NUMBER(I)=NOT_READ then 
79070                   let FAILED=1
79072                end if 
79074                if NUMBER(I)>1800 then 
79076                   let FORCEYEAR=I
79078                end if 
79080             next I
79082 ! 
79084             if ~FAILED then 
79086                if FORCEYEAR then 
79088 ! .              ! if any of them are greater then 1800 then its a year
79090 ! .              ! so ignore order given and suck year up as a year
79092                   let DATES(F_YEAR)=NUMBER(FORCEYEAR)
79094                   let FNCONSOLIDATEDIRECT(MAT NUMBER,FORCEYEAR)
79096                   let FNCONSOLIDATECHILD(MAT ORDER,F_YEAR)
79098                end if 
79100 ! 
79102 ! .           ! take the remaining values from their given places
79104                for I=1 to UDIM(MAT ORDER)
79106                   let DATES(ORDER(I))=NUMBER(I)
79108                next I
79110             end if 
79112          else 
79114 ! .        ! There are no delimiters, so do it by position
79116             let NUMBER=NOT_READ
79118             let STRING$=TRIM$(STRING$(1:8))
79120             let NUMBER=VAL(STRING$) conv IGNORE
79122             if NUMBER=NOT_READ then 
79124                let FAILED=1
79126             end if 
79128 ! 
79130             if ~FAILED then 
79132                if MOD(LEN(STRING$),2) then let STRING$="0"&STRING$  !Make string an even length
79134                if LEN(STRING$)=2 then ! 1 number given
79136                   if UDIM(ORDER)>1 then ! if there's more then one needed
79138                      let FAILED=1     !we failed
79140                   else ! otherwise use the number
79142                      let DATES(ORDER(1))=VAL(STRING$)
79144                   end if 
79146                else if LEN(STRING$)=4 then ! 2 nums or a year
79148                   if UDIM(ORDER)=1 AND ORDER(1)=F_YEAR then ! if we only gave them a year
79150                      let DATES(F_YEAR)=VAL(STRING$)  !then its a year
79152                   else if UDIM(ORDER)=2 then ! if we gave them 2 numbers
79154                      let DATES(ORDER(1))=VAL(STRING$(1:2))
79156                      let DATES(ORDER(2))=VAL(STRING$(3:4))
79158                   else 
79160                      let FAILED=1
79162                   end if 
79164                else if LEN(STRING$)=6 then ! 3 nums or 1 nums and a year
79166                   if UDIM(ORDER)=2 AND (ORDER(1)=F_YEAR OR ORDER(2)=F_YEAR) then ! 1 num and 1 year
79168                      if ORDER(1)=F_YEAR then 
79170                         let DATES(ORDER(1))=VAL(STRING$(1:4))
79172                         let DATES(ORDER(2))=VAL(STRING$(5:6))
79174                      else if ORDER(2)=F_YEAR then 
79176                         let DATES(ORDER(1))=VAL(STRING$(1:2))
79178                         let DATES(ORDER(2))=VAL(STRING$(3:6))
79180                      end if 
79182                   else if UDIM(ORDER)=3 then 
79184                      let DATES(ORDER(1))=VAL(STRING$(1:2))
79186                      let DATES(ORDER(2))=VAL(STRING$(3:4))
79188                      let DATES(ORDER(3))=VAL(STRING$(5:6))
79190                   else 
79192                      let FAILED=1
79194                   end if 
79196                else if LEN(STRING$)=8 then 
79198                   if UDIM(MAT ORDER)=3 then 
79200                      if ORDER(1)=F_YEAR then 
79202                         let DATES(ORDER(1))=VAL(STRING$(1:4))
79204                         let DATES(ORDER(2))=VAL(STRING$(5:6))
79206                         let DATES(ORDER(3))=VAL(STRING$(7:8))
79208                      else if ORDER(2)=F_YEAR then 
79210                         let DATES(ORDER(1))=VAL(STRING$(1:2))
79212                         let DATES(ORDER(2))=VAL(STRING$(3:6))
79214                         let DATES(ORDER(3))=VAL(STRING$(7:8))
79216                      else if ORDER(3)=F_YEAR then 
79218                         let DATES(ORDER(1))=VAL(STRING$(1:2))
79220                         let DATES(ORDER(2))=VAL(STRING$(3:4))
79222                         let DATES(ORDER(3))=VAL(STRING$(5:8))
79224                      end if 
79226                   else 
79228                      let FAILED=1
79230                   end if 
79232                else 
79234                   let FAILED=1
79236                end if 
79238             end if 
79240          end if 
79242 ! 
79244          if ~FAILED then 
79246 ! .        ! if Day or month aren't given, default them
79248             if DATES(F_MONTH)<1 then let DATES(F_MONTH)=VAL(DATE$("mm"))
79250             if DATES(F_DAY)<1 then let DATES(F_DAY)=1
79252 ! 
79254             if DATES(F_YEAR)=NOT_GIVEN then 
79256 ! .           ! if they didn't give a year, then use closest year
79258                let DATES(F_YEAR)=FNFINDCLOSESTYEAR(DATES(F_MONTH),DATES(F_DAY))
79260             else if DATES(F_YEAR)>=0 AND DATES(F_YEAR)<100 then 
79262 ! .           ! if they gave a 2 digit year then use BR's internal function to turn it into a 4 digit year
79264                let DATES(F_YEAR)=VAL(DATE$(DAYS(CNVRT$("pic(##)",DATES(F_YEAR)),"yy"),"ccyy"))
79266             end if 
79268 ! 
79270             let FNCHECKDAYS=DAYS(CNVRT$("pic(##)",DATES(F_MONTH))&"/"&CNVRT$("pic(##)",DATES(F_DAY))&"/"&CNVRT$("pic(####)",DATES(F_YEAR)),"mm/dd/ccyy") conv IGNORE
79272          else 
79274             let FNCHECKDAYS=DAYS(STRING$,DATESPEC$) error IGNORE
79276          end if 
79278       end if                          !#End Select#
79280    fnend 
79282 ! 
79284 ! .! Tries to make a date using prior year, current year, and next year, and returns the one closest to today.
79286    def FNFINDCLOSESTYEAR(MONTH,DAY;___,TESTDATE,Y,YEAR,DIFFERENCE,BESTDATE,BESTYEAR,TODAY)
79288       let YEAR=VAL(DATE$("ccyy"))
79290       let TODAY=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")
79292       for Y=YEAR-1 to YEAR+1
79294          let TESTDATE=DAYS(STR$(DAY)&"/"&STR$(MONTH)&"/"&STR$(Y),"dd/mm/ccyy")
79296          if ABS(TODAY-TESTDATE)<ABS(TODAY-BESTDATE) then 
79298             let BESTDATE=TESTDATE
79300             let BESTYEAR=Y
79302          end if 
79304       next Y
79306       if ~BESTYEAR then let BESTYEAR=YEAR
79308       let FNFINDCLOSESTYEAR=BESTYEAR
79310    fnend 
79312 ! 
79314    def FNCONSOLIDATEBLANKS(MAT ORDER,MAT FORMAT;___,I,J)
79316       for I=1 to UDIM(MAT ORDER)
79318          if FORMAT(ORDER(I)) then 
79320             let ORDER(I-J)=ORDER(I)
79322          else 
79324             let J+=1
79326          end if 
79328       next I
79330       mat ORDER((I-1)-J)
79332    fnend 
79334    def FNCONSOLIDATEDIRECT(MAT ARRAY,NUMBER;___,I,J)
79336       for I=1 to UDIM(MAT ARRAY)
79338          if I<>NUMBER then 
79340             let ARRAY(I-J)=ARRAY(I)
79342          else 
79344             let J+=1
79346          end if 
79348       next I
79350       mat ARRAY((I-1)-J)
79352    fnend 
79354    def FNCONSOLIDATEDIRECTS(MAT ARRAY$,NUMBER;___,I,J)
79356       for I=1 to UDIM(MAT ARRAY$)
79358          if I<>NUMBER then 
79360             let ARRAY$(I-J)=ARRAY$(I)
79362          else 
79364             let J+=1
79366          end if 
79368       next I
79370       mat ARRAY$((I-1)-J)
79372    fnend 
79374    def FNCONSOLIDATECHILD(MAT ARRAY,NUMBER;___,I,J)
79376       for I=1 to UDIM(MAT ARRAY)
79378          if ARRAY(I)<>NUMBER then 
79380             let ARRAY(I-J)=ARRAY(I)
79382          else 
79384             let J+=1
79386          end if 
79388       next I
79390       mat ARRAY((I-1)-J)
79392    fnend 
79394 ! 
79396    def FNOPENSTICKY(INDEX,TEXT$*1000,&WINDOW,CONTROL,ROWS,COLS,ROW,COL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,R,C,H,W,COLOR$*255,SUNKEN$,SPEC$*255)  !Open yellow sticky note on the screen
79398       let R=VPOSITION(CONTROL)+1
79400       let C=HPOSITION(CONTROL)+2
79402       let H=HEIGHT(CONTROL)
79404       let W=WIDTH(CONTROL)
79406 ! 
79408       let R+=ROW-1
79410       let C+=COL-1
79412 ! 
79414       if R+H-1>ROWS then let R=ROWS-H+1
79416       if R<0 then 
79418          let H+=(R-1)
79420          let R=1
79422       end if 
79424       if C+W-1>COLS then let C=COLS-W+1
79426       if C<0 then 
79428          let W+=(C-1)
79430          let C=1
79432       end if 
79434 ! 
79436       if LEN(TRIM$(SCREENIO$(SI_MYCHANGES))) then 
79438          let COLOR$=TRIM$(SCREENIO$(SI_MYCHANGES))
79440       else 
79442          let COLOR$="/#000000:#FFFF00"
79444       end if 
79446       if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="c" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="search" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="filter" then let SUNKEN$="S"
79448 ! 
79450       open #(WINDOW:=FNGETFILENUMBER): "SRow="&STR$(R)&",scol="&STR$(C)&",rows="&STR$(MAX(1,H))&",cols="&STR$(W),display,outin 
79452       let SPEC$="1,1,"&FNCALCULATEFIELDTYPE$(FIELDTYPE$(CONTROL),JUSTIFY$(CONTROL),W,SPECWIDTH(CONTROL),H,ATTR$(CONTROL))&","&SUNKEN$&COLOR$&","&STR$(FNSTICKYBASE+INDEX)
79454       print #WINDOW, fields SPEC$ : TEXT$
79456    fnend 
79458 ! 
79460    def FNCLOSEALLSTICKIES(MAT WINDOWS, MAT SUBS, MAT DATA$;___,INDEX)
79462       for INDEX=1 to UDIM(MAT WINDOWS)
79464          close #WINDOWS(INDEX): 
79466       next INDEX
79468       mat WINDOWS(0)
79470       mat SUBS(0)
79472       mat DATA$(0)
79474    fnend 
79476 ! 
79478 Respondtouseraction: ! Respond To The Users Action Here, Setting Exitmode If Necessary
79480    def FNRESPONDTOUSERACTION(FUNCTION,&EXITMODE,&CURRENTFIELD,&CURRENTFIELD$,MAT SUBS,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;WINDOW,SAVEDONTASK,___,KEYVAL$*255,RECORDVAL,PARENT_KEY$*255,DUMMY$*255,DUMMY,LOOPAGAIN,CONTROL)
79482 ! 
79484 ! .   ! Esc Button
79486       if FUNCTION=99 then 
79488          if ~FNSEARCHCLOSELY(MAT FUNCTION$,"exitmode","quitonly") then 
79490             if FNTHERESALISTVIEW(MAT FIELDTYPE$) then 
79492                let EXITMODE=QUITONLY
79494             else 
79496                if SAVEDONTASK then 
79498                   let EXITMODE=SAVEANDQUIT
79500                else 
79502                   let EXITMODE=ASKSAVEANDQUIT
79504                end if 
79506             end if 
79508          end if 
79510       end if 
79512 ! 
79514       if FUNCTION=0 then 
79516          if FNTHERESALISTVIEW(MAT FIELDTYPE$) then 
79518             let EXITMODE=SELECTANDQUIT
79520          end if 
79522       end if 
79524 ! 
79526       do 
79528          let LOOPAGAIN=0
79530          if FUNCTION<FNKEYBASE AND FUNCTION>FNBASE then 
79532 ! .        ! Go back up a level
79534             if FNTHERESALISTVIEW(MAT FIELDTYPE$) then 
79536                let EXITMODE=SELECTANDQUIT
79538             else 
79540                if SAVEDONTASK then 
79542                   let EXITMODE=SAVEANDQUIT
79544                else 
79546                   let EXITMODE=ASKSAVEANDQUIT
79548                end if 
79550             end if 
79552          end if 
79554 ! 
79556          if FUNCTION>FNKEYBASE AND FUNCTION<=FNKEYBASE+UDIM(MAT CONTROLNAME$) then 
79558             let CONTROL=FUNCTION-FNKEYBASE
79560             if ~PROTECTED(CONTROL) AND TRIM$(FNREMOVEPROTECTEDATTRIBUTE$(ATTR$(CONTROL)))=TRIM$(ATTR$(CONTROL)) then 
79562 ! 
79564                if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "caption" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "p" then ! #Select# Lwrc$(Trim$(Fieldtype$(Control))) #Case# "button" # "caption" # "p"
79566                   if TRIM$(FUNCTION$(CONTROL))<>"" then 
79568                      let FNEXECUTE(FUNCTION$(CONTROL),CONTROL)
79570                   end if 
79572                else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "c" then ! #Case# "c"
79574                   if (NEWFIELD:=SRCH(MAT SUBS,CONTROL))>0 then 
79576                      let CURRENTFIELD=NEWFIELD
79578                   end if 
79580                else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "search" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "filter" then ! #Case# "search" # "filter"
79582                   let EXITMODE=SELECTANDQUIT  !This makes "enter" on search box exit
79584 ! 
79586                else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "screen" then ! #Case# "screen"
79588 ! .              ! if trim$(Function$(Control))<>"" then
79590                   let DUMMY$="["&FIELDNAME$(CONTROL)&"]"&FUNCTION$(CONTROL)
79592                   let FNPARSESCREENINFO(DUMMY$,KEYVAL$,PARENT_KEY$,DUMMY,DUMMY,DUMMY,DUMMY,DUMMY,RECORDVAL,PARENTKEY$)
79594                   let SCR_FREEZE
79596                   let FNMASTER$(FIELDNAME$(CONTROL),KEYVAL$,VPOSITION(CONTROL),HPOSITION(CONTROL),PARENT_KEY$,WINDOW,0,0,RECORDVAL,PATH$)
79598                   let SCR_FREEZE
79600                   let FNMASTER$(FIELDNAME$(CONTROL),KEYVAL$,VPOSITION(CONTROL),HPOSITION(CONTROL),PARENT_KEY$,WINDOW,1,0,RECORDVAL,PATH$,0,0,FUNCTION)
79602 ! .              ! end if
79604                else ! #Case Else#
79606 ! .! .            ! Ignore other control types
79608 ! .!
79610                end if                 !#End Select#
79612 ! 
79614                if FKEY<>FUNCTION then 
79616                   let FUNCTION=FKEY
79618                   let LOOPAGAIN=1
79620                end if 
79622             end if 
79624          end if 
79626       loop WHILE LOOPAGAIN
79628 ! 
79630       if FUNCTION=93 OR FKEY=93 then 
79632          if FNTHERESALISTVIEW(MAT FIELDTYPE$) then 
79634             let EXITMODE=QUITONLY
79636          else 
79638             if SAVEDONTASK then 
79640                let EXITMODE=SAVEANDQUIT
79642             else 
79644                let EXITMODE=ASKSAVEANDQUIT
79646             end if 
79648          end if 
79650       end if 
79652 ! 
79654       if FUNCTION=92 OR FKEY=92 then 
79656          if FNTHERESALISTVIEW(MAT FIELDTYPE$) then 
79658             let EXITMODE=SELECTANDQUIT
79660          else 
79662             let EXITMODE=SAVEANDQUIT
79664          end if 
79666       end if 
79668 ! 
79670       if DEFAULTMAINLOOPFUNCTION then 
79672          let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\mainloop.brs"))
79674       end if 
79676 ! 
79678 ! .   ! Here's where we link to our MainLoop event
79680       if LEN(TRIM$(SCREENIO$(SI_LOOPFN))) then 
79682          let FNEXECUTE(SCREENIO$(SI_LOOPFN))
79684       end if 
79686 ! 
79688    fnend 
79690 ! 
79692 ! 
84000 !  #Autonumber# 84000,5
84005 Openwindow: ! Opens A User Screen
84010    def FNOPENWINDOW(VPOS,HPOS,MAT SCREENIO$, MAT SCREENIO;PARENT,DISPLAYONLY,FORCETHISINDEX,ACTIVE,EDITING,___,WINDOWATTRIBUTES$*1024,WWINDOW,FGCOLOR$,BGCOLOR$,FORCEINDEX)
84015 ! 
84020       let WINDOWATTRIBUTES$=FNMAKEWINDOWSPEC$(VPOS,HPOS,MAT SCREENIO$,MAT SCREENIO,PARENT,DISPLAYONLY,ACTIVE,EDITING)
84025       let WWINDOW:=FNGETFILENUMBER(-1)
84030 ! 
84035       if DISPLAYONLY then let FORCEINDEX=WWINDOW+1000
84040       if FORCETHISINDEX then let FORCEINDEX=FORCETHISINDEX
84045 ! 
84050       if FORCEINDEX AND FN42 then 
84055          let WINDOWATTRIBUTES$ = WINDOWATTRIBUTES$ & ", Fkey=" & STR$(FORCEINDEX)
84060       end if 
84065 ! 
84070       open #WWINDOW: WINDOWATTRIBUTES$, display, outin 
84075 ! 
84080       if FORCEINDEX AND ~FN42 then 
84085          print #WWINDOW, fields "1,1,C "&STR$(SCREENIO(SI_VSIZE)*SCREENIO(SI_HSIZE))&",/W:T,"&STR$(FORCEINDEX) : ""  !Make it hot
84090       end if 
84095 ! 
84100       let FNOPENWINDOW=WWINDOW
84105 ! 
84110    fnend 
84115 ! 
84120    def FNMAKEWINDOWSPEC$*1024(VPOS,HPOS,MAT SCREENIO$, MAT SCREENIO;PARENT,DISPLAYONLY,ACTIVE,EDITING,___,WINDOWATTRIBUTES$*1024,FGCOLOR$,BGCOLOR$)
84125       if TRIM$(SCREENIO$(SI_PICTURE))<>"" then 
84130          let WINDOWATTRIBUTES$=", Picture="&SCREENIO$(SI_PICTURE)
84135       end if 
84140 ! 
84145       if TRIM$(SCREENIO$(SI_ATTRIBUTES))<>"" then 
84150          if FNTESTATTRIBUTES(SCREENIO$(SI_ATTRIBUTES),VPOS,HPOS) then 
84155             let WINDOWATTRIBUTES$ = WINDOWATTRIBUTES$ & ", " & SCREENIO$(SI_ATTRIBUTES)
84160          end if 
84165       end if 
84170 ! 
84175       if ((ACTIVE OR ~DISPLAYONLY) AND LEN(TRIM$(SCREENIO$(SI_ACTIVECOLOR))) AND FNTESTATTRIBUTES(SCREENIO$(SI_ACTIVECOLOR),VPOS,HPOS)) then 
84180          let WINDOWATTRIBUTES$ = WINDOWATTRIBUTES$ & ", N=" & SCREENIO$(SI_ACTIVECOLOR)
84185       else if ACTIVE AND EDITING then 
84190          let WINDOWATTRIBUTES$=WINDOWATTRIBUTES$&", N=/#000000:#FFFF00"
84195       else if (TRIM$(SCREENIO$(SI_FGCOLOR))<>"" OR TRIM$(SCREENIO$(SI_BGCOLOR))<>"") AND ~POS(UPRC$(WINDOWATTRIBUTES$),"N=") then 
84200          let FGCOLOR$=TRIM$(SCREENIO$(SI_FGCOLOR))
84205          let BGCOLOR$=TRIM$(SCREENIO$(SI_BGCOLOR))
84210          if FGCOLOR$="" then let FGCOLOR$="W"
84215          if BGCOLOR$="" then let BGCOLOR$="W"
84220          if LEN(FGCOLOR$)=6 then let FGCOLOR$="#"&FGCOLOR$
84225          if LEN(BGCOLOR$)=6 then let BGCOLOR$="#"&BGCOLOR$
84230 ! 
84235          let WINDOWATTRIBUTES$=WINDOWATTRIBUTES$&", N=/"&FGCOLOR$&":"&BGCOLOR$
84240       end if 
84245 ! 
84250       if SCREENIO(SI_BORDER) then 
84255          let WINDOWATTRIBUTES$ = WINDOWATTRIBUTES$ & ", Border=S"
84260       end if 
84265 ! 
84270       if TRIM$(SCREENIO$(SI_WINDCAP))<>"" then 
84275          let WINDOWATTRIBUTES$ = WINDOWATTRIBUTES$ & ", Caption=" & TRIM$(SCREENIO$(SI_WINDCAP))
84280       end if 
84285 ! 
84290       if PARENT=-1 then 
84295          if FN42 then let WINDOWATTRIBUTES$ = WINDOWATTRIBUTES$ & ", Parent=None"
84300       else if PARENT then 
84305          let WINDOWATTRIBUTES$ = WINDOWATTRIBUTES$ & ", Parent=" & STR$(PARENT)
84310       end if 
84315 ! 
84320       let FNMAKEWINDOWSPEC$="SROW=" & STR$(VPOS) & ", SCOL=" & STR$(HPOS) & ", ROWS=" & STR$(SCREENIO(SI_VSIZE)) & ", COLS=" & STR$(SCREENIO(SI_HSIZE)) & WINDOWATTRIBUTES$
84325    fnend 
84330 ! 
84335 ! 
84340 ! .! Color Picker
84345    dim COLORSHADES$(38)
84350    def FNCOLORPICKER$(OLD$;ROW,COLUMN,VIEWTEXT$,&FUNCTION,___,WINDOW,INDEX,CURRENT$,HCODE$,CURRENTSPEC$*32,HCODESPEC$,SEL,COLORROW,COLORCOL,LASTINDEX,OLDHCODE$,NEWINDEX)
84355 ! 
84360       let SCR_FREEZE
84365       if ~ROW then let ROW=14 : let COLUMN=38
84370 ! 
84375       mat COLORSPEC$(38) : mat COLORTEXT$(38)
84380       mat CAPTIONSPEC$(2) : mat CAPTIONTEXT$(2)
84385 ! 
84390       mat COLORTEXT$=("")
84395 ! 
84400       if COLORSHADES$(1)="" then 
84405          for INDEX=1 to UDIM(MAT COLORSPEC$)
84410             let COLORSHADES$(INDEX)=FNBUTTONCOLOR2$(INDEX)
84415          next INDEX
84420       end if 
84425 ! 
84430       let HCODESPEC$="6,8,8/CU 6,X"
84435       let HCODE$=OLD$
84440       if ~FNVALIDHEXCOLOR(HCODE$) then let HCODE$="W"
84445       let CURRENTSPEC$="6,19,CC 20,"&FNBUILDCOLOR$(HCODE$)&",B14"
84450       let CURRENT$=VIEWTEXT$
84455       let CAPTIONTEXT$(1)="Color Picker"
84460       let CAPTIONSPEC$(1)="1,3,C 14,[TB]"
84465       let CAPTIONTEXT$(2)="HTML:"
84470       let CAPTIONSPEC$(2)="6,2,CR 5,[TB]"
84475 ! 
84480       open #(WINDOW:=FNGETFILENUMBER(100)): "sRow="&STR$(ROW)&",sCol="&STR$(COLUMN)&",Rows=7,Cols=40,Border=S",display,outin 
84485       print #WINDOW, fields MAT CAPTIONSPEC$ : MAT CAPTIONTEXT$
84490       print #WINDOW, fields "4,5,CC 8,/W:W,B7001;4,17,CC 8,/W:W,B7002;4,29,CC 8,/W:W,B7003" : "W","T",""
84495       print #WINDOW, fields "1,35,CC 5,/W:W,B8000" : "Reset"
84500       do 
84505          mat COLORTEXT$=("")
84510          for INDEX=1 to UDIM(MAT COLORSPEC$)
84515             let COLORROW=2
84520             let COLORCOL=INDEX+1
84525             let COLORSPEC$(INDEX)=STR$(COLORROW)&","&STR$(COLORCOL)&",C 1,"&COLORSHADES$(INDEX)&",B71"&CNVRT$("pic(##)",INDEX)
84530             if (LWRC$(COLORSHADES$(INDEX))(11:16)=LWRC$(OLDHCODE$)) then 
84535                let COLORTEXT$(INDEX)="*"
84540             end if 
84545          next INDEX
84550          print #WINDOW, fields MAT COLORSPEC$ : MAT COLORTEXT$
84555          print #WINDOW, fields CURRENTSPEC$ : CURRENT$
84560          rinput #WINDOW, fields HCODESPEC$ : HCODE$
84565          let SEL=FKEY : if SEL=0 then let SEL=14
84570          if SEL>7000 then 
84575             if SEL = 7001 then ! #Select# Sel #Case# 7001
84580                let HCODE$ = "W"
84585             else if SEL = 7002 then ! #Case# 7002
84590                let HCODE$ = "T"
84595             else if SEL = 7003 then ! #Case# 7003
84600                let HCODE$ = ""
84605             else if SEL = 8000 then ! #Case# 8000
84610                for INDEX=1 to UDIM(MAT COLORSPEC$)
84615                   let COLORSHADES$(INDEX)=FNBUTTONCOLOR2$(INDEX)
84620                next INDEX
84625             else ! #Case Else#
84630                let COLORSHADES$(SEL-7100)=FNSELECTSHADECOLOR$(COLORSHADES$(SEL-7100),SEL-7100,1+ROW,(SEL-7099)+COLUMN)  !Row is 2, Col is Index+1
84635                let HCODE$ =COLORSHADES$(SEL-7100)(11:16)
84640             end if                    !#End Select#
84645          end if 
84650          if HCODE$<>OLDHCODE$ then ! If Hcode$ Changed Then
84655             if HCODE$="" OR FNVALIDHEXCOLOR(HCODE$) then 
84660                let OLDHCODE$=HCODE$
84665             else 
84670                let HCODE$=OLDHCODE$
84675             end if 
84680          end if 
84685          let CURRENTSPEC$=CURRENTSPEC$(1:POS(CURRENTSPEC$,"/")-1)&FNBUILDCOLOR$(HCODE$)&",B14"
84690       loop UNTIL (SEL=14) OR (SEL=99) OR ((SEL>1100) AND (SEL<1699)) OR (SEL=98) OR (SEL=93) OR (SEL=44) OR (SEL=19) OR FKEY=93
84695       if SEL=99 then 
84700          let FNCOLORPICKER$=OLD$
84705       else 
84710          let FNCOLORPICKER$=HCODE$
84715       end if 
84720       if (SEL<>14) AND (SEL<>99) then let FUNCTION=SEL
84725       close #WINDOW: 
84730    fnend 
84735 ! 
84740    dim SHADESPEC$(36)*32,SHADETEXT$(36)
84745 ! 
84750    def FNSELECTSHADECOLOR$(SCODE$,INDEX;SROW,SCOL,___,WINDOW,ROW,COL,SEL,X$,SHADEINDEX,STARTCOL,STARTROW,SHADECOLOR$)
84755       if LEN(SCODE$)=6 then let SCODE$=FNBUILDCOLOR$(SCODE$)
84760       if ~SROW then let SROW=10
84765       if ~SCOL then let SCOL=30
84770 ! 
84775       let STARTCOL=6
84780       let STARTROW=1
84785       mat SHADETEXT$=("")
84790 ! 
84795       for ROW=1 to 6
84800          for COL=1 to 6
84805             let SHADEINDEX=(ROW-1)*6+COL
84810             let SHADECOLOR$=FNSHADECOLOR$(INDEX,ROW,COL)
84815             let SHADESPEC$(SHADEINDEX)=STR$(ROW)&","&STR$(COL)&",C 1,"&SHADECOLOR$&",B71"&STR$(ROW)&STR$(COL)
84820             if LWRC$(SHADECOLOR$)=LWRC$(SCODE$) then 
84825                let SHADETEXT$(SHADEINDEX)="*"
84830                let STARTCOL=COL
84835                let STARTROW=ROW
84840             end if 
84845          next COL
84850       next ROW
84855 ! 
84860       let SCOL=MAX(2,SCOL-STARTCOL)
84865       let SROW=MAX(2,(SROW-STARTROW)+1)
84870 ! 
84875       open #(WINDOW:=FNGETFILENUMBER): "srow="&STR$(SROW)&",scol="&STR$(SCOL)&",rows=6,cols=6,border=s", display, outin 
84880 ! 
84885       print #WINDOW, fields MAT SHADESPEC$ : MAT SHADETEXT$
84890       let X$=""
84895       rinput #0, fields "2,2,C 1,AEX" : X$
84900       let SEL=FKEY : if SEL=0 then let SEL=14
84905       if SEL>7100 then 
84910          let SCODE$=FNSHADECOLOR$(INDEX,VAL(STR$(SEL)(3:3)),VAL(STR$(SEL)(4:4)))
84915       end if 
84920 ! 
84925       let FNSELECTSHADECOLOR$=SCODE$
84930       close #WINDOW: 
84935    fnend 
84940 ! 
84945    dim COLORSPEC$(216)*31,COLORTEXT$(216)
84950    dim CAPTIONSPEC$(2),CAPTIONTEXT$(2)
84955 ! 
84960 Colorpickerh: !   ***** Allows The User To Select A Color And Returns Hex
84965    def FNCOLORPICKERH$(OLD$;ROW,COLUMN,VIEWTEXT$,&FUNCTION,___,WINDOW,INDEX,CURRENT$,HCODE$,CURRENTSPEC$*32,HCODESPEC$,SEL,COLORROW,COLORCOL,LASTINDEX,OLDHCODE$,NEWINDEX)
84970       let SCR_FREEZE
84975       if ~ROW then let ROW=14 : let COLUMN=38
84980       mat COLORSPEC$(216) : mat COLORTEXT$(216)
84985       mat CAPTIONSPEC$(2) : mat CAPTIONTEXT$(2)
84990 ! 
84995       for INDEX=1 to UDIM(COLORSPEC$)
85000          let COLORROW=INT((INDEX-1)/36)+2 !:
               let COLORCOL=MOD(INDEX-1,36)+3 !:
               let COLORSPEC$(INDEX)=STR$(COLORROW)&","&STR$(COLORCOL)&",C 1,"&FNBUTTONCOLOR$(COLORROW,COLORCOL)&",B7"&STR$(COLORROW)&CNVRT$("pic(##)",COLORCOL)
85005          if (FNBUTTONCOLOR$(COLORROW,COLORCOL)(11:16)=OLD$) then !:
                  let COLORTEXT$(INDEX)="*" !:
                  let LASTINDEX=INDEX !:
                  let OLDHCODE$=OLD$ !:
               else !:
                  let COLORTEXT$(INDEX)=" "
85010       next INDEX
85015       let HCODESPEC$="11,8,8/CU 6,X"
85020       let HCODE$=OLD$
85025       if ~FNVALIDHEXCOLOR(HCODE$) then let HCODE$="W"
85030       let CURRENTSPEC$="11,19,CC 20,"&FNBUILDCOLOR$(HCODE$)&",B14"
85035       let CURRENT$=VIEWTEXT$
85040       let CAPTIONTEXT$(1)="Color Picker"
85045       let CAPTIONSPEC$(1)="1,3,C 14,[TB]"
85050       let CAPTIONTEXT$(2)="HTML:"
85055       let CAPTIONSPEC$(2)="11,2,CR 5,[TB]"
85060       open #(WINDOW:=FNGETFILENUMBER(100)): "sRow="&STR$(ROW)&",sCol="&STR$(COLUMN)&",Rows=12,Cols=40,Border=S",display,outin 
85065       print #WINDOW, fields MAT CAPTIONSPEC$ : MAT CAPTIONTEXT$
85070       print #WINDOW, fields "9,5,CC 8,,B7001;9,17,CC 8,,B7002;9,29,CC 8,,B7003" : "W","T",""
85075       do 
85080          print #WINDOW, fields MAT COLORSPEC$ : MAT COLORTEXT$
85085          print #WINDOW, fields CURRENTSPEC$ : CURRENT$
85090          rinput #WINDOW, fields HCODESPEC$ : HCODE$
85095          let SEL=FKEY : if SEL=0 then let SEL=14
85100          if SEL>7000 then 
85105             if SEL = 7001 then ! #Select# Sel #Case# 7001
85110                let HCODE$ = "W"
85115             else if SEL = 7002 then ! #Case# 7002
85120                let HCODE$ = "T"
85125             else if SEL = 7003 then ! #Case# 7003
85130                let HCODE$ = ""
85135             else ! #Case Else#
85140                let HCODE$ = FNBUTTONCOLOR$(VAL(STR$(SEL)(2:2)),VAL(STR$(SEL)(3:4)))(11:16)
85145             end if                    !#End Select#
85150          end if 
85155          if HCODE$<>OLDHCODE$ then ! If Hcode$ Changed Then
85160             if HCODE$="" OR FNVALIDHEXCOLOR(HCODE$) then 
85165                if LASTINDEX then let COLORTEXT$(LASTINDEX)=" "
85170                let OLDHCODE$=HCODE$
85175                let LASTINDEX=FNSEARCHCLOSELY(MAT COLORSPEC$,":#"&HCODE$)
85180                if LASTINDEX then let COLORTEXT$(LASTINDEX)="*"
85185             else 
85190                let HCODE$=OLDHCODE$
85195             end if 
85200          end if 
85205          let CURRENTSPEC$=CURRENTSPEC$(1:POS(CURRENTSPEC$,"/")-1)&FNBUILDCOLOR$(HCODE$)&",B14"
85210       loop UNTIL (SEL=14) OR (SEL=99) OR ((SEL>1100) AND (SEL<1699)) OR (SEL=98) OR (SEL=93) OR (SEL=44) OR (SEL=19)
85215       if SEL=99 then 
85220          let FNCOLORPICKERH$=OLD$
85225       else 
85230          let FNCOLORPICKERH$=HCODE$
85235       end if 
85240       if (SEL<>14) AND (SEL<>99) then let FUNCTION=SEL
85245       close #WINDOW: 
85250    fnend 
85255 ! 
85260 Buttoncolor: !   ***** Returns Fg/Bg Color 0f A Specific Button
85265    def FNBUTTONCOLOR$(ROW,COL;___,R,G,B)
85270       let R=INT((COL-3)/6)
85275       let G=MOD((COL-3),6)
85280       let B=7-ROW
85285       let FNBUTTONCOLOR$=FNBUILDCOLOR$(FNPATTERN$(R)&FNPATTERN$(G)&FNPATTERN$(B))
85290    fnend 
85295    def FNBUTTONCOLOR2$(INDEX;___,R,G,B)
85300       let FNBUTTONRGB(INDEX,R,G,B)
85305       let FNBUTTONCOLOR2$=FNBUILDCOLOR$(FNPATTERN2$(R)&FNPATTERN2$(G)&FNPATTERN2$(B))
85310    fnend 
85315 ! 
85320    def FNSHADECOLOR$(INDEX,ROW,COL;___,R,G,B,BRIGHTNESS,CONTRAST)
85325       let FNBUTTONRGB(INDEX,R,G,B)
85330       let CONTRAST=(6-ROW)/5
85335       let BRIGHTNESS=(COL-1)/5
85340 ! 
85345       let R=6-R
85350       let G=6-G
85355       let B=6-B
85360 ! 
85365       let R*=CONTRAST
85370       let G*=CONTRAST
85375       let B*=CONTRAST
85380 ! 
85385       let R=6-R
85390       let G=6-G
85395       let B=6-B
85400 ! 
85405       let R*=BRIGHTNESS
85410       let G*=BRIGHTNESS
85415       let B*=BRIGHTNESS
85420 ! 
85425       let FNSHADECOLOR$=FNBUILDCOLOR$(FNPATTERN2$(R)&FNPATTERN2$(G)&FNPATTERN2$(B))
85430    fnend 
85435 ! 
85440    def FNBUTTONRGB(INDEX,&R,&G,&B)
85445       if INDEX<=1 then 
85450          let R=6
85455          let G=6
85460          let B=6
85465       else if INDEX<=2 then 
85470          let R=0
85475          let G=0
85480          let B=0
85485       else if INDEX<=8 then 
85490          let R=6
85495          let G=INDEX-2
85500          let B=0
85505       else if INDEX<=14 then 
85510          let R=14-INDEX
85515          let G=6
85520          let B=0
85525       else if INDEX<=20 then 
85530          let R=0
85535          let G=6
85540          let B=INDEX-14
85545       else if INDEX<=26 then 
85550          let R=0
85555          let G=26-INDEX
85560          let B=6
85565       else if INDEX<=32 then 
85570          let R=INDEX-26
85575          let G=0
85580          let B=6
85585       else if INDEX<=38 then 
85590          let R=6
85595          let G=0
85600          let B=38-INDEX
85605       end if 
85610    fnend 
85615 ! 
85620 ! 
85625 Buildcolor: !   ***** Builds A Forground And Background That Match
85630    def FNBUILDCOLOR$(BKG$;___,NUMBER)
85635       if LEN(TRIM$(BKG$)) = 6 then ! #Select# Len(Trim$(Bkg$)) #Case# 6
85640          let NUMBER=10
85645          let NUMBER=VAL(BKG$(3:3)) conv IGNORE
85650          if NUMBER<9 then 
85655             let FNBUILDCOLOR$="/#FFFFFF:#"&BKG$
85660          else 
85665             let FNBUILDCOLOR$="/#000000:#"&BKG$
85670          end if 
85675       else ! #Case Else#
85680          let FNBUILDCOLOR$="/W:W"
85685       end if                          !#End Select#
85690    fnend 
85695 ! 
85700 Pattern: !   ****** Returns A Hex Code Pattern Based On Entered Number
85705    def FNPATTERN$(X)
85710       if X = 0 then ! #Select# X #Case#  0
85715          let FNPATTERN$="00"
85720       else if X = 1 then ! #Case#  1
85725          let FNPATTERN$="33"
85730       else if X = 2 then ! #Case# 2
85735          let FNPATTERN$="66"
85740       else if X = 3 then ! #Case# 3
85745          let FNPATTERN$="99"
85750       else if X = 4 then ! #Case# 4
85755          let FNPATTERN$="CC"
85760       else if X = 5 then ! #Case# 5
85765          let FNPATTERN$="FF"
85770       end if                          !#End Select#
85775    fnend 
85780 ! 
85785    def FNPATTERN2$(X)
85790       let X*=255
85795       let X/=6
85800       let FNPATTERN2$=UNHEX$(CHR$(X))
85805    fnend 
85810 ! 
85815 Validhexcolor: !   ***** Returns 1  If Valid Color
85820    def FNVALIDHEXCOLOR(HC$;___,INDEX,INVALID)
85825       if TRIM$(HC$) = "W" OR TRIM$(HC$) = "T" then ! #Select# Trim$(Hc$) #Case# "W" # "T"
85830          let FNVALIDHEXCOLOR=1
85835       else ! #Case Else#
85840          if LEN(HC$)=6 then 
85845             for INDEX=1 to 6
85850                if ~(POS("0123456789ABCDEF",HC$(INDEX:INDEX))) then let INVALID=1
85855             next INDEX
85860          else 
85865             let INVALID=1
85870          end if 
85875          let FNVALIDHEXCOLOR=~INVALID
85880       end if                          !#End Select#
85885    fnend 
85890 ! 
85895    dim READSETTINGS
85900    def FNSETTINGS
85905       if ~READSETTINGS then 
85910          let FNDEFAULTSETTINGS
85915          if EXISTS("screenio.ini") then 
85920             execute "*subproc screenio.ini"
85925          else if EXISTS("screenio\screenio.ini") then 
85930             execute "*subproc screenio\screenio.ini"
85935          else if EXISTS("\screenio.ini") then 
85940             execute "*subproc \screenio.ini"
85945          else if EXISTS("\screenio\screenio.ini") then 
85950             execute "*subproc \screenio\screenio.ini"
85955          end if 
85960          let READSETTINGS=1
85965 ! 
85970          let FNPARSESETTINGS
85975 ! 
85980          library SETTING_FILEIOPATH$ : FNOPENFILE, FNCLOSEFILE, FNGETFILENUMBER, FNKEY$, FNBUILDKEY$, FNREADLAYOUTARRAYS, FNDOESLAYOUTEXIST, FNREADALLKEYS, FNREADLAYOUTS, FNDISPLAYLENGTH, FNUPDATEFILE, FNREADNUMBER, FNREADLAYOUTPATH$, FNREADSUBS, FNREADUNOPENEDNUMBER,FNREADUNOPENEDDESCRIPTION$,FNLOG,FNLOGARRAY,FNSETLOGCHANGES,FNLOGCHANGES,FNRUNPROCFILE,FNBUILDPROCFILE,FNREADLOCKEDUSERS, FNASKCOMBO$, FNCLEARLAYOUTCACHE
85985       end if 
85990    fnend 
85995 ! 
86000 Execute: ! Execute Custom Code Call Here
86005    def FNEXECUTE(FUNCTION$*255;&CONTROLINDEX,&FIELDTEXT$,&FIELDINDEX,___,POUND$)
86010       let POUND$="#"
86015       if FUNCTION$(1:1) = POUND$ OR FUNCTION$(1:1) = "{" then ! #Select# Function$(1:1) #Case# Pound$ # "{"
86020          let FNEXECUTE=FNEXECUTEFUNCTION(FUNCTION$)
86025       else if FUNCTION$(1:1) = "[" then ! #Case# "["
86030          let FNEXECUTE=FNRETURNVALUE(FNEXECUTESCREEN$(FUNCTION$))
86035       else if FUNCTION$(1:1) = "%" then ! #Case# "%"
86040          chain FUNCTION$(2:LEN(FUNCTION$))
86045       else ! #Case Else#
86050          execute FUNCTION$
86055       end if                          !#End Select#
86060    fnend 
86065    def FNEXECUTE$(FUNCTION$*255;&CONTROLINDEX,&FIELDTEXT$,&FIELDINDEX,___,POUND$)
86070       let POUND$="#"
86075       if FUNCTION$(1:1) = POUND$ OR FUNCTION$(1:1) = "{" then ! #Select# Function$(1:1) #Case# Pound$ # "{"
86080          let FNEXECUTE$=FNEXECUTEFUNCTION$(FUNCTION$)
86085       else if FUNCTION$(1:1) = "[" then ! #Case# "["
86090          let FNEXECUTE$=FNEXECUTESCREEN$(FUNCTION$)
86095       else if FUNCTION$(1:1) = "%" then ! #Case# "%"
86100          chain FUNCTION$(2:LEN(FUNCTION$))
86105       else ! #Case Else#
86110          execute FUNCTION$
86115       end if                          !#End Select#
86120    fnend 
86125    def FNEXECUTEGETDATA(FUNCTION$*255,MAT RETURNDATA$;CONTROLINDEX,FIELDTEXT$,FIELDINDEX)
86130       let POUND$="#"
86135       if FUNCTION$(1:1) = POUND$ OR FUNCTION$(1:1) = "{" then ! #Select# Function$(1:1) #Case# Pound$ # "{"
86140          let FNEXECUTEGETDATA=FNEXECUTEFUNCTION(FUNCTION$)
86145       end if                          !#End Select#
86150    fnend 
86155 ! 
86160 Callscreen: ! Use Executescreen To Launch A Screenio Screen. (Use This When Calling Screenio Screens From Code From Within Other Screenio Screens.)
86165    def library FNCALLSCREEN$*255(SCREEN$*255;KEYVAL$*255,PARENT_KEY$*255,DISPLAY_ONLY,PARENT_WINDOW,DONTREDOLISTVIEW,RECORDVAL,MAT PASSEDDATA$,USEMYF,MAT MYF$,MAT MYF,PATH$*255,SELECTING)
86170       if SCREEN$(1:1)<>"[" then let SCREEN$(1:0)="["
86175       if SCREEN$(LEN(SCREEN$):LEN(SCREEN$))<>"]" then let SCREEN$=SCREEN$&"]"
86180       let FNCALLSCREEN$=FNEXECUTESCREEN$(SCREEN$,KEYVAL$,PARENT_KEY$,DISPLAY_ONLY,PARENT_WINDOW,DONTREDOLISTVIEW,RECORDVAL,MAT PASSEDDATA$,USEMYF,MAT MYF$,MAT MYF,PATH$,SELECTING)
86185    fnend 
86190 ! 
86195 Executescreen: ! Push All Arrays Onto Stack And Jump To Another Screen
86200    def FNEXECUTESCREEN$*255(SCREEN$*255;KEYVAL$*255,PARENT_KEY$*255,DISPLAY_ONLY,PARENT_WINDOW,DONTREDOLISTVIEW,RECORDVAL,MAT PASSEDDATA$,USEMYF,MAT MYF$,MAT MYF,_PATH$*255,SELECTING,___,TARGET_ROW,TARGET_COL,PTH$*255)
86205       if _PATH$<>"" then let PTH$=_PATH$ else let PTH$=PATH$
86210       let FNPARSESCREENINFO(SCREEN$,KEYVAL$,PARENT_KEY$,DISPLAY_ONLY,PARENT_WINDOW,DONTREDOLISTVIEW,TARGET_ROW,TARGET_COL,RECORDVAL,PARENTKEY$)
86215       let FNEXECUTESCREEN$=FNMASTERFM$(SCREEN$,KEYVAL$,TARGET_ROW,TARGET_COL,PARENT_KEY$,PARENT_WINDOW,DISPLAY_ONLY,DONTREDOLISTVIEW,RECORDVAL,PTH$,SELECTING,0,0,0,MAT PASSEDDATA$,USEMYF,MAT MYF$,MAT MYF)
86220    fnend 
86225 ! 
86230    def FNPARSESCREENINFO(&SCREEN$,&KEY$,&PARENTKEY$,&DISPLAYONLY,&PARENTWINDOW,&DONTREDOLISTVIEW,&TARGETROW,&TARGETCOL,&RECORD;THISPARENTKEY$*255,___,DIVIDERPOSITION,ENDSCREENCODE)
86235       let ENDSCREENCODE=DIVIDERPOSITION=POS(SCREEN$,"(")
86240       if DIVIDERPOSITION < POS(SCREEN$,"]") then 
86245          let TARGETROW=VAL(SCREEN$(POS(SCREEN$,"(")+1:POS(SCREEN$,",")-1)) conv IGNORE
86250          let TARGETCOL=VAL(SCREEN$(POS(SCREEN$,",")+1:POS(SCREEN$,")")-1)) conv IGNORE
86255       end if 
86260 ! 
86265       let DIVIDERPOSITION=POS(SCREEN$,"]")
86270 ! 
86275       if ENDSCREENCODE=0 then 
86280          let ENDSCREENCODE=DIVIDERPOSITION
86285       else if DIVIDERPOSITION=0 then 
86290          let ENDSCREENCODE=ENDSCREENCODE
86295       else 
86300          let ENDSCREENCODE=MIN(DIVIDERPOSITION,ENDSCREENCODE)
86305       end if 
86310 ! 
86315       if DIVIDERPOSITION then 
86320          if TRIM$(SCREEN$(DIVIDERPOSITION+1:LEN(SCREEN$)))<>"" then 
86325             if TRIM$(SCREEN$(DIVIDERPOSITION+1:LEN(SCREEN$)))(1:1)="{" OR TRIM$(SCREEN$(DIVIDERPOSITION+1:LEN(SCREEN$)))(1:1)="#" then 
86330                let KEY$=FNEXECUTEFUNCTION$(TRIM$(SCREEN$(DIVIDERPOSITION+1:LEN(SCREEN$))))
86335             else if TRIM$(SCREEN$(DIVIDERPOSITION+1:LEN(SCREEN$)))(1:1)="*" then 
86340                execute TRIM$(SCREEN$(DIVIDERPOSITION+1:LEN(SCREEN$)))
86345             else 
86350                execute ""&TRIM$(SCREEN$(DIVIDERPOSITION+1:LEN(SCREEN$)))
86355             end if 
86360          end if 
86365 ! 
86370          let SCREEN$=UPRC$(SCREEN$(2:ENDSCREENCODE-1))
86375       else if ENDSCREENCODE then 
86380          let SCREEN$=UPRC$(SCREEN$(2:ENDSCREENCODE-1))
86385       else 
86390          let SCREEN$=UPRC$(SCREEN$(2:LEN(SCREEN$)))
86395       end if 
86400       let SCREEN$=TRIM$(SCREEN$)
86405    fnend 
86410 ! 
86415 ! .! Clear all screenio arrays in case they've been sullied by a
86420 ! .!  previous screen.
86425    def FNCLEARALLARRAYS
86430       mat S$(0) : mat F$(0) : mat F(0) : mat FIELDSSSUBS$(0) : mat FIELDSNSUBS$(0) : mat SCREENSUBS$(0) : mat FORM$(0) : mat S_SUBS(0) : mat TEMPDATA$(0)
86435       mat TEMP_S_SPEC$(0) : mat SELECTEDRECORDS(0) : mat SELECTEDKEYS$(0) : mat VISIBLEKEYS$(0) : mat VISIBLERECORDS(0) : mat SAVE_S$(0) : mat SAVE_F(0) : mat SAVE_F$(0)
86440       mat SAVE_S_SUBS(0) : mat SAVE_S_DATA$(0) : mat CHANGED_S_SUBS(0) : mat CHANGED_S_DATA$(0) : mat OTHER_S_SUBS(0) : mat OTHER_S_DATA$(0)
86445       mat OTHERCHANGED_S_SUBS(0) : mat OTHERCHANGED_S_DATA$(0) : mat READ_F(0)
86450       mat READ_F$(0) : mat FRAMEKEYS$(0) : mat FRAMESPECCONTROL$(0) : mat FRAMEWINDOWS(0) : mat SCREENKEYS$(0) : mat SCREENWINDOWS(0)
86455 ! 
86460       mat CONTROLNAME$(0) : mat FIELDNAME$(0) : mat FUNCTION$(0) : mat CNVRTIN$(0) : mat SPECWIDTH(0)
86465       mat SCREENIO$(0) : mat SCREENIO(0) : mat DESCRIPTION$(0) : mat VPOSITION(0) : mat HPOSITION(0) : mat FIELDTYPE$(0) : mat WIDTH(0)
86470       mat HEIGHT(0) : mat TRUEVALUE$(0) : mat FALSEVALUE$(0) : mat PICTURE$(0) : mat PARENT$(0) : mat FGCOLOR$(0) : mat BGCOLOR$(0)
86475       mat JUSTIFY$(0) : mat ATTR$(0) : mat PROTECTED(0) : mat INVISIBLE(0) : mat TOOLTIP$(0) : mat CNVRTOUT$(0) : mat MULTISELECT(0)
86480       mat GRIDLINES(0) : mat USERDATA$(0) : mat S_OLD$(0) : mat S_DATA$(0) : mat S_DATA(0) : mat S_SPEC$(0)
86485    fnend 
86490 ! 
90000 ! #Autonumber# 90000,2
90002 Stack: ! Functions To Manage The Stack
90004    dim STACK$(1)*255
90006    dim LONGSTACK$(1)*2047
90008    dim STACK(1)
90010 ! 
90012    dim UNDOSTACK$(1)*255
90014    dim UNDOLONGSTACK$(1)*2047
90016    dim UNDOSTACK(1)
90018 ! 
90020    dim SIZE1(1)
90022    dim SIZE2(1)
90024    dim SIZE3(1)
90026 ! 
90028    def FNPUSHMEMORY(;___,STRINGARRAYS,NUMBEROFSTRINGARRAYS,LONGSTRING$*800)
90030 ! .  ! Test how much we're about to push.
90032       let LONGSTRING$="mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$,"
90034       let LONGSTRING$=LONGSTRING$&" mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat MultiSelect,mat UserData$,mat GridLines"
90036       let NUMBEROFSTRINGARRAYS=LEN(LONGSTRING$)-LEN(SREP$(LONGSTRING$,"$",""))
90038       let STRINGARRAYS=UDIM(MAT CONTROLNAME$)*NUMBEROFSTRINGARRAYS+UDIM(MAT SCREENIO$)
90040       let STRINGARRAYS+=UDIM(MAT SCREENSUBS$)+UDIM(MAT S$)+UDIM(MAT FORM$)+UDIM(MAT F$)
90042       let STRINGARRAYS+=UDIM(MAT FIELDSSSUBS$)+UDIM(MAT FIELDSNSUBS$)+UDIM(MAT TEMP_S_SPEC$)
90044       let STRINGARRAYS+=UDIM(MAT FIELDSSDESCRIPTION$)+UDIM(MAT FIELDSNDESCRIPTION$)+UDIM(MAT FIELDSSSPEC$)+UDIM(MAT FIELDSNSPEC$)
90046       let STRINGARRAYS+=UDIM(MAT FIELDSSDATESPEC$)+UDIM(MAT FIELDSNDATESPEC$)
90048       let STRINGARRAYS+=UDIM(MAT SELECTEDKEYS$)+UDIM(MAT SAVE_S$)+UDIM(MAT SAVE_F$)
90050       let STRINGARRAYS+=UDIM(MAT VISIBLEKEYS$)
90052       let STRINGARRAYS+=UDIM(MAT SAVE_S_DATA$)+UDIM(MAT CHANGED_S_DATA$)+UDIM(MAT OTHER_S_DATA$)
90054       let STRINGARRAYS+=UDIM(MAT OTHERCHANGED_S_DATA$)+UDIM(MAT READ_F$)+UDIM(MAT FRAMEKEYS$)+UDIM(MAT FRAMESPECCONTROL$)+UDIM(SCREENKEYS$)
90056 ! 
90058       if ~FN42 AND (UDIM(MAT STACK$)+STRINGARRAYS>4000 OR UDIM(MAT LONGSTACK$)>400 OR UDIM(MAT STACK)>20000) then 
90060          let MSGBOX("We didn't have enough memory to load this screen. Consider upgrading to BR 4.2 or don't load so many screens at one time.","Out of Memory")
90062          let FNPUSHMEMORY=1           !Out of memory Error
90064       else 
90066          let FNPUSHDATA(0,1)
90068       end if 
90070    fnend 
90072    def FNPOPMEMORY(;DONTREDOLISTVIEW)
90074       let FNPOPDATA
90076 ! 
90078       let FNEXECUTESETSUBSCRIPTS(MAT SCREENSUBS$,"sio_")
90080       let FNEXECUTESETSUBSCRIPTS(MAT CONTROLNAME$,"ctl_")
90082       let FNEXECUTEUNIQUESUBSCRIPTS(MAT CONTROLNAME$,"ctl_")
90084 ! 
90086       let FNEXECUTESETSUBSCRIPTS(MAT FIELDSNSUBS$,PREFIX$)
90088       let FNEXECUTESETSUBSCRIPTS(MAT FIELDSSSUBS$,PREFIX$)
90090 ! 
90092       let FNESTABLISHLIBRARYLINKAGE
90094 ! 
90096       if WWINDOW=0 OR FILE(WWINDOW)=-1 then 
90098          let WWINDOW=FNOPENWINDOW(ROW,COL,MAT SCREENIO$,MAT SCREENIO)
90100          let FNDRAWFRAMES(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
90102          let FNDRAWSCREENS(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
90104          let FNDRAWALLLISTVIEWS(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
90106          let DONTREDOLISTVIEW=0       !Force Redo Listview If Window Has To Be Rebuilt.
90108          let REPOPULATECOMBO=1        !Force Repuplate Combo if Window has to be rebuilt.
90110       end if 
90112 ! 
90114       if ~DONTREDOLISTVIEW then 
90116          let LASTROW=FNPOPULATEALLLISTVIEWS(WWINDOW,FDATAFILE,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT LISTVIEWRECORDS,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
90118          mat OLD_DATA=(0)             !Clear information so it forces read again.
90120          mat RLV_SAVEREADDATA$=("")
90122          let S_CURRENTROW=0
90124       end if 
90126    fnend 
90128 ! 
90130 Pack: ! Pack Data Functions
90132 ! 
90134    dim SCREENDATA$(1)*255
90136    dim SCREENLONGDATA$(1)*2047
90138    dim SCREENDATA(1)
90140 ! 
90142 ! .! AltStack:
90144 ! .!  0 - Regular Stack - This is used when loading a screen from inside another screen.
90146 ! .!  1 - Undo Stack - This is used when tracking undo history while editing a screen
90148 ! .!  2 - Custom Function Parameter Stack - This is used to pass the bulk of screen data into your helper library in 2 simple variables.
90150 ! .!
90152    def FNPUSHDATA(;ALTSTACK,WIPE)
90154       if ALTSTACK<>2 then 
90156          let FNPUSH$(MAT PASSEDINF$,ALTSTACK,WIPE)
90158          let FNPUSH(MAT PASSEDINF,ALTSTACK,WIPE)
90160          let FNPUSH$(MAT S$,ALTSTACK,WIPE)
90162          let FNPUSH$(MAT F$,ALTSTACK,WIPE)
90164          let FNPUSH(MAT F,ALTSTACK,WIPE)
90166 ! 
90168          let FNPUSH$(MAT FIELDSSSUBS$,ALTSTACK,WIPE)
90170          let FNPUSH$(MAT FIELDSNSUBS$,ALTSTACK,WIPE)
90172 ! 
90174          let FNPUSH$(MAT SCREENSUBS$,ALTSTACK,WIPE)
90176          let FNPUSH$(MAT FORM$,ALTSTACK,WIPE)
90178          let FNPUSH(MAT S_SUBS,ALTSTACK,WIPE)
90180          let FNPUSHVALUE$(TEMPDATA$,ALTSTACK,WIPE)
90182 ! 
90184          let FNPUSH$(MAT TEMP_S_SPEC$,ALTSTACK,WIPE)
90186          let FNPUSH(MAT OLD_DATA,ALTSTACK,WIPE)
90188          let FNPUSH$(MAT RLV_SAVEREADDATA$,ALTSTACK,WIPE)
90190       end if 
90192 ! 
90194       let FNPUSH$(MAT FIELDSSDESCRIPTION$,ALTSTACK,WIPE)
90196       let FNPUSH$(MAT FIELDSNDESCRIPTION$,ALTSTACK,WIPE)
90198       let FNPUSH$(MAT FIELDSSSPEC$,ALTSTACK,WIPE)
90200       let FNPUSH$(MAT FIELDSNSPEC$,ALTSTACK,WIPE)
90202       let FNPUSH$(MAT FIELDSSDATESPEC$,ALTSTACK,WIPE)
90204       let FNPUSH$(MAT FIELDSNDATESPEC$,ALTSTACK,WIPE)
