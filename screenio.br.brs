60830       open #0: "rows="&STR$(PRESERVENONGUIROWS)&", cols="&STR$(PRESERVENONGUICOLS),display,outin 
60832       print #0, fields "1,1,C "&STR$(PRESERVENONGUIROWS*PRESERVENONGUICOLS) : PRESERVENONGUI$
