61274                   let FNADDEXITBUTTONS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
61276 ! 
61278 ! .              ! Save the screen
61280                   if FNWRITESCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
61282                      let FNLAUNCHLATER(GS_DATA$(GS_NAMEADDEDIT))
61284                   else 
61286                      let MSGBOX("Error saving Add/Edit Screen.")
61288                      let STOPHERE=1
61290                   end if 
61292                end if 
61294             end if 
61296          end if 
61298 ! 
61300          if ~STOPHERE then 
61302             if GS_DATA$(GS_BUILDCOMBO)(1:1)="^" then ! Create Combo Screen
61304                let GENERATE=FNINPUTFIELDS(GS_DATA$(GS_LAYOUT),"Select fields for Combo Screen Listview",MAT GS_FIELD$,MAT GS_FIELDSPEC$,MAT GS_FIELDDESC$,MAT GS_DATESPEC$)
61306                if GENERATE then 
61308 ! 
61310                   let FNREADSCREEN("",MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)  !Init Blank Screen
61312                   let FNGENERATEHEADER(GS_DATA$(GS_NAMECOMBO),GS_DATA$(GS_LAYOUT),MAT SCREENIO$,MAT SCREENIO,1)
61314                   mat GAPS=(0)
61316                   let TITLEFIELD=FNADDATITLE(GS_DATA$(GS_LAYOUT),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO,1)
61318                   let FNSKIPAGAP
61320 ! 
61322 ! .              ! Add a listview on the left
61324                   let LISTVIEWFIELD=FNADDLISTVIEW(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
61326                   let HPOSITION(LISTVIEWFIELD)=5
61328                   let WIDTH(LISTVIEWFIELD)=MAX(INT((SCREENIO(SI_HSIZE)-10)/2),10)
61330                   let HEIGHT(LISTVIEWFIELD)=SCREENIO(SI_VSIZE)-8
61332                   let FGCOLOR$(LISTVIEWFIELD)="W"
61334                   let BGCOLOR$(LISTVIEWFIELD)="W"
61336 ! 
61338 ! .              ! Add some columns
61340                   for INDEX=1 to UDIM(MAT GS_FIELD$)
61342                      let NEWFIELD=FNADDCURRENTLISTCHLD(PARENT$(LISTVIEWFIELD),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,GS_FIELD$(INDEX),GS_FIELDDESC$(INDEX),GS_FIELDSPEC$(INDEX),GS_DATESPEC$(INDEX))
61344                   next INDEX
61346 ! 
61348 ! .              ! Add a Search box
61350                   if FN43 then 
61352                      let NEWFIELD=FNADDFILTERBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,INPUTEDITORMODE,LISTVIEWFIELD)
61354                   else 
61356                      let NEWFIELD=FNADDSEARCHBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,INPUTEDITORMODE,LISTVIEWFIELD)
61358                   end if 
61360                   let SPECWIDTH(LISTVIEWFIELD)=1  !Set it to search 1st column
61362                   let FGCOLOR$(NEWFIELD)="W"
61364                   let BGCOLOR$(NEWFIELD)="W"
61366 ! 
61368                   let GENERATE=FNINPUTFIELDS(GS_DATA$(GS_LAYOUT),"Select fields for Combo Screen Edit",MAT GS_FIELD$,MAT GS_FIELDSPEC$,MAT GS_FIELDDESC$,MAT GS_DATESPEC$)
61370                   if GENERATE then 
61372                      mat GAPS=(0)
61374                      let FNSKIPAGAP
61376                      let FNSKIPAGAP
61378 ! .                 ! Add a bunch of edit fields (on the right half)
61380                      for INDEX=1 to UDIM(MAT GS_FIELD$)
61382                         let NEWFIELD=FNADDANDCOLORCURRENTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO,GS_FIELD$(INDEX),GS_FIELDDESC$(INDEX),GS_FIELDSPEC$(INDEX),GS_DATESPEC$(INDEX),CAPTIONINDEX,INDEX+2)
61384                         let HPOSITION(CAPTIONINDEX)=HPOSITION(LISTVIEWFIELD)+WIDTH(LISTVIEWFIELD)+5
61386                         let WIDTH(CAPTIONINDEX)=10
61388 ! 
61390                         let HPOSITION(NEWFIELD)=HPOSITION(CAPTIONINDEX)+WIDTH(CAPTIONINDEX)+2
61392                         let WIDTH(NEWFIELD)=MIN(MAX(SCREENIO(SI_HSIZE)-HPOSITION(NEWFIELD)-5,5),WIDTH(NEWFIELD))
61394                         let FUNCTION$(NEWFIELD)="{listviewcombovalfld}"
61396                         if INDEX=1 then let CONTROLNAME$(NEWFIELD)="FirstField"
61398                      next INDEX
61400 ! 
61402 ! .                 ! Assign a read function and mainloop to make it ignore user changes when listview sel changes too.
61404                      let SCREENIO$(SI_READFN)="{listviewcomboread}"
61406                      let SCREENIO$(SI_LOOPFN)="{listviewcombomain}"
61408 ! 
61410 ! .                 ! Assign a listview postpopulate function that calls read
61412 ! .                 ! let ScreenIO$(si_PostListviewFn)="{listviewcombopost}"
61414 ! 
61416 ! .                 ! Add Exit Buttons
61418                      let FNADDEXITBUTTONS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,CANCELBUTTON,SAVEBUTTON)
61420                      let FUNCTION$(SAVEBUTTON)="{listviewcombosave}"
61422                      let DESCRIPTION$(SAVEBUTTON)="Save"
61424                      let DESCRIPTION$(CANCELBUTTON)="Quit"
61426 ! 
61428 ! .                 ! Add Add/Delete Buttons
61430                      let FNADDAEBUTTONS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,"nothing",VPOSITION(SAVEBUTTON),0,0,1,0,ADDBUTTON,EDITBUTTON,DELETEBUTTON)
61432                      if ADDBUTTON then 
61434                         let FUNCTION$(ADDBUTTON)="{listviewcomboadd}"
61436                      end if 
61438                      if DELETEBUTTON then 
61440                         let FUNCTION$(DELETEBUTTON)="{listviewcombodelete}"
61442                      end if 
61444 ! 
61446 ! .                 ! Save the screen
61448                      if FNWRITESCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
61450                         let FNLAUNCHLATER(GS_DATA$(GS_NAMECOMBO))
61452                      else 
61454                         let MSGBOX("Error saving Combo Screen.")
61456                         let STOPHERE=1
61458                      end if 
61460                   end if 
61462                end if 
61464             end if 
61466          end if 
61468          if ~NOLAUNCH then let FNLAUNCHSCREENS
61470       end if 
61472    fnend 
61474    def FNLAUNCHLATER(SCREENNAME$;___,I)
61476       let I=UDIM(MAT GS_LAUNCHLIST$)+1
61478       mat GS_LAUNCHLIST$(I)
61480       let GS_LAUNCHLIST$(I)=SCREENNAME$
61482    fnend 
61484    def FNLAUNCHSCREENS(;___,I)
61486       for I=1 to UDIM(MAT GS_LAUNCHLIST$)
61488          if EXTERNALLAUNCH OR I < UDIM(MAT GS_LAUNCHLIST$) then 
61490             let FNLAUNCHSCREEN(GS_LAUNCHLIST$(I),I)  !Normal mode launches all but 1 which it keeps in memory. External launches all.
61492          end if 
61494       next I
61496    fnend 
61498 ! 
61500    def FNADDATITLE(FILEDESCRIPTION$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO;EDIT,___,INDEX)
61502       let INDEX=FNADDCAPTION(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
61504       let CONTROLNAME$(INDEX)="Title"
61506       if EDIT then 
61508          let DESCRIPTION$(INDEX)="Edit "&UPRC$(FILEDESCRIPTION$(1:1))&LWRC$(FILEDESCRIPTION$(2:18))
61510       else 
61512          let DESCRIPTION$(INDEX)=UPRC$(FILEDESCRIPTION$(1:1))&LWRC$(FILEDESCRIPTION$(2:18))&" List"
61514       end if 
61516       let JUSTIFY$(INDEX)="C"
61518       let HPOSITION(INDEX)=6
61520       let WIDTH(INDEX)=SCREENIO(SI_HSIZE)-14
61522       let SPECWIDTH(INDEX)=LEN(TRIM$(DESCRIPTION$(INDEX)))
61524       let FNADDATITLE=INDEX
61526    fnend 
61528 ! 
61530    dim GS_CAP$(6),GS_CAPSPEC$(6)*50,GS_SPEC$(7)*50,GS_COMBO$*50,GS_LASTCHOICE$,GS_LAYOUTS$(1)
61532    def FNINPUTMAINPAGE(MAT GS_DATA$;___,WINDOW,DONE,FUNCTION,CFLD,SROWS,SCOLS,ROW,COL)
61534       let FNREADSCREENSIZE(SROWS,SCOLS)
61536       let ROW=MAX(1,INT((SROWS-9)/2))
61538       let COL=MAX(1,INT((SCOLS-40)/2))
61540       open #(WINDOW:=FNGETFILENUMBER): "srow="&STR$(ROW)&",scol="&STR$(COL)&",rows=9,cols=40,border=s,caption=Generate Screens",display,outin 
61542 ! .  ! Build Caption Specs
61544       let GS_CAPSPEC$(1)="2,2,CR 10" : let GS_CAP$(1)="Layout: "
61546       let GS_CAPSPEC$(2)="4,2,CR 10" : let GS_CAP$(2)="Listview: "
61548       let GS_CAPSPEC$(3)="5,2,CR 10" : let GS_CAP$(3)="Add/Edit: "
61550       let GS_CAPSPEC$(4)="8,20,CC 8,/W:W,B5" : let GS_CAP$(4)="Generate"
61552       let GS_CAPSPEC$(5)="8,30,CC 8,/W:W,B99" : let GS_CAP$(5)="Cancel"
61554       let GS_CAPSPEC$(6)="6,2,CR 10" : let GS_CAP$(6)="Cmb Scrn: "
61556 ! 
61558 ! .  ! Build Input Specs
61560       let GS_COMBO$="2,13,COMBO 18,=,SELECT"
61562       let GS_SPEC$(GS_LAYOUT)="2,13,COMBO 18,X/W:W,SELECT"
61564       let GS_SPEC$(GS_BUILDLISTVIEW)="4,13,CHECK 1,/W:W"
61566       let GS_SPEC$(GS_BUILDADDEDIT)="5,13,CHECK 1,/W:W"
61568       let GS_SPEC$(GS_NAMELISTVIEW)="4,15,C 18,/W:W"
61570       let GS_SPEC$(GS_NAMEADDEDIT)="5,15,C 18,/W:W"
61572       let GS_SPEC$(GS_BUILDCOMBO)="6,13,CHECK 1,/W:W"
61574       let GS_SPEC$(GS_NAMECOMBO)="6,15,C 18,/W:W"
61576 ! 
61578 ! .  ! Print Captions
61580       print #WINDOW, fields MAT GS_CAPSPEC$ : MAT GS_CAP$
61582 ! 
61584 ! .  ! Read File Layouts
61586       let FNREADLAYOUTS(MAT GS_LAYOUTS$)
61588 ! 
61590 ! .  ! Populate Combo Box
61592       mat GS_LAYOUTS$(UDIM(MAT GS_LAYOUTS$)+1)  !Add blank one
61594       print #WINDOW, fields GS_COMBO$ : MAT GS_LAYOUTS$
61596 ! 
61598 ! .  ! Check for match on the combo box
61600       if SRCH(MAT GS_LAYOUTS$,GS_DATA$(1))<=0 then 
61602          let GS_DATA$(GS_LAYOUT)=GS_LASTCHOICE$=""
61604          let GS_DATA$(GS_NAMELISTVIEW)=""
61606          let GS_DATA$(GS_NAMEADDEDIT)=""
61608          let GS_DATA$(GS_NAMECOMBO)=""
61610       end if 
61612 ! 
61614       do UNTIL DONE
61616          rinput #WINDOW, fields MAT GS_SPEC$ : MAT GS_DATA$
61618          let FUNCTION=FKEY
61620          let CFLD=CURFLD
61622          let CURFLD(CFLD,FUNCTION)
61624 ! 
61626          if GS_LASTCHOICE$><GS_DATA$(GS_LAYOUT) then 
61628             let GS_DATA$(GS_NAMELISTVIEW)=UPRC$(TRIM$(GS_DATA$(GS_LAYOUT)))(1:14)&"LIST"
61630             let GS_DATA$(GS_NAMEADDEDIT)=UPRC$(TRIM$(GS_DATA$(GS_LAYOUT)))(1:14)&"EDIT"
61632             let GS_DATA$(GS_NAMECOMBO)=UPRC$(TRIM$(GS_DATA$(GS_LAYOUT)))(1:13)&"COMBO"
61634             let GS_LASTCHOICE$=GS_DATA$(GS_LAYOUT)
61636          end if 
61638 ! 
61640          let FNCLEANSTRING(GS_DATA$(GS_NAMELISTVIEW))
61642          let FNCLEANSTRING(GS_DATA$(GS_NAMEADDEDIT))
61644          let FNCLEANSTRING(GS_DATA$(GS_NAMECOMBO))
61646 ! 
61648          if FUNCTION = 5 then ! #Select# Function #Case# 5
61650             if LEN(TRIM$(GS_DATA$(GS_LAYOUT))) AND (GS_DATA$(GS_BUILDLISTVIEW)(1:1)="^" AND LEN(TRIM$(GS_DATA$(GS_NAMELISTVIEW)))) OR (GS_DATA$(GS_BUILDADDEDIT)(1:1)="^" AND LEN(TRIM$(GS_DATA$(GS_NAMEADDEDIT)))) OR (GS_DATA$(GS_BUILDCOMBO)(1:1)="^" AND LEN(TRIM$(GS_DATA$(GS_NAMECOMBO)))) then 
61652                let DONE=1
61654             else 
61656                let MSGBOX("You must select a file layout, check at least 1 box above, and enter a valid screen name.","Nothing to do.")
61658             end if 
61660          else if FUNCTION = 99 OR FUNCTION = 93 then ! #Case# 99 # 93
61662             let DONE=-1
61664          end if                       !#End Select#
61666       loop 
61668 ! 
61670       close #WINDOW: 
61672 ! 
61674       if DONE=1 then 
61676          let FNINPUTMAINPAGE=1
61678       end if 
61680    fnend 
61682 ! 
61684    dim IF_SFIELDS$(1)*64,IF_NFIELDS$(1)*64
61686    dim IF_SFIELDSSPEC$(1)*32,IF_NFIELDSSPEC$(1)*32
61688    dim IF_SFIELDSDESCRIPTION$(1)*255,IF_NFIELDSDESCRIPTION$(1)*255
61690    dim IF_SPOS(1), IF_NPOS(1)
61692    dim IF_SDATESPEC$(1)*64,IF_NDATESPEC$(1)*64
61694 ! 
61696    dim ROWSELECTED(1)
61698    def FNINPUTFIELDS(LAYOUT$,CAPTION$*40,MAT SELECTEDFIELDS$,MAT SELECTEDSPEC$,MAT SELECTEDDESCRIPTION$,MAT SELECTEDDATESPEC$;___,LISTSPEC$,ROW,COL,ROWS,SROWS,SCOLS,WINDOW,DONE,FUNCTION,CFLD,PREFIX$,SELCOUNT,INDEX)
61700 ! .  ! Read Fields
61702       let FNREADLAYOUTARRAYS(LAYOUT$,PREFIX$,MAT IF_SFIELDS$,MAT IF_NFIELDS$,MAT IF_SFIELDSSPEC$,MAT IF_NFIELDSSPEC$,MAT IF_SFIELDSDESCRIPTION$,MAT IF_NFIELDSDESCRIPTION$,MAT IF_SPOS,MAT IF_NPOS,0,MAT IF_SDATESPEC$,MAT IF_NDATESPEC$)
61704 ! 
61706       let FNREADSCREENSIZE(SROWS,SCOLS)
61708       let ROWS=SROWS-8 : let ROWS=MAX(ROWS,6) : let ROWS=MIN(ROWS,UDIM(MAT IF_SFIELDS$)+UDIM(MAT IF_NFIELDS$)+5)  !Total Rows
61710       let COL=MAX(1,INT((SCOLS-42)/2)) : let ROW=MAX(1,INT((SROWS-(ROWS+2))/2))  !Position in Center
61712 ! 
61714       open #(WINDOW:=FNGETFILENUMBER): "srow="&STR$(ROW)&",scol="&STR$(COL)&",rows="&STR$(ROWS)&",cols=40,border=s",display,outin 
61716 ! 
61718 ! .  ! Print listview
61720       let FIELDSHEADINGS$(1)="Name"
61722       let FIELDSWIDTHS(1)=9
61724       let FIELDSSPEC$(1)="V 50"
61726       let FIELDSHEADINGS$(2)="Description"
61728       let FIELDSWIDTHS(2)=14
61730       let FIELDSSPEC$(2)="V 255"
61732       let FIELDSHEADINGS$(3)="Type"
61734       let FIELDSWIDTHS(3)=5
61736       let FIELDSSPEC$(3)="V 30"
61738       let FIELDSHEADINGS$(4)="Date"
61740       let FIELDSWIDTHS(4)=3
61742       let FIELDSSPEC$(4)="V 64"
61744 ! 
61746       let LISTSPEC$="3,1,LIST "&STR$(ROWS-4)&"/40"
61748 ! 
61750       print #WINDOW, fields LISTSPEC$&",HEADERS,/W:W,1300" : (MAT FIELDSHEADINGS$, MAT FIELDSWIDTHS, MAT FIELDSSPEC$)
61752 ! 
61754 ! .  ! Print Exit Buttons
61756       print #WINDOW, fields STR$(ROWS)&",20,CC 8,/W:W,B7;"&STR$(ROWS)&",30,CC 8,/W:W,B99" : "Generate","Cancel"
61758       print #WINDOW, fields "1,1,CC 40" : CAPTION$
61760 ! 
61762 ! .  ! Populate Listview
61764       print #WINDOW, fields LISTSPEC$&",=,1300" : (MAT IF_SFIELDS$, MAT IF_SFIELDSDESCRIPTION$, MAT IF_SFIELDSSPEC$, MAT IF_SDATESPEC$)
61766       print #WINDOW, fields LISTSPEC$&",+,1300" : (MAT IF_NFIELDS$, MAT IF_NFIELDSDESCRIPTION$, MAT IF_NFIELDSSPEC$, MAT IF_NDATESPEC$)
61768 ! 
61770       do UNTIL DONE
61772          rinput #WINDOW, fields LISTSPEC$&",ROWCNT,SEL" : SELCOUNT
61774          mat ROWSELECTED(SELCOUNT)    !We do it the old way so its compatible with both ways
61776          rinput #WINDOW, fields LISTSPEC$&",ROWSUB,SEL,NOWAIT" : MAT ROWSELECTED
61778 ! 
61780          let FUNCTION=FKEY
61782          let CFLD=CURFLD
61784          let CURFLD(CFLD,FUNCTION)
61786 ! 
61788          if FUNCTION = 7 then ! #Select# Function #Case# 7
61790 ! 
61792 ! .        ! Return Selected Fields
61794 ! .        ! Clear the arrays first
61796             mat SELECTEDFIELDS$(0)
61798             mat SELECTEDSPEC$(0)
61800             mat SELECTEDDESCRIPTION$(0)
61802             mat SELECTEDDATESPEC$(0)
61804 ! 
61806 ! .        ! Loop through selected, and build them into passback arrays
61808             for INDEX=1 to UDIM(MAT ROWSELECTED)
61810                if ROWSELECTED(INDEX)<=UDIM(MAT IF_SFIELDS$) then 
61812                   mat SELECTEDFIELDS$(UDIM(MAT SELECTEDFIELDS$)+1)
61814                   mat SELECTEDSPEC$(UDIM(MAT SELECTEDFIELDS$))
61816                   mat SELECTEDDESCRIPTION$(UDIM(MAT SELECTEDFIELDS$))
61818                   mat SELECTEDDATESPEC$(UDIM(MAT SELECTEDFIELDS$))
61820 ! 
61822                   let SELECTEDFIELDS$(UDIM(MAT SELECTEDFIELDS$))=IF_SFIELDS$(ROWSELECTED(INDEX))
61824                   let SELECTEDSPEC$(UDIM(MAT SELECTEDFIELDS$))=IF_SFIELDSSPEC$(ROWSELECTED(INDEX))
61826                   let SELECTEDDESCRIPTION$(UDIM(MAT SELECTEDFIELDS$))=IF_SFIELDSDESCRIPTION$(ROWSELECTED(INDEX))
61828                   let SELECTEDDATESPEC$(UDIM(MAT SELECTEDFIELDS$))=IF_SDATESPEC$(ROWSELECTED(INDEX))
61830                else 
61832                   mat SELECTEDFIELDS$(UDIM(MAT SELECTEDFIELDS$)+1)
61834                   mat SELECTEDSPEC$(UDIM(MAT SELECTEDFIELDS$))
61836                   mat SELECTEDDESCRIPTION$(UDIM(MAT SELECTEDFIELDS$))
61838                   mat SELECTEDDATESPEC$(UDIM(MAT SELECTEDFIELDS$))
61840 ! 
61842                   let SELECTEDFIELDS$(UDIM(MAT SELECTEDFIELDS$))=IF_NFIELDS$(ROWSELECTED(INDEX)-UDIM(IF_SFIELDS$))
61844                   let SELECTEDSPEC$(UDIM(MAT SELECTEDFIELDS$))=IF_NFIELDSSPEC$(ROWSELECTED(INDEX)-UDIM(IF_SFIELDS$))
61846                   let SELECTEDDESCRIPTION$(UDIM(MAT SELECTEDFIELDS$))=IF_NFIELDSDESCRIPTION$(ROWSELECTED(INDEX)-UDIM(IF_SFIELDS$))
61848                   let SELECTEDDATESPEC$(UDIM(MAT SELECTEDFIELDS$))=IF_NDATESPEC$(ROWSELECTED(INDEX)-UDIM(IF_SFIELDS$))
61850                end if 
61852             next INDEX
61854 ! 
61856             let DONE=1
61858          else if FUNCTION = 99 OR FUNCTION = 93 then ! #Case# 99 # 93
61860             let DONE=-1
61862          end if                       !#End Select#
61864       loop 
61866 ! 
61868       close #WINDOW: 
61870 ! 
61872       if DONE=1 then 
61874          let FNINPUTFIELDS=1
61876       end if 
61878    fnend 
61880 ! 
61882    def FNCLEANSTRING(&STRING$;___,INDEX)
61884       do 
61886          let INDEX+=1
61888          if INDEX<=LEN(STRING$) then 
61890             if POS("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",UPRC$(STRING$(INDEX:INDEX)))<=0 then 
61892                let STRING$(INDEX:INDEX)=""
61894                let INDEX-=1
61896             end if 
61898          end if 
61900       loop WHILE INDEX<LEN(STRING$)
61902    fnend 
