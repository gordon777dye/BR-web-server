45070 Openfieldswindow: !  Open  The Fields Window Here
45075    def FNOPENFIELDSWINDOW(WTOOLBAR,TOOLBARVSIZE,BUTTONSIZE)
45080       let STATIC_FIELDSVSIZE=TOOLBARVSIZE - BUTTONSIZE - 19
