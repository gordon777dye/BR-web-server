18662 ! 
18664                   if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="frame" then 
18666                      let FNPRINTDOTS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,VPOSITION(CONTROL),HPOSITION(CONTROL),WIDTH(CONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CONTROL)))=="combo")),HEIGHT(CONTROL))
18668                      let FNREDRAWSCREENPART(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,VPOSITION(CONTROL),HPOSITION(CONTROL),WIDTH(CONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CONTROL)))=="combo")),HEIGHT(CONTROL))
18670                   end if 
18672 ! 
18674                   let FNCHANGEFORCEVISIBILITY(0)
18676 ! 
18678                   if FUNCTION=110 then 
18680                      let CONTROL+=1
18682                      if CONTROL>UDIM(MAT CONTROLNAME$) then let CONTROL=1
18684                   else if FUNCTION=111 then 
18686                      let CONTROL-=1
18688                      if ~CONTROL then let CONTROL=UDIM(MAT CONTROLNAME$)
18690                   else 
18692                      let CONTROL=FUNCTION-1500
18694                   end if 
18696                   let NEWV=VPOSITION(CONTROL)
18698                   let NEWH=HPOSITION(CONTROL)
18700                   let NEWW=WIDTH(CONTROL)
18702                   let NEWHTH=HEIGHT(CONTROL)
18704 ! 
18706                   let FNSELECTFRAMECONTROLS(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
18708 ! 
18710                   let FNCHECKPOINT(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
18712                end if 
18714 ! 
18716 ! .             ! Standardize Heights
18718             loop UNTIL EXITMOVEMENT
18720             let SCR_FREEZE
18722             execute "config keyboard clear"  !Clear Keyboard Remapping
18724             let FNPREFORMOBJECTMOVEMENT=FUNCTION
18726          end if 
18728       else 
18730          let MODE=INPUTATTRIBUTESMODE
18732       end if 
18734    fnend 
18736 ! 
18738    dim ALREADYMOVED(1)
18740    dim ZERO(1)
18742 Movecontrol: ! Move A Control And Output  The Specs To Move It
18744    def FNMOVECONTROL(INDEX,NEWV,NEWH,NEWW,NEWHTH,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;DONTACTIVE,DONTERASEYET,MAT SELCONT,___,WEDITOR,RELATEDINDEX,ERASEROW,ERASECOL,ERASEWIDTH,ERASEHEIGHT,DOTSIZE,OLDV,OLDH,OLDWTH,OLDHTH,OLDERASEROW,OLDERASECOL,LEFTDISTANCE,RIGHTDISTANCE,TOPDISTANCE,BOTTOMDISTANCE,SELINDEX,BORDERSIZE)
18746       let WEDITOR=FNGETEDITORWINDOW
18748 ! 
18750 !      Let Msgbox("Move Control "&Str$(Index)&":"&Str$(Vposition(Index))&","&Str$(Newv)&":"&Str$(Hposition(Index))&","&Str$(Newh))
18752       if ~ALREADYMOVED(INDEX) then 
18754 ! 
18756 !         ! If things are selected and we're moving the selection then
18758 !         !  we need to make sure that the distance from here to the bottommost control is also
18760 !         !  considered.
18762 ! 
18764 !         ! This code is designed to ensure that controls dont bunch up
18766 !         ! when moving groups of them near the edge with the mouse
18768 !         !  but alas.. it didn't work so its commented out now.
18770 ! 
18772 !         let TopDistance=0 : let BottomDistance=0
18774 !         let LeftDistance=0 : let RightDistance=0
18776 !         if Udim(Mat Selcont)>=Index And selcont(Index) then
18778 !            for selIndex=1 to udim(mat selcont)
18780 !               if selcont(selIndex) then
18782 !                  let topdistance=max(topdistance,VPosition(Index)-Vposition(selIndex))
18784 !                  let bottomdistance=max(bottomdistance,(VPosition(selIndex)+Height(selIndex)-1)-(VPosition(Index)+Height(Index)-1))
18786 !                  let leftdistance=max(leftdistance,HPosition(Index)-HPosition(selIndex))
18788 !                  let rightDistance=max(Rightdistance,(HPosition(selIndex)+Width(selIndex)-1)-(HPosition(Index)+Width(Index)-1))
18790 !               end if
18792 !            next selIndex
18794 !         end if
18796 ! 
18798 !         let Newv=Max(Min(Newv,1+Screenio(Si_Vsize)-Max(Newhth,1)+BottomDistance),1+TopDistance)
18800 !         let Newh=Max(Min(Newh,1+Screenio(Si_Hsize)-Neww+RightDistance),1+LeftDistance)
18802 ! 
18804          if (LWRC$(TRIM$(FIELDTYPE$(INDEX)))="frame" OR LWRC$(TRIM$(FIELDTYPE$(INDEX)))="screen") AND GRIDLINES(INDEX) then let BORDERSIZE=1
18806 ! 
18808          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"screen" then 
18810             let NEWW=MAX(NEWW,1)
18812             let NEWW=MIN(SCREENIO(SI_HSIZE)-2*BORDERSIZE,NEWW)
18814             let NEWHTH=MAX(NEWHTH,1)
18816             let NEWHTH=MIN(SCREENIO(SI_VSIZE)-2*BORDERSIZE,NEWHTH)
18818          end if 
18820 ! 
18822          let NEWV=MAX(MIN(NEWV,1+SCREENIO(SI_VSIZE)-MAX(NEWHTH,1)-BORDERSIZE),1+BORDERSIZE)
18824          let NEWH=MAX(MIN(NEWH,1+SCREENIO(SI_HSIZE)-MAX(NEWW,1)-BORDERSIZE),1+BORDERSIZE)
18826 ! 
18828          if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listview" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "p" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "frame" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "listview"#"p"#"frame"#"caption"#"c"#"button"
18830             let NEWHTH=MAX(1,NEWHTH)
18832          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "screen" then ! #Case# "screen"
18834 ! .        ! Child Screen Controls can't change size.
18836             let NEWHTH=HEIGHT(INDEX)
18838             let NEWW=WIDTH(INDEX)
18840          else ! #Case Else#
18842             let NEWHTH=1
18844          end if                       !#End Select#
18846 ! 
18848          if NEWV<>VPOSITION(INDEX) OR NEWH<>HPOSITION(INDEX) OR NEWW<>WIDTH(INDEX) OR NEWHTH<>HEIGHT(INDEX) then 
18850             let ERASEROW=VPOSITION(INDEX)
18852             let ERASECOL=HPOSITION(INDEX)
18854             let ERASEWIDTH=WIDTH(INDEX)+(2*(LWRC$(TRIM$(FIELDTYPE$(INDEX)))=="combo"))
18856             let ERASEHEIGHT=MAX(HEIGHT(INDEX),1)
18858 ! 
18860             if (RELATEDINDEX:=FNFINDRELATEDCONTROL(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)) then 
18862                let FNMOVECONTROL(RELATEDINDEX,VPOSITION(RELATEDINDEX)+NEWV-VPOSITION(INDEX),HPOSITION(RELATEDINDEX)+NEWH-HPOSITION(INDEX),WIDTH(RELATEDINDEX),HEIGHT(RELATEDINDEX),MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
18864             end if 
18866 ! .        ! Move controls inside frame if frame moves.
18868             if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="frame" then 
18870                if (NEWV<>VPOSITION(INDEX) OR NEWH<>HPOSITION(INDEX)) then 
18872                   for RELATEDINDEX=1 to UDIM(MAT FRAMEMOVEMENT)
18874                      if FRAMEMOVEMENT(RELATEDINDEX) then 
18876                         let FNMOVECONTROL(RELATEDINDEX,VPOSITION(RELATEDINDEX)+NEWV-VPOSITION(INDEX),HPOSITION(RELATEDINDEX)+NEWH-HPOSITION(INDEX),WIDTH(RELATEDINDEX)+NEWW-WIDTH(INDEX),HEIGHT(RELATEDINDEX)+NEWHTH-HEIGHT(INDEX),MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,1)
18878                      end if 
18880                   next RELATEDINDEX
18882                end if 
18884             end if 
18886             if UDIM(MAT SELCONT)>=INDEX AND SELCONT(INDEX) then 
18888                let OLDV=VPOSITION(INDEX)
18890                let OLDH=HPOSITION(INDEX)
18892                let OLDWTH=WIDTH(INDEX)
18894                let OLDHTH=HEIGHT(INDEX)
18896                for RELATEDINDEX=1 to UDIM(MAT SELCONT)
18898                   if SELCONT(RELATEDINDEX) then 
18900 ! .                  ! Expand EraseRow and EraseCol to include new control...
18902                      let OLDERASEROW=ERASEROW
18904                      let OLDERASECOL=ERASECOL
18906                      let ERASEROW=MIN(ERASEROW,VPOSITION(RELATEDINDEX))
18908                      let ERASECOL =MIN(ERASECOL,HPOSITION(RELATEDINDEX))
18910                      let ERASEWIDTH=MAX(OLDERASECOL+ERASEWIDTH,HPOSITION(RELATEDINDEX)+WIDTH(RELATEDINDEX)+(2*(LWRC$(TRIM$(FIELDTYPE$(RELATEDINDEX)))=="combo")))-ERASECOL
18912                      let ERASEHEIGHT=MAX(OLDERASEROW+ERASEHEIGHT,VPOSITION(RELATEDINDEX)+MAX(1,HEIGHT(RELATEDINDEX)))-ERASEROW
18914 ! 
18916                      let FNMOVECONTROL(RELATEDINDEX,VPOSITION(RELATEDINDEX)+NEWV-OLDV,HPOSITION(RELATEDINDEX)+NEWH-OLDH,WIDTH(RELATEDINDEX)+NEWW-OLDWTH,HEIGHT(RELATEDINDEX)+NEWHTH-OLDHTH,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1,1)
18918                   end if 
18920                next RELATEDINDEX
18922             end if 
18924          end if 
18926 ! 
18928          let VPOSITION(INDEX)=NEWV
18930          let HPOSITION(INDEX)=NEWH
18932          let WIDTH(INDEX)=NEWW
18934          let HEIGHT(INDEX)=NEWHTH
18936 ! 
18938          if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "frame" then ! #Select# lwrc$(trim$(fieldType$(index))) #case# "frame"
18940          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "textbox" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" then ! #Case# "c" # "button" # "textbox" # "caption"
18942             if HEIGHT(INDEX)<=1 then 
18944                let FNCHANGEFORCEVISIBILITY(1)
18946             end if 
18948          else ! #Case Else#
18950             let FNCHANGEFORCEVISIBILITY(1)
18952          end if                       !#End Select#
18954 ! 
18956          if ERASEROW AND ERASECOL AND ERASEWIDTH AND ERASEHEIGHT AND ~DONTERASEYET then 
18958             let DOTSIZE=FNCALCULATEDOTSIZE(SCREENIO(SI_VSIZE),SCREENIO(SI_HSIZE))
18960             let FNPRINTDOTS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ERASEROW,ERASECOL,ERASEWIDTH,ERASEHEIGHT)  !Erase Old Control
18962             if DOTSIZE>1 then 
18964                let FNPRINTDOTS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,VPOSITION(INDEX),HPOSITION(INDEX),WIDTH(INDEX)+(2*(LWRC$(TRIM$(FIELDTYPE$(INDEX)))=="combo")),MAX(HEIGHT(INDEX),1))
18966             end if 
18968             let FNREDRAWSCREENPART(WEDITOR,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ERASEROW,ERASECOL,ERASEWIDTH,ERASEHEIGHT)
18970          end if 
18972 ! 
18974          let FNDRAWCONTROL(WEDITOR,INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,~DONTACTIVE)
18976 ! 
18978          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="frame" then 
18980             let FNCHANGEFORCEVISIBILITY(1)
18982             let FNREDRAWSCREENPART(WWINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,VPOSITION(CONTROL),HPOSITION(CONTROL),WIDTH(CONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CONTROL)))=="combo")),HEIGHT(CONTROL))
18984          end if 
18986 ! 
18988          let FNCHANGEFORCEVISIBILITY(0)
18990          let ALREADYMOVED(INDEX)=1
18992       end if 
18994    fnend 
18996 ! 
18998    def FNREDRAWSCREENPART(WEDITOR,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ERASEROW,ERASECOL,ERASEWIDTH,ERASEHEIGHT;___,CHECKCONTROL)
19000       for CHECKCONTROL=1 to UDIM(MAT CONTROLNAME$)
19002          if LWRC$(TRIM$(FIELDTYPE$(CHECKCONTROL)))<>"frame" AND LWRC$(TRIM$(FIELDTYPE$(CHECKCONTROL)))<>"listchld" then 
19004             if ((VPOSITION(CHECKCONTROL)+MAX(HEIGHT(CHECKCONTROL),1)-1 >= ERASEROW) AND (VPOSITION(CHECKCONTROL)<=ERASEROW+ERASEHEIGHT-1)) then 
19006                if ((HPOSITION(CHECKCONTROL)+WIDTH(CHECKCONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CHECKCONTROL)))=="combo"))-1 >= ERASECOL) AND (HPOSITION(CHECKCONTROL)<=ERASECOL+ERASEWIDTH-1)) then 
19008                   let FNDRAWCONTROL(WEDITOR,CHECKCONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19010                end if 
19012             end if 
19014          end if 
19016       next CHECKCONTROL
19018    fnend 
19020 ! 
19022    dim FRAMEMOVEMENT(1)
19024    def FNSELECTFRAMECONTROLS(FRAME,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19026       mat FRAMEMOVEMENT(UDIM(MAT FIELDTYPE$))
19028       if LWRC$(TRIM$(FIELDTYPE$(FRAME)))="frame" then 
19030          for INDEX=1 to UDIM(MAT FIELDTYPE$)
19032             if INDEX<>FRAME then 
19034                if ((VPOSITION(INDEX)>=VPOSITION(FRAME)) AND (VPOSITION(INDEX)+MAX(HEIGHT(INDEX),1)<=VPOSITION(FRAME)+HEIGHT(FRAME))) then 
19036                   if ((HPOSITION(INDEX)>=HPOSITION(FRAME)) AND (HPOSITION(INDEX)+WIDTH(INDEX)<=HPOSITION(FRAME)+WIDTH(FRAME))) then 
19038                      let FRAMEMOVEMENT(INDEX)=1
19040                   end if 
19042                end if 
19044             end if 
19046          next INDEX
19048       else 
19050          mat FRAMEMOVEMENT=(0)
19052       end if 
19054    fnend 
19056 ! 
19058 Deletecontrol: ! Delete The Given Control And Return A New Control
19060    def FNDELETECONTROL(CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;MAT SELCONT,___,INDEX)
19062       if UDIM(MAT SELCONT)>=CONTROL AND SELCONT(CONTROL) then 
19064          let INDEX=0
19066          do WHILE INDEX<UDIM(MAT SELCONT)
19068             let INDEX+=1
19070             if SELCONT(INDEX) then 
19072                let FNDELETE(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19074                if INDEX<UDIM(MAT SELCONT) then 
19076                   mat SELCONT(INDEX:UDIM(MAT SELCONT)-1)=SELCONT(INDEX+1:UDIM(MAT SELCONT))
19078                end if 
19080                mat SELCONT(UDIM(MAT SELCONT)-1)
19082                let INDEX-=1
19084             end if 
19086          loop WHILE UDIM(MAT SELCONT)
19088       else 
19090          let FNDELETE(CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19092       end if 
19094       let FNRENDERSCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
19096 ! 
19098       if CONTROL>UDIM(MAT CONTROLNAME$) then let CONTROL=UDIM(MAT CONTROLNAME$)
19100       let FNDELETECONTROL=CONTROL
19102    fnend 
19104 ! 
19106    def FNDELETE(CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,ROW,COL,WIDTH,HEIGHT,CHILDSEARCH)
19108       let ROW=VPOSITION(CONTROL)
19110       let COL=HPOSITION(CONTROL)
19112       let WIDTH=WIDTH(CONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CONTROL)))=="combo"))
19114       let HEIGHT=HEIGHT(CONTROL)
19116 ! 
19118       if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "listview" then ! #Select# Lwrc$(Trim$(Fieldtype$(Control))) #Case# "listview"
19120 ! .       ! If its a listview, then we need to delete all its children too.
19122          for CHILDSEARCH=1 to UDIM(MAT FIELDTYPE$)
19124             if CHILDSEARCH<=UDIM(MAT FIELDTYPE$) then 
19126                if LWRC$(TRIM$(FIELDTYPE$(CHILDSEARCH)))="listchld" AND PARENT$(CHILDSEARCH)=PARENT$(CONTROL) then 
19128                   for INDEX=CHILDSEARCH to UDIM(MAT CONTROLNAME$)-1
19130                      let FNCOPYCONTROLARRAYS(INDEX,INDEX+1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19132                   next INDEX
19134                   let FNRESIZECONTROLARRAYS(UDIM(MAT CONTROLNAME$)-1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19136                end if 
19138             end if 
19140          next CHILDSEARCH
19142       else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "frame" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "caption" then ! #Case# "frame" # "c" # "button" # "caption"
19144 ! .     ! if it has a frame, we need to close the window
19146          let FNCLOSEFRAMEWINDOW(PARENT$(CONTROL))
19148       else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "screen" then ! #Case# "screen"
19150 ! .     ! if its a screen, we need to close it
19152          let CHILDSEARCH=SRCH(MAT SCREENKEYS$,PARENT$(CONTROL))
19154          if CHILDSEARCH>0 then 
19156             if SCREENWINDOWS(CHILDSEARCH) AND FILE(CHILDSEARCH)<>-1 then close #SCREENWINDOWS(CHILDSEARCH): 
19158             for INDEX=CHILDSEARCH to UDIM(MAT SCREENKEYS$)-1
19160                let SCREENKEYS$(INDEX)=SCREENKEYS$(INDEX+1)
19162                let SCREENWINDOWS(INDEX)=SCREENWINDOWS(INDEX+1)
19164             next INDEX
19166             mat SCREENKEYS$(UDIM(MAT SCREENKEYS$)-1)
19168             mat SCREENWINDOWS(UDIM(MAT SCREENWINDOWS)-1)
19170          end if 
19172 ! 
19174       end if                          !#End Select#
19176 ! 
19178       for INDEX=CONTROL to UDIM(MAT CONTROLNAME$)-1
19180          let FNCOPYCONTROLARRAYS(INDEX,INDEX+1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19182       next INDEX
19184       let FNRESIZECONTROLARRAYS(UDIM(MAT CONTROLNAME$)-1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
19186 ! 
19188       let FNCHANGEFORCEVISIBILITY(1)
19190       let FNPRINTDOTS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ROW,COL,WIDTH,HEIGHT)
19192       let FNCHANGEFORCEVISIBILITY(0)
19194    fnend 
19196 ! 
19198 ! 
19200 Findrelatedcontrol: ! Finds The Related Control If Any
19202    def FNFINDRELATEDCONTROL(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,RELATEDINDEX)
19204       if TRIM$(LWRC$(FIELDTYPE$(CONTROL))) = "c" OR TRIM$(LWRC$(FIELDTYPE$(CONTROL))) = "search" OR TRIM$(LWRC$(FIELDTYPE$(CONTROL))) = "filter" OR TRIM$(LWRC$(FIELDTYPE$(CONTROL))) = "combo" then ! #Select# Trim$(Lwrc$(Fieldtype$(Control))) #Case# "c" # "search" # "filter" # "combo"
19206          if TRIM$(DESCRIPTION$(CONTROL))<>"" then 
19208             if (RELATEDINDEX:=SRCH(MAT CONTROLNAME$,DESCRIPTION$(CONTROL))) > 0 then 
19210                let FNFINDRELATEDCONTROL=RELATEDINDEX
19212             end if 
19214          end if 
19216       end if                          !#End Select#
19218    fnend 
19220 ! 
19222 ! 
20000 !  #Autonumber# 20000,5
20005 ! *****************************************************************
20010 ! ****************************** Dots *****************************
20015 ! *****************************************************************
20020 Adddot: ! Adds A Dot To The Dots Arrays
20025    def FNADDDOT(ROW,COL,SIZE,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST;___,INDEX)
20030       let INDEX=SRCH(MAT DOTEXIST,0)
20035       if INDEX<1 then 
20040          let INDEX=UDIM(MAT DOTROW) + 1
20045          mat DOTROW(INDEX)
20050          mat DOTCOL(INDEX)
20055          mat DOTSIZE(INDEX)
20060          mat DOTEXIST(INDEX)
20065       end if 
20070       let DOTROW(INDEX)=ROW
20075       let DOTCOL(INDEX)=COL
20080       let DOTSIZE(INDEX)=SIZE
20085       let DOTEXIST(INDEX)=1
20090 ! 
20095       let FNADDDOT=INDEX
20100    fnend 
20105 ! 
20110 Maskdot: ! Masks Out A Dot From The Dots Arrays
20115    def FNMASKDOT(ROW,COL,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST;___,DOT,INDEX,JNDEX)
20120       let DOT=FNFINDDOT(ROW,COL,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST)
20125       if DOT then 
20130          for INDEX=DOTROW(DOT) to DOTROW(DOT)+DOTSIZE(DOT)-1
20135             for JNDEX=DOTCOL(DOT) to DOTCOL(DOT)+DOTSIZE(DOT)-1
20140                if INDEX<>ROW OR JNDEX<>COL then 
20145                   let FNADDDOT(INDEX,JNDEX,1,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST)  !Add Smaller Dots In The Old Positions
20150                end if 
20155             next JNDEX
20160          next INDEX
20165 ! 
20170          let DOTROW(DOT)=0            !Delete Dot
20175          let DOTCOL(DOT)=0
20180          let DOTSIZE(DOT)=0
20185          let DOTEXIST(DOT)=0
20190       end if 
20195    fnend 
20200 ! 
20205 Finddot: ! Find Which Dot Exists On A Given Row
20210    def FNFINDDOT(ROW,COL,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST;___,INDEX,DOTFOUND)
20215       do WHILE (INDEX:=SRCH(MAT DOTEXIST,1,INDEX+1))>0
20220          if INDEX>0 then 
20225             if (ROW>=DOTROW(INDEX)) AND (ROW<=DOTROW(INDEX)+DOTSIZE(INDEX)-1) then 
20230                if (COL>=DOTCOL(INDEX)) AND (COL<=DOTCOL(INDEX)+DOTSIZE(INDEX)-1) then 
20235                   let DOTFOUND=1      !Found
20240                   exit do 
20245                end if 
20250             end if 
20255          end if 
20260       loop 
20265 ! 
20270       if DOTFOUND then 
20275          let FNFINDDOT=INDEX
20280       end if 
20285    fnend 
20290 ! 
20295 Printdots: ! Print The Clickable Dots For Click-To-Move Functionality
20300    def FNPRINTDOTS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;MASKROW,MASKCOL,MASKWIDTH,MASKHEIGHT,___,INDEX,ROW,COL,DOTSIZE,TR,TC,PRINTFULLSCREEN,WINDOW)
20305       dim DOTROW(1), DOTCOL(1), DOTSIZE(1),DOTEXIST(1)
20310 ! 
20315       let WINDOW=FNGETEDITORWINDOW
20320 ! 
20325       if WINDOW>0 then 
20330          mat DOTROW(0) : mat DOTCOL(0) : mat DOTSIZE(0) : mat DOTEXIST(0)
20335 ! 
20340          let DOTSIZE=FNCALCULATEDOTSIZE(SCREENIO(SI_VSIZE),SCREENIO(SI_HSIZE))
20345 ! 
20350          if ~(MASKROW OR MASKCOL OR MASKWIDTH OR MASKHEIGHT) then 
20355             let PRINTFULLSCREEN=1
20360          end if 
20365 ! 
20370          if MASKROW AND MASKCOL AND MASKWIDTH AND ~MASKHEIGHT then 
20375             let MASKHEIGHT=1
20380          end if 
20385 ! 
20390          if SETTINGTEMPDOTS OR POS(UPRC$(ENV$("clickmove")),"Y") then 
20395 !    .      Assign Default Mask Area
20400             if ~MASKROW then let MASKROW=1
20405             if ~MASKCOL then let MASKCOL=1
20410             if ~MASKWIDTH then let MASKWIDTH=SCREENIO(SI_HSIZE)-MASKCOL+1
20415             if ~MASKHEIGHT then let MASKHEIGHT=SCREENIO(SI_VSIZE)-MASKROW+1
20420 ! 
20425 !    .      Grow Mask Area Slightly To Include Only Whole Dots
20430             let MASKHEIGHT+=(MASKROW-((INT((MASKROW-1)/DOTSIZE)*DOTSIZE)+1))
20435             let MASKWIDTH+=(MASKCOL-((INT((MASKCOL-1)/DOTSIZE)*DOTSIZE)+1))
20440             let MASKROW=(INT((MASKROW-1)/DOTSIZE)*DOTSIZE)+1
20445             let MASKCOL=(INT((MASKCOL-1)/DOTSIZE)*DOTSIZE)+1
20450             let MASKHEIGHT=INT(((MASKHEIGHT-1)/DOTSIZE)+1)*DOTSIZE
20455             let MASKWIDTH=INT(((MASKWIDTH-1)/DOTSIZE)+1)*DOTSIZE
20460 ! 
20465 !    .      Build Dots Only For Mask Area
20470             for ROW=MASKROW to MASKROW+MASKHEIGHT-1 step DOTSIZE
20475                for COL=MASKCOL to MASKCOL+MASKWIDTH-1 step DOTSIZE
20480                   let FNADDDOT(ROW,COL,DOTSIZE,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST)
20485                next COL
20490             next ROW
20495 ! 
20500 !    .      Finally, Mask Off Any Dots That May Be Outside The Screen.
20505             for COL=SCREENIO(SI_HSIZE)+1 to MASKCOL+MASKWIDTH
20510                for ROW=MASKROW to MASKROW+MASKHEIGHT
20515                   let FNMASKDOT(ROW,COL,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST)
20520                next ROW
20525             next COL
20530             for ROW=SCREENIO(SI_VSIZE)+1 to MASKROW+MASKHEIGHT
20535                for COL=MASKCOL to MASKCOL+MASKWIDTH
20540                   let FNMASKDOT(ROW,COL,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST)
20545                next COL
20550             next ROW
20555 ! 
20560 !    .      Mask Controls Only If They Fall Inside The Already Defined Mask Area.
20565             for INDEX=1 to UDIM(CONTROLNAME$)
20570                if LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"listchld" AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"frame" then 
20575                   for ROW=VPOSITION(INDEX) to (VPOSITION(INDEX)+MAX(1,HEIGHT(INDEX))-1)
20580                      for COL=HPOSITION(INDEX) to (HPOSITION(INDEX)+WIDTH(INDEX)-1)+(2*(LWRC$(TRIM$(FIELDTYPE$(INDEX)))=="combo"))
20585                         if COL<=MASKCOL+MASKWIDTH AND COL>=MASKCOL AND ROW<=MASKROW+MASKHEIGHT AND ROW>=MASKROW then 
20590                            let FNMASKDOT(ROW,COL,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST)
20595                         end if 
20600                      next COL
20605                   next ROW
20610                end if 
20615             next INDEX
20620 ! 
20625             let FNRENDERDOTS(WINDOW,DOTSIZE,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST,PRINTFULLSCREEN)
20630          else 
20635             if ~PRINTFULLSCREEN then 
20640                for INDEX=MASKROW to MASKROW+MAX(MASKHEIGHT,1)-1
20645                   print #WINDOW, fields STR$(INDEX)&","&STR$(MASKCOL)&",C "&STR$(MASKWIDTH) : ""
20650                next INDEX
20655             end if 
20660          end if 
20665       end if 
20670    fnend 
20675 ! 
20680    dim PERMDOTROW(1), PERMDOTCOL(1), PERMDOTSIZE(1), PERMDOTEXIST(1)
20685 Renderdots: ! Move The Dots To The Permenant Dot Arrays And Print Them
20690    def FNRENDERDOTS(WINDOW,DOTSIZE,MAT DOTROW,MAT DOTCOL,MAT DOTSIZE,MAT DOTEXIST;CLEARPERMANENT,___,INDEX,DOT,ROW,COL,FKEYVALUE)
20695       dim DOTSPEC$(1)*40, DOTDATA$(1)*60
20700       mat DOTSPEC$(0) : mat DOTDATA$(0)
20705 ! 
20710       if CLEARPERMANENT then 
20715          mat PERMDOTROW(0) : mat PERMDOTCOL(0) : mat PERMDOTSIZE(0) : mat PERMDOTEXIST(0)
20720       end if 
20725 ! 
20730       mat DOTSPEC$(SUM(MAT DOTEXIST))
20735       mat DOTDATA$(SUM(MAT DOTEXIST))
20740 ! 
20745       let INDEX=0
20750       do WHILE (INDEX:=SRCH(MAT DOTEXIST,1,INDEX+1))>0
20755          if ~CLEARPERMANENT then 
20760             for ROW=DOTROW(INDEX) to DOTROW(INDEX)+DOTSIZE(INDEX)-1
20765                for COL=DOTCOL(INDEX) to DOTCOL(INDEX)+DOTSIZE(INDEX)-1
20770                   let FNMASKDOT(ROW,COL,MAT PERMDOTROW,MAT PERMDOTCOL,MAT PERMDOTSIZE,MAT PERMDOTEXIST)
20775                next COL
20780             next ROW
20785          end if 
20790          let FKEYVALUE=FNADDDOT(DOTROW(INDEX),DOTCOL(INDEX),DOTSIZE(INDEX),MAT PERMDOTROW,MAT PERMDOTCOL,MAT PERMDOTSIZE,MAT PERMDOTEXIST)
20795 ! 
20800          let DOT+=1
20805          let DOTSPEC$(DOT)=STR$(DOTROW(INDEX))&","&STR$(DOTCOL(INDEX))&",P "&STR$(DOTSIZE(INDEX))&"/"&STR$(DOTSIZE(INDEX))&",,"&STR$(2000+FKEYVALUE)
20810          if DOTSIZE(INDEX)<DOTSIZE then 
20815             let DOTDATA$(DOT)=SETTING_IMAGEPATH$&"\black.bmp"
20820          else 
20825             if DOTSIZE=1 then 
20830                let DOTDATA$(DOT)=SETTING_IMAGEPATH$&"\dot.bmp"
20835             else 
20840                let DOTDATA$(DOT)=SETTING_IMAGEPATH$&"\bigdot.bmp"
20845             end if 
20850          end if 
20855       loop 
20860 ! 
20865       print #WINDOW, fields MAT DOTSPEC$ : MAT DOTDATA$
20870    fnend 
20875 ! 
20880 Calculatedotsize: ! Calculate The Step Size Based On The Screen Size
20885    def FNCALCULATEDOTSIZE(VSIZE,HSIZE;___,BUTTONSIZE,MAXNUMBEROFBUTTONS)
20890       let MAXNUMBEROFBUTTONS = 3000
20895 ! 
20900       let BUTTONSIZE=INT((((VSIZE*HSIZE)-1)/MAXNUMBEROFBUTTONS))+1
20905       let BUTTONSIZE=INT(SQR(BUTTONSIZE-1))+1
20910 ! 
20915       let FNCALCULATEDOTSIZE = BUTTONSIZE
20920    fnend 
20925 ! 
20930 Getclickposition: ! Returns The Click Position
20935    def FNGETCLICKPOSITION(FUNCTION,&ROW,&COL;___,INDEX)
20940       if FUNCTION>2000 then 
20945          let ROW=PERMDOTROW(FUNCTION-2000)
20950          let COL=PERMDOTCOL(FUNCTION-2000)
20955       end if 
20960    fnend 
20965 ! 
21000 !  #Autonumber# 21000,2
21002 ! *****************************************************************
21004 ! ************************ Render Controls ************************
21006 ! *****************************************************************
21008    dim DRAW_LV_CAPTION$(1)*255,DRAW_LV_WIDTH(1),DRAW_LV_SPEC$(1)*40,DRAW_LV_DATA$(1)*255
21010 Drawcontrol: ! Draw The Given Control
21012    def FNDRAWCONTROL(WINDOW,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ACTIVE,FGCOLOR$,BGCOLOR$,DONTPOPULATE,FORCEINDEX,RUNTIME,___,DATA$*255,SPEC$*255,INDEX)
21014       if WIDTH(CONTROL)<=SCREENIO(SI_HSIZE) AND HEIGHT(CONTROL)<=SCREENIO(SI_VSIZE) then 
21016          if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "listview" then ! #Select# Lwrc$(Trim$(Fieldtype$(Control)))   #Case# "listview"
21018 ! .          ! Draw Listview Header
21020             let SPEC$=FNCALCULATELISTVIEWHEADERS$(MAT DRAW_LV_CAPTION$, MAT DRAW_LV_WIDTH, MAT DRAW_LV_SPEC$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE)
21022             if LEN(TRIM$(FGCOLOR$)) AND LEN(TRIM$(BGCOLOR$)) then 
21024                let SPEC$=SREP$(SPEC$,FNCOLOR$(0,FIELDTYPE$(CONTROL),FGCOLOR$(CONTROL),BGCOLOR$(CONTROL),0,INVISIBLE(CONTROL)),FNCOLOR$(0,FIELDTYPE$(CONTROL),FGCOLOR$,BGCOLOR$))
21026             end if 
21028 ! 
21030 ! .        ! This next part fixes it so that if you have a Read event for your listview, the other stuff all updates correctly.
21032 ! .        !  In order for ScreenIO to do its magic, there has to be an "X" attribute for the listview and for all other input
21034 ! .        !  text controls on the screen, so that it can get control and make sure things are updated properly and the Read Event runs.
21036             if LEN(TRIM$(SCREENIO$(SI_READFN))) then 
21038                for INDEX=1 to UDIM(MAT DRAW_LV_SPEC$)
21040                   if POS(DRAW_LV_SPEC$(INDEX),",") AND POS(DRAW_LV_SPEC$(INDEX),"/",POS(DRAW_LV_SPEC$(INDEX),",",-1)) then 
21042                      let DRAW_LV_SPEC$(INDEX)=DRAW_LV_SPEC$(INDEX)(1:POS(DRAW_LV_SPEC$(INDEX),"/",-1)-1)&"X"&DRAW_LV_SPEC$(INDEX)(POS(DRAW_LV_SPEC$(INDEX),"/",-1):LEN(DRAW_LV_SPEC$(INDEX)))
21044                   else 
21046                      let DRAW_LV_SPEC$(INDEX)=DRAW_LV_SPEC$(INDEX)&"X"
21048                   end if 
21050                next INDEX
21052                for INDEX=1 to UDIM(MAT FIELDTYPE$)
21054                   if FNISINPUT(FIELDTYPE$(INDEX)) then 
21056                      if POS(ATTR$(INDEX),"/") then 
21058                         if ATTR$(INDEX)(POS(ATTR$(INDEX),"/")-1:POS(ATTR$(INDEX),"/")-1)><"X" then 
21060                            let ATTR$(INDEX)=ATTR$(INDEX)(1:POS(ATTR$(INDEX),"/")-1)&"X"&ATTR$(INDEX)(POS(ATTR$(INDEX),"/"):LEN(ATTR$(INDEX)))
21062                         end if 
21064                      else 
21066                         if ATTR$(INDEX)(LEN(ATTR$(INDEX)):LEN(ATTR$(INDEX)))><"X" then 
21068                            let ATTR$(INDEX)=ATTR$(INDEX)&"X"
21070                         end if 
21072                      end if 
21074                   end if 
21076                next INDEX
21078             end if 
21080 ! 
21082             if FORCEINDEX then 
21084                let SPEC$=SPEC$(1:POS(SPEC$,",",-1)-1)&","&STR$(FORCEINDEX)
21086             end if 
21088 ! 
21090 ! .         ! Add Hidden Column for Record Number
21092             mat DRAW_LV_CAPTION$(UDIM(MAT DRAW_LV_CAPTION$)+1)
21094             mat DRAW_LV_WIDTH(UDIM(MAT DRAW_LV_WIDTH)+1)
21096             mat DRAW_LV_SPEC$(UDIM(MAT DRAW_LV_SPEC$)+1)
21098 ! 
21100             let DRAW_LV_WIDTH(UDIM(MAT DRAW_LV_WIDTH))=0
21102             let DRAW_LV_SPEC$(UDIM(MAT DRAW_LV_SPEC$))="C 12"
21104 ! 
21106 ! .        ! Add Hidden Column for Search
21108 !            mat Draw_Lv_Caption$(Udim(Mat Draw_Lv_Caption$)+1)
21110 !            mat Draw_Lv_Width(Udim(Mat Draw_Lv_Width)+1)
21112 !            mat Draw_Lv_Spec$(Udim(Mat Draw_Lv_Spec$)+1)
21114 ! 
21116 !            let Draw_Lv_Width(Udim(Mat Draw_Lv_Width))=0
21118 !            let Draw_Lv_Spec$(Udim(Mat Draw_Lv_Spec$))="C 1000"
21120 ! 
21122             print #WINDOW, fields SPEC$ : (MAT DRAW_LV_CAPTION$, MAT DRAW_LV_WIDTH, MAT DRAW_LV_SPEC$)
21124 ! 
21126 ! .         ! Populate Listview with Empty Data
21128             mat DRAW_LV_DATA$((HEIGHT(CONTROL)-1)*UDIM(DRAW_LV_WIDTH))=("")
21130             let SPEC$=FNCALCULATELISTVIEWSPEC$(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
21132             print #WINDOW, fields SPEC$&",=" : (MAT DRAW_LV_DATA$)
21134             if ~DONTPOPULATE then 
21136                let FNTRYTOPOPULATELISTVIEWS(WINDOW,MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,CONTROL)
21138             end if 
21140          else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "listchld" then ! #Case# "listchld"
21142 ! .         ! Listview Children get drawn by the Draw Listview Code Above
21144          else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "frame" then ! #Case# "frame"
21146             let SPEC$=FNCALCULATEFRAMESPEC$(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE,RUNTIME)
21148             if LEN(TRIM$(FGCOLOR$)) AND LEN(TRIM$(BGCOLOR$)) then 
21150                let SPEC$=SREP$(SPEC$,FNCOLOR$(0,FIELDTYPE$(CONTROL),FGCOLOR$(CONTROL),BGCOLOR$(CONTROL),0,INVISIBLE(CONTROL)),FNCOLOR$(0,FIELDTYPE$(CONTROL),FGCOLOR$,BGCOLOR$))
21152             end if 
21154             let FNOPENFRAMEWINDOW(WINDOW,SPEC$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,RUNTIME,FORCEINDEX)
21156 ! 
21158          else if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "screen" then ! #Case# "screen"
21160             let FNOPENSCREEN(WINDOW,SPEC$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,RUNTIME,FORCEINDEX,ACTIVE)
21162 ! 
21164          else ! #Case Else#
21166             let DATA$=FNCALCULATEDATA$(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE)
21168             let SPEC$=FNCALCULATESPEC$(WINDOW,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE,1)
21170 ! 
21172             if LEN(TRIM$(FGCOLOR$)) AND LEN(TRIM$(BGCOLOR$)) then 
21174                let SPEC$=SREP$(SPEC$,FNCOLOR$(0,FIELDTYPE$(CONTROL),FGCOLOR$(CONTROL),BGCOLOR$(CONTROL),0,INVISIBLE(CONTROL)),FNCOLOR$(0,FIELDTYPE$(CONTROL),FGCOLOR$,BGCOLOR$))
21176             end if 
21178             print #WINDOW, fields SPEC$ : DATA$  !Inactivate Old Control
21180          end if                       !#End Select#
21182       end if 
21184    fnend 
21186 ! 
21188    def FNCLOSEFRAMEWINDOWS(;___,INDEX)
21190       let FNCHANGEFORCEVISIBILITY(0)
21192       for INDEX=1 to UDIM(MAT FRAMEWINDOWS)
21194          if FRAMEWINDOWS(INDEX) AND FILE(FRAMEWINDOWS(INDEX))<>-1 then 
21196             close #FRAMEWINDOWS(INDEX): 
21198          end if 
21200       next INDEX
21202       mat FRAMEWINDOWS(0)
21204       mat FRAMEKEYS$(0)
21206       mat FRAMESPECCONTROL$(0)
21208       for INDEX=1 to UDIM(MAT SCREENWINDOWS)
21210          if SCREENWINDOWS(INDEX) AND FILE(SCREENWINDOWS(INDEX))<>-1 then 
21212             close #SCREENWINDOWS(INDEX): 
21214          end if 
21216       next INDEX
21218       mat SCREENWINDOWS(0)
21220       mat SCREENKEYS$(0)
21222    fnend 
21224 ! 
21226 ! .! if framespec is given, don't close that one.
21228    def FNCLOSEFRAMEWINDOW(FRAMEKEY$;&FRAMESPEC$,___,FRAMEKEY)
21230 ! .  ! check to see if window is already open
21232       let FRAMEKEY=SRCH(MAT FRAMEKEYS$,FRAMEKEY$)
21234       if FRAMEKEY>0 then 
21236          if ~LEN(FRAMESPEC$) OR FRAMESPECCONTROL$(FRAMEKEY)><FRAMESPEC$ then 
21238             if FRAMEWINDOWS(FRAMEKEY) AND FILE(FRAMEWINDOWS(FRAMEKEY))<>-1 then 
21240 ! .           ! print "Close "&FrameKey$ : pause
21242                close #FRAMEWINDOWS(FRAMEKEY): 
21244                let FRAMEWINDOWS(FRAMEKEY)=0
21246                let FRAMESPECCONTROL$(FRAMEKEY)=""
21248             end if 
21250          end if 
21252       end if 
21254    fnend 
21256 ! 
21258    def FNREADSIZEFROMSPEC(&ROWS,&COLS,SPEC$*255;___,SR,SC,ER,EC)
21260       let ROWS=FNGETSPEC("rows=",SPEC$)
21262       let COLS=FNGETSPEC("cols=",SPEC$)
21264       if ~ROWS then 
21266          let SR=FNGETSPEC("srow=",SPEC$)
21268          let ER=FNGETSPEC("erow=",SPEC$)
21270          let ROWS=(ER-SR)+1
21272       end if 
21274       if ~COLS then 
21276          let SC=FNGETSPEC("scol=",SPEC$)
21278          let EC=FNGETSPEC("ecol=",SPEC$)
21280          let COLS=(EC-SC)+1
21282       end if 
21284    fnend 
21286    def FNGETSPEC(KEY$*128,SPEC$*255;ENDCHAR$,___,NUMBER,NUMBER$)
21288       let NUMBER$=FNGETSPEC$(KEY$,SPEC$,ENDCHAR$)
21290       let NUMBER=VAL(NUMBER$) conv IGNORE
21292       let FNGETSPEC=NUMBER
21294    fnend 
21296 ! 
21298    def FNGETSPEC$(KEY$*128,SPEC$*255;ENDCHAR$,___,POSSTART)
21300       if ENDCHAR$="" then let ENDCHAR$=","
21302       let POSSTART=POS(LWRC$(SPEC$),LWRC$(KEY$))
21304       if POSSTART then 
21306          let POSSTART+=LEN(KEY$)
21308          let POSEND=POS(LWRC$(SPEC$),LWRC$(ENDCHAR$),POSSTART)
21310          if ~POSEND then let POSEND=LEN(SPEC$) else let POSEND-=1
21312          let FNGETSPEC$=SPEC$(POSSTART:POSEND)
21314       end if 
21316    fnend 
21318 ! 
21320    def FNSAMESIZE(SPEC$*255,WINDOW;___,ROWS,COLS,TESTROWS,TESTCOLS)
21322       if TRIM$(UPRC$(FILE$(WINDOW)))=":CON:" then 
21324          let FNREADSCREENSIZE(ROWS,COLS,WINDOW)
21326          if FNREADSIZEFROMSPEC(TESTROWS,TESTCOLS,SPEC$) then 
21328             if ROWS=TESTROWS AND COLS=TESTCOLS then 
21330                let FNSAMESIZE=1
21332             end if 
21334          end if 
21336       end if 
21338    fnend 
21340 ! 
21342    def FNOPENFRAMEWINDOW(WINDOW,SPEC$*255,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;RUNTIME,FORCEINDEX,___,FRAMEKEY,ALREADYOPEN)
21344       if TRIM$(PARENT$(CONTROL))="" then let PARENT$(CONTROL)=FNGENERATEUNIQUELVNAME$(MAT PARENT$,FIELDTYPE$(CONTROL))
21346 ! 
21348 ! .  ! check to see if window is already open
21350       let FRAMEKEY=SRCH(MAT FRAMEKEYS$,PARENT$(CONTROL))
21352       if FRAMEKEY>0 then 
21354          if FRAMEWINDOWS(FRAMEKEY) AND FILE(FRAMEWINDOWS(FRAMEKEY))<>-1 then 
21356             if SPEC$><FRAMESPECCONTROL$(FRAMEKEY) OR (EDITING AND ~FNSAMESIZE(SPEC$,FRAMEWINDOWS(FRAMEKEY))) then 
21358                close #FRAMEWINDOWS(FRAMEKEY): 
21360                let FRAMEWINDOWS(FRAMEKEY)=0
21362             else 
21364                let ALREADYOPEN=1
21366             end if 
21368          end if 
21370       else 
21372          let FRAMEKEY=UDIM(MAT FRAMEWINDOWS)
21374          if ~FRAMEKEY OR FRAMEWINDOWS(FRAMEKEY) then 
21376             let FRAMEKEY+=1
21378             mat FRAMEWINDOWS(FRAMEKEY)
21380             mat FRAMEKEYS$(FRAMEKEY)
21382             mat FRAMESPECCONTROL$(FRAMEKEY)
21384          end if 
21386          let FRAMEKEYS$(FRAMEKEY)=PARENT$(CONTROL)
21388          let FRAMESPECCONTROL$(FRAMEKEY)=SPEC$
21390       end if 
21392       if (~ALREADYOPEN) AND (~RUNTIME OR ~INVISIBLE(CONTROL)) then 
21394          let FRAMEWINDOWS(FRAMEKEY)=FNGETFILENUMBER(-1)
21396          open #FRAMEWINDOWS(FRAMEKEY): SPEC$&",parent="&STR$(WINDOW),display,outin 
21398 ! .     ! print "Open "&Parent$(Control) : pause
21400          if FORCEINDEX then 
21402             print #FRAMEWINDOWS(FRAMEKEY), fields "1,1,C "&STR$(WIDTH(CONTROL)*HEIGHT(CONTROL))&",/W:T,"&STR$(FORCEINDEX) : ""  !Make it hot
21404          else if ~RUNTIME then 
21406             print #FRAMEWINDOWS(FRAMEKEY), fields "1,1,C "&STR$(WIDTH(CONTROL)*HEIGHT(CONTROL))&",/W:T,"&FNMAKEINDEX$(FIELDTYPE$(CONTROL),CONTROL) : ""  !Make it hot
21408          end if 
21410       end if 
21412    fnend 
21414 ! 
21416    dim SCREENWINDOWS(1)
21418    dim SCREENKEYS$(1)
21420 ! 
21422    dim PDATA$(1)*255
21424 ! 
21426    def FNOPENSCREEN(WINDOW,SPEC$*255,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;RUNTIME,FORCEINDEX,ACTIVE,_PATH$*255,___,SCREENKEY,KEYVAL$*255,PTH$*255,PARENT_KEY$*255,RECORDVAL,DUMMY$*255,DUMMY,WINDOWNUMBER,RECORD)
21428 ! .  ! check to see if window is already open
21430       let SCREENKEY=SRCH(MAT SCREENKEYS$,PARENT$(CONTROL))
21432       if SCREENKEY>0 then 
21434          if SCREENWINDOWS(SCREENKEY) AND FILE(SCREENWINDOWS(SCREENKEY))<>-1 then 
21436             close #SCREENWINDOWS(SCREENKEY): 
21438             let SCREENWINDOWS(SCREENKEY)=0
21440          end if 
21442       else 
21444          let SCREENKEY=UDIM(MAT SCREENWINDOWS)
21446          if ~SCREENKEY OR SCREENWINDOWS(SCREENKEY) then 
21448             let SCREENKEY+=1
21450             mat SCREENWINDOWS(SCREENKEY)
21452             mat SCREENKEYS$(SCREENKEY)
21454          end if 
21456          let SCREENKEYS$(SCREENKEY)=PARENT$(CONTROL)
21458       end if 
21460       if ~RUNTIME OR ~INVISIBLE(CONTROL) then 
21462          if ~FORCEINDEX then let FORCEINDEX=CONTROL+FNKEYBASE
21464          if LEN(TRIM$(_PATH$)) then let PTH$=_PATH$ else let PTH$=PATH$
21466          if ~RUNTIME then 
21468             let FNPUSHSCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
21470             let PARENTKEY$=SCREENIO$(SI_DEBUGPARENTKEY)
21472             let CURRENTKEY$=SCREENIO$(SI_DEBUGKEY)
21474             let CURRENTREC=SCREENIO(SI_DEBUGRECORD)
21476             let PTH$=SCREENIO$(SI_DEBUGPATH)
21478             let FNUNPACKPDATA$(MAT PDATA$,SCREENIO$(SI_DEBUGPASSED))
21480          end if 
21482          let DUMMY$="["&FIELDNAME$(CONTROL)&"]"&FUNCTION$(CONTROL)
21484          if RUNTIME then let FNPARSESCREENINFO(DUMMY$,KEYVAL$,PARENT_KEY$,DUMMY,DUMMY,DUMMY,DUMMY,DUMMY,RECORDVAL,PARENTKEY$)
21486          let WINDOWNUMBER=VAL(FNMASTER$(FIELDNAME$(CONTROL),KEYVAL$,VPOSITION(CONTROL),HPOSITION(CONTROL),PARENT_KEY$,WINDOW,1,1,RECORDVAL,PTH$,0,ACTIVE,FORCEINDEX,~RUNTIME,MAT PDATA$))
21488          if ~RUNTIME then 
21490             let FNPOPSCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
21492          end if 
21494          let SCREENWINDOWS(SCREENKEY)=WINDOWNUMBER
21496       end if 
21498    fnend 
21500 ! 
21502    def FNUNPACKPDATA$(MAT X$,Y$*255;___,INDEX)
21504       if FN42 then 
21506          let STR2MAT(Y$,MAT X$,",")
21508       else 
21510          mat X$(0)
21512          do WHILE POS(Y$,",")
21514             let INDEX=UDIM(MAT X$)+1
21516             mat X$(INDEX)
21518             let X$(INDEX)=Y$(1:POS(Y$,",")-1)
21520             let Y$(1:POS(Y$,","))=""
21522          loop 
21524          if LEN(TRIM$(Y$)) then 
21526             let INDEX=UDIM(MAT X$)+1
21528             mat X$(INDEX)
21530             let X$(INDEX)=Y$
21532          end if 
21534       end if 
21536    fnend 
21538 ! 
21540 Drawscreens: ! Predraw all the screens on the screen
21542    def FNDRAWSCREENS(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;RUNTIME,FORCEINDEX,WHICHONE,___,INDEX)
21544       for INDEX=1 to UDIM(MAT FIELDTYPE$)  !Look at all controls
21546          if WHICHONE>=0 OR WHICHONE*-1=INDEX then ! Draw just the ones we want
21548             if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "screen" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "screen"
21550                if FNVALIDSPEC(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
21552                   let FNDRAWCONTROL(WINDOW,INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,"","",0,FORCEINDEX,RUNTIME)
21554                end if 
21556             end if                    !#End Select#
21558          end if 
21560       next INDEX
21562    fnend 
21564 ! 
21566 Drawframes: ! Predraw all the frames on the screen
21568    def FNDRAWFRAMES(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;RUNTIME,FORCEINDEX,WHICHONE,___,INDEX)
21570       for INDEX=1 to UDIM(MAT FIELDTYPE$)  !Look at all controls
21572          if WHICHONE>=0 OR WHICHONE*-1=INDEX then ! Draw just the ones we want
21574             if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "frame" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "frame"
21576                if FNVALIDSPEC(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
21578                   let FNDRAWCONTROL(WINDOW,INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,"","",0,FORCEINDEX,RUNTIME)
21580                end if 
21582             end if                    !#End Select#
21584          end if 
21586       next INDEX
21588    fnend 
21590 ! 
21592 Drawalllistviews: ! Redraw All The Listviews On The Screen
21594    def FNDRAWALLLISTVIEWS(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;RUNTIME,FORCEINDEX,___,INDEX)
21596       for INDEX=1 to UDIM(MAT FIELDTYPE$)  !Draw All Listview Controls (there's only ever one)
21598          if ~RUNTIME OR ~INVISIBLE(INDEX) then 
21600             if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listview" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "listview"
21602                if FNVALIDSPEC(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
21604                   let FNDRAWCONTROL(WINDOW,INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,"","",1,FORCEINDEX)
21606                end if 
21608             end if                    !#End Select#
21610          end if 
21612       next INDEX
21614    fnend 
21616 ! 
21618 Trytopopulatelistviews: ! Populates The Listview With Sample Data If Possible
21620    def FNTRYTOPOPULATELISTVIEWS(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;JUSTTHISONE,___,INDEX,PREFIX$,FILENUMBER,THERESALISTVIEW)
21622       dim TRYPOPULATE$(1)*1000, TRYPOPULATE(1)
21624       for INDEX=1 to UDIM(MAT FIELDTYPE$)
21626          if LWRC$(FIELDTYPE$(INDEX))="listview" then 
21628             let THERESALISTVIEW=1
21630          end if 
21632       next INDEX
21634 ! 
21636       if THERESALISTVIEW AND POS(UPRC$(ENV$("poplist")),"Y") AND TRIM$(SCREENIO$(SI_FILELAY))<>"" AND FNDOESLAYOUTEXIST(TRIM$(SCREENIO$(SI_FILELAY))) then 
21638          let FILENUMBER=FNOPEN(TRIM$(SCREENIO$(SI_FILELAY)),MAT TRYPOPULATE$,MAT TRYPOPULATE,MAT FORM$)
21640 ! 
21642          let FNREADLAYOUTARRAYS(TRIM$(SCREENIO$(SI_FILELAY)),PREFIX$,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$)
21644          for INDEX=1 to UDIM(MAT FIELDSSSUBS$)
21646             let FIELDSSSUBS$(INDEX)=LWRC$(TRIM$(FIELDSSSUBS$(INDEX)))
21648          next INDEX
21650          for INDEX=1 to UDIM(MAT FIELDSNSUBS$)
21652             let FIELDSNSUBS$(INDEX)=LWRC$(TRIM$(FIELDSNSUBS$(INDEX)))
21654          next INDEX
21656 ! 
21658          if POS(UPRC$(ENV$("filter")),"Y") AND (~LIBRARYLINKAGE OR ROUTINENAME$<>SCREENIO$(SI_SCREENCODE)) then 
21660             let ROUTINENAME$=SCREENIO$(SI_SCREENCODE)
21662             let FNESTABLISHLIBRARYLINKAGE
21664             let FNREADLAYOUTARRAYS("screenio",SCREENIOPREFIX$,MAT SCREENIOSSUBS$,MAT SCREENIONSUBS$)
21666             let FNEXECUTESETSUBSCRIPTS(MAT CONTROLNAME$,"ctl_")
21668             let FNEXECUTEUNIQUESUBSCRIPTS(MAT CONTROLNAME$,"ctl_")
21670          end if 
21672 ! 
21674          let FNINITIALIZEMATS(MAT S$,MAT SCREENSUBS$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
21676          let FNEXECUTESETSUBSCRIPTS(MAT SCREENSUBS$,"sio_")
21678 ! 
21680          let FNPOPULATEALLLISTVIEWS(WINDOW,FILENUMBER,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT LISTVIEWRECORDS,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,JUSTTHISONE,(~(LIBRARYLINKAGE AND POS(UPRC$(ENV$("filter")),"Y"))),1)
21682          let FNCLOSEFILE(FILENUMBER,TRIM$(SCREENIO$(SI_FILELAY)),"",1)
21684       end if 
21686    fnend 
21688 ! 
21690 ! 
25000 ! #Autonumber# 25000, 5
25005 Populatealllistviews: ! This Function Populates All The Listviews On The Screen
25010    def FNPOPULATEALLLISTVIEWS(WINDOW,FDATAFILE,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT RECORDS,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;JUSTTHISONE,IGNOREFILTERS,EDITING,&FIRSTROW,DISPLAYONLY,___,ATTRIBUTE$*128,INDEX,SPEC$*60,COLUMNS,COL,POPULATEROW,COLINDEX,POSITION,COLOR$*40,SCREENSUBINDEX,CLEARFLAG$,POPULATEDATAUDIM,POPULATECOLORUDIM,POPULATESIZE,SAVEFDATAFILE,FILEFORM,ROWCOUNT,EVERY10,HASFILTERFUNCTION)
25015 ! 
25020       dim POPULATEDATA$(1000)*1000, POPULATECOLOR$(9999)*40, POPULATEREAD$(1)*1000, POPULATEREAD(1), LISTVIEWCHILDINDEX(1), POPULATESORTEDSUBS, INITFUNCTION$*255,FINALFUNCTION$*255
25025 ! 
25030       let INITFUNCTION$=FINALFUNCTION$=""
25035 !      dim SearchColumn$*1000
25040 ! 
25045       if FDATAFILE AND FILE(FDATAFILE)>-1 then ! If File Is Open
25050 ! 
25055          let POPULATESIZE=9999
25060 ! .!
25065          mat POPULATEREAD$(UDIM(MAT FIELDSSSUBS$))
25070          mat POPULATEREAD(UDIM(MAT FIELDSNSUBS$))
25075 ! 
25080          restore #FDATAFILE: 
25085 ! 
25090          if ~IGNOREFILTERS then 
25095             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
25100                if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\prelist.brs") then 
25105                   let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\prelist.brs"))
25110                end if 
25115             end if 
25120 ! 
25125             if LEN(TRIM$(SCREENIO$(SI_PRELISTVIEWFN))) then 
25130                let FNEXECUTE(TRIM$(SCREENIO$(SI_PRELISTVIEWFN)))
25135             end if 
25140 ! 
25145             for INDEX=1 to UDIM(MAT FIELDTYPE$)
25150                if LEN(TRIM$(FUNCTION$(INDEX))) AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))="listview" then 
25155                   let HASFILTERFUNCTION=1
25160                   let INITFUNCTION$=FNGETSPECIALFUNCTIONHANDLE$(TRIM$(FUNCTION$(INDEX)),"Init_")
25165                   let FINALFUNCTION$=FNGETSPECIALFUNCTIONHANDLE$(TRIM$(FUNCTION$(INDEX)),"Final_")
25170                end if 
25175             next INDEX
25180 ! 
25185             if HASFILTERFUNCTION then 
25190                let FNEXECUTE(INITFUNCTION$)
25195             end if 
25200          end if 
25205 ! .!
25210          for INDEX=1 to UDIM(MAT FIELDTYPE$)
25215             if (INDEX=JUSTTHISONE) OR (NOT JUSTTHISONE) then 
25220                if EDITING OR ~INVISIBLE(INDEX) then 
25225                   if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listview" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "listview"
25230                      if FNVALIDSPEC(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
25235 ! 
25240                         let FILEFORM=FDATAFILE
25245 ! 
25250                         if ~SCREENIO(SI_READINDEX) then 
25255 ! .                        ! Open file relative for faster reading
25260                            let SAVEFDATAFILE=FDATAFILE
25265                            open #(FDATAFILE:=FNGETFILENUMBER(400)): "name="&FILE$(SAVEFDATAFILE)&",shr",internal,input,relative 
25270                            restore #FDATAFILE: 
25275                         end if 
25280 ! 
25285                         let FNPREPAREANIM
25290 ! 
25295                         let POPULATEDATAUDIM=0
25300                         let POPULATECOLORUDIM=0
25305                         let FNCLEARCOLORARRAYS
25310 ! 
25315                         let CLEARFLAG$=",="
25320                         let COLUMNS=FNCOUNTCOLUMNS(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
25325                         mat LISTVIEWCHILDINDEX(COLUMNS)
25330                         for COL=1 to COLUMNS
25335                            let LISTVIEWCHILDINDEX(COL)=FNFINDLISTVIEWCHILD(COL,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
25340                         next COL
25345 ! 
25350                         let SPEC$=FNCALCULATELISTVIEWSPEC$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
25355 ! 
25360                         if FNVALIDATTRIBUTE(ATTR$(INDEX),FIELDTYPE$(INDEX)) then 
25365                            let ATTRIBUTE$=ATTR$(INDEX)
25370                         end if 
25375 ! .   !
25380                         let ROWCOUNT=0
25385 ! 
25390                         if ~IGNOREFILTERS AND LEN(TRIM$(FUNCTION$(INDEX))) then 
25395                            let FNEXECUTE("{{SetData}}")
25400                         end if 
25405 ! 
25410                         dim POPULATEINCREMENT,POPULATERECKEYSIZE
25415                         let POPULATEINCREMENT=1000 : let POPULATERECKEYSIZE=0
25420                         mat RECORDS(0)
25425 ! 
25430                         do 
25435                            read #FDATAFILE, using FORM$(FILEFORM), release: MAT POPULATEREAD$, MAT POPULATEREAD error IGNORE
25440                            if FILE(FDATAFILE)=0 then ! If No Read Problems
25445                               if ~IGNOREFILTERS then 
25450                                  let COLOR$:=FNPASSFILTER$(MAT POPULATEREAD$,MAT POPULATEREAD,FUNCTION$(INDEX),INDEX)
25455                               end if 
25460                               if IGNOREFILTERS OR (LEN(TRIM$(COLOR$)) AND TRIM$(COLOR$)<>"0" AND UPRC$(TRIM$(COLOR$))<>"STOP") then 
25505                                  let ROWCOUNT+=1
25510                                  let POPULATECOLORUDIM+=1
25515                                  if POPULATECOLORUDIM>25000 then 
25520                                     let FNSETCOLORS(MAT POPULATECOLOR$,MAT LVAC_START,MAT LVAC_END,MAT LVAC_COLOR$)
25525                                     mat POPULATECOLOR$=("")
25530                                     let POPULATECOLORUDIM=1
25535                                  end if 
25540                                  if POPULATESIZE<POPULATECOLORUDIM then 
25545                                     mat POPULATECOLOR$(25000)
25550                                     let POPULATESIZE=25000
25555                                  end if 
25560                                  let POPULATECOLOR$(POPULATECOLORUDIM)=COLOR$
25565                                  let POPULATEROW=POPULATEDATAUDIM
25570                                  let POPULATEDATAUDIM+=(COLUMNS+1)  !Extra Columns To Store Record Number
25575 ! 
25580                                  if ROWCOUNT>POPULATERECKEYSIZE then ! Ensure its big enough
25585                                     let POPULATERECKEYSIZE+=POPULATEINCREMENT
25590                                     mat RECORDS(POPULATERECKEYSIZE)
25595                                  end if 
25600 ! .   !
25605                                  let RECORDS(ROWCOUNT)=REC(DATAFILE)
25610 ! 
25615 !                                 let SearchColumn$=""
25620                                  for COL=1 to COLUMNS
25625                                     let COLUMNINDEX=LISTVIEWCHILDINDEX(COL)
25630                                     if TRIM$(FIELDNAME$(COLUMNINDEX))="" AND TRIM$(CONTROLNAME$(COLUMNINDEX))<>"" AND (SCREENSUBINDEX:=SRCH(MAT SCREENSUBS$,LWRC$(TRIM$(CONTROLNAME$(COLUMNINDEX)))))>0 then 
25635                                        let POPULATEDATA$(POPULATEROW+COL)=S$(SCREENSUBINDEX)
25640                                     else 
25645                                        if FNISNUMBER(MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,FIELDNAME$(COLUMNINDEX)) then 
25650                                           let POSITION=SRCH(MAT FIELDSNSUBS$,LWRC$(TRIM$(FIELDNAME$(COLUMNINDEX))))
25655                                           if POSITION>0 then 
25660                                              let POPULATEDATA$(POPULATEROW+COL)=STR$(POPULATEREAD(POSITION))
25665                                           end if 
25670                                        else 
25675                                           let POSITION=SRCH(MAT FIELDSSSUBS$,LWRC$(TRIM$(FIELDNAME$(COLUMNINDEX))))
25680                                           if POSITION>0 then 
25685                                              let POPULATEDATA$(POPULATEROW+COL)=POPULATEREAD$(POSITION)
25690                                              let FNTRIMTOCRLF(POPULATEDATA$(POPULATEROW+COL))
25695                                           end if 
25700                                        end if 
25705                                     end if 
25710 ! 
25715 ! .                                ! Apply Conversion From Disk
25720 ! .                                ! Only implemented for Dates in C fields and Listview Children
25725                                     if LWRC$(CNVRTOUT$(COLUMNINDEX))(1:5)="date(" then 
25730                                        if FNISDIGIT(POPULATEDATA$(POPULATEROW+COL)) then 
25735                                           let POPULATEDATA$(POPULATEROW+COL)=STR$(DAYS(VAL(POPULATEDATA$(POPULATEROW+COL)),FNDATEMASK$(CNVRTOUT$(COLUMNINDEX)))) error IGNORE
25740                                        else 
25745                                           let POPULATEDATA$(POPULATEROW+COL)=STR$(DAYS(POPULATEDATA$(POPULATEROW+COL),FNDATEMASK$(CNVRTOUT$(COLUMNINDEX)))) error IGNORE
25750                                        end if 
25755                                     end if 
25760 ! 
25765                                     if FNAPPLYCONVERSION(CNVRTIN$(COLUMNINDEX)) then 
25770                                        let POPULATEDATA$(POPULATEROW+COL)=TRIM$(CNVRT$(FNUNPACKCONVERTSPEC$(COLUMNINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES),VAL(POPULATEDATA$(POPULATEROW+COL)))) error IGNORE
25775                                     end if   !Attempt To Apply Conversion Manually If Fnapplyconversion Thinks We Should
25780 ! .                                ! let SearchColumn$=SearchColumn$&"|"&PopulateData$(PopulateRow+Col)
25785                                     let POPULATEDATA$(POPULATEROW+COL)=POPULATEDATA$(POPULATEROW+COL)(1:SPECWIDTH(COLUMNINDEX))
25790                                  next COL
25795                                  let POPULATEDATA$(POPULATEROW+COLUMNS+1)=STR$(REC(FDATAFILE))
25800 ! .                             ! let Populatedata$(Populaterow+Columns+2)=SearchColumn$
25805                                  if (POPULATEDATAUDIM+COLUMNS+2)>1000 then 
25810                                     mat POPULATEDATA$(POPULATEDATAUDIM)
25815                                     print #WINDOW, fields SPEC$&CLEARFLAG$&ATTRIBUTE$ : (MAT POPULATEDATA$)
25820                                     mat POPULATEDATA$(1000)
25825                                     let POPULATEDATAUDIM=0
25830                                     let CLEARFLAG$=",+"
25835                                  end if 
25840                               end if 
25845                               let FNRUNANIM
25850                            end if 
25855                         loop UNTIL (FILE(FDATAFILE)=10) OR (UPRC$(TRIM$(COLOR$))="STOP") OR (EDITING AND (POPULATEDATAUDIM>((HEIGHT(INDEX)+5)*(COLUMNS+1))))
25860 ! 
25865                         if ~IGNOREFILTERS AND LEN(TRIM$(FUNCTION$(INDEX))) then 
25870                            let FNEXECUTE("{{GetData}}")
25875                         end if 
25880 ! 
25885                         if ~POPULATECOLORUDIM then 
25890                            let POPULATEDATAUDIM=COLUMNS+1
25895                            mat POPULATEDATA$(1:POPULATEDATAUDIM)=("")
25900                         end if 
25905 ! 
25910                         let FNCLOSEANIM  !close animation window if its there.
25915 ! 
25920                         mat POPULATEDATA$(POPULATEDATAUDIM)
25925                         print #WINDOW, fields SPEC$&CLEARFLAG$&ATTRIBUTE$ : (MAT POPULATEDATA$)
25930                         mat POPULATEDATA$(1000)
25935                         if POPULATECOLORUDIM then 
25940                            mat POPULATECOLOR$(POPULATECOLORUDIM)
25945                            let FNSETCOLORS(MAT POPULATECOLOR$,MAT LVAC_START,MAT LVAC_END,MAT LVAC_COLOR$)
25950                            mat POPULATECOLOR$(25000)
25955                            let POPULATECOLORUDIM=0
25960 ! 
25965                            let FNAPPLYCOLOR(WINDOW,SPEC$)
25970                            if SPECWIDTH(INDEX)<>0 then 
25975                               if SPECWIDTH(INDEX)>0 then 
25980                                  print #WINDOW, fields SPEC$&",SORT" : SPECWIDTH(INDEX)
25985                               else if SPECWIDTH(INDEX)<0 then 
25990                                  print #WINDOW, fields SPEC$&",SORT" : ABS(SPECWIDTH(INDEX))
25995                                  print #WINDOW, fields SPEC$&",SORT" : ABS(SPECWIDTH(INDEX))
26000                               end if 
26005                               if ~EDITING AND ~DISPLAYONLY AND FN43 then 
26010                                  mat POPULATESORTEDSUBS(ROWCOUNT)
26015                                  input #WINDOW, fields SPEC$&",ROWSUB,ALL,DISPLAYED_ORDER,NOWAIT" : MAT POPULATESORTEDSUBS
26020                                  let FIRSTROW=POPULATESORTEDSUBS(1)
26025                               end if 
26030                            end if 
26035 ! 
26040                            if FN42 AND GRIDLINES(INDEX) then 
26045                               print #WINDOW, fields SPEC$&",GRIDLINES" : 1
26050                            end if 
26055                         end if 
26060                         mat RECORDS(ROWCOUNT)
26065                         if SAVEFDATAFILE then close #FDATAFILE: : let FDATAFILE=SAVEFDATAFILE
26070                         let FNPOPULATEALLLISTVIEWS=ROWCOUNT
26075                      end if 
26080                   else ! #Case Else#
26085 ! .   ! .            ! Ignore Non-Listview Controls
26090                   end if              !#End Select#
26095                end if 
26100             end if 
26105          next INDEX
26110 ! 
26115          if ~IGNOREFILTERS then 
26120 ! 
26125             if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") then 
26130                if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\postlist.brs") then 
26135                   let FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\postlist.brs"))
26140                end if 
26145             end if 
26150 ! 
26155             if LEN(TRIM$(SCREENIO$(SI_POSTLISTVIEWFN))) then 
26160                let FNEXECUTE(TRIM$(SCREENIO$(SI_POSTLISTVIEWFN)))
26165             end if 
26170 ! 
26175             if HASFILTERFUNCTION then 
26180                let FNEXECUTE(FINALFUNCTION$)
26185             end if 
26190          end if 
26195 ! 
26200       end if 
26205    fnend 
26210 ! 
26500 !  #Autonumber# 26500,2
26502    def FNTRIMTOCRLF(&STRING$;___,POS0D,POS0A,POSCRLF)
26504       let POS0D=POS(STRING$,HEX$("0D"))
26506       let POS0A=POS(STRING$,HEX$("0A"))
26508       if POS0D AND POS0A then 
26510          let POSCRLF=MIN(POS0D,POS0A)
26512       else if POS0D then 
26514          let POSCRLF=POS0D
26516       else if POS0A then 
26518          let POSCRLF=POS0A
26520       else 
26522          let POSCRLF=0
26524       end if 
26526       if POSCRLF then let STRING$=STRING$(1:POSCRLF-1)
26528    fnend 
26530 ! 
26532    def FNISNUMERIC(&STRING$;___,DUMMY)
26534       let DUMMY=VAL(STRING$) conv Notnumeric
26536       let FNISNUMERIC=1
26538 Notnumeric: ! Do Nothing
26540    fnend 
26542 ! 
26544 ! .! Strip up to third comma, for Listview Spec (Row,Col,LIST Rows/Cols,)
26546    def library FNLISTSPEC$*255(SPECIN$*255)=SPECIN$(1:POS(SPECIN$,",",POS(SPECIN$,",",POS(SPECIN$,",")+1)+1)-1)
26548 ! 
26550 ! .! Animation Functionality
26552    def library FNPREPAREANIMATION=FNPREPAREANIM
26554    def library FNANIMATE(;TEXT$*60)=FNRUNANIM(TEXT$)
26556    def library FNCLOSEANIMATION=FNCLOSEANIM
26558 ! 
26560    def FNPREPAREANIM                  !set defaults
26562       dim ANIMTIMING,ANIMATION,ANIMWINDOW,CSPEED,ANIMFRAME,ANIMV,ANIMH,ARW,ACL,CBD$*40,CCL$*40,AROWS,ATEXT
26564       let ANIMTIMING=ANIMATION=ANIMWINDOW=CSPEED=ANIMFRAME=ANIMV=ANIMH=ARW=ACL=0
26566       let CBD$=CCL$=""
26568       let CSPEED=.5
26570 ! 
26572       let FNSETTINGS
26574    fnend 
26576 ! 
26578    dim ANIMSPEC$(1)
26580 ! 
26582    def FNRUNANIM(;&TEXT$)
26584 ! .  ! Note: if text is given for any animation call,
26586 ! .  !  it must be given for the first one.
26588       if ANIMATION<>-1 then 
26590          if TIMER-ANIMTIMING>CSPEED then 
26592             let ANIMTIMING=TIMER
26594 ! 
26596             if ANIMATION OR (ANIMATION:=FNREADCLOCKFOLDER(SETTING_CLOCKPATH$,MAT ANIMATION$,CSPEED,ANIMV,ANIMH,CCL$,CBD$))>0 then 
26598 ! .            ! Open Animation Window if its not open
26600                if ~ANIMWINDOW then 
26602                   dim CLOCKATTR$*128
26604                   let CLOCKATTR$=""
26606 ! 
26608                   let FNREADSCREENSIZE(SCREENV,SCREENH)
26610                   if LEN(TRIM$(CCL$)) then let CLOCKATTR$=CLOCKATTR$&",N="&CCL$
26612                   if LEN(TRIM$(CBD$)) then let CLOCKATTR$=CLOCKATTR$&",Border="&CBD$
26614                   let AROWS=ANIMV
26616                   if LEN(TEXT$) then 
26618                      let AROWS+=1
26620                      let ATEXT=1
26622                      let ANIMH=MAX(LEN(TEXT$),ANIMH)
26624                      mat ANIMSPEC$(2)
26626                      let ANIMSPEC$(2)=STR$(AROWS)&",1,"&STR$(ANIMH)&"/CC 60"
26628                   else 
26630                      mat ANIMSPEC$(1)
26632                      let ATEXT=0
26634                   end if 
26636                   let ANIMSPEC$(1)="1,1,P "&STR$(ANIMV)&"/"&STR$(ANIMH)
26638                   let ARW=INT((SCREENV-ANIMV)/2)+1
26640                   let ACL=INT((SCREENH-ANIMH)/2)+1
26642                   open #(ANIMWINDOW:=FNGETFILENUMBER(-1)): "srow="&STR$(ARW)&",scol="&STR$(ACL)&",rows="&STR$(AROWS)&",cols="&STR$(ANIMH)&CLOCKATTR$,display,outin 
26644                end if 
26646 ! 
26648                let ANIMFRAME+=1
26650                if ANIMFRAME>UDIM(MAT ANIMATION$) then let ANIMFRAME=1
26652                if ATEXT then 
26654                   let ANIMSPEC$(2)=ANIMSPEC$(2)(1:POS(ANIMSPEC$(2)," ",-1))&STR$(LEN(TRIM$(TEXT$)))
26656                   print #ANIMWINDOW, fields MAT ANIMSPEC$ : ANIMATION$(ANIMFRAME), TRIM$(TEXT$)
26658                else 
26660                   print #ANIMWINDOW, fields MAT ANIMSPEC$ : ANIMATION$(ANIMFRAME)
26662                end if 
26664                let SCR_THAW
26666             end if 
26668          end if 
26670       end if 
26672    fnend 
26674 ! 
26676    def FNCLOSEANIM
26678       if ANIMWINDOW then 
26680          close #ANIMWINDOW: 
26682          let ANIMWINDOW=0
26684       end if 
26686    fnend 
26688 ! 
26690    dim ANIMATION$(1)*255
26692    def FNREADCLOCKFOLDER(FOLDER$*255,MAT ANIMATION$,&ANIMSPEED,&VSIZE,&HSIZE,&CLOCKCOLOR$,&CLOCKBORDER$;___,INDEX,SETTINGS)
26694       if EXISTS(FOLDER$) then 
26696          if UDIM(MAT ANIMATION$)=1 AND ANIMATION$(1)="" then 
26698             let FNREADFILES(MAT ANIMATION$,FOLDER$,"gif",1,0,1)
26700             let FNREADFILES(MAT ANIMATION$,FOLDER$,"jpg",0,0,1)
26702 ! 
26704             for INDEX=1 to UDIM(MAT ANIMATION$)
26706                let ANIMATION$(INDEX)=FOLDER$&"\"&ANIMATION$(INDEX)&":NORESIZE"
26708             next INDEX
26710 ! 
26712             let FNSORTANIMATIONS(MAT ANIMATION$)
26714          end if 
26716          if ~VSIZE OR ~HSIZE then 
26718 ! .         ! Read Clock File
26720             if EXISTS(FOLDER$&"\clock.ini") then 
26722                open #(SETTINGS:=FNGETFILENUMBER): "name="&FOLDER$&"\clock.ini",display,input 
26724                input #SETTINGS: ANIMSPEED,VSIZE,HSIZE,CLOCKCOLOR$,CLOCKBORDER$ error IGNORE
26726                close #SETTINGS: 
26728             end if 
26730 ! 
26732             if ~VSIZE then let VSIZE=5  !Default Size
26734             if ~HSIZE then let HSIZE=10  !Default Size
26736          end if 
26738          if UDIM(MAT ANIMATION$) then 
26740             let FNREADCLOCKFOLDER=1
26742          else 
26744             let FNREADCLOCKFOLDER=-1
26746          end if 
26748       else 
26750          let FNREADCLOCKFOLDER=-1
26752       end if 
26754    fnend 
26756 ! 
26758    dim SRT_ANIMATION$(1)*255
26760    dim SORT(1)
26762    def FNSORTANIMATIONS(MAT ANIMATION$;___,INDEX)
26764       mat SRT_ANIMATION$(UDIM(ANIMATION$))=ANIMATION$
26766       mat SORT(UDIM(ANIMATION$))=AIDX(ANIMATION$)
26768 ! 
26770       for INDEX=1 to UDIM(MAT SORT)
26772          let ANIMATION$(INDEX)=SRT_ANIMATION$(SORT(INDEX))
26774       next INDEX
26776    fnend 
26778 ! 
26780    dim LASTINDEX
26782    dim LVAC_START(1)
26784    dim LVAC_END(1)
26786    dim LVAC_COLOR$(1)*40
26788 ! 
26790 Applycolor: ! Function To Apply A Color Array To A Listview
26792    def FNSETCOLORS(MAT COLOR$,MAT LVAC_START,MAT LVAC_END,MAT LVAC_COLOR$;___,INDEX,COLOR$*40,START)
26794       for INDEX=1 to UDIM(MAT COLOR$)
26796          if COLOR$<>COLOR$(INDEX) then 
26798             let COLOR$=COLOR$(INDEX)
26800             if UDIM(MAT LVAC_END) AND ~LVAC_END(UDIM(MAT LVAC_END)) then 
26802                let LVAC_END(UDIM(MAT LVAC_END))=INDEX+LASTINDEX-1
26804             end if 
26806             if COLOR$(1:1)="/" OR COLOR$(1:1)="[" then 
26808                mat LVAC_END(UDIM(MAT LVAC_END)+1)
26810                mat LVAC_START(UDIM(MAT LVAC_END))
26812                mat LVAC_COLOR$(UDIM(MAT LVAC_END))
26814 ! 
26816                let LVAC_START(UDIM(MAT LVAC_START))=INDEX+LASTINDEX
26818                let LVAC_COLOR$(UDIM(MAT LVAC_COLOR$))=COLOR$
26820             end if 
26822          end if 
26824       next INDEX
26826       let LASTINDEX+=UDIM(MAT COLOR$)
26828       if UDIM(MAT LVAC_END) AND ~LVAC_END(UDIM(MAT LVAC_END)) then 
26830          let LVAC_END(UDIM(LVAC_END))=UDIM(MAT COLOR$)
26832       end if 
26834    fnend 
26836 ! 
26838    def FNAPPLYCOLOR(WINDOW,SPEC$)
26840       if UDIM(MAT LVAC_END)>0 then 
26842          print #WINDOW, fields SPEC$&",ATTR" : (MAT LVAC_START, MAT LVAC_END, MAT LVAC_COLOR$)
26844       end if 
26846    fnend 
26848 ! 
26850    def FNCLEARCOLORARRAYS
26852       mat LVAC_END(0)
26854       mat LVAC_START(0)
26856       mat LVAC_COLOR$(0)
26858       let LASTINDEX=0
26860       mat COLOR$(0)
26862    fnend 
26864 ! 
26866 Calculatelistviewheaders: ! Calculate The Columns And Spec For A Listview
26868    def FNCALCULATELISTVIEWHEADERS$*255(MAT CAPTION$, MAT WID, MAT SPEC$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ACTIVE,&COUNT,___,INDEX,ATTRIBUTES$*255)
26870       let COUNT=0
26872       mat CAPTION$(COUNT) : mat WID(COUNT) : mat SPEC$(COUNT)
26874       for INDEX=1 to UDIM(MAT FIELDTYPE$)
26876          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="listchld" AND UPRC$(TRIM$(PARENT$(INDEX)))=UPRC$(TRIM$(PARENT$(CONTROL))) then 
26878             let COUNT+=1
26880             mat CAPTION$(COUNT) : mat WID(COUNT) : mat SPEC$(COUNT)
26882             let CAPTION$(COUNT)=TRIM$(DESCRIPTION$(INDEX))
26884             let WID(COUNT)=WIDTH(INDEX)
26886             let ATTRIBUTES$=ATTR$(INDEX)
26888             if FNVALIDHEXCOLOR(FGCOLOR$(INDEX)) OR FNVALIDHEXCOLOR(BGCOLOR$(INDEX)) then 
26890                let ATTRIBUTES$=ATTRIBUTES$&FNCOLOR$(0,FIELDTYPE$(INDEX),FGCOLOR$(INDEX),BGCOLOR$(INDEX))
26892 ! .        ! else if Fnvalidhexcolor(Fgcolor$(Index)) then
26894 ! .        !    let Attributes$=Attributes$&Fncolor$(0,Fieldtype$(Index),Fgcolor$(Index),"N")
26896 ! .        ! else if Fnvalidhexcolor(Bgcolor$(Index)) then
26898 ! .        !    let Attributes$=Attributes$&Fncolor$(0,Fieldtype$(Index),"N",Bgcolor$(Index))    $$$$$
26900             end if 
26902             if ~FNVALIDATTRIBUTE(ATTRIBUTES$,FIELDTYPE$(INDEX)) then 
26904                let ATTRIBUTES$=""
26906             end if 
26908             let SPEC$(COUNT)="C"&TRIM$(JUSTIFY$(INDEX))&" "&STR$(SPECWIDTH(INDEX))&","&ATTRIBUTES$
26910 ! .         ! Apply conversion in Header if we should
26912             if FNAPPLYCONVERSION(CNVRTIN$(INDEX),1) then let SPEC$(COUNT)=FNUNPACKCONVERTSPEC$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)&","&ATTRIBUTES$
26914          end if 
26916       next INDEX
26918       let FNCALCULATELISTVIEWHEADERS$=FNCALCULATELISTVIEWSPEC$(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE,1)
26920    fnend 
26922 ! 
26924    def FNUNPACKCONVERTSPEC$*255(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,SPEC$*255)
26926       let SPEC$=TRIM$(CNVRTIN$(CONTROL))
26928       if SPEC$="N" then let SPEC$="N "&STR$(SPECWIDTH(CONTROL))
26930       let FNUNPACKCONVERTSPEC$=SPEC$
26932    fnend 
26934 ! 
26936    def FNAPPLYCONVERSION(&CONVERT$;HEADER)
26938       if LEN(TRIM$(CONVERT$)) then 
26940          if FN42 AND TRIM$(LWRC$(CONVERT$))(1:3)<>"pic" AND TRIM$(LWRC$(CONVERT$))(1:3)<>"fmt" then 
26942 ! .         ! Apply at Header
26944             let FNAPPLYCONVERSION=HEADER
26946          else 
26948 ! .         ! Apply Manually
26950             let FNAPPLYCONVERSION=~HEADER
26952          end if 
26954       end if 
26956    fnend 
26958 ! 
26960    dim COMBO$(1)*255                  !
26962 Populatecombo: ! This Function Populates All The Combo Boxes On The Screen
26964    def FNPOPULATECOMBO(WINDOW,FDATAFILE,MAT FIELDSSSUBS$,MAT FIELDSNSUBS$,MAT S$,MAT SCREENSUBS$,MAT FORM$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;JUSTTHISONE,IGNOREFILTERS,EDITING,WHICHONE,___,ATTRIBUTE$*128,INDEX,SPEC$*60,POSITION,SELECT$)
26966       for INDEX=1 to UDIM(MAT FIELDTYPE$)
26968          if WHICHONE>=0 OR WHICHONE*-1=INDEX then 
26970             if (INDEX=JUSTTHISONE) OR (NOT JUSTTHISONE) then 
26972                if EDITING OR ~INVISIBLE(INDEX) then 
26974                   if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "combo" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "combo"
26976                      mat COMBO$(0)
26978                      if ~IGNOREFILTERS AND LEN(TRIM$(FUNCTION$(INDEX))) then 
26980 ! .                    ! run your populate function, pass it mat combo$
26982                         let FNEXECUTEGETDATA(FUNCTION$(INDEX),MAT COMBO$,INDEX)
26984                      end if 
26986                      let ATTRIBUTE$="="
26988                      let SELECT$=""
26990                      if GRIDLINES(INDEX) then let SELECT$=",SELECT"
26992                      let SPEC$=FNCALCULATESPEC$(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
26994 ! 
26996                      let POSITION=POS(SPEC$,",",-1)
26998                      let SPEC$(POSITION:POSITION-1)=SELECT$  !insert select attribute
27000 ! 
27002                      let POSITION=POS(SPEC$,",",POS(SPEC$,",",POS(SPEC$,",")+1)+1)
27004                      let SPEC$(POSITION+1:POSITION)=ATTRIBUTE$  !insert populate attribute
27006                      let SCR_FREEZE
27008                      print #WINDOW, fields SPEC$ : MAT COMBO$
27010                   else ! #Case Else#
27012 ! .                  ! Ignore Non-Combo Controls
27014                   end if              !#End Select#
27016                end if 
27018             end if 
27020          end if 
27022       next INDEX
27024    fnend 
27026 ! 
27028 Calculatelistviewspec: ! Calculate The Listview Spec Here
27030    def FNCALCULATELISTVIEWSPEC$*255(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ACTIVE,HEADERS,___,ATTRIBUTES$*128,SELECTED)
27032       if HEADERS then 
27034          let ATTRIBUTES$=ATTR$(CONTROL)
27036          let ATTRIBUTES$=FNREMOVEPROTECTEDATTRIBUTE$(ATTRIBUTES$)
27038          if ~FNVALIDATTRIBUTE(ATTRIBUTES$,FIELDTYPE$(CONTROL)) then 
27040             let ATTRIBUTES$=""
27042          end if 
27044          if SUM(SELECTEDCONTROLS) then 
27046             mat SELECTEDCONTROLS(UDIM(MAT CONTROLNAME$))
27048             let SELECTED=SELECTEDCONTROLS(CONTROL)
27050          end if 
27052          let FNCALCULATELISTVIEWSPEC$=STR$(VPOSITION(CONTROL))&","&STR$(HPOSITION(CONTROL))&",LIST "&STR$(HEIGHT(CONTROL))&"/"&STR$(WIDTH(CONTROL))&",HEADERS"&","&ATTRIBUTES$&FNCOLOR$(ACTIVE,FIELDTYPE$(CONTROL),FGCOLOR$(CONTROL),BGCOLOR$(CONTROL),SELECTED,INVISIBLE(CONTROL))&","&FNMAKEINDEX$(FIELDTYPE$(CONTROL),CONTROL)
27054       else 
27056          let FNCALCULATELISTVIEWSPEC$=STR$(VPOSITION(CONTROL))&","&STR$(HPOSITION(CONTROL))&",LIST "&STR$(HEIGHT(CONTROL))&"/"&STR$(WIDTH(CONTROL))
27058       end if 
27060    fnend 
27062 ! 
27064    def FNCONTROLDESCRIPTION$*255(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;FAVORCONTROLNAME)
27066       if FAVORCONTROLNAME then 
27068          if LEN(TRIM$(CONTROLNAME$(CONTROL))) then 
27070             let FNCONTROLDESCRIPTION$=CONTROLNAME$(CONTROL)
27072          else if LEN(TRIM$(DESCRIPTION$(CONTROL))) then 
27074             let FNCONTROLDESCRIPTION$=DESCRIPTION$(CONTROL)
27076          else 
27078             let FNCONTROLDESCRIPTION$=STR$(VPOSITION(CONTROL))&","&STR$(HPOSITION(CONTROL))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(CONTROL),JUSTIFY$(CONTROL),WIDTH(CONTROL),SPECWIDTH(CONTROL),HEIGHT(CONTROL))
27080          end if 
27082       else 
27084          if LEN(TRIM$(DESCRIPTION$(CONTROL))) then 
27086             let FNCONTROLDESCRIPTION$=DESCRIPTION$(CONTROL)
27088          else if LEN(TRIM$(CONTROLNAME$(CONTROL))) then 
27090             let FNCONTROLDESCRIPTION$=CONTROLNAME$(CONTROL)
27092          else 
27094             let FNCONTROLDESCRIPTION$=STR$(VPOSITION(CONTROL))&","&STR$(HPOSITION(CONTROL))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(CONTROL),JUSTIFY$(CONTROL),WIDTH(CONTROL),SPECWIDTH(CONTROL),HEIGHT(CONTROL))
27096          end if 
27098       end if 
27100    fnend 
27102 ! 
27104 Calculateframespec: ! Calculate Frame Spec here
27106    def FNCALCULATEFRAMESPEC$*255(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ACTIVE,RUNTIME,___,ATTRIBUTES$*128,SELECTED,TEXT$*255,DUMMY$*255,COLOR$*255)
27108       if RUNTIME then 
27110          let TEXT$=DESCRIPTION$(CONTROL)
27112       else if ~ACTIVE AND LEN(TRIM$(DESCRIPTION$(CONTROL))) then 
27114          let TEXT$=DESCRIPTION$(CONTROL)
27116       else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(CONTROL))) then 
27118          let TEXT$=CONTROLNAME$(CONTROL)
27120       else 
27122          let TEXT$=STR$(VPOSITION(CONTROL))&"."&STR$(HPOSITION(CONTROL))&"."&STR$(WIDTH(CONTROL))&"/"&STR$(HEIGHT(CONTROL))
27124       end if 
27126       let ATTRIBUTES$=",N="&ATTR$(CONTROL)
27128       if ~FNVALIDFRAME(ATTRIBUTES$) then let ATTRIBUTES$=""
27130       let COLOR$=FNCOLOR$(ACTIVE,FIELDTYPE$(CONTROL),FGCOLOR$(CONTROL),BGCOLOR$(CONTROL),SELECTED,INVISIBLE(CONTROL))
27132       if ~LEN(TRIM$(COLOR$)) then let COLOR$=""
27134       let ATTRIBUTES$=",N="&COLOR$
27136       if GRIDLINES(CONTROL) then 
27138          let ATTRIBUTES$=",border=S"&COLOR$&ATTRIBUTES$
27140          if LEN(TRIM$(TEXT$)) then 
27142             let ATTRIBUTES$=ATTRIBUTES$&",caption="&TRIM$(TEXT$)
27144          end if 
27146       end if 
27148       if LEN(TRIM$(PICTURE$(CONTROL))) then 
27150          let DUMMY$=PICTURE$(CONTROL)
27152          if POS(DUMMY$,":",-1)>4 then let DUMMY$=DUMMY$(1:POS(DUMMY$,":")-1)
27154          if EXISTS(DUMMY$) then 
27156             let ATTRIBUTES$=ATTRIBUTES$&",picture="&PICTURE$(CONTROL)
27158          end if 
27160       end if 
27162 ! 
27164       let FNCALCULATEFRAMESPEC$="srow="&STR$(VPOSITION(CONTROL))&",scol="&STR$(HPOSITION(CONTROL))&",rows="&STR$(HEIGHT(CONTROL))&",cols="&STR$(WIDTH(CONTROL))&ATTRIBUTES$
27166    fnend 
27168 ! 
27170 Calculatespec: !  Calculate Spec For Editor Control
27172    def FNCALCULATESPEC$*255(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ACTIVE,EDITING,OTHERCHANGED,___,TARGET$*32,TARGET,ATTRIBUTES$*383,ALTERNATESPEC$*255,FINALATTR$*383,PROTECT,FRAMESPEC$*255,POSOFCOMMA)
27174       if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="search" OR LWRC$(TRIM$(FIELDTYPE$(INDEX)))="filter" then 
27176          let TARGET=FNFINDTARGET(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
27178          if TARGET>0 then 
27180             let TARGET$=","&STR$(VPOSITION(TARGET))&","&STR$(HPOSITION(TARGET))
27182          else 
27184             let TARGET$=",1,1"        !Just Has To Be Something Valid
27186          end if 
27188          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="filter" then 
27190             let FNCLEANFILTER(PICTURE$(INDEX))
27192 ! 
27194             let TARGET$=TARGET$&","&TRIM$(PICTURE$(INDEX),",")
27196          end if 
27198       end if 
27200       let ATTRIBUTES$=ATTR$(INDEX)
27202       if PROTECTED(INDEX) then 
27204          if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" then ! #Select# lwrc$(trim$(FieldType$(Index))) #Case# "c"
27206             if LEN(TRIM$(SCREENIO$(SI_PROTECTEDTEXT))) then 
27208                let ATTRIBUTES$=TRIM$(ATTRIBUTES$)&TRIM$(SCREENIO$(SI_PROTECTEDTEXT))
27210                let PROTECT=1
27212             end if 
27214          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" then ! #Case# "button"
27216             if LEN(TRIM$(SCREENIO$(SI_PROTECTEDBUTTON))) then 
27218                let ATTRIBUTES$=TRIM$(ATTRIBUTES$)&TRIM$(SCREENIO$(SI_PROTECTEDBUTTON))
27220                let PROTECT=1
27222             end if 
27224          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "check" then ! #Case# "check"
27226             if LEN(TRIM$(SCREENIO$(SI_PROTECTEDCHECK))) then 
27228                let ATTRIBUTES$=TRIM$(ATTRIBUTES$)&TRIM$(SCREENIO$(SI_PROTECTEDCHECK))
27230                let PROTECT=1
27232             end if 
27234          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "search" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "filter" then ! #Case# "search" # "filter"
27236             if LEN(TRIM$(SCREENIO$(SI_PROTECTEDTEXT))) then 
27238                let ATTRIBUTES$=TRIM$(ATTRIBUTES$)&TRIM$(SCREENIO$(SI_PROTECTEDTEXT))
27240                let PROTECT=1
27242             end if 
27244          end if                       !#End Select#
27246       end if 
27248       if EDITING then 
27250          let ATTRIBUTES$=FNREMOVEPROTECTEDATTRIBUTE$(ATTRIBUTES$)
27252          if ~FNVALIDATTRIBUTE(ATTRIBUTES$,FIELDTYPE$(INDEX)) then 
27254             let ATTRIBUTES$=""
27256          end if 
27258          mat SELECTEDCONTROLS(UDIM(MAT FIELDTYPE$))
27260       else 
27262          if UPRC$(CNVRTIN$(INDEX))(1:4)="FMT(" then let ALTERNATESPEC$=CNVRTIN$(INDEX)
27264       end if 
27266       if FN42IA AND FNMULTILINETEXTBOX(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
27268          if FN42JD then 
27270             let ATTRIBUTES$=ATTRIBUTES$&"^ENTER_CRLF"
27272          else 
27274             let ATTRIBUTES$=ATTRIBUTES$&"^ENTER-CRLF"
27276          end if 
27278       end if 
27280       let FINALATTR$=ATTRIBUTES$&FNCOLOR$(ACTIVE,FIELDTYPE$(INDEX),FGCOLOR$(INDEX),BGCOLOR$(INDEX),(EDITING AND SELECTEDCONTROLS(INDEX)),(EDITING AND INVISIBLE(INDEX)),PROTECT,OTHERCHANGED)&TARGET$
27282       let FNCALCULATESPEC$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX),ATTR$(INDEX),ALTERNATESPEC$)&","&FINALATTR$&","&FNMAKEINDEX$(FIELDTYPE$(INDEX),INDEX)
27284 ! 
27286       if WINDOW then 
27288 ! .     ! if its a multiline textbox, button, or caption then
27290 ! .     ! open a frame tied to the thing by unique Parent$ value
27292          if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" then ! #Select# lwrc$(trim$(fieldtype$(Index))) #Case# "c" # "button" # "caption"
27294 ! .        ! We need to test if frame is broken first before reprinting it. We only need to reprint if it moves or changes
27296             let FRAMESPEC$=FNCALCULATEFRAMESPEC$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
27298             let FNCLOSEFRAMEWINDOW(PARENT$(INDEX),FRAMESPEC$)
27300             if HEIGHT(INDEX)>1 then 
27302                let FNCHANGEFORCEVISIBILITY(0)
27304                let FNOPENFRAMEWINDOW(WINDOW,FRAMESPEC$,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
27306                let FNCHANGEFORCEVISIBILITY(1)
27308             end if 
27310          end if                       !#End Select#
27312       end if 
27314    fnend 
27316 ! 
27318 Calculatedata: !  Calculate Data For Editor Control
27320    def FNCALCULATEDATA$*255(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ACTIVE,RUNTIME,___,DATA$*255,TARGET,TARGET$,DUMMY$*255)
27322       if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index)))   #Case# "caption"
27324          if RUNTIME OR (~ACTIVE AND LEN(TRIM$(DESCRIPTION$(INDEX)))) then 
27326             let DATA$=DESCRIPTION$(INDEX)
27328 !            If Data$="" Then Let Data$=" "
27330          else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(INDEX))) then 
27332             let DATA$=CONTROLNAME$(INDEX)
27334          else 
27336             let DATA$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX))
27338          end if 
27340          let FNCHANGESPECWIDTH(INDEX,LEN(DATA$))
27342       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "check" then ! #Case# "check"
27344          if RUNTIME OR (~ACTIVE AND LEN(TRIM$(DESCRIPTION$(INDEX)))) then 
27346             let DATA$=DESCRIPTION$(INDEX)
27348             if DATA$="" then let DATA$=" "
27350          else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(INDEX))) then 
27352             let DATA$=CONTROLNAME$(INDEX)
27354          else if ACTIVE then 
27356             let DATA$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX),ATTR$(INDEX))
27358          else 
27360             let DATA$=""
27362          end if 
27364 ! 
27366          if ACTIVE then let DATA$="^"&DATA$
27368          let FNCHANGESPECWIDTH(INDEX,LEN(DATA$)+1)
27370       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" then ! #Case# "button"
27372          if RUNTIME OR (~ACTIVE AND LEN(TRIM$(DESCRIPTION$(INDEX)))) then 
27374             let DATA$=DESCRIPTION$(INDEX)
27376             if DATA$="" then let DATA$=" "
27378          else if ~ACTIVE AND LEN(TRIM$(FUNCTION$(INDEX))) then 
27380             let DATA$=FUNCTION$(INDEX)
27382          else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(INDEX))) then 
27384             let DATA$=CONTROLNAME$(INDEX)
27386          else 
27388             let DATA$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX),"",ALTSPEC$)
27390          end if 
27392          let FNCHANGESPECWIDTH(INDEX,LEN(DATA$))
27394       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "p" then ! #Case# "p"
27396          if RUNTIME OR LEN(TRIM$(PICTURE$(INDEX))) then 
27398             let DATA$=PICTURE$(INDEX)
27400             if DATA$="" then let DATA$=SETTING_IMAGEPATH$&"\nothing.gif"
27402             if FN42 then 
27404                let DUMMY$=PICTURE$(INDEX)
27406                if POS(PICTURE$(INDEX),":",-1)>4 then let DUMMY$=DUMMY$(1:POS(DUMMY$,":")-1)
27408                if ~EXISTS(DUMMY$) then let DATA$=SETTING_IMAGEPATH$&"\nothing.gif"
27410             end if 
27412          else 
27414             if FN42 then 
27416                let DATA$=SETTING_IMAGEPATH$&"\yellow.gif"
27418             else 
27420                let DATA$="nothing.bmp"  !It Doesn't have to exist in 4.1
27422             end if 
27424          end if 
27426       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" then ! #Case# "c"
27428          if RUNTIME then 
27430             let DATA$=DESCRIPTION$(INDEX)
27432             if DATA$="" then let DATA$=" "
27434          else if ~ACTIVE AND LEN(TRIM$(FIELDNAME$(INDEX))) then 
27436             let DATA$=FIELDNAME$(INDEX)
27438          else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(INDEX))) then 
27440             let DATA$=CONTROLNAME$(INDEX)
27442          else 
27444             if UPRC$(CNVRTIN$(INDEX))(1:4)="FMT(" then let DUMMY$=CNVRTIN$(INDEX) else let DUMMY$=""
27446             let DATA$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX),"",DUMMY$)
27448          end if 
27450 ! 
27452          let DATA$=DATA$(1:SPECWIDTH(INDEX))
27454 ! 
27456       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "search" then ! #Case# "search"
27458          let TARGET=FNFINDTARGET(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
27460          if TARGET>0 then 
27462             let TARGET$=",,"&STR$(VPOSITION(TARGET))&","&STR$(HPOSITION(TARGET))
27464          end if 
27466 ! 
27468          if RUNTIME then 
27470             let DATA$=DESCRIPTION$(INDEX)
27472             if DATA$="" then let DATA$=" "
27474          else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(INDEX))) then 
27476             let DATA$=CONTROLNAME$(INDEX)
27478          else 
27480             let DATA$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX))&TARGET$
27482          end if 
27484 ! 
27486          let DATA$=DATA$(1:SPECWIDTH(INDEX))
27488 ! 
27490       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "filter" then ! #Case# "filter"
27492          let TARGET=FNFINDTARGET(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
27494          if TARGET>0 then 
27496             let TARGET$=",,"&STR$(VPOSITION(TARGET))&","&STR$(HPOSITION(TARGET))
27498          end if 
27500 ! 
27502          if RUNTIME then 
27504             let DATA$=DESCRIPTION$(INDEX)
27506             if DATA$="" then let DATA$=" "
27508          else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(INDEX))) then 
27510             let DATA$=CONTROLNAME$(INDEX)
27512          else 
27514             let DATA$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX))&TARGET$&","&PICTURE$(INDEX)
27516          end if 
27518 ! 
27520          let DATA$=DATA$(1:SPECWIDTH(INDEX))
27522 ! 
27524       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listchld" then ! #Case# "listchld"
27526       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listview" then ! #Case# "listview"
27528       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "screen" then ! #Case# "screen"
27530       else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "frame" then ! #Case# "frame"
27532       else ! #Case Else#
27534          if RUNTIME then 
27536             let DATA$=DESCRIPTION$(INDEX)
27538             if DATA$="" then let DATA$=" "
27540          else if ~ACTIVE AND LEN(TRIM$(FIELDNAME$(INDEX))) then 
27542             let DATA$=FIELDNAME$(INDEX)
27544          else if ~ACTIVE AND LEN(TRIM$(CONTROLNAME$(INDEX))) then 
27546             let DATA$=CONTROLNAME$(INDEX)
27548          else 
27550             let DATA$=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&FNCALCULATEFIELDTYPE$(FIELDTYPE$(INDEX),JUSTIFY$(INDEX),WIDTH(INDEX),SPECWIDTH(INDEX),HEIGHT(INDEX))
27552          end if 
27554 ! 
27556          if SPECWIDTH(INDEX)>0 then 
27558             let DATA$=DATA$(1:SPECWIDTH(INDEX))
27560          else 
27562             let DATA$=DATA$(1:WIDTH(INDEX))
27564          end if 
27566       end if                          !#End Select#
27568       let FNCALCULATEDATA$=DATA$
27570    fnend 
27572 ! 
27574 Calculatehelp: ! Calculate The Helptext By Adding The "3;" To The Beginning If Necessary.
27576    def FNCALCULATEHELP$*1017(HELPTEXT$*1050;___,X,HELPLEVEL$)
27578       let FNFIXTOOLTIPS(HELPTEXT$)
27580       let FNCALCULATEHELP$=HELPTEXT$(1:1017)
27582    fnend 
27584 ! 
27586    def library FNBR42=FN42
27588    def library FNBR43=FN43
27590    def FN42=(VAL(WBVERSION$(1:3))>=4.2)
27592    def FN43=(VAL(WBVERSION$(1:3))>=4.3)
27594    def FN44=(VAL(WBVERSION$(1:3))>=4.4)
27596    def FN42IA=((WBVERSION$=="4.20ia") OR (FN42 AND (WBVERSION$(5:5)>"i"))) OR FN43
27598    def FN42JD=(WBVERSION$>="4.20jd") OR FN43
27600    def FN42E=(WBVERSION$>="4.20e") OR FN43
27602    def FN432=(WBVERSION$(1:4)>="4.32") OR FN44
27604    def FN432C=((WBVERSION$(1:4)=="4.32") AND (LWRC$(WBVERSION$(5:5))>="c")) OR FN433
27606    def FN433=(WBVERSION$(1:4)>="4.33") OR FN44
27608 ! 
27610 ! 
27612 Calculatefieldtype: ! Caluclate Display Spec Based On Field Type
27614    def FNCALCULATEFIELDTYPE$*255(TYPE$,JUSTIFY$,WIDTH,SPECWIDTH,HEIGHT;ATTR$*128,ALTSPEC$*255)
27616       if LWRC$(TRIM$(TYPE$)) = "c" then ! #Select# Lwrc$(Trim$(Type$)) #Case# "c"
27618 !         if Height>1 then let Width=Width+((Height-1)*Screenio(Si_Hsize))
27620          let WIDTH=WIDTH*MAX(HEIGHT,1)
27622          if ALTSPEC$="" then 
27624             let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&FNDISPLAYFIELDTYPE$(TYPE$)&TRIM$(JUSTIFY$)&" "&STR$(SPECWIDTH)
27626          else 
27628             let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&ALTSPEC$
27630          end if 
27632       else if LWRC$(TRIM$(TYPE$)) = "combo" then ! #Case# "combo"
27634          let WIDTH=WIDTH*MAX(HEIGHT,1)
27636          if ALTSPEC$="" then 
27638             let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&FNDISPLAYFIELDTYPE$(TYPE$)&" "&STR$(SPECWIDTH)
27640          else 
27642             let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&ALTSPEC$
27644          end if 
27646       else if LWRC$(TRIM$(TYPE$)) = "p" then ! #Case# "p"
27648          let FNCALCULATEFIELDTYPE$=FNDISPLAYFIELDTYPE$(TYPE$)&" "&STR$(HEIGHT)&"/"&STR$(WIDTH)
27650       else if LWRC$(TRIM$(TYPE$)) = "button" then ! #Case# "button"
27652          let WIDTH=WIDTH*MAX(HEIGHT,1)
27654          let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&FNDISPLAYFIELDTYPE$(TYPE$)&" "&STR$(MAX(SPECWIDTH,1))
27656       else if LWRC$(TRIM$(TYPE$)) = "caption" then ! #Case# "caption"
27658 !         if Height>1 then let Width=Width+((Height-1)*Screenio(Si_Hsize))
27660          let WIDTH=WIDTH*MAX(HEIGHT,1)
27662          let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&FNDISPLAYFIELDTYPE$(TYPE$)&TRIM$(JUSTIFY$)&" "&STR$(SPECWIDTH)
27664       else if LWRC$(TRIM$(TYPE$)) = "listchld" then ! #Case# "listchld"
27666       else if LWRC$(TRIM$(TYPE$)) = "listview" then ! #Case# "listview"
27668       else if LWRC$(TRIM$(TYPE$)) = "frame" then ! #Case# "frame"
27670       else if LWRC$(TRIM$(TYPE$)) = "check" then ! #Case# "check"
27672          if POS("0123456789",ATTR$(1:1)) then let TYPE$="radio"
27674          let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&FNDISPLAYFIELDTYPE$(TYPE$)&" "&STR$(MAX(SPECWIDTH,1))
27676       else if LWRC$(TRIM$(TYPE$)) = "search" OR LWRC$(TRIM$(TYPE$)) = "filter" then ! #Case# "search" # "filter"
27678          let FNCALCULATEFIELDTYPE$=STR$(WIDTH)&"/"&FNDISPLAYFIELDTYPE$(TYPE$)&" "&STR$(SPECWIDTH)
27680       else ! #Case Else#
27682          let FNCALCULATEFIELDTYPE$=FNDISPLAYFIELDTYPE$(TYPE$)&" "&STR$(WIDTH)
27684       end if                          !#End Select#
27686    fnend 
27688 ! 
27690 Displayfieldtype: !  Calculate Display Field Type
27692    def FNDISPLAYFIELDTYPE$(TYPE$)
27694       if LWRC$(TRIM$(TYPE$)) = "caption" then ! #Select# Lwrc$(Trim$(Type$)) #Case# "caption"
27696          let FNDISPLAYFIELDTYPE$="C"
27698       else if LWRC$(TRIM$(TYPE$)) = "button" then ! #Case# "button"
27700          let FNDISPLAYFIELDTYPE$="CC"
27702       else if LWRC$(TRIM$(TYPE$)) = "listview" then ! #Case# "listview"
27704       else if LWRC$(TRIM$(TYPE$)) = "listchld" then ! #Case# "listchld"
27706       else ! #Case Else#
27708          let FNDISPLAYFIELDTYPE$=TYPE$
27710       end if                          !#End Select#
27712    fnend 
27714 Color: ! Determine Color Spec Based On Type
27716    def FNCOLOR$*255(ACTIVE,TYPE$,FGCOLOR$,BGCOLOR$;SELECTED,INVISIBLE,PROTECTED,OTHERCHANGED,___,SUNKEN$,COLOR$*255)
27718       if OTHERCHANGED then 
27720          if LEN(TRIM$(SCREENIO$(SI_OTHERCHANGES))) then 
27722             let COLOR$=TRIM$(SCREENIO$(SI_OTHERCHANGES))
27724          else 
27726             let COLOR$="/#000000:#FF99FF"  !Pink
27728          end if 
27730       else 
27732          if ACTIVE then 
27734             if SELECTED then 
27736                let BGCOLOR$="A0FF00"  !Yellow Green
27738             else 
27740                if INVISIBLE then 
27742                   let BGCOLOR$="FF9933"  !Orange (Yellow Pink)
27744                else 
27746                   let BGCOLOR$="FFFF00"  !Yellow
27748                end if 
27750             end if 
27752          else 
27754             if SELECTED then 
27756                let BGCOLOR$="00FF00"  !Green
27758             else if INVISIBLE then 
27760                let BGCOLOR$="FF99FF"  !Pink
27762             end if 
27764          end if 
27766          if ~PROTECTED AND (LEN(TRIM$(FGCOLOR$)) OR LEN(TRIM$(BGCOLOR$))) then 
27768             if ~FNVALIDHEXCOLOR(FGCOLOR$) then let FGCOLOR$="W"
27770             if ~FNVALIDHEXCOLOR(BGCOLOR$) then let BGCOLOR$="W"
27772             if LEN(TRIM$(FGCOLOR$))=6 then let FGCOLOR$="#"&FGCOLOR$
27774             if LEN(TRIM$(BGCOLOR$))=6 then let BGCOLOR$="#"&BGCOLOR$
27776             let FGCOLOR$=TRIM$(FGCOLOR$)
27778             let BGCOLOR$=TRIM$(BGCOLOR$)
27780             let COLOR$="/"&FGCOLOR$&":"&BGCOLOR$
27782          end if 
27784 ! .! .!
27786          if LWRC$(TRIM$(TYPE$)) = "c" then ! #Select# Lwrc$(Trim$(Type$)) #Case# "c"
27788             let SUNKEN$="S"
27790          else ! #Case Else#
27792             let SUNKEN$=""
27794          end if                       !#End Select#
27796       end if 
27798       let FNCOLOR$=SUNKEN$&COLOR$
27800    fnend 
27802 Makeindex: !  Calculate Index Based On Field Type   (Button Or Otherwise)
27804    def FNMAKEINDEX$(TYPE$,INDEX)
27806       if LWRC$(TRIM$(TYPE$)) = "button" then ! #Select# Lwrc$(Trim$(Type$)) #Case#  "button"
27808          let FNMAKEINDEX$="B"&STR$(FNKEYBASE+INDEX)
27810       else ! #Case Else#
27812          let FNMAKEINDEX$=STR$(FNKEYBASE+INDEX)
27814       end if                          !#End Select#
27816    fnend 
27818 ! 
27820 Removeprotectedattribute: ! Strip Protected Attribute
27822    def FNREMOVEPROTECTEDATTRIBUTE$*128(WRKATTR$*128;___,PLOOP,SPOT)
27824       for PLOOP = 1 to LEN(WRKATTR$)
27826          if (SPOT:=POS(WRKATTR$,"[",PLOOP))>0 then 
27828             let WRKATTR$(PLOOP:SPOT-1)=SREP$(WRKATTR$(PLOOP:SPOT-1),"p","")
27830             let WRKATTR$(PLOOP:SPOT-1)=SREP$(WRKATTR$(PLOOP:SPOT-1),"P","")
27832             let PLOOP = POS(WRKATTR$,"]",SPOT)
27834             if PLOOP<1 then 
27836                let PLOOP=LEN(WRKATTR$)+5
27838             end if 
27840          else 
27842             let WRKATTR$(PLOOP:LEN(WRKATTR$)) = SREP$(WRKATTR$(PLOOP:LEN(WRKATTR$)),"p","")
27844             let WRKATTR$(PLOOP:LEN(WRKATTR$)) = SREP$(WRKATTR$(PLOOP:LEN(WRKATTR$)),"P","")
27846             let PLOOP=LEN(WRKATTR$)+5
27848          end if 
27850       next PLOOP
27852       let FNREMOVEPROTECTEDATTRIBUTE$=WRKATTR$
27854    fnend 
27856 ! 
27858 Attribute: ! Check For A Specific Attribute
27860    def FNATTRIBUTE(SEARCHFOR$,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,PARENT$,CONTROL,STARTP,ENDP,ATTRIBUTE$*255,BROKEN)  !Returns True If Theres An L Attribute
27862       if LISTVIEWINDEX AND LISTVIEWINDEX<=UDIM(MAT PARENT$) then 
27864          let PARENT$=PARENT$(LISTVIEWINDEX)
27866          for CONTROL=1 to UDIM(MAT PARENT$)
27868             if PARENT$(CONTROL)=PARENT$ then 
27870                let BROKEN=0
27872                let ATTRIBUTE$=ATTR$(CONTROL)
27874                do WHILE (STARTP:=POS(ATTRIBUTE$,"["))>0
27876                   if (ENDP:=POS(ATTRIBUTE$,"]",STARTP)) then 
27878                      let ATTRIBUTE$(STARTP:ENDP)=""
27880                   else 
27882                      let BROKEN=1
27884                   end if 
27886                loop UNTIL BROKEN
27888                if ~BROKEN then 
27890                   if POS(LWRC$(ATTRIBUTE$),LWRC$(SEARCHFOR$))>0 then 
27892                      let FNATTRIBUTE=1
27894                      let CONTROL=UDIM(MAT PARENT$)
27896                   end if 
27898                end if 
27900             end if 
27902          next CONTROL
27904       end if 
27906    fnend 
27908 ! 
27910 ! *****************************************************************
27912 ! ********************** Input Listview Fields ********************
27914 ! *****************************************************************
27916 Inputlistviewfields: ! Create A Grid Containing All Listview Columns
27918    def FNINPUTLISTVIEWFIELDS(&MODE, &CONTROL, MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,WINDOW,FUNCTION,WEDITOR,SPEC$*60,INDEX,COLUMNS,KEY$,LASTCHILD,WFIELDS,INPUTROW,CURRENTCOLUMN,DIRECTION,FROMINDEX,TOINDEX,FKEYVALUE$,WGRID,LSPEC$*64,EROW,ECOL,LWIDTH,ROWS,COLS)
27920 ! 
27922       if CONTROL>0 AND LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="listview" then 
27924          let WEDITOR=FNGETEDITORWINDOW
27926 ! 
27928 ! .       ! Open Window to the Left with the row captions
27930          let WINDOW=FNOPENGRIDHEADINGSWINDOW(14,15,VPOSITION(CONTROL),HPOSITION(CONTROL))
27932          let FNPRINTGRIDHEADINGSWINDOW(WINDOW,15)
27934 ! 
27936          if FN43 then 
27938             execute "config keyboard C000 1300"  !Ctrl <- To Shift F9  (Fkey 19)
27940             execute "config keyboard C100 1500"  !Ctrl -> To Shift F10 (Fkey 21)
27942          else 
27944             execute "config keyboard 7600 1300"  !Ctrl <- To Shift F9  (Fkey 19)
27946             execute "config keyboard 7500 1500"  !Ctrl -> To Shift F10 (Fkey 21)
27948          end if 
27950          execute "config keyboard 0B00 0A0A0A636F6E206B657920636C6561720D"  !Shift F1 Key To "con key clear<CR>"
27952 ! 
27954          let FNGETEDITORPOSITION(EROW,ECOL)
27956          let LSPEC$=FNCALCULATELISTVIEWHEADERS$(MAT DRAW_LV_CAPTION$, MAT DRAW_LV_WIDTH, MAT DRAW_LV_SPEC$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE,COLUMNS)
27958 ! 
27960          let EROW=VPOSITION(CONTROL)
27962          let ECOL=HPOSITION(CONTROL)
27964          let FNCALCULATEREALPOSITION(EROW,ECOL)
27966          let LWIDTH=WIDTH(CONTROL)
27968          let FNGETSCREENSIZE(ROWS,COLS)
27970          let EROW=MIN(ROWS-14,EROW)
27972 ! 
27974 ! .     ! Open it at position of editor window + position of listview, width of listview, height of 10
27976          open #(WGRID:=FNGETFILENUMBER): "srow="&STR$(EROW)&",scol="&STR$(ECOL)&",rows=13,cols="&STR$(LWIDTH),display,outin 
27978 ! 
27980          do 
27982 ! .          ! Draw Listview Header
27984             let SPEC$=FNCALCULATELISTVIEWHEADERS$(MAT DRAW_LV_CAPTION$, MAT DRAW_LV_WIDTH, MAT DRAW_LV_SPEC$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE,COLUMNS)
27986             let SPEC$=SREP$(UPRC$(SPEC$),"LIST","GRID")
27988             let SPEC$(1:POS(SPEC$,"/")-1)="1,1,GRID 13"
27990 ! 
27992             if FN42 then 
27994                mat DRAW_LV_SPEC$=("C 255,^nosort")  !Reset All Specs To Attribute Grid Specs
27996             else 
27998                mat DRAW_LV_SPEC$=("C 255")  !Reset All Specs To Attribute Grid Specs
28000             end if 
28002             for INDEX=1 to UDIM(MAT DRAW_LV_WIDTH)
28004                let DRAW_LV_WIDTH(INDEX)=MAX(1,DRAW_LV_WIDTH(INDEX))
28006             next INDEX
28008 ! 
28010             print #WGRID, fields SPEC$ : (MAT DRAW_LV_CAPTION$, MAT DRAW_LV_WIDTH, MAT DRAW_LV_SPEC$)
28012 ! 
28014 ! .         ! Populate Listview with Column Data
28016             let FNLOADLISTCHLDDATA(CONTROL,COLUMNS,MAT DRAW_LV_DATA$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28018 ! 
28020             let SPEC$=FNCALCULATELISTVIEWSPEC$(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28022             let SPEC$=SREP$(UPRC$(SPEC$),"LIST","GRID")
28024             let SPEC$(1:POS(SPEC$,"/")-1)="1,1,GRID 13"
28026             let FKEYVALUE$=","&FNMAKEINDEX$(FIELDTYPE$(CONTROL),CONTROL)
28028             print #WGRID, fields SPEC$&",="&FKEYVALUE$ : (MAT DRAW_LV_DATA$)
28030 ! 
28032 ! .         ! Next Input from Grid
28034             if UDIM(MAT DRAW_LV_DATA$) AND SUM(MAT DRAW_LV_WIDTH) then 
28036                input #WGRID, fields SPEC$&",CELL,ALL"&FKEYVALUE$ : (MAT DRAW_LV_DATA$)
28038                let CURRENTCOLUMN=CURCOL
28040             else 
28042                input #0, fields "1,2,C 1,AEX" : KEY$
28044                let CURRENTCOLUMN=0
28046             end if 
28048             let FUNCTION=FKEY
28050 ! 
28052 ! .         ! Store Results Back into Child Arrays
28054             let FNSAVELISTCHLDDATA(CONTROL,COLUMNS,MAT DRAW_LV_DATA$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28056 ! 
28058             if FUNCTION=0 then 
28060                let FUNCTION=1500+CONTROL
28062             end if 
28064 ! 
28066             if FUNCTION=19 OR FUNCTION=21 then ! Ctrl Left Arrow (Shift Column)
28068                let DIRECTION=FUNCTION-20  !-1 For Left, 1 For Right
28070                if CURRENTCOLUMN>0 AND CURRENTCOLUMN<=COLUMNS AND CURRENTCOLUMN+DIRECTION>0 AND CURRENTCOLUMN+DIRECTION<=COLUMNS then 
28072                   let FROMINDEX=FNFINDLISTVIEWCHILD(CURRENTCOLUMN,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28074                   let TOINDEX=FNFINDLISTVIEWCHILD(CURRENTCOLUMN+DIRECTION,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28076                   let FNSWAPCONTROLARRAYS(FROMINDEX,TOINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28078                   let CURFLD(1,(COLUMNS*(CURROW-1))+CURRENTCOLUMN+DIRECTION)
28080                else 
28082                   print BELL
28084                   let CURFLD(1,(COLUMNS*(CURROW-1))+CURRENTCOLUMN)
28086                end if 
28088             end if 
28090             if FUNCTION=1000 then ! Add Column
28092                let FNADDLISTVIEWCHILD(PARENT$(CONTROL),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28094             end if 
28096             if FUNCTION=1001 then ! Delete Column
28098 ! .            ! Find Current Column. Delete That One. Shift All Others.
28100                let FROMINDEX=FNFINDLISTVIEWCHILD(CURRENTCOLUMN,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28102 ! 
28104                for INDEX=FROMINDEX to UDIM(MAT CONTROLNAME$)-1
28106                   let FNCOPYCONTROLARRAYS(INDEX,INDEX+1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28108                next INDEX
28110                let FNRESIZECONTROLARRAYS(UDIM(MAT CONTROLNAME$)-1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28112             end if 
28114             if FUNCTION=1300 then 
28116                let WFIELDS=FNGETFIELDSWINDOW
28118                let FNCOLORFIELDSACTIVE(1)
28120                do 
28122                   let FNGETFIELDSSPEC(SPEC$)
28124                   rinput #WFIELDS, fields SPEC$ : INPUTROW
28126                   let FUNCTION=FKEY
28128                   if FUNCTION=1300 OR FUNCTION=0 OR FUNCTION=201 then 
28130                      let FNADDCURRENTLISTCHLD(PARENT$(CONTROL),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28132                      let FUNCTION=0
28134 ! 
28136                      let SPEC$=FNCALCULATELISTVIEWHEADERS$(MAT DRAW_LV_CAPTION$, MAT DRAW_LV_WIDTH, MAT DRAW_LV_SPEC$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ACTIVE,COLUMNS)
28138                      let SPEC$=SREP$(UPRC$(SPEC$),"LIST","GRID")
28140                      let SPEC$(1:POS(SPEC$,"/")-1)="1,1,GRID 13"
28142 ! 
28144                      mat DRAW_LV_SPEC$=("C 255")  !Reset All Specs To Attribute Grid Specs
28146                      for INDEX=1 to UDIM(MAT DRAW_LV_WIDTH)
28148                         let DRAW_LV_WIDTH(INDEX)=MAX(1,DRAW_LV_WIDTH(INDEX))
28150                      next INDEX
28152                      print #WGRID, fields SPEC$ : (MAT DRAW_LV_CAPTION$, MAT DRAW_LV_WIDTH, MAT DRAW_LV_SPEC$)
28154                      let FNLOADLISTCHLDDATA(CONTROL,COLUMNS,MAT DRAW_LV_DATA$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28156                      let SPEC$=FNCALCULATELISTVIEWSPEC$(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
28158                      let SPEC$=SREP$(UPRC$(SPEC$),"LIST","GRID")
28160                      let SPEC$(1:POS(SPEC$,"/")-1)="1,1,GRID 13"
28162 ! 
28164                      let FKEYVALUE$=","&FNMAKEINDEX$(FIELDTYPE$(CONTROL),CONTROL)
28166                      print #WGRID, fields SPEC$&",="&FKEYVALUE$ : (MAT DRAW_LV_DATA$)
28168                   end if 
28170                loop WHILE FUNCTION=0
28172                if FUNCTION=1500+CONTROL then 
28174                   let FUNCTION=0
28176                end if 
28178                let FNCOLORFIELDSACTIVE(0)
28180             end if 
28182          loop UNTIL FUNCTION>1100 OR FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR FUNCTION=44
28184          close #WINDOW:               !Close Gridheadings Window
28186          close #WGRID:                !Close Grid editing window
28188          execute "config keyboard clear"
28190          let FNINPUTLISTVIEWFIELDS=FUNCTION
28192       else 
28194          let MODE=0                   !Reset Mode For Invalid Control
28196       end if 
28198    fnend 
28200 ! 
28202 Findlistviewchild: ! Finds The "Nth" Listview Child
28204    def FNFINDLISTVIEWCHILD(N,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,COUNT)
28206       do WHILE (INDEX:=INDEX+1)<= UDIM(MAT FIELDTYPE$)
28208          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="listchld" AND PARENT$(INDEX)=PARENT$(CONTROL) then 
28210             let COUNT+=1
28212          end if 
28214       loop UNTIL COUNT=N
28216       let FNFINDLISTVIEWCHILD=INDEX
28218    fnend 
28220 ! 
28222 Countcolumns: ! Count The Columns Of A Listview Control
28224    def FNCOUNTCOLUMNS(PARENT$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,COUNT)
28226       for INDEX=1 to UDIM(MAT FIELDTYPE$)
28228          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="listchld" AND PARENT$(INDEX)=PARENT$ then 
28230             let COUNT+=1
28232          end if 
28234       next INDEX
28236       let FNCOUNTCOLUMNS=COUNT
28238    fnend 
28240 ! 
28242 Opengridheadingswindow: !  Open The Attributes Window In A Place It Wont Be Off The Screen
28244    def FNOPENGRIDHEADINGSWINDOW(ROWSIZE,COLSIZE,ROW,COL;___,WINDOW,ROWS,COLS)
28246       let FNCALCULATEREALPOSITION(ROW, COL)
28248       let ROW=MAX(2,ROW)              !Try To The Left
28250       let COL=MAX(2,COL-COLSIZE-1)
28252       let FNGETSCREENSIZE(ROWS,COLS)
28254       let ROW=MIN(ROWS-ROWSIZE,ROW)
28256       open #(WINDOW:=FNGETFILENUMBER) : "SROW="&STR$(ROW)&",SCOL="&STR$(COL)&",ROWS="&STR$(ROWSIZE)&",COLS="&STR$(COLSIZE)&",Border=S",display,outin 
28258       let FNOPENGRIDHEADINGSWINDOW=WINDOW
28260    fnend 
28262 ! 
28264 Printgridheadingswindow: ! Print The Grid Headings To The Given Window
28266    def FNPRINTGRIDHEADINGSWINDOW(WINDOW,WIDTH)
28268       dim GH_CAPTION$(1),GH_WIDTH(1),GH_SPEC$(1)
28270       dim GH_DATA$(11)
28272 ! 
28274       let GH_CAPTION$(1)=""
28276       let GH_WIDTH(1)=WIDTH
28278       if FN42 then 
28280          let GH_SPEC$(1)="CR 18,^nosort"
28282       else 
28284          let GH_SPEC$(1)="CR 18"
28286       end if 
28288 ! 
28290       dim LV_BUTTONS$(2)
28292       dim LV_BUTTONSSPEC$(2)*32
28294 ! 
28296       let LV_BUTTONSSPEC$(1)="13,1,CC 14,/W:W,B1000"
28298       let LV_BUTTONSSPEC$(2)="14,1,CC 14,/W:W,B1001"
28300 ! 
28302       let LV_BUTTONS$(1)="Add Column"
28304       let LV_BUTTONS$(2)="Delete Column"
28306 ! 
28308       let GH_DATA$(1)="Control Name-" !:
            let GH_DATA$(2)="Field Name-" !:
            let GH_DATA$(3)="Caption-" !:
            let GH_DATA$(4)="Data Width-" !:
            let GH_DATA$(5)="Display Width-" !:
            let GH_DATA$(6)="Justify-" !:
            let GH_DATA$(7)="FgColor-" !:
            let GH_DATA$(8)="BgColor-" !:
            let GH_DATA$(9)="Attributes-" !:
            let GH_DATA$(10)="Column Spec-" !:
            let GH_DATA$(11)="Date Disk Fmt-"
28310 ! 
28312       print #WINDOW, fields "1,1,GRID 12/16,HEADERS,/W:W" : (MAT GH_CAPTION$, MAT GH_WIDTH, MAT GH_SPEC$)
28314       print #WINDOW, fields "1,1,GRID 12/16,=" : (MAT GH_DATA$)
28316       print #WINDOW, fields MAT LV_BUTTONSSPEC$ : MAT LV_BUTTONS$
28318    fnend 
28320 ! 
28322 Savelistchlddata: ! Saves The Listview Child Data Back To The Screencontrols Objects
28324    def FNSAVELISTCHLDDATA(CONTROL,COLUMNS,MAT DATA$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,DUMMY$)
28326       for INDEX=1 to UDIM(DATA$)
28328          if INT((INDEX-1)/COLUMNS)+1 = 1 then ! #Select# Int((Index-1)/Columns)+1 #Case# 1
28330             let CONTROLNAME$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))(1:20)
28332          else if INT((INDEX-1)/COLUMNS)+1 = 2 then ! #Case# 2
28334             let FIELDNAME$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))(1:30)
28336          else if INT((INDEX-1)/COLUMNS)+1 = 3 then ! #Case# 3
28338             let DESCRIPTION$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))(1:60)
28340          else if INT((INDEX-1)/COLUMNS)+1 = 4 then ! #Case# 4
28342             let SPECWIDTH(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=VAL(DATA$(INDEX)) conv IGNORE
28344          else if INT((INDEX-1)/COLUMNS)+1 = 5 then ! #Case# 5
28346             let WIDTH(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=VAL(DATA$(INDEX)) conv IGNORE
28348          else if INT((INDEX-1)/COLUMNS)+1 = 6 then ! #Case# 6
28350             let DUMMY$=TRIM$(UPRC$(DATA$(INDEX)))(LEN(TRIM$(DATA$(INDEX))):LEN(TRIM$(DATA$(INDEX))))
28352             if DUMMY$="C" OR DUMMY$="U" OR DUMMY$="R" OR DUMMY$="L" OR DUMMY$="" then 
28354                let JUSTIFY$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=DUMMY$
28356             end if 
28358          else if INT((INDEX-1)/COLUMNS)+1 = 7 then ! #Case# 7
28360             let FGCOLOR$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))(1:6)
28362          else if INT((INDEX-1)/COLUMNS)+1 = 8 then ! #Case# 8
28364             let BGCOLOR$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))(1:6)
28366          else if INT((INDEX-1)/COLUMNS)+1 = 9 then ! #Case# 9
28368             let ATTR$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))
28370          else if INT((INDEX-1)/COLUMNS)+1 = 10 then ! #Case# 10
28372             let DATA$(INDEX)=FNFIXDATESPEC$(DATA$(INDEX))
28374             let CNVRTIN$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))
28376          else if INT((INDEX-1)/COLUMNS)+1 = 11 then ! #Case# 11
28378             let DATA$(INDEX)=FNFIXDATESPEC$(DATA$(INDEX))
28380             let CNVRTOUT$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))=TRIM$(DATA$(INDEX))
28382          end if                       !#End Select#
28384       next INDEX
28386    fnend 
28388 ! 
28390 Loadlistchlddata: ! Loads The Listview Child Data From The Screencontrols Objects
28392    def FNLOADLISTCHLDDATA(CONTROL,COLUMNS,MAT DATA$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX)
28394       mat DATA$(11*COLUMNS)
28396       for INDEX=1 to UDIM(DATA$)
28398          if INT((INDEX-1)/COLUMNS)+1 = 1 then ! #Select# Int((Index-1)/Columns)+1 #Case# 1
28400             let DATA$(INDEX)=CONTROLNAME$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28402          else if INT((INDEX-1)/COLUMNS)+1 = 2 then ! #Case# 2
28404             let DATA$(INDEX)=FIELDNAME$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28406          else if INT((INDEX-1)/COLUMNS)+1 = 3 then ! #Case# 3
28408             let DATA$(INDEX)=DESCRIPTION$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28410          else if INT((INDEX-1)/COLUMNS)+1 = 4 then ! #Case# 4
28412             let DATA$(INDEX)=STR$(SPECWIDTH(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)))
28414          else if INT((INDEX-1)/COLUMNS)+1 = 5 then ! #Case# 5
28416             let DATA$(INDEX)=STR$(WIDTH(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)))
28418          else if INT((INDEX-1)/COLUMNS)+1 = 6 then ! #Case# 6
28420             let DATA$(INDEX)=JUSTIFY$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28422          else if INT((INDEX-1)/COLUMNS)+1 = 7 then ! #Case# 7
28424             let DATA$(INDEX)=FGCOLOR$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28426          else if INT((INDEX-1)/COLUMNS)+1 = 8 then ! #Case# 8
28428             let DATA$(INDEX)=BGCOLOR$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28430          else if INT((INDEX-1)/COLUMNS)+1 = 9 then ! #Case# 9
28432             let DATA$(INDEX)=ATTR$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28434          else if INT((INDEX-1)/COLUMNS)+1 = 10 then ! #Case# 10
28436             let DATA$(INDEX)=CNVRTIN$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28438          else if INT((INDEX-1)/COLUMNS)+1 = 11 then ! #Case# 11
28440             let DATA$(INDEX)=CNVRTOUT$(FNFINDLISTVIEWCHILD(MOD(INDEX-1,COLUMNS)+1,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES))
28442          end if                       !#End Select#
28444       next INDEX
28446    fnend 
28448 ! 
33000 !  #Autonumber# 33000,2
33002 ! *****************************************************************
33004 ! *********************** Input Control Attr **********************
33006 ! *****************************************************************
33008 Preformeditorinput: ! 
33010    def FNPREFORMEDITORINPUT(&MODE, &CONTROL, MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,WINDOW,FUNCTION,FIELD,WEDITOR,DATA$*255,SPEC$*60,FGCOLORINDEX,BGCOLORINDEX,JUSTIFYSUB,FUNCTIONEDITSUB,LISTVIEWINDEX,SPECWIDTHINDEX,TEMP_FGCOLOR$,TEMP_BGCOLOR$,CSOPENSTRING$,SCREEN$,BORDERSIZE,SCREENATTR$*255)
33012       dim STATIC_LASTCONTROL, STATIC_CURFLD, OAS_SPEC$(1)*60, OAS_DATA$(1)*1000, OAS_CAPTIONSPEC$(1), OAS_CAPTIONDATA$(1)*30, OAS_TOOLTIP$(1)*2000, OAS_INPUTSPEC$(1)*60, OAS_INPUTDATA$(1)*2000, OAS_INPUTTOOLTIP$(1)*2000, OAS_SUBS(1), OAS_BUTTONS(1)
33014       if CONTROL>0 then 
33016          let WEDITOR=FNGETEDITORWINDOW
33018          let FNGENERATEOASPECS(FIELDTYPE$(CONTROL) ,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33020          if UDIM(MAT OAS_SPEC$) then 
33022             let WINDOW=FNOPENOBJECTATTRIBUTESWINDOW(CONTROL,MAX(UDIM(MAT OAS_SPEC$),UDIM(MAT OAS_CAPTIONSPEC$)),32,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33024             print #WINDOW, fields MAT OAS_CAPTIONSPEC$ : MAT OAS_CAPTIONDATA$
33026             let FNOBJECTTOSCREEN(CONTROL,MAT OAS_SUBS,MAT OAS_DATA$,MAT OAS_SPEC$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33028 ! 
33030             if (JUSTIFYSUB:=SRCH(MAT OAS_SUBS,SF_JUSTIFY)) > 0 then 
33032                let FNPOPULATEJUSTIFY(OAS_SPEC$(JUSTIFYSUB),WINDOW)
33034             end if 
33036             if (FUNCTIONEDITSUB:=SRCH(MAT OAS_SUBS,SF_FUNCTION))>0 then 
33038                print #WINDOW, fields FNFUNCTIONEDITSPEC$(OAS_SPEC$(FUNCTIONEDITSUB),FUNCTIONEDITSUB) : "Edit"
33040             end if 
33042             if (FUNCTIONEDITSUB:=SRCH(MAT OAS_SUBS,SF_CNVRTIN))>0 then 
33044                print #WINDOW, fields FNFUNCTIONEDITSPEC$(OAS_SPEC$(FUNCTIONEDITSUB),FUNCTIONEDITSUB) : "Edit"
33046             end if 
33048 ! .        ! if (Functioneditsub:=Srch(Mat Oas_Subs,Sf_Cnvrtout))>0 then
33050 ! .        !    print #Window, fields Fnfunctioneditspec$(Oas_Spec$(Functioneditsub),Functioneditsub) : "Edit"
33052 ! .        ! end if
33054             if (FUNCTIONEDITSUB:=SRCH(MAT OAS_SUBS,SF_PICTURE))>0 then 
33056                print #WINDOW, fields FNFUNCTIONEDITSPEC$(OAS_SPEC$(FUNCTIONEDITSUB),FUNCTIONEDITSUB) : "Select"
33058             end if 
33060 ! 
33062             let FNCOPYOASINPUTSPEC(MAT OAS_INPUTSPEC$,MAT OAS_INPUTDATA$,MAT OAS_INPUTTOOLTIP$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33064 ! .!
33066             do 
33068                if STATIC_LASTCONTROL=CONTROL then 
33070                   let CURFLD(STATIC_LASTCURFLD)
33072                end if 
33074                print #WINDOW, fields MAT OAS_SPEC$, help MAT OAS_TOOLTIP$ : MAT OAS_DATA$
33076                input #WINDOW, fields MAT OAS_INPUTSPEC$, help MAT OAS_INPUTTOOLTIP$ : MAT OAS_INPUTDATA$
33078                let FUNCTION=FKEY
33080                let FNCOPYBACKOASINPUTSPEC(MAT OAS_INPUTSPEC$,MAT OAS_INPUTDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33082 ! .!
33084                let FNSETLASTCURFLD(CONTROL, CURFLD)
33086                if FUNCTION=0 then 
33088                   let FUNCTION=1500+CONTROL
33090                end if 
33092 ! .!
33094                if FUNCTION>1000 AND FUNCTION<=1000+UDIM(MAT OAS_SUBS) then 
33096                   let FIELD=FUNCTION-1000
33098                   if OAS_SUBS(FIELD) = SF_FGCOLOR OR OAS_SUBS(FIELD) = SF_BGCOLOR then ! #Select# Oas_Subs(Field) #Case# Sf_Fgcolor # Sf_Bgcolor
33100                      let FGCOLORINDEX=SRCH(MAT OAS_SUBS,SF_FGCOLOR)
33102                      let BGCOLORINDEX=SRCH(MAT OAS_SUBS,SF_BGCOLOR)
33104 ! 
33106                      if FGCOLORINDEX>0 OR BGCOLORINDEX>0 then 
33108                         let OAS_DATA$(FIELD)=FNCOLORPICKER$(OAS_DATA$(FIELD),0,0,"Select Color",FUNCTION)
33110 ! 
33112                         if TRIM$(OAS_DATA$(FIELD))="" then ! Setting either to "" sets all to ""
33114                            if BGCOLORINDEX>0 then let OAS_DATA$(BGCOLORINDEX)=""
33116                            if FGCOLORINDEX>0 then let OAS_DATA$(FGCOLORINDEX)=""
33118                         else if OAS_SUBS(FIELD)=SF_BGCOLOR then 
