36286 Compilescreen: ! Compiles One Screen's Helper Library By Screen Code (Callable From Code)
36287    def library FNCOMPILESCREEN(SCREENCODE$*18;WAITFORCOMPLETE,___,SUCCESS)
36288       let FNSETTINGS                  !Also includes library linkage to FileIO
36289       let FNOPENSCREENFILES(MAT SCREENIO$,MAT SCREENIO)
36290       if FNREADSCREEN(UPRC$(TRIM$(SCREENCODE$)),MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
36291          let FNCOMPILEHELPERLIBRARY(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,"",WAITFORCOMPLETE)
36292          let SUCCESS=1
36293       end if 
36294       let FNCOMPILESCREEN=SUCCESS
36295    fnend 
36296 ! 
36297 Checkscreenerrors: ! Runs The Same Validation The "To Do" Debug Listview Shows, Callable From Code
36298    def library FNCHECKSCREENERRORS(SCREENCODE$*18,MAT ERROBJECT,MAT ERRFIELD,MAT ERRMESSAGE$,MAT ERRTYPE;___,SUCCESS,ERRCNT,INDEX)
36299       let FNSETTINGS                  !Also includes library linkage to FileIO
36300       let FNOPENSCREENFILES(MAT SCREENIO$,MAT SCREENIO)
36301       let DB_WARNING=1                !Normally set by Fnpaintdebugwindow, which never runs headless
36302       let DB_ERROR=2
36303       if FNREADSCREEN(UPRC$(TRIM$(SCREENCODE$)),MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
36304          let FNVALIDATEFIELDS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
36305          let ERRCNT=UDIM(MAT DEBUGERROR_OBJECT)
36306          mat ERROBJECT(ERRCNT) : mat ERRFIELD(ERRCNT) : mat ERRMESSAGE$(ERRCNT) : mat ERRTYPE(ERRCNT)
36307          for INDEX=1 to ERRCNT
36308             let ERROBJECT(INDEX)=DEBUGERROR_OBJECT(INDEX)
36309             let ERRFIELD(INDEX)=DEBUGERROR_FIELD(INDEX)
36310             let ERRMESSAGE$(INDEX)=DEBUGERROR_MESSAGE$(INDEX)
36311             let ERRTYPE(INDEX)=DEBUGERROR_TYPE(INDEX)
36312          next INDEX
36313          let SUCCESS=1
36314       end if 
36315       let FNCHECKSCREENERRORS=SUCCESS
36316    fnend 
36317 ! 
36318 Printline: ! Prints A Line With A Line Number
36319    def FNPRINTLINE(STRING$*800;SKIPNUMBER)
36320       if SKIPNUMBER then 
36321          print #STATIC_COMPILEFILE: "      "&STRING$
36322       else 
36323          print #STATIC_COMPILEFILE: CNVRT$("PIC(#####)",STATIC_LINENUMBER)&" "&STRING$
36324          let STATIC_LINENUMBER+=STATIC_INCREMENT
36325       end if 
36326    fnend 
36327 Setlinenumber: ! Sets The Printline Linenumber, Increment, Filenumber
36328    def FNSETLINENUMBER(LINENUMBER,INCREMENT;FILENUMBER)
36329       let STATIC_INCREMENT=INCREMENT
36330       let STATIC_LINENUMBER=LINENUMBER
36331       if FILENUMBER then 
36332          let STATIC_COMPILEFILE=FILENUMBER
36333       end if 
36334    fnend 
36335 ! 
36336    def FNGETSPECIALFUNCTIONNAME$*30(FUNCTIONNAME$*255,INSERT$)
36337       if FUNCTIONNAME$(1:1)="{" then let FUNCTIONNAME$(1:1)="fn"
36338       if FUNCTIONNAME$(LEN(FUNCTIONNAME$):LEN(FUNCTIONNAME$))="}" then let FUNCTIONNAME$=FUNCTIONNAME$(1:LEN(FUNCTIONNAME$)-1)
36339       let FUNCTIONNAME$(3:2)=INSERT$
36340       let FUNCTIONNAME$=SREP$(FUNCTIONNAME$,"$","")
36341       let FNGETSPECIALFUNCTIONNAME$=FUNCTIONNAME$(1:30)
36342    fnend 
36343 ! 
36344    def FNGETSPECIALFUNCTIONHANDLE$*255(FUNCTIONHANDLE$*255,INSERT$)
36345       let FUNCTIONHANDLE$(2:1)=LWRC$(INSERT$)
36346       let FNGETSPECIALFUNCTIONHANDLE$=FUNCTIONHANDLE$
36347    fnend 
36348 ! 
36349 ! .! Reads the indicated file and looks for a definition of the given function.
36350    def FNCHECKFORFUNCTION(FUNCTION$*255;SEARCH$*255,___,FILENUMBER,STRING$*800,FOUNDIT)
36351       let FUNCTION$=FNCUSTOMFILENAMEOF$(FUNCTION$)
36352 ! 
36353       open #(FILENUMBER:=FNGETFILENUMBER): "name="&FUNCTION$,display,input error IGNORE
36354       do WHILE FILE(FILENUMBER)=0
36355          linput #FILENUMBER: STRING$ eof IGNORE
36356          if FILE(FILENUMBER)=0 then 
36357             if POS(LWRC$(STRING$),LWRC$("def "&SEARCH$(1:LEN(SEARCH$)-1)))>0 then 
36358                let FOUNDIT=1
36359             end if 
36360          end if 
36361       loop UNTIL FOUNDIT
36362 ! 
36363       close #FILENUMBER: 
36364       let FNCHECKFORFUNCTION=FOUNDIT
36365    fnend 
36366 ! 
36367    dim CONST$(1)*1024, CONSTNAME$(1)*255
36368    dim CURRENTSELECT$*255, CURRENTCASE$(1)*255
36369    dim DEFINE$, INCLUDE$, SELECT$, CASE$, CASEELSE$, ENDSELECT$
36370 ! 
36371 Importfunction: ! Imports The Function Text From A .Brs File
36372    def FNIMPORTFUNCTION(FUNCTION$*255,MAT NEWINCLUDE$;___,FILENUMBER,STRING$*800, CONSTINDEX, CONSTANTPOSITION, SKIPNEXTONE, CONSTNAMESTARTPOS, CONSTNAMEENDPOS, SELECTPOSITION,CASEPOSITION,CASEINDEX,CURRENTCASECHUNK,NEXTCASECHUNK)
36373       let FUNCTION$=FNCUSTOMFILENAMEOF$(FUNCTION$)
36374 ! 
36375       library SETTING_LEXIPATH$ : FNAPPLYLEXI
36376       let FNAPPLYLEXI(FUNCTION$,"tempfile[SESSION].brs",1)
36377 ! 
36378       open #(FILENUMBER:=FNGETFILENUMBER): "name=tempfile[SESSION].brs",display,input error IGNORE
36379       if FILE(FILENUMBER)=0 then 
36380 ! 
36381          let FNPRINTLINE('! Imported From "'&FUNCTION$&'"')
36382          do WHILE FILE(FILENUMBER)=0
36383             linput #FILENUMBER: STRING$ eof IGNORE
36384             if FILE(FILENUMBER)=0 then 
36385 ! .           ! Maintain Spacing
36386                if TRIM$(STRING$)="" then let STRING$=RPT$(" ",SETTING_PAD_FUNCTIONS)&"!"
36387 ! 
36388 ! .           ! Process Include Statements
36389                if POS(LWRC$(STRING$),"#include") then 
36390                   mat NEWINCLUDE$(UDIM(MAT NEWINCLUDE$)+1)
36391                   let NEWINCLUDE$(UDIM(MAT NEWINCLUDE$))=TRIM$(STRING$(POS(LWRC$(STRING$),"#include")+8:LEN(STRING$)))
36392                end if 
36393 ! 
36394 ! .           ! Print Line to File
36395                let FNPRINTLINE(STRING$,SKIPNEXTONE)
36396 ! 
36397 ! .           ! Check if we need to Skip Next One
36398                if TRIM$(STRING$)(LEN(TRIM$(STRING$))-1:LEN(TRIM$(STRING$))) = "!:" then 
36399                   let SKIPNEXTONE=1
36400                else 
36401                   let SKIPNEXTONE=0
36402                end if 
36403             end if 
36404          loop 
36405          close #FILENUMBER: 
36406       end if 
36407    fnend 
36408 ! 
36409    def FNFINDINCLUDES(FUNCTION$*255,MAT NEWINCLUDE$;___,FILENUMBER,STRING$*800,FI_FUNCTION$*255)
36410       let FUNCTION$=FNCUSTOMFILENAMEOF$(FUNCTION$)
36411 ! 
36412       open #(FILENUMBER:=FNGETFILENUMBER): "name="&FUNCTION$,display,input error IGNORE
36413       if FILE(FILENUMBER)=0 then 
36414 ! 
36415          do WHILE FILE(FILENUMBER)=0
36416             linput #FILENUMBER: STRING$ eof IGNORE
36417             if FILE(FILENUMBER)=0 then 
36418 ! 
36419 ! .           ! Process Include Statements
36420                if POS(LWRC$(STRING$),"#include") then 
36421                   let FI_FUNCTION$=LWRC$(TRIM$(STRING$(POS(LWRC$(STRING$),"#include")+8:LEN(STRING$))))
36422                   if SRCH(MAT NEWINCLUDE$,FI_FUNCTION$)<=0 then 
36423                      mat NEWINCLUDE$(UDIM(MAT NEWINCLUDE$)+1)
36424                      let NEWINCLUDE$(UDIM(MAT NEWINCLUDE$))=FI_FUNCTION$
36425                   end if 
36426                end if 
36427             end if 
36428          loop 
36429          close #FILENUMBER: 
36430       end if 
36431    fnend 
36432 ! 
36433 Customfilenameof: ! Extracts The File Name For A {Filename} Style Fn Reference
36434    def FNCUSTOMFILENAMEOF$*255(FUNCTION$*255)
36435       let FUNCTION$=LWRC$(FUNCTION$)
36436       if ~EXISTS(SETTING_FUNCTIONFOLDER$) then execute "mkdir "&SETTING_FUNCTIONFOLDER$
36437       let FUNCTION$=TRIM$(FUNCTION$)
36438       if FUNCTION$(1:1)="{" then 
36439          let FUNCTION$=FUNCTION$(2:LEN(FUNCTION$))
36440       end if 
36441       if FUNCTION$(LEN(FUNCTION$):LEN(FUNCTION$))="}" then 
36442          let FUNCTION$=FUNCTION$(1:LEN(FUNCTION$)-1)
36443       end if 
36444       let FUNCTION$=SETTING_FUNCTIONFOLDER$&FUNCTION$&".brs"
36445       let FNCUSTOMFILENAMEOF$=FUNCTION$
36446    fnend 
36447    def FNFUNCTIONNAME$*255(FUNCTION$*255)
36448       let FUNCTION$=LWRC$(FUNCTION$)
36449       let FUNCTION$=TRIM$(FUNCTION$)
36450       if FUNCTION$(1:1)="{" then 
36451          let FUNCTION$=FUNCTION$(2:LEN(FUNCTION$))
36452       end if 
36453       if FUNCTION$(LEN(FUNCTION$):LEN(FUNCTION$))="}" then 
36454          let FUNCTION$=FUNCTION$(1:LEN(FUNCTION$)-1)
36455       end if 
36456    fnend 
36457    def FNFUNCTIONSTRING$*255(FILENAME$*255)
36458       let FILENAME$=SREP$(LWRC$(FILENAME$),LWRC$(SETTING_FUNCTIONFOLDER$),"")
36459       let FILENAME$=SREP$(LWRC$(FILENAME$),".brs","")
36460       let FILENAME$="{"&FILENAME$&"}"
36461       let FNFUNCTIONSTRING$=FILENAME$
36462    fnend 
36463 ! 
36464 Readavailablefunctions: ! Reads All Helper Function Files Into An Array
36465    def FNREADAVAILABLEFUNCTIONS(MAT FUNCTIONS$;___,DIRFILE,DUMMY$*255)
36466       let FNREADFILES(MAT FUNCTIONS$,SETTING_FUNCTIONFOLDER$,"brs",1,1)
36467    fnend 
36468 ! 
36469    def FNREADFILES(MAT FILES$,FOLDER$*255;EXTENSION$,CLEARARRAY,CREATEFOLDER,INCLUDEEXTENSIONS,&MASK$,___,DIRFILE,DUMMY$*255,DIRMASK$*400)
36470       if CLEARARRAY then mat FILES$(0)
36471 ! 
36472       if CREATEFOLDER then 
36473          if ~EXISTS(FOLDER$) then execute "mkdir "&FOLDER$
36474       end if 
36475 ! 
36476       if FOLDER$(LEN(FOLDER$):LEN(FOLDER$))="\" then let FOLDER$=FOLDER$(1:LEN(FOLDER$)-1)
36477 ! 
36478       if ~LEN(TRIM$(EXTENSION$)) then let EXTENSION$="*"
36479 ! 
36480       if LEN(TRIM$(MASK$)) then 
36481          let DIRMASK$=FOLDER$&"\"&FNCLEANMASK$(MASK$)&"."&LWRC$(EXTENSION$)
36482       else 
36483          let DIRMASK$=FOLDER$&"\*."&LWRC$(EXTENSION$)
36484       end if 
36485 ! 
36486       execute "dir "&DIRMASK$&" >dirlist.[SESSION]" error IGNORE
36487       open #(DIRFILE:=FNGETFILENUMBER) : "Name=dirlist.[SESSION]", display,input 
36488       do 
36489          linput #DIRFILE: DUMMY$ eof IGNORE
36490          if FILE(DIRFILE)=0 AND ~POS(DUMMY$,"<DIR>") then 
36491             if EXTENSION$="*" OR LWRC$(EXTENSION$)=LWRC$(FNFINDEXTENSION$(DUMMY$)) then 
36492                mat FILES$(UDIM(FILES$)+1) !:
                     let FILES$(UDIM(FILES$))=LWRC$(TRIM$(DUMMY$(44:99))(1:32))
36493                if POS(LWRC$(FILES$(UDIM(FILES$))),".")>0 then 
36494                   let FILES$(UDIM(FILES$))=FILES$(UDIM(FILES$))(1:POS(LWRC$(FILES$(UDIM(FILES$))),".",-1)-1)
36495                   if INCLUDEEXTENSIONS then 
36496                      if EXTENSION$="*" then 
36497                         let FILES$(UDIM(FILES$))=FILES$(UDIM(FILES$))&"."&LWRC$(FNFINDEXTENSION$(DUMMY$))
36498                      else 
36499                         let FILES$(UDIM(FILES$))=FILES$(UDIM(FILES$))&"."&EXTENSION$
36500                      end if 
36501                   end if 
36502                end if 
36503             end if 
36504          end if 
36505       loop WHILE FILE(DIRFILE)=0
36506       close #DIRFILE: 
36507       execute "free dirlist.[SESSION]"
36508    fnend 
36509 ! 
36510    def FNFINDEXTENSION$(DIRLISTLINE$*255;___,D,P)
36511       if LEN(TRIM$(DIRLISTLINE$(11:13))) then 
36512          let FNFINDEXTENSION$=DIRLISTLINE$(11:13)
36513       else 
36514          let DIRLISTLINE$=RTRM$(DIRLISTLINE$)
36515          let P=LEN(DIRLISTLINE$)
36516          let D=POS(DIRLISTLINE$,".",-1)
36517          if D>0 then 
36518             let FNFINDEXTENSION$=DIRLISTLINE$(D+1:P)
36519          end if 
36520       end if 
36521    fnend 
36522 ! 
36523    def FNCLEANMASK$*80(&MASK$;___,INDEX,OUTMASK$*80)
36524       let MASK$=TRIM$(MASK$)
36525       if POS(MASK$,"\") then 
36526          let MASK$=MASK$(POS(MASK$,"\"):LEN(MASK$))
36527       end if 
36528       if POS(MASK$,".") then 
36529          let MASK$=MASK$(1:POS(MASK$,"."))
36530       end if 
36531       let OUTMASK$=""
36532       for INDEX=1 to LEN(MASK$)
36533          if POS("abcdefghijklmnopqrstuvwxyz?*",LWRC$(MASK$(INDEX:INDEX))) then 
36534             let OUTMASK$=OUTMASK$&MASK$(INDEX:INDEX)
36535          end if 
36536       next INDEX
36537       let MASK$=OUTMASK$
36538       let FNCLEANMASK$=OUTMASK$
36539    fnend 
36540 ! 
36541 Readcustomfunction: ! Reads The Given Custom Function Into A Long String With Embedded Crs (Chr$(13))
36542    def FNREADCUSTOMFUNCTION$*2000(FILENAME$*255;___,FILENUMBER,STRING$*800,FUNCTIONTEXT$*2000,DONE)
36543       let FILENAME$=FNCUSTOMFILENAMEOF$(FILENAME$)
36544 ! 
36545       if EXISTS(FILENAME$) then 
36546          open #(FILENUMBER:=FNGETFILENUMBER): "name="&FILENAME$,display,input error IGNORE
36547          if FILE(FILENUMBER)=0 then 
36548             do WHILE FILE(FILENUMBER)=0
36549                linput #FILENUMBER: STRING$ eof IGNORE
36550                if FILE(FILENUMBER)=0 then 
36551                   if LEN(STRING$)+1+LEN(FUNCTIONTEXT$)<2000 then 
36552                      let FUNCTIONTEXT$=FUNCTIONTEXT$&HEX$("0D0A")&STRING$
36553                   else 
36554                      let DONE=1
36555                   end if 
36556                end if 
36557             loop UNTIL DONE
36558             close #FILENUMBER: 
36559          end if 
36560       end if 
36561       let FNREADCUSTOMFUNCTION$=FUNCTIONTEXT$
36562    fnend 
36563 ! 
36564 Readcustomfunctionstatement: ! Reads And Calculates The Custom Function Call Statement From The Given File
36565    def FNREADCUSTOMFUNCTIONSTATEMENT$*255(FILENAME$*255;___,FILENUMBER,STRING$*800,FUNCTIONCALL$*800,DONE,STARFOUND,COMMA,SEMICOLON,LEFTPAREN,RIGHTPAREN,NUMBEREND)
36566 ! 
36567       let FILENAME$=FNCUSTOMFILENAMEOF$(FILENAME$)
36568 ! 
36569       if EXISTS(FILENAME$) then 
36570          open #(FILENUMBER:=FNGETFILENUMBER): "name="&FILENAME$,display,input error IGNORE
36571          if FILE(FILENUMBER)=0 then 
36572             do WHILE FILE(FILENUMBER)=0
36573                linput #FILENUMBER: STRING$ eof IGNORE
36574                if FILE(FILENUMBER)=0 then 
36575                   if POS(LWRC$(STRING$),"def fn") then 
36576                      let FUNCTIONCALL$=STRING$
36577                      let DONE=1
36578                   end if 
36579                end if 
36580             loop UNTIL DONE
36581             close #FILENUMBER: 
36582          end if 
36583       end if 
36584 ! 
36585       if LEN(TRIM$(FUNCTIONCALL$)) then 
36586          let FUNCTIONCALL$=FUNCTIONCALL$(POS(LWRC$(FUNCTIONCALL$),"def fn")+4:LEN(FUNCTIONCALL$))
36587          if POS(FUNCTIONCALL$,"(;") then let FUNCTIONCALL$=FUNCTIONCALL$(1:POS(FUNCTIONCALL$,"(;")-1)
36588          if POS(FUNCTIONCALL$,";") then let FUNCTIONCALL$=FUNCTIONCALL$(1:POS(FUNCTIONCALL$,";")-1)&")"
36589          let FUNCTIONCALL$=SREP$(FUNCTIONCALL$,"&","")
36590 ! 
36591          do WHILE (STARFOUND:=POS(FUNCTIONCALL$,"*"))
36592             let COMMA=POS(FUNCTIONCALL$,",",STARFOUND)
36593             let SEMICOLON=POS(FUNCTIONCALL$,";",STARFOUND)
36594             let LEFTPAREN=POS(FUNCTIONCALL$,"(",STARFOUND)
36595             let RIGHTPAREN=POS(FUNCTIONCALL$,")",STARFOUND)
36596             if COMMA<STARFOUND then let COMMA=9999
36597             if SEMICOLON<STARFOUND then let SEMICOLON=9999
36598             if LEFTPAREN<STARFOUND then let LEFTPAREN=9999
36599             if RIGHTPAREN<STARFOUND then let RIGHTPAREN=9999
36600             let NUMBEREND=MIN(COMMA,SEMICOLON,LEFTPAREN,RIGHTPAREN)-1
36601             let FUNCTIONCALL$(STARFOUND:NUMBEREND)=""
36602          loop 
36603       end if 
36604 ! 
36605       let FNREADCUSTOMFUNCTIONSTATEMENT$=FUNCTIONCALL$
36606 ! 
36607    fnend 
36608 ! 
36609 Createnewfunction: ! Creates A New Blank Function File
36610    def FNCREATENEWFUNCTION(FUNCTION$*255;FUNCTIONTYPE,SUBTYPE,___,FILENAME$*255,FILENUMBER,PADDING$)
36611 ! 
36612       let FILENAME$=FNCUSTOMFILENAMEOF$(FUNCTION$)
36613       let FUNCTION$=TRIM$(FUNCTION$)
36614       if FUNCTION$(1:1)="{" then let FUNCTION$=FUNCTION$(2:LEN(FUNCTION$))
36615       if FUNCTION$(LEN(FUNCTION$):LEN(FUNCTION$))="}" then let FUNCTION$=FUNCTION$(1:LEN(FUNCTION$)-1)
36616 ! 
36617       let PADDING$=RPT$(" ",SETTING_PAD_FUNCTIONS)
36618 ! 
36619       if ~EXISTS(FILENAME$) then 
36620          open #(FILENUMBER:=FNGETFILENUMBER): "name="&FILENAME$&",new,recl=800",display,output error IGNORE
36621          if FILE(FILENUMBER)=0 then 
36622             print #FILENUMBER: PADDING$&"! "&FILENAME$
36623             print #FILENUMBER: PADDING$&"! Created on "&DATE$("mm/dd/ccyy")
36624             print #FILENUMBER: PADDING$&"!"
36625             print #FILENUMBER: PADDING$&"! fn"&FUNCTION$&" - This function ..."
36626             print #FILENUMBER: PADDING$&"!"
36627 ! 
36628             if SETTING_DETAILEDCOMMENTS then 
36629                let FNPRINTCUSTOMFUNCTIONCOMMENT(FILENUMBER,FUNCTIONTYPE,SUBTYPE)
36630             end if 
36631 ! 
36632             print #FILENUMBER: PADDING$&"!"
36633             print #FILENUMBER: PADDING$&"def fn"&FUNCTION$
36634             print #FILENUMBER: PADDING$
36635             print #FILENUMBER: PADDING$
36636             print #FILENUMBER: PADDING$&"fnend"
36637             if FUNCTIONTYPE=2000+SF_FUNCTION AND SUBTYPE=4 then 
36638                print #FILENUMBER: PADDING$
36639                print #FILENUMBER: PADDING$
36640                print #FILENUMBER: PADDING$&"! This function is run before the listview starts loading. Put any code here"
36641                print #FILENUMBER: PADDING$&"!  that you need to run prior to loading the listview."
36642                print #FILENUMBER: PADDING$&"def "&FNGETSPECIALFUNCTIONNAME$("fn"&FUNCTION$,"Init_")
36643                print #FILENUMBER: PADDING$
36644                print #FILENUMBER: PADDING$
36645                print #FILENUMBER: PADDING$&"fnend"
36646                print #FILENUMBER: PADDING$
36647                print #FILENUMBER: PADDING$&"! This function is run after the listview has finished loading. Put any code here"
36648                print #FILENUMBER: PADDING$&"!  that you want to run when the listview finishes populating."
36649                print #FILENUMBER: PADDING$&"def "&FNGETSPECIALFUNCTIONNAME$("fn"&FUNCTION$,"Final_")
36650                print #FILENUMBER: PADDING$
36651                print #FILENUMBER: PADDING$
36652                print #FILENUMBER: PADDING$&"fnend"
36653             end if 
36654             close #FILENUMBER: 
36655          end if 
36656       end if 
36657    fnend 
36658 ! 
36659    def FNPRINTCUSTOMFUNCTIONCOMMENT(FILENUMBER,FUNCTIONTYPE,SUBTYPE;___,PADDING$)
36660       let PADDING$=RPT$(" ",SETTING_PAD_FUNCTIONS)
36661       print #FILENUMBER: PADDING$&"!"
36662       print #FILENUMBER: PADDING$&"! Fill in the comment above with a description of what this"
36663       print #FILENUMBER: PADDING$&"! particular function does."
36664       print #FILENUMBER: PADDING$&"!"
36665       print #FILENUMBER: PADDING$&"!"
36666       if FUNCTIONTYPE = 0 then ! #Select# FunctionType #Case# 0
36667       else if FUNCTIONTYPE = 1000+SI_ENTERFN then ! #Case# 1000+si_enterfn
36668          print #FILENUMBER: PADDING$&"! This is an Enter Event Function. When selected as the Enter"
36669          print #FILENUMBER: PADDING$&"! Event for your screen, this function runs after the screen"
36670          print #FILENUMBER: PADDING$&"! has loaded but before the screen is drawn and before the"
36671          print #FILENUMBER: PADDING$&"! record is read."
36672       else if FUNCTIONTYPE = 1000+SI_INITFN then ! #Case# 1000+si_initfn
36673          print #FILENUMBER: PADDING$&"! This is an Initialize Event Function. When selected as the Init"
36674          print #FILENUMBER: PADDING$&"! Event for your screen, this function runs only when the user is"
36675          print #FILENUMBER: PADDING$&"! adding a new record to the data file. Use this event in your Add/Edit"
36676          print #FILENUMBER: PADDING$&"! screens to initialize the new record and preform any other tasks that"
36677          print #FILENUMBER: PADDING$&"! need to run each time a record is added. It is not run when Reading"
36678          print #FILENUMBER: PADDING$&"! an existing record (See the Read Event for that)."
36679       else if FUNCTIONTYPE = 1000+SI_READFN then ! #Case# 1000+si_readfn
36680          print #FILENUMBER: PADDING$&"! This is a Read Event Function."
36681          print #FILENUMBER: PADDING$&"! "
36682          print #FILENUMBER: PADDING$&"! When used in an Add/Edit screen, this function runs"
36683          print #FILENUMBER: PADDING$&"! only when the user is editing an existing record in"
36684          print #FILENUMBER: PADDING$&"! a data file. Use this event to unpack the new record"
36685          print #FILENUMBER: PADDING$&"! and preform any other tasks that need to run at read time."
36686          print #FILENUMBER: PADDING$&"! This function runs just after the record is read. It is"
36687          print #FILENUMBER: PADDING$&"! not run when Adding a record. (See Initialize Event)"
36688          print #FILENUMBER: PADDING$&"!"
36689          print #FILENUMBER: PADDING$&"! When used in a Listview screen, this function runs each time"
36690          print #FILENUMBER: PADDING$&"! the user's selection on the listview has changed. You can use it"
36691          print #FILENUMBER: PADDING$&"! to update related fields when the listview selection changes"
36692          print #FILENUMBER: PADDING$&"! in realtime. It can slow things down, so use it with caution"
36693          print #FILENUMBER: PADDING$&"! and make sure your code here is as effecient as possible."
36694       else if FUNCTIONTYPE = 1000+SI_LOADFN then ! #Case# 1000+si_loadfn
36695          print #FILENUMBER: PADDING$&"! This is a Load Event Function. It runs after the record is"
36696          print #FILENUMBER: PADDING$&"! read and the screen has finished loading, but before the"
36697          print #FILENUMBER: PADDING$&"! screen is run. Use it to perform user interactions and other"
36698          print #FILENUMBER: PADDING$&"! tasks that you want to run after the screen is drawn and"
36699          print #FILENUMBER: PADDING$&"! before starting your program."
36700       else if FUNCTIONTYPE = 1000+SI_WRITEFN then ! #Case# 1000+si_writefn
36701          print #FILENUMBER: PADDING$&"! This is a PreWrite Event Function. When used in an Add/Edit screen,"
36702          print #FILENUMBER: PADDING$&"! this function runs only when the user exited the screen and chose"
36703          print #FILENUMBER: PADDING$&"! to save the data. This function is run before the data is written."
36704          print #FILENUMBER: PADDING$&"!"
36705          print #FILENUMBER: PADDING$&"! This is a good place to do full record validations that can't be"
36706          print #FILENUMBER: PADDING$&"! done as you're going along. You can cancel the Exit by setting"
36707          print #FILENUMBER: PADDING$&"! ExitMode to 0."
36708       else if FUNCTIONTYPE = 1000+SI_WAITFN then ! #Case# 1000+si_waitfn
36709          print #FILENUMBER: PADDING$&"! This is a Wait Event Function. It is called when the user has"
36710          print #FILENUMBER: PADDING$&"! been idle for a long time (configurable in Screen Attributes)."
36711          print #FILENUMBER: PADDING$&"! If not specified, the default ScreenIO Idle Message window"
36712          print #FILENUMBER: PADDING$&"! appears instead. Ues this function to change the default"
36713          print #FILENUMBER: PADDING$&"! idle behavior for your program."
36714       else if FUNCTIONTYPE = 1000+SI_LOCKEDFN then ! #Case# 1000+si_lockedfn
36715          print #FILENUMBER: PADDING$&"! This is a Locked Event Function. Use this to override the default"
36716          print #FILENUMBER: PADDING$&"! ScreenIO Locked Record behavior. This is run whenever a user attempts"
36717          print #FILENUMBER: PADDING$&"! to edit a record but the record is locked (currently being edited) by"
36718          print #FILENUMBER: PADDING$&"! another user."
36719       else if FUNCTIONTYPE = 1000+SI_MERGEFN then ! #Case# 1000+si_mergefn
36720          print #FILENUMBER: PADDING$&"! This is a Merge Event Function. Its called when standard record"
36721          print #FILENUMBER: PADDING$&"! locking is disabled and instead multiple users are allowed to"
36722          print #FILENUMBER: PADDING$&"! edit the record, and the system attempts to merge their changes."
36723          print #FILENUMBER: PADDING$&"! If you select that option, screenIO automatically merges the changes."
36724          print #FILENUMBER: PADDING$&"! You can use this Merge function to override the default ScreenIO"
36725          print #FILENUMBER: PADDING$&"! merging behavior."
36726       else if FUNCTIONTYPE = 1000+SI_LOOPFN then ! #Case# 1000+si_loopfn
36727          print #FILENUMBER: PADDING$&"! This is a Main Loop Event Function. This code is run every time"
36728          print #FILENUMBER: PADDING$&"! the user does anything on your screen. Use it to handle special"
36729          print #FILENUMBER: PADDING$&"! user interactions such as custom Fkeys and double clicks."
36730       else if FUNCTIONTYPE = 1000+SI_NOKEYFN then ! #Case# 1000+si_nokeyfn
36731          print #FILENUMBER: PADDING$&"! This is a NoKey Event Function. This function is called"
36732          print #FILENUMBER: PADDING$&"! any time the selected key is not found when attempting to"
36733          print #FILENUMBER: PADDING$&"! edit. If this function is not specified, ScreenIO Defaults"
36734          print #FILENUMBER: PADDING$&"! to displaying a message to the end user indicating that the"
36735          print #FILENUMBER: PADDING$&"! key could not be found."
36736       else if FUNCTIONTYPE = 1000+SI_PRELISTVIEWFN then ! #Case# 1000+si_prelistviewfn
36737          print #FILENUMBER: PADDING$&"! This is a Pre-Listview Populate Event Function. When used in"
36738          print #FILENUMBER: PADDING$&"! a Listview Screen, this code is run just prior to the listview"
36739          print #FILENUMBER: PADDING$&"! being populated. Use this function to open related reference"
36740          print #FILENUMBER: PADDING$&"! data files that you want to read during the populate, or to"
36741          print #FILENUMBER: PADDING$&"! preposition the record pointer in the data file."
36742       else if FUNCTIONTYPE = 1000+SI_POSTLISTVIEWFN then ! #Case# 1000+si_postlistviewfn
36743          print #FILENUMBER: PADDING$&"! This is a Post-Populate Listview Event Function. When used in"
36744          print #FILENUMBER: PADDING$&"! a Listview Screen, this code runs just after the listview is"
36745          print #FILENUMBER: PADDING$&"! populated. Use it to close data files you might have opened"
36746          print #FILENUMBER: PADDING$&"! during Pre-Populate."
36747       else if FUNCTIONTYPE = 1000+SI_EXITFN then ! #Case# 1000+si_exitfn
36748          print #FILENUMBER: PADDING$&"! This is an Exit Event Function. You can use it to close data"
36749          print #FILENUMBER: PADDING$&"! files that you opened during the Enter event. It runs when the"
36750          print #FILENUMBER: PADDING$&"! screen is already closing, and the record has already been"
36751          print #FILENUMBER: PADDING$&"! written. It is too late to cancel the close here."
36752       else if FUNCTIONTYPE = 2000+SF_FUNCTION then ! #Case# 2000+sf_function
36753          if ~SUBTYPE OR SUBTYPE=1 then 
36754             print #FILENUMBER: PADDING$&"! This is a Click Event function. It runs when the user Clicks"
36755             print #FILENUMBER: PADDING$&"! on the Control it is the click event for."
36756          else if SUBTYPE=2 then 
36757             print #FILENUMBER: PADDING$&"! This is a Validate Event Function. This function runs any time"
36758             print #FILENUMBER: PADDING$&"! the control has been changed by the user."
36759             print #FILENUMBER: PADDING$&"!"
36760             print #FILENUMBER: PADDING$&"! (To make it run as soon as it is changed, consider adding the"
36761             print #FILENUMBER: PADDING$&"! ""X"" attribute to the control.)"
36762          else if SUBTYPE=3 then 
36763             print #FILENUMBER: PADDING$&"! This function is both the Populate and Validate functions"
36764             print #FILENUMBER: PADDING$&"! for a Combo Box control. To use it, set the contents of an"
36765             print #FILENUMBER: PADDING$&"! array called ReturnData$ and ScreenIO will populate that"
36766             print #FILENUMBER: PADDING$&"! data into the Combo Box."
36767             print #FILENUMBER: PADDING$&"!"
36768             print #FILENUMBER: PADDING$&"! It is also a Validate event, so make sure to have your function"
36769             print #FILENUMBER: PADDING$&"! return true in order accept the users changes to the control."
36770          else if SUBTYPE=4 then 
36771             print #FILENUMBER: PADDING$&"! This function is the Filter function for the listview. It is run"
36772             print #FILENUMBER: PADDING$&"! as the listview is being populated, and it runs once for every"
36773             print #FILENUMBER: PADDING$&"! record in the data file, so be careful to make your code run as"
36774             print #FILENUMBER: PADDING$&"! quickly as possible."
36775             print #FILENUMBER: PADDING$&"!"
36776             print #FILENUMBER: PADDING$&"! Here you can unpack special fields from the data on disk to"
36777             print #FILENUMBER: PADDING$&"! the listview if you want to, or color the row by returning html"
36778             print #FILENUMBER: PADDING$&"! or an [ATTRIBUTE] substitution from your brconfig.sys (or"
36779             print #FILENUMBER: PADDING$&"! settings.sys) file."
36780             print #FILENUMBER: PADDING$&"!"
36781             print #FILENUMBER: PADDING$&"! You can also test the data and include or exclude rows in the data"
36782             print #FILENUMBER: PADDING$&"! file. If your Filter function returns 1 (True) or non-blank (for example,"
36783             print #FILENUMBER: PADDING$&"! a Color or [Attribute]), then the row is included in the listview."
36784             print #FILENUMBER: PADDING$&"! If your function returns 0 (False) or Blank, then the row is excluded."
36785             print #FILENUMBER: PADDING$&"!"
36786             print #FILENUMBER: PADDING$&"! Make sure your filter function returns something. If you want to"
36787             print #FILENUMBER: PADDING$&"! see all the rows in the list, make your function return 1 (True)."
36788             print #FILENUMBER: PADDING$&"!"
36789             print #FILENUMBER: PADDING$&"! Use the fnInit_ and fnFinal_ functions below, to open and close any needed"
36790             print #FILENUMBER: PADDING$&"! reference data files, initialize counters, and stuff like that."
36791          else if SUBTYPE=5 then 
36792             print #FILENUMBER: PADDING$&"! This function should not be used for Child Screen controls. Instead"
36793             print #FILENUMBER: PADDING$&"! of linking to a custom function, use the field to pass in parameters"
36794             print #FILENUMBER: PADDING$&"! to your Child Screen. "
36795          end if 
36796       else if FUNCTIONTYPE = 2000+SF_CNVRTIN then ! #Case# 2000+sf_cnvrtin
36797          print #FILENUMBER: PADDING$&"! This is a ConvertIn Function. Normally, you would specify a"
36798          print #FILENUMBER: PADDING$&"! ScreenIO Conversion Spec such as FMT(, PIC( or DATE( instead"
36799          print #FILENUMBER: PADDING$&"! of linking to a custom function. This custom function won't"
36800          print #FILENUMBER: PADDING$&"! be run by ScreenIO."
36801       else if FUNCTIONTYPE = 2000+SF_CNVRTOUT then ! #Case# 2000+sf_cnvrtout
36802          print #FILENUMBER: PADDING$&"! This is a ConvertOut Function. It isn't supported yet."
36803          print #FILENUMBER: PADDING$&"! This custom function won't be run by ScreenIO."
36804       end if                          !#End Select#
36805    fnend 
36806 ! 
36807    def FNSUBTYPE(FIELDTYPE$)
36808       if LWRC$(TRIM$(FIELDTYPE$)) = "p" OR LWRC$(TRIM$(FIELDTYPE$)) = "button" OR LWRC$(TRIM$(FIELDTYPE$)) = "caption" OR LWRC$(TRIM$(FIELDTYPE$)) = "calendar" then ! #Select# lwrc$(trim$(FieldType$)) #Case# "p" # "button" # "caption" # "calendar"
36809          let FNSUBTYPE=1
36810       else if LWRC$(TRIM$(FIELDTYPE$)) = "c" OR LWRC$(TRIM$(FIELDTYPE$)) = "search" OR LWRC$(TRIM$(FIELDTYPE$)) = "filter" OR LWRC$(TRIM$(FIELDTYPE$)) = "check" then ! #Case# "c" # "search" # "filter" # "check"
36811          let FNSUBTYPE=2
36812       else if LWRC$(TRIM$(FIELDTYPE$)) = "combo" then ! #Case# "combo"
36813          let FNSUBTYPE=3
36814       else if LWRC$(TRIM$(FIELDTYPE$)) = "listview" then ! #Case# "listview"
36815          let FNSUBTYPE=4
36816       else if LWRC$(TRIM$(FIELDTYPE$)) = "screen" then ! #Case# "screen"
36817          let FNSUBTYPE=5
36818       else ! #Case Else#
36819          let FNSUBTYPE=0
36820       end if                          !#End Select#
36821    fnend 
36822 ! 
36823 Editcustomfunction: ! Launches Code Editor To Edit The Given Function File
36824    def FNEDITCUSTOMFUNCTION(FILENAME$*255)
36825 ! 
36826       let FILENAME$=FNCUSTOMFILENAMEOF$(FILENAME$)
36827 ! 
36828       if EXISTS(FILENAME$) then 
36829          execute "system -C -M start "&OS_FILENAME$(FILENAME$)
36830       end if 
36831    fnend 
36832 ! 
36833    def library FNSELECTEVENT$*255(&CURRENT$;&RETURNFKEY)
36834       let FNSELECTEVENT$=FNSELECTFUNCTIONDIALOG$(CURRENT$,RETURNFKEY)
36835    fnend 
36836 ! 
36837    dim FUNCTIONSELECTION(1)
36838 ! 
36839 Selectfunctiondialog: ! Displays The Select Function Dialog.
36840    def FNSELECTFUNCTIONDIALOG$*255(CURRENT$*255;&RETURNFKEY,FUNCTIONTYPE,SUBTYPE,___,SELECTIONCOUNT,FUNCTIONNAME$*255,SCREENROWS,SCREENCOLS,RPOS,CPOS,WINDOW,TEXTBOXWINDOW,SELECTEDFUNCTION$*255,FUNCTIONTEXT$*2000,CURRENTSELECTION,NEWSELECTION,CURRENTFIELD,BUTTONTEXT$,TEMPSELECTION,INDEX,DONE,FILTERBOX$*60)
36841 ! 
36842       dim LVSF_NAME$(1)
36843       dim LVSF_WIDTH(1)
36844       dim LVSF_SPEC$(1)
36845       dim LVSF_FNFL$(1)*80
36846 ! 
36847       let LVSF_NAME$(1)="Function Files"
36848       let LVSF_WIDTH(1)=25
36849       let LVSF_SPEC$(1)="C 80,X"
36850 ! 
36851       let SELECTEDFUNCTION$=CURRENT$(1:28)
36852 ! .  !let Selectedfunction$=fnFunctionName$(Lwrc$(Current$(1:28)))
36853 ! .  ! let Selectedfunction$=Selectedfunction$(10:Len(Selectedfunction$)-4)
36854 ! 
36855       let FNREADAVAILABLEFUNCTIONS(MAT LVSF_FNFL$)
36856 ! 
36857       let NEWSELECTION=1
36858       let CURRENTFIELD=1
36859 ! 
36860       let FNGETSCREENSIZE(SCREENROWS,SCREENCOLS)
36861       if ~SCREENROWS OR ~SCREENCOLS then 
36862          let FNREADSCREENSIZE(SCREENROWS,SCREENCOLS)
36863       end if 
36864 ! 
36865       let RPOS=INT((SCREENROWS-24)/2)
36866       let CPOS=INT((SCREENCOLS-85)/2)
36867 ! 
36868       open #(WINDOW:=FNGETFILENUMBER) : "srow="&STR$(RPOS)&",scol="&STR$(CPOS)&",rows=24,cols=85,border=S,caption=Select Function", display, outin 
36869       open #(TEXTBOXWINDOW:=FNGETFILENUMBER) : "srow=2,scol=28,rows=20,cols=56,parent="&STR$(WINDOW),display,outin 
36870 ! 
36871       print #WINDOW, fields "2,2,LIST 20/25,HEADERS,/W:W" : (MAT LVSF_NAME$,MAT LVSF_WIDTH,MAT LVSF_SPEC$)
36872       print #WINDOW, fields "2,2,LIST 20/25,=" : (MAT LVSF_FNFL$)
36873       print #WINDOW, fields "2,2,LIST 20/25,SORT" : 1
36874       print #WINDOW, fields "23,42,CC 6,/W:W,B34;23,50,CC 6,/W:W,B35;23,58,CC 6,/W:W,B99;23,66,12/CC 16,/W:W,B37" : "New","Ok","Cancel","Affected Screens"
36875       print #WINDOW, fields "23,2,P 1/2,,1004" : SETTING_IMAGEPATH$&"\search.png"
36876 ! 
36877       execute "config keyboard clear"
36878       execute "config keyboard 0B00 0A0A0A636F6E206B657920636C6561720D"  !Shift F1 Key To "con key clear<CR>"
36879 ! 
36880       execute "config keyboard 0B 0F00"  !Up To Shift F5 (Fkey 15)
36881       execute "config keyboard 0A 1000"  !Dn To Shift F6 (Fkey 16)
36882 ! 
36883       execute "config keyboard 09 1100"  !Tab To Shift F7 (Fkey 17)
36884       execute "config keyboard 07 1100"  !Shift Tab To Shift F7 (Fkey 17)
36885 ! 
36886       do 
36887          if UDIM(MAT LVSF_FNFL$) then 
36888             if NEWSELECTION<>CURRENTSELECTION then 
36889                let FUNCTIONTEXT$=FNREADCUSTOMFUNCTION$(LVSF_FNFL$(NEWSELECTION))
36890                if FN42IA then 
36891                   let FUNCTIONTEXT$=SREP$(FUNCTIONTEXT$,HEX$("0D0A"),HEX$("0D"))
36892                   let FUNCTIONTEXT$=SREP$(FUNCTIONTEXT$,HEX$("0A"),HEX$("0D"))
36893                   let FUNCTIONTEXT$=SREP$(FUNCTIONTEXT$,HEX$("0D"),HEX$("0D0A"))
36894                   if FN42JD then 
36895                      print #TEXTBOXWINDOW, fields "1,1,1120/C 2000,S^ENTER_CRLF" : FUNCTIONTEXT$
36896                   else 
36897                      print #TEXTBOXWINDOW, fields "1,1,1120/C 2000,S^ENTER-CRLF" : FUNCTIONTEXT$
36898                   end if 
36899                else 
36900                   print #TEXTBOXWINDOW, fields "1,1,1120/C 2000,S" : FUNCTIONTEXT$
36901                end if 
36902                let CURRENTSELECTION=NEWSELECTION
36903             end if 
36904          end if 
36905 ! 
36906          if CURRENTFIELD=2 then 
36907             let CURFLD(CURRENTFIELD,CURRENTSELECTION)
36908          else 
36909             let CURFLD(CURRENTFIELD)
36910          end if 
36911 ! 
36912          if FN43 AND SETTING_FUNCTIONSEL_FILTER then 
36913             let FILTERBOX$="23,5,35/FILTER 28,X/W:W,2,2,FULLROW,ALL"
36914          else 
36915             let FILTERBOX$="23,5,35/SEARCH 28,X/W:W,2,2"
36916          end if 
36917 ! 
36918          if UDIM(MAT LVSF_FNFL$) then 
36919             print #WINDOW, fields FILTERBOX$ : SELECTEDFUNCTION$
36920             if CURRENTFIELD=1 then 
36921                input #WINDOW, fields FILTERBOX$&";2,2,LIST 20/25,ROWSUB,SELONE,1005" : SELECTEDFUNCTION$,NEWSELECTION error IGNORE
36922             else 
36923                input #WINDOW, fields FILTERBOX$&";2,2,LIST 20/25,ROWSUB,SELONE,-1" : SELECTEDFUNCTION$,NEWSELECTION error IGNORE
36924             end if 
36925 ! .        ! if (udim(mat FunctionSelection)) then
36926 ! .        !    let NewSelection=FunctionSelection(1)
36927 ! .        ! else 
36928 ! .        !    let NewSelection=-1
36929 ! .        ! end if
36930 ! .        ! if SelectionCount>0 then
36931 !                input #Window, fields "2,2,LIST 20/25,ROWSUB,SELONE,NOWAIT" : NewSelection
36932 !             else 
36933 !                let NewSelection=-1
36935          else !             end if
36936             rinput #WINDOW, fields "23,5,35/C 28,X" : SELECTEDFUNCTION$
36937          end if 
36938 ! 
36939          let SELECTEDFUNCTION$=TRIM$(SELECTEDFUNCTION$)(1:28)
36940          for INDEX=1 to LEN(SELECTEDFUNCTION$)
36941             if ~POS("abcdefghijklmnopqrstuvwxyz0123456789_",LWRC$(SELECTEDFUNCTION$(INDEX:INDEX))) then 
36942                let SELECTEDFUNCTION$(INDEX:INDEX)="_"
36943             end if 
36944          next INDEX
36945 ! 
36946          if CURRENTFIELD=1 then ! We Are In The Search Box
36947             if FKEY=15 then ! Up
36948                let CURRENTFIELD=2
36949                let TEMPSELECTION=SRCH(MAT LVSF_FNFL$,LWRC$(TRIM$(SELECTEDFUNCTION$)))
36950                if TEMPSELECTION>0 then let NEWSELECTION=TEMPSELECTION
36951             end if 
36952             if FKEY=16 then ! Dn
36953                let CURRENTFIELD=2
36954                let TEMPSELECTION=SRCH(MAT LVSF_FNFL$,LWRC$(TRIM$(SELECTEDFUNCTION$)))
36955                if TEMPSELECTION>0 then let NEWSELECTION=TEMPSELECTION
36956             end if 
36957          else ! We Are In The Listview
36958             if FKEY=15 then ! Up
36959                if NEWSELECTION<=1 then let CURRENTFIELD=1 else let NEWSELECTION-=1
36960             end if 
36961             if FKEY=16 then ! Dn
36962                if NEWSELECTION=>UDIM(LVSF_FNFL$) then let CURRENTFIELD=1 else let NEWSELECTION+=1
36963             end if 
36964          end if 
36965          if FKEY=17 OR FKEY=200 then ! Tab Or Shift Tab Or Click On Other Control
36966             if CURRENTFIELD=1 then let CURRENTFIELD=2 else let CURRENTFIELD=1
36967             if CURRENTFIELD=2 then 
36968                if FN42 then input #WINDOW, fields "2,2,LIST 20/25,ROWSUB,NEXT,NOWAIT" : NEWSELECTION
36969             end if 
36970          end if 
36971          if FKEY=1005 then ! Listview Clicked On
36972             let CURRENTFIELD=2
36973             if FN42 then input #WINDOW, fields "2,2,LIST 20/25,ROWSUB,NEXT,NOWAIT" : NEWSELECTION
36974          end if 
36975          if FKEY=1004 then ! Search Box Clicked On
36976             let CURRENTFIELD=1
36977          end if 
36978          if FKEY=34 then ! New Button Clicked On
36979             if LEN(TRIM$(SELECTEDFUNCTION$)) then 
36980                if 2=MSGBOX("Do you wish to create "&SELECTEDFUNCTION$&".brs","Proceed?","yN","QST") then 
36981                   let FNCREATENEWFUNCTION(SELECTEDFUNCTION$,FUNCTIONTYPE,SUBTYPE)
36982                   let FNEDITCUSTOMFUNCTION(SELECTEDFUNCTION$)
36983                   let FNREADAVAILABLEFUNCTIONS(MAT LVSF_FNFL$)
36984                   let CURRENTFIELD=2
36985                   let NEWSELECTION=SRCH(MAT LVSF_FNFL$,LWRC$(TRIM$(SELECTEDFUNCTION$)))
36986                   if NEWSELECTION>0 then let FKEY(35)  !New Button Also Selects
36987                   print #WINDOW, fields "2,2,LIST 20/25,=" : (MAT LVSF_FNFL$)
36988                end if 
36989             else 
36990                let MSGBOX("Please type a name for your new function.","No Name Given")
36991             end if 
36992          end if 
36993          if FKEY=37 then 
36994             dim SELFUNCTION(1)
36995             dim SELFUNCTION$(1)*255
36996 ! 
36997             let SELFUNCTION(1)=1
36998             let SELFUNCTION$(1)="{"&LVSF_FNFL$(NEWSELECTION)&"}"
36999             let DONE=FNCEAFFECTEDSCREENLIST(MAT SELFUNCTION,MAT SELFUNCTION$)
37000             let FKEY(-1)              !Clear fkey
37001          end if 
37002       loop UNTIL FKEY=99 OR FKEY=35 OR ((FKEY>1100) AND (FKEY<1699)) OR FKEY=98 OR FKEY=93 OR DONE
37003 ! 
37004       execute "config keyboard clear"
37005 ! 
37006       if FKEY=35 then 
37007          let SELECTEDFUNCTION$=LVSF_FNFL$(NEWSELECTION)
37008          let SELECTEDFUNCTION$="{"&TRIM$(SELECTEDFUNCTION$)&"}"
37009       else 
37010          let SELECTEDFUNCTION$=CURRENT$
37011       end if 
37012       if FKEY<>99 AND FKEY<>35 then 
37013          let RETURNFKEY=FKEY
37014       end if 
37015       if DONE then 
37016          let RETURNFKEY=99
37017       end if 
37018 ! 
37019       let FNSELECTFUNCTIONDIALOG$=SELECTEDFUNCTION$
37020 ! 
37021       if TEXTBOXWINDOW AND FILE(TEXTBOXWINDOW)>-1 then close #TEXTBOXWINDOW: 
37022       if WINDOW AND FILE(WINDOW)>-1 then close #WINDOW: 
37023 ! 
37024    fnend 
37025 ! 
37026 ! *****************************************************************
37027 ! ******************* Validate And Render Screen ******************
37028 ! *****************************************************************
37029 Validatefields: !  Validate All Data And Populate Todo Listview
37030    def FNVALIDATEFIELDS(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,INDEX,MODE,OBJECT,MESSAGE$*255,JNDEX,GOODFUNK,FUNK$*255,LVCOUNT,BADLV)
37031 ! 
37032       let FNCLEARDEBUGLISTVIEW
37033 ! 
37034 ! .       !  Validate Header Fields
37035       if TRIM$(SCREENIO$(SI_SCREENCODE))="" then 
37036          let FNPRINTTODEBUGLISTVIEW(INPUTATTRIBUTESMODE,SI_SCREENCODE,"Window Name cannot be blank.",DB_ERROR)
37037       end if 
37038 ! 
37039       if TRIM$(SCREENIO$(SI_PICTURE))<>"" AND ~EXISTS(SCREENIO$(SI_PICTURE)) then 
37040          let FNPRINTTODEBUGLISTVIEW(INPUTATTRIBUTESMODE,SI_PICTURE,"Picture does not exist.",DB_ERROR)
37041       end if 
37042 ! 
37043       if TRIM$(SCREENIO$(SI_FILELAY))="" then 
37044          let FNPRINTTODEBUGLISTVIEW(SELECTFILELAYMODE,SI_FILELAY,"You should enter a file layout.",DB_WARNING)
37045       end if 
37046 ! 
37047       if TRIM$(SCREENIO$(SI_FILELAY))<>"" AND ~FNDOESLAYOUTEXIST(SCREENIO$(SI_FILELAY)) then 
37048          let FNPRINTTODEBUGLISTVIEW(SELECTFILELAYMODE,SI_FILELAY,"File layout not found.",DB_ERROR)
37049       end if 
37050 ! 
37051       let LVCOUNT=BADLV=0
37052       for INDEX=1 to UDIM(MAT CONTROLNAME$)
37053          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="listview" then 
37054             let LVCOUNT+=1
37055             let BADLV=INDEX
37056          end if 
37057       next INDEX
37058 ! 
37059       if LVCOUNT>1 then 
37060          let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,BADLV,"You have 2 listviews. One of them will be inactive when running your screen.",DB_WARNING)
37061       end if 
37062 ! 
37063       for INDEX=1 to UDIM(MAT CONTROLNAME$)
37064          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"listchld" then 
37065             let MODE=1
37066             if ~FNVALIDSPEC(INDEX,MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MODE,OBJECT,MESSAGE$) then 
37067                let FNPRINTTODEBUGLISTVIEW(MODE,OBJECT,MESSAGE$,DB_ERROR)
37068             end if 
37069             if ~FNVALIDATTRIBUTE(ATTR$(INDEX),FIELDTYPE$(INDEX)) then 
37070                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Invalid attribute Specified for Control "&STR$(INDEX)&".",DB_ERROR)
37071             end if 
37072          end if 
37073 ! 
37074          if FUNCTION$(INDEX)<>"" AND FUNCTION$(INDEX)(1:1)<>"{" AND FUNCTION$(INDEX)(1:1)<>"[" AND FUNCTION$(INDEX)(1:1)<>"%" AND FUNCTION$(INDEX)(1:1)<>"#" then 
37075             let FUNK$=TRIM$(FUNCTION$(INDEX))
37076             let GOODFUNK=0
37077             for JNDEX=1 to LEN(FUNK$)
37078                if ~POS("abcdefghijklmnopqrstuvwxyz",LWRC$(FUNK$(JNDEX:JNDEX))) then let GOODFUNK=1
37079             next JNDEX
37080             if ~GOODFUNK then 
37081                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Control "&STR$(INDEX)&"'s Function doesn't look right. It doesn't do anything.",DB_WARNING)
37082             end if 
37083          end if 
37084 ! 
37085          if TRIM$(CONTROLNAME$(INDEX))="" AND TRIM$(FIELDNAME$(INDEX))="" then 
37086             if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listchld" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "listchld" # "c"
37087                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Control "&STR$(INDEX)&" has no source. It needs either a Control Name or a Field Name.",DB_WARNING)
37088             else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" OR LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "picture" then ! #Case# "button" # "caption" # "picture"
37089                if TRIM$(DESCRIPTION$(INDEX))="" then 
37090                   let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Control "&STR$(INDEX)&" has no source. It needs either a Control Name or a Caption.",DB_WARNING)
37091                end if 
37092             end if                    !#End Select#
37093          end if 
37094 ! 
37095          if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "c" then ! #Select# Lwrc$(Trim$(Fieldtype$(Index))) #Case# "c"
37096             if TRIM$(FIELDNAME$(INDEX))="" then 
37097 !                Let Fnprinttodebuglistview(Inputeditormode,Index,"Control "&Str$(Index)&" is not tied to a field.",Db_Warning)
37098             end if 
37099 ! 
37100          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "button" then ! #Case# "button"
37101             if TRIM$(FUNCTION$(INDEX))="" then 
37102                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Control "&STR$(INDEX)&" has no function.",DB_WARNING)
37103             end if 
37104 ! 
37105          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "p" then ! #Case# "p"
37106             if TRIM$(PICTURE$(INDEX))="" then 
37107 !              Let Fnprinttodebuglistview(Inputeditormode,Index,"Control "&Str$(Index)&" has no picture assigned.",Db_Warning)
37108             else if ~EXISTS(TRIM$(PICTURE$(INDEX))) then 
37109                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Picture File "&TRIM$(PICTURE$(INDEX))&" could not be found.",DB_ERROR)
37110             end if 
37111 ! 
37112          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "calendar" then ! #Case# "calendar"
37113 ! .        ! $$$$$  Give a warning if its not tied to any text box
37114 ! 
37115 ! 
37116          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "caption" then ! #Case# "caption"
37117             if TRIM$(DESCRIPTION$(INDEX))="" then 
37118 !               Let Fnprinttodebuglistview(Inputeditormode,Index,"Control "&Str$(Index)&" has no caption set.",Db_Warning)
37119             end if 
37120 ! 
37121          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "listview" then ! #Case# "listview"
37122             if ~FNCOUNTCOLUMNS(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
37123                let FNPRINTTODEBUGLISTVIEW(INPUTLISTVIEWMODE,INDEX,"Listview "&STR$(INDEX)&" has no columns.",DB_ERROR)
37124             end if 
37125 ! 
37126          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "search" then ! #Case# "search"
37127             if ~(TARGET:=FNFINDTARGET(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)) then 
37128                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Search Box "&STR$(INDEX)&" is not tied to a listview.",DB_ERROR)
37129             else if SPECWIDTH(TARGET)=0 then 
37130                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,TARGET,"Listview "&STR$(INDEX)&" has a Search Box but no Sort Column.",DB_WARNING)
37131             end if 
37132 ! 
37133          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "filter" then ! #Case# "filter"
37134             if ~(TARGET:=FNFINDTARGET(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)) then 
37135                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Filter Box "&STR$(INDEX)&" is not tied to a listview.",DB_ERROR)
37136             else 
37137                let FNCLEANFILTER(PICTURE$(INDEX))
37138                if LWRC$(PICTURE$(INDEX))(1:4)><"full" then 
37139                   if VAL(PICTURE$(INDEX)(1:POS(PICTURE$(INDEX),",")-1))>FNCOUNTCOLUMNS(PARENT$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
37140                      let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMODE,INDEX,"Filter Box "&STR$(INDEX)&" is tied to a column that doesn't exist.",DB_ERROR)
37141                   end if 
37142                end if 
37143             end if 
37144 ! 
37145          else if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "screen" then ! #Case# "screen"
37146             if LWRC$(TRIM$(FIELDNAME$(INDEX)))=LWRC$(TRIM$(SCREENIO$(SI_SCREENCODE))) then 
37147                let FNPRINTTODEBUGLISTVIEW(INPUTEDITORMOVEMODE,INDEX,"It's probably not a good idea to place a screen on top of itself.",DB_ERROR)
37148             end if 
37149          end if                       !#End Select#
37150       next INDEX
37151       let FNVALIDATEFIELDS=1          !True For Now
37152 ! 
37153    fnend 
37154 ! 
37155 Renderscreen: ! Draw All Valid Controls On The Screen
37156    def FNRENDERSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;DONTCLEAR,___,INDEX,WINDOW,ARRAYINDEX)
37157       dim RENDERSPEC$(1)*255, RENDERDATA$(1)*255
37158 ! 
37159       mat RENDERSPEC$(0)
37160       mat RENDERDATA$(0)
37161 ! 
37162       let WINDOW=FNGETEDITORWINDOW
37163       let FNDRAWFRAMES(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
37164       let FNDRAWSCREENS(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
37165 ! 
37166       for INDEX=1 to UDIM(MAT CONTROLNAME$)
37167          if ((LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"listview") AND (LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"listchld") AND (LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"frame") AND (LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"screen")) then 
37168             if FNVALIDSPEC(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
37169                let ARRAYINDEX=UDIM(MAT RENDERSPEC$)+1
37170                mat RENDERDATA$(ARRAYINDEX)
37171                mat RENDERSPEC$(ARRAYINDEX)
37172                let RENDERDATA$(ARRAYINDEX)=FNCALCULATEDATA$(INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
37173                let RENDERSPEC$(ARRAYINDEX)=FNCALCULATESPEC$(WINDOW,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,1)
37174             end if 
37175          end if 
37176       next INDEX
37177 ! 
37178       let FNCHANGEFORCEVISIBILITY(1)
37179       if ~DONTCLEAR then 
37180          print #WINDOW: NEWPAGE
37181          let DOTSPRINTED=0            !Dots were erased
37182          let SETTINGTEMPDOTS=0
37183       end if 
37184       print #WINDOW, fields MAT RENDERSPEC$ : MAT RENDERDATA$
37185       let FNCHANGEFORCEVISIBILITY(0)
37186 ! 
37187       let FNDRAWALLLISTVIEWS(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
37188       let FNTRYTOPOPULATELISTVIEWS(WINDOW,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
37189    fnend 
37190 ! 
37191 Validspec: ! Returns True If A Spec Is Valid, Sets Object, Control, Message If Not
37192    def FNVALIDSPEC(CONTROL,MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;&MODE,&OBJECT,&MESSAGE$,_,INDEX,VALID,TESTROW, TESTCOL,FRAMECONTROL,OTHERCONTROL,INSIDE,SETINSIDE)
37193       let VALID=1                     !Spec Starts Out Valid
37194       if HPOSITION(CONTROL)+(WIDTH(CONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CONTROL)))=="combo"))-1)>SCREENIO(SI_HSIZE) then 
37195          let VALID=0                  !Not Valid
37196          if MODE then 
37197             let MODE=INPUTEDITORMODE
37198             let OBJECT=CONTROL
37199             let MESSAGE$="Control is outside right boundary of Window."
37200          end if 
37201       end if 
37202       if VPOSITION(CONTROL)+(MAX(HEIGHT(CONTROL),1)-1)>SCREENIO(SI_VSIZE) then 
37203          let VALID=0
37204          if MODE then 
37205             let MODE=INPUTEDITORMODE
37206             let OBJECT=CONTROL
37207             let MESSAGE$="Control is outside bottom boundary of Window."
37208          end if 
37209       end if 
37210       if VALID then ! If Still Valid
37211          if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))<>"listchld" AND LWRC$(TRIM$(FIELDTYPE$(CONTROL)))<>"screen" then 
37212             for INDEX=1 to CONTROL-1
37213                let SETINSIDE=0
37214                let INSIDE=0
37215                if LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"listchld" AND LWRC$(TRIM$(FIELDTYPE$(CONTROL)))<>"screen" then 
37216                   if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="frame" AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))="listview" OR LWRC$(TRIM$(FIELDTYPE$(INDEX)))="frame" AND LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="listview" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL)))<>"frame" AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"frame" then 
37217                      for TESTROW=VPOSITION(CONTROL) to VPOSITION(CONTROL)+MAX(1,HEIGHT(CONTROL))-1
37218                         for TESTCOL=HPOSITION(CONTROL) to HPOSITION(CONTROL)+WIDTH(CONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CONTROL)))=="combo"))-1
37219                            if FNCONTROLISINSIDE(TESTROW,TESTCOL,VPOSITION(INDEX),HPOSITION(INDEX),WIDTH(INDEX)+(2*(LWRC$(TRIM$(FIELDTYPE$(INDEX)))=="combo")),HEIGHT(INDEX)) then 
37220                               let VALID=0
37221                               if MODE then 
37222                                  let MODE=INPUTEDITORMOVEMODE
37223                                  let OBJECT=CONTROL
37224                                  if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))<>"frame" AND LWRC$(TRIM$(FIELDTYPE$(INDEX)))<>"frame" then 
37225                                     let MESSAGE$="Control "&STR$(CONTROL)&" overlaps control "&STR$(INDEX) &"."
37226                                  else 
37227                                     let MESSAGE$="BR doesn't support a listview on a frame."
37228                                  end if 
37229                               end if 
37230                               let TESTCOL=HPOSITION(CONTROL)+WIDTH(CONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(CONTROL)))=="combo"))-1
37231                               let TESTROW=VPOSITION(CONTROL)+MAX(1,HEIGHT)-1
37232                               goto Endtest  !We Found A Problem, We Can Stop Searching
37233                            end if 
37234                         next TESTCOL
37235                      next TESTROW
37236                   else if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="frame" OR LWRC$(TRIM$(FIELDTYPE$(INDEX)))="frame" then 
37237                      if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="frame" then 
37238                         let FRAMECONTROL=CONTROL
37239                         let OTHERCONTROL=INDEX
37240                      else 
37241                         let FRAMECONTROL=INDEX
37242                         let OTHERCONTROL=CONTROL
37243                      end if 
37244                      for TESTROW=VPOSITION(OTHERCONTROL) to VPOSITION(OTHERCONTROL)+MAX(1,HEIGHT(OTHERCONTROL))-1
37245                         for TESTCOL=HPOSITION(OTHERCONTROL) to HPOSITION(OTHERCONTROL)+WIDTH(OTHERCONTROL)+(2*(LWRC$(TRIM$(FIELDTYPE$(OTHERCONTROL)))=="combo"))-1
37246                            if ~SETINSIDE then 
37247                               let INSIDE=FNCONTROLISINSIDE(TESTROW,TESTCOL,VPOSITION(FRAMECONTROL),HPOSITION(FRAMECONTROL),WIDTH(FRAMECONTROL),HEIGHT(FRAMECONTROL))
37248                               let SETINSIDE=1
37249                            else 
37250                               if INSIDE<>FNCONTROLISINSIDE(TESTROW,TESTCOL,VPOSITION(FRAMECONTROL),HPOSITION(FRAMECONTROL),WIDTH(FRAMECONTROL),HEIGHT(FRAMECONTROL)) then 
37251                                  let VALID=0
37252                                  if MODE then 
37253                                     let MODE=INPUTEDITORMOVEMODE
37254                                     let OBJECT=OTHERCONTROL
37255                                     let MESSAGE$="Control "&STR$(OTHERCONTROL)&" is halfway outside of a frame."
37256                                  end if 
37257                               end if 
37258                            end if 
37259                         next TESTCOL
37260                      next TESTROW
37261                   end if 
37262                end if 
37263             next INDEX
37264          end if 
37265       end if 
37266 Endtest: ! End Of The Test Here
37267       let FNVALIDSPEC=VALID
37268    fnend 
37269 ! 
37270 ! 
37271    dim VALIDSPECATTRIBUTES$(1)*128
37272    dim VALIDSPECATTRIBUTES(1)
37273 ! 
37274    def FNVALIDATTRIBUTE(ATTRIBUTE$*128,FIELDTYPE$;___,VISIBILITY)
37275       if LEN(TRIM$(ATTRIBUTE$)) then 
37276          if UDIM(MAT VALIDSPECATTRIBUTES$)=1 AND VALIDSPECATTRIBUTES$(1)="" then 
37277             mat VALIDSPECATTRIBUTES$(0)
37278             mat VALIDSPECATTRIBUTES(0)
37279          end if 
37280          let I=SRCH(MAT VALIDSPECATTRIBUTES$,ATTRIBUTE$)
37281          if I<1 then 
37282             let I=UDIM(MAT VALIDSPECATTRIBUTES$)+1
37283             mat VALIDSPECATTRIBUTES$(I)
37284             mat VALIDSPECATTRIBUTES(I)
37285             let VALIDSPECATTRIBUTES$(I)=ATTRIBUTE$
37286 ! 
37287             let VISIBILITY=FNFORCEVISIBILITY
37288             let FNCHANGEFORCEVISIBILITY(0)
37289             if LWRC$(TRIM$(FIELDTYPE$))="check" AND POS("0123456789",ATTRIBUTE$(1:1)) then 
37290                let ATTRIBUTE$(1:1)=""  !strip the number thats breaking design
37291             end if 
37292             print #0, fields "3,3,C 1,"&ATTRIBUTE$ : "" error _Invalidattribute
37293             let VALIDSPECATTRIBUTES(I)=1
37294 _Invalidattribute: ! Invalid Attribute
37295             let FNCHANGEFORCEVISIBILITY(VISIBILITY)
37296          end if 
37297          let FNVALIDATTRIBUTE=VALIDSPECATTRIBUTES(I)
37298       else 
37299          let FNVALIDATTRIBUTE=1
37300       end if 
37301    fnend 
37302 ! 
37303    dim VALIDWINDOWATTRIBUTES$(1)*128
37304    dim VALIDWINDOWATTRIBUTES(1)
37305 ! 
37306    def FNVALIDFRAME(ATTRIBUTE$*128;___,X,I)
37307       if LEN(TRIM$(ATTRIBUTE$)) then 
37308          if UDIM(MAT VALIDWINDOWATTRIBUTES$)=1 AND VALIDWINDOWATTRIBUTES$(1)="" then 
37309             mat VALIDWINDOWATTRIBUTES$(0)
37310             mat VALIDWINDOWATTRIBUTES(0)
37311          end if 
37312          let I=SRCH(MAT VALIDWINDOWATTRIBUTES$,ATTRIBUTE$)
37313          if I<1 then 
37314             let I=UDIM(MAT VALIDWINDOWATTRIBUTES$)+1
37315             mat VALIDWINDOWATTRIBUTES$(I)
37316             mat VALIDWINDOWATTRIBUTES(I)
37317             let VALIDWINDOWATTRIBUTES$(I)=ATTRIBUTE$
37318             open #(X:=FNGETFILENUMBER) : "srow=2,scol=2,rows=1,cols=1"&ATTRIBUTE$,display,outin error _Invalidframe
37319             close #X: 
37320             let VALIDWINDOWATTRIBUTES(I)=1
37321 _Invalidframe: ! Invalid Frame
37322          end if 
37323          let FNVALIDFRAME=VALIDWINDOWATTRIBUTES(I)
37324       else 
37325          let FNVALIDFRAME=1
37326       end if 
37327    fnend 
37328 ! 
37329 Controlisinside: ! Return True If The Given Position Is Inside The Given Control Boundaries
37330    def FNCONTROLISINSIDE(TESTROW,TESTCOL,ROW,COL,WIDTH,HEIGHT)
37331       if HEIGHT=0 then let HEIGHT=1
37332       if TESTROW=>ROW AND TESTROW<=ROW+HEIGHT-1 AND TESTCOL=>COL AND TESTCOL<=COL+WIDTH-1 then 
37333          let FNCONTROLISINSIDE=1
37334       else 
37335          let FNCONTROLISINSIDE=0
37336       end if 
37337    fnend 
37338 ! 
39000 !  #Autonumber# 39000,1
39001 ! *****************************************************************
39002 ! ******************** Add New Controls ***************************
39003 ! *****************************************************************
39004    dim GAPS(1)
39005    def FNFINDAVAILABLEVPOSITION(;&HPOS,&WIDTH,___,INDEX,ROW,FOUND)
39006       mat GAPS(SCREENIO(SI_VSIZE))
39007       if ~HPOS then let HPOS=INT(SCREENIO(SI_HSIZE)/4)
39008       if ~WIDTH then let WIDTH=18
39009       let ROW=1
39010       do WHILE ROW<SCREENIO(SI_VSIZE)-1
39011          let ROW+=1
39012          if ~GAPS(ROW) then 
39013             let FOUND=FNCHECKROW(ROW,HPOS,WIDTH,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39014          end if 
39015       loop UNTIL FOUND
39016       if ~FOUND then ! Screen Needs To Be Made Bigger
39017          let SCREENIO(SI_VSIZE)+=1
39018          let FOUND=SCREENIO(SI_VSIZE)-1
39019       end if 
39020       let FNFINDAVAILABLEVPOSITION=FOUND
39021    fnend 
39022 ! 
39023    def FNCHECKROW(ROW,HPOS,WIDTH,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,FOUND,TESTCOL)
39024       do WHILE INDEX<UDIM(MAT CONTROLNAME$)
39025          let INDEX+=1
39026          for TESTCOL=HPOS to HPOS+WIDTH
39027             if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="frame" then 
39028                if GRIDLINES(INDEX) then 
39029                   if FNCONTROLISINSIDE(ROW,TESTCOL,VPOSITION(INDEX)-1,HPOSITION(INDEX),WIDTH(INDEX),1) then let FOUND=1
39030                   if FNCONTROLISINSIDE(ROW,TESTCOL,VPOSITION(INDEX)+HEIGHT(INDEX),HPOSITION(INDEX),WIDTH(INDEX),1) then let FOUND=1
39031                end if 
39032             else 
39033                if FNCONTROLISINSIDE(ROW,TESTCOL,VPOSITION(INDEX),HPOSITION(INDEX),WIDTH(INDEX),HEIGHT(INDEX)) then let FOUND=1
39034             end if 
39035          next TESTCOL
39036       loop UNTIL FOUND
39037       if ~FOUND then 
39038          let FNCHECKROW=ROW
39039       end if 
39040    fnend 
39041 ! 
39042    def FNSKIPAGAP(;___,X)
39043       let X=FNFINDAVAILABLEVPOSITION
39044       if X then let GAPS(X)=1
39045    fnend 
39046 ! 
39047    def FNRESIZESCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,RIGHTEDGE,BOTTOMEDGE)
39048       for INDEX=1 to UDIM(MAT HPOSITION)
39049          let RIGHTEDGE=MAX(RIGHTEDGE,HPOSITION(INDEX)+WIDTH(INDEX)-1)
39050          let BOTTOMEDGE=MAX(BOTTOMEDGE,VPOSITION(INDEX)+HEIGHT(INDEX)-1)
39051       next INDEX
39052 ! 
39053       let SCREENIO(SI_VSIZE)=MAX(5,BOTTOMEDGE+1)
39054       let SCREENIO(SI_HSIZE)=MAX(30,RIGHTEDGE+4)
39055    fnend 
39056 ! 
39057    def FNTHERESALISTVIEW(MAT FIELDTYPE$;___,INDEX,LISTVIEW)
39058       for INDEX=1 to UDIM(MAT FIELDTYPE$)
39059          if LWRC$(TRIM$(FIELDTYPE$(INDEX)))="listview" then let LISTVIEW=1
39060       next INDEX
39061       let FNTHERESALISTVIEW=LISTVIEW
39062    fnend 
39063 ! 
39064    def FNFINDEXITROW(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,FOUNDEXITROW)
39065       for INDEX=1 to UDIM(MAT CONTROLNAME$)
39066          if CONTROLNAME$(INDEX)="Cancel_Button" OR CONTROLNAME$(INDEX)="Save_Button" OR CONTROLNAME$(INDEX)="Select_Button" then 
39067             let FOUNDEXITROW=INDEX
39068          end if 
39069          if CONTROLNAME$(INDEX)="Add_Button" OR CONTROLNAME$(INDEX)="Edit_Button" then 
39070             let FOUNDEXITROW=INDEX
39071          end if 
39072       next INDEX
39073       if FOUNDEXITROW=0 then 
39074          for INDEX=1 to UDIM(MAT FUNCTION$)
39075             if POS(LWRC$(FUNCTION$(INDEX)),"exitmode") AND POS(LWRC$(FUNCTION$(INDEX)),"quit") then 
39076                let FOUNDEXITROW=INDEX
39077             end if 
39078          next INDEX
39079       end if 
39080       if FOUNDEXITROW then 
39081          let FNFINDEXITROW=VPOSITION(FOUNDEXITROW)
39082       end if 
39083    fnend 
39084 ! 
39085    dim SCREENS$(1)
39086    def FNADDAEBUTTONS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;TARGET$,ROW,COL,NOADD,NOEDIT,NODELETE,&ADD,&EDIT,&DELETEBUTTON,___,INDEX,FINDLISTVIEW,COLUMN)
39087       if TARGET$="" then 
39088 ! .     ! library "fileio" : fnAskCombo$ Linkage already established
39089          let FNREADALLSCREENCODES(MAT TEMPSCREENLIST$,MAT TEMPCREATEDATE,MAT TEMPMODIFYDATE,MAT TEMPVERSION,MAT TEMPCREATEUSER$,MAT TEMPMODIFYUSER$,MAT TEMPPROJECT$,MAT TEMPNOTES$)
39090 ! 
39091          let TARGET$=FNASKCOMBO$(MAT TEMPSCREENLIST$,"Select target:")
39092       end if 
39093 ! 
39094       for INDEX=1 to UDIM(MAT FIELDTYPE$)
39095          if LWRC$(TRIM$(FIELDTYPE$))="listview" then 
39096             let FINDLISTVIEW=INDEX
39097          end if 
39098       next INDEX
39099 ! 
39100       if ~ROW then let ROW=FNFINDEXITROW(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39101       if ~ROW then let FNSKIPAGAP
39102 ! 
39103       if ~COL then 
39104          if FINDLISTVIEW then 
39105             let COL=HPOSITION(FINDLISTVIEW)
39106          else 
39107             let COL=10
39108          end if 
39109       end if 
39110 ! 
39111       if ~NOADD then 
39112          let ADD=FNADDBUTTON(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39113          if ADD then 
39114             if ~ROW then let ROW=VPOSITION(ADD)
39115             let WIDTH(ADD)=10
39116             let VPOSITION(ADD)=ROW
39117             let HPOSITION(ADD)=COL
39118             let CONTROLNAME$(ADD)="Add_Button"
39119             let DESCRIPTION$(ADD)="Add"
39120             let FUNCTION$(ADD)="["&UPRC$(TARGET$)&"]"
39121             let FGCOLOR$(ADD)="W"
39122             let BGCOLOR$(ADD)="W"
39123             let COL+=12               !Move over for Next Button
39124          end if 
39125       end if 
39126 ! 
39127       if ~NOEDIT then 
39128          let EDIT=FNADDBUTTON(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39129          if EDIT then 
39130             let WIDTH(EDIT)=10
39131             let VPOSITION(EDIT)=ROW
39132             let HPOSITION(EDIT)=COL
39133             let CONTROLNAME$(EDIT)="Edit_Button"
39134             let DESCRIPTION$(EDIT)="Edit"
39135             let FUNCTION$(EDIT)="["&UPRC$(TARGET$)&"]Record=CurrentRec"
39136             let FGCOLOR$(EDIT)="W"
39137             let BGCOLOR$(EDIT)="W"
39138             let COL+=12               !Move over for Next Button
39139          end if 
39140       end if 
39141 ! 
39142       if ~NODELETE then 
39143 ! .     ! Add Delete Button
39144          let DELETEBUTTON=FNADDBUTTON(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39145          if DELETEBUTTON then 
39146             let WIDTH(DELETEBUTTON)=10
39147             let VPOSITION(DELETEBUTTON)=ROW
39148             let HPOSITION(DELETEBUTTON)=COL
39149             let CONTROLNAME$(DELETEBUTTON)="Delete_Button"
39150             let DESCRIPTION$(DELETEBUTTON)="Delete"
39151             let FUNCTION$(DELETEBUTTON)="{deletelistviewrecord}"
39152             let FGCOLOR$(DELETEBUTTON)="W"
39153             let BGCOLOR$(DELETEBUTTON)="W"
39154             let COL+=12               !Move over for Next Button
39155          end if 
39156       end if 
39157    fnend 
39158 ! 
39159    def FNADDEXITBUTTONS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ROW,&CANCELBUTTON,&OKBUTTON,___,CANCEL,SAVE,INDEX,RIGHTEDGE)
39160 ! .  ! IF there's AE buttons, use that row
39161 ! .  !  if not, use the skipagap logic
39162       if ~ROW then let ROW=FNFINDEXITROW(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39163       if ~ROW then let FNSKIPAGAP
39164 ! 
39165       for INDEX=1 to UDIM(MAT HPOSITION)
39166          let RIGHTEDGE=MAX(RIGHTEDGE,HPOSITION(INDEX)+WIDTH(INDEX)-1)
39167       next INDEX
39168       if ~RIGHTEDGE then let RIGHTEDGE=SCREENIO(SI_HSIZE)-4
39169       let RIGHTEDGE=MAX(RIGHTEDGE,24)
39170 ! 
39171       let CANCEL=FNADDBUTTON(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39172       if ~ROW then let ROW=VPOSITION(CANCEL)
39173       let VPOSITION(CANCEL)=ROW
39174       let WIDTH(CANCEL)=10
39175       let HPOSITION(CANCEL)=RIGHTEDGE-WIDTH(CANCEL)+1
39176       let CONTROLNAME$(CANCEL)="Cancel_Button"
39177       let DESCRIPTION$(CANCEL)="Cancel"
39178       let FUNCTION$(CANCEL)="let ExitMode=QuitOnly"
39179       let FGCOLOR$(CANCEL)="W"
39180       let BGCOLOR$(CANCEL)="W"
39181 ! 
39182       let SAVE=FNADDBUTTON(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39183       let WIDTH(SAVE)=10
39184       let VPOSITION(SAVE)=ROW
39185       let HPOSITION(SAVE)=HPOSITION(CANCEL)-2-WIDTH(SAVE)
39186       let FGCOLOR$(SAVE)="W"
39187       let BGCOLOR$(SAVE)="W"
39188 ! 
39189       if FNTHERESALISTVIEW(MAT FIELDTYPE$) then 
39190          let CONTROLNAME$(SAVE)="Select_Button"
39191          let DESCRIPTION$(SAVE)="Select"
39192          let FUNCTION$(SAVE)="let ExitMode=SelectAndQuit"
39193       else 
39194          let CONTROLNAME$(SAVE)="Save_Button"
39195          let DESCRIPTION$(SAVE)="Save"
39196          let FUNCTION$(SAVE)="let ExitMode=SaveAndQuit"
39197       end if 
39198       let FNADDEXITBUTTONS=SAVE
39199 ! 
39200       let CANCELBUTTON=CANCEL
39201       let OKBUTTON=SAVE
39202 ! 
39203 ! .   ! let Description$(Save)="Ok" ! Uncomment this line to make it use OK for the save button.
39204    fnend 
39205 ! 
39206 Addemptyfield: ! Add An Empty Field To The Editor Arrays
39207    def FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;SKIPPLACEMENT,SPECIFYROW,___,INDEX)
39208       let FNRESIZECONTROLARRAYS(INDEX:=UDIM(CONTROLNAME$)+ 1,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39209       let WIDTH(INDEX)=18
39210       if SPECIFYROW then 
39211          let VPOSITION(INDEX)=SPECIFYROW
39212       else if ~SKIPPLACEMENT then 
39213          let VPOSITION(INDEX)=FNFINDAVAILABLEVPOSITION(HPOSITION(INDEX),WIDTH(INDEX))  !Sets Hposition To 1/4th The Screen Size Also
39214       else 
39215          let VPOSITION(INDEX)=1       !in case it has to be something..
39216       end if 
39217       let HEIGHT(INDEX)=1
39218       let FNADDEMPTYFIELD=INDEX
39219    fnend 
39220 ! 
39221    def FNADDANDCOLORCURRENTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO;NAME$*50,DESCRIPTION$*255,TYPE$*30,DATESPEC$*64,&CAPTIONINDEX,SPECIFYROW,___,INDEX,RELATEDCONTROL)
39222       let INDEX=FNADDCURRENTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,SCREENIO(SI_HSIZE),NAME$,DESCRIPTION$,TYPE$,DATESPEC$,CAPTIONINDEX,SPECIFYROW)
39223       if INDEX then 
39224          let FGCOLOR$(INDEX)="W"
39225          let BGCOLOR$(INDEX)="W"
39226          if TRIM$(SCREENIO$(SI_FGCOLOR))<>"" then 
39227             if (RELATEDCONTROL:=SRCH(MAT CONTROLNAME$,DESCRIPTION$(INDEX)))>0 then 
39228                let FGCOLOR$(RELATEDCONTROL)=TRIM$(SCREENIO$(SI_FGCOLOR))
39229             end if 
39230          end if 
39231       end if 
39232       let FNADDANDCOLORCURRENTFIELD=INDEX
39233    fnend 
39234 ! 
39235 Addcurrentfield: ! Add The Current Field To The Editor Arrays
39236    def FNADDCURRENTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,SCREENWIDTH;NAME$*50,DESCRIPTION$*255,TYPE$*30,DATESPEC$*64,&CAPTIONFIELD,SPECIFYROW,___,INDEX,CAPTIONDISPLAYWIDTH,VPOS,HPOS,NOFIELDSEL)
39237       if NAME$="" AND DESCRIPTION$="" AND TYPE$="" then 
39238          if FNGETFIELDSCOUNT then 
39239             if ~FNREADFIELDS(NAME$,DESCRIPTION$,TYPE$,DATESPEC$) then 
39240                let NOFIELDSEL=1       !Abort
39241             end if 
39242          else 
39243             let NOFIELDSEL=1
39244          end if 
39245       end if 
39246       if ~NOFIELDSEL then 
39247 ! .     ! Add Field
39248          if LEN(TRIM$(DESCRIPTION$)) then let DESCRIPTION$=DESCRIPTION$&": "
39249          let CAPTIONDISPLAYWIDTH=INT(LEN(TRIM$(DESCRIPTION$))*4/5)+2
39250          let INDEX=FNADDTEXTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,SPECIFYROW)
39251          let FIELDTYPE$(INDEX)="C"
39252          let CONTROLNAME$(INDEX)="Field_"&TRIM$(NAME$)(1:44)
39253          let DESCRIPTION$(INDEX)="Caption_"&TRIM$(NAME$)(1:42)
39254          let FIELDNAME$(INDEX)=TRIM$(NAME$)
39255          let WIDTH(INDEX)=FNDISPLAYLENGTH(TYPE$)
39256          let SPECWIDTH(INDEX)=WIDTH(INDEX)
39257          let WIDTH(INDEX)=MIN(WIDTH(INDEX),40)
39258          let HPOSITION(INDEX)=MAX(CAPTIONDISPLAYWIDTH+2,HPOSITION(INDEX))
39259          let WIDTH(INDEX)=MIN(WIDTH(INDEX),SCREENWIDTH-HPOSITION(INDEX))
39260          let VPOS=VPOSITION(INDEX)
39261          let HPOS=HPOSITION(INDEX)
39262 ! 
39263          if LEN(TRIM$(DATESPEC$)) then 
39264 ! .        ! Then let dateSpec$ = the default DateFormatDisplay from ScreenIO.ini.
39265             let CNVRTIN$(INDEX)="DATE("&SETTING_DATEFORMATDISPLAY$&")"
39266             if ~POS(LWRC$(DATESPEC$),"julian") then 
39267                let CNVRTOUT$(INDEX)="DATE("&DATESPEC$&")"
39268             end if 
39269          end if 
39270 ! 
39271          let FNADDCURRENTFIELD=INDEX
39272          let INDEX=FNADDCAPTION(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39273          let FIELDTYPE$(INDEX)="caption"
39274          let CONTROLNAME$(INDEX)="Caption_"&TRIM$(NAME$)(1:42)
39275          let DESCRIPTION$(INDEX)=TRIM$(DESCRIPTION$)
39276          let JUSTIFY$(INDEX)="R"
39277          let VPOSITION(INDEX)=VPOS
39278          let HPOSITION(INDEX)=HPOS-(CAPTIONDISPLAYWIDTH+1)
39279          let WIDTH(INDEX)=CAPTIONDISPLAYWIDTH
39280          let SPECWIDTH(INDEX)=LEN(TRIM$(DESCRIPTION$))
39281 ! 
39282 ! 
39283          let CAPTIONFIELD=INDEX
39284       end if 
39285    fnend 
39286 ! 
39287 Addtextfield: ! Add A  Textbox Field
39288    def FNADDTEXTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;SPECIFYROW,___,INDEX)
39289       let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,SPECIFYROW)
39290       let FIELDTYPE$(INDEX)="C"
39291       let SPECWIDTH(INDEX)=WIDTH(INDEX)
39292       let PARENT$(INDEX)=FNGENERATEUNIQUELVNAME$(MAT PARENT$,"Textbox")
39293       let FNADDTEXTFIELD=INDEX
39294    fnend 
39295 ! 
39296 Addcaption: ! Add A Caption Field
39297    def FNADDCAPTION(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX)
39298       let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39299       let FIELDTYPE$(INDEX)="caption"
39300       let SPECWIDTH(INDEX)=WIDTH(INDEX)
39301       let PARENT$(INDEX)=FNGENERATEUNIQUELVNAME$(MAT PARENT$,"Caption")
39302       let FNADDCAPTION=INDEX
39303    fnend 
39304 ! 
39305 Addscreen: ! Add An Entire Screen As A Clickable Field
39306    def FNADDSCREEN(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,SCREEN$)
39307       let SCREEN$=FNSELECTSCREEN$
39308       if TRIM$(SCREEN$)<>"" then 
39309          let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39310          let FIELDTYPE$(INDEX)="screen"
39311          let FIELDNAME$(INDEX)=SCREEN$
39312          let PARENT$(INDEX)=FNGENERATEUNIQUELVNAME$(MAT PARENT$,"Screen")
39313 ! 
39314          let FNREADCHILDSCREENSIZE(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39315 ! 
39316          let FUNCTION$(INDEX)="ParentKey$=CurrentKey$"
39317          let FNADDSCREEN=INDEX
39318       end if 
39319    fnend 
39320 ! 
