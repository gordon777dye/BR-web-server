93830 ! 
93835 Generatesubscripts: ! Generates The Subscripts That Get Passed Into User Defined Functions
93840    def FNGENERATESUBSCRIPTS(MAT SUBSCRIPTS$;___,INDEX,SUBINDEX)
93845       if ~SUBSCRIPTSALREADYSET then ! If They're already set then leave them alone
93850          mat SUBSCRIPTS$(0)
93855 ! 
93860 ! .      ! fileio subscripts for mat f$ and mat f
93865          let FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,TRIM$(PREFIX$),MAT FIELDSSSUBS$)
93870          let FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,TRIM$(PREFIX$),MAT FIELDSNSUBS$)
93875 ! 
93880 ! .      ! fileIO Subscripts for mat ScreenIO$ and mat ScreenIO
93885          let FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,TRIM$(SCREENIOPREFIX$),MAT SCREENIOSSUBS$)
93890          let FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,TRIM$(SCREENIOPREFIX$),MAT SCREENIONSUBS$)
93895 ! 
93900 ! .      ! screenio subscripts for mat s$ (based on Control Name field)
93905          let FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,"sio_",MAT SCREENSUBS$)
93910 ! 
93915 ! .      ! Control Subs based on Control Name field
93920          let FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,"ctl_",MAT CONTROLNAME$)
93925          let FNADDUNIQUEARRAYTOSUBS(MAT SUBSCRIPTS$,"ctl_",MAT CONTROLNAME$)
93930 ! 
93935 ! .      ! Exitmode Literals such as SaveAndQuit and QuitOnly
93940          let FNADDTOSUBSARRAY("let QuitOnly="&STR$(QUITONLY),MAT SUBSCRIPTS$)
93945          let FNADDTOSUBSARRAY("let SaveAndQuit="&STR$(SAVEANDQUIT),MAT SUBSCRIPTS$)
93950          let FNADDTOSUBSARRAY("let SelectAndQuit="&STR$(SELECTANDQUIT),MAT SUBSCRIPTS$)
93955          let FNADDTOSUBSARRAY("let QuitOther="&STR$(QUITOTHER),MAT SUBSCRIPTS$)
93960          let FNADDTOSUBSARRAY("let AskSaveAndQuit="&STR$(ASKSAVEANDQUIT),MAT SUBSCRIPTS$)
93965          let FNADDTOSUBSARRAY("let Reload="&STR$(RELOAD),MAT SUBSCRIPTS$)
93970          let FNADDTOSUBSARRAY("let AutoReload="&STR$(AUTORELOAD),MAT SUBSCRIPTS$)
93975          let FNADDTOSUBSARRAY("let FkeyPgUp=90",MAT SUBSCRIPTS$)
93980          let FNADDTOSUBSARRAY("let FkeyPgDn=91",MAT SUBSCRIPTS$)
93985          let FNADDTOSUBSARRAY("let FkeyUp=102",MAT SUBSCRIPTS$)
93990          let FNADDTOSUBSARRAY("let FkeyDn=104",MAT SUBSCRIPTS$)
93995          let FNADDTOSUBSARRAY("let FkeyLeft=103",MAT SUBSCRIPTS$)
94000          let FNADDTOSUBSARRAY("let FkeyRight=109",MAT SUBSCRIPTS$)
94005          let FNADDTOSUBSARRAY("let FkeyUpFld=105",MAT SUBSCRIPTS$)
94010          let FNADDTOSUBSARRAY("let FkeyDnFld=106",MAT SUBSCRIPTS$)
94015          let FNADDTOSUBSARRAY("let FkeyEsc=99",MAT SUBSCRIPTS$)
94020          let FNADDTOSUBSARRAY("let FkeyWinClose=93",MAT SUBSCRIPTS$)
94025          let FNADDTOSUBSARRAY("let FkeyHome=112",MAT SUBSCRIPTS$)
94030          let FNADDTOSUBSARRAY("let FkeyEnd=113",MAT SUBSCRIPTS$)
94035          let FNADDTOSUBSARRAY("let FkeyFldPlus=114",MAT SUBSCRIPTS$)
94040          let FNADDTOSUBSARRAY("let FkeyFldMinus=115",MAT SUBSCRIPTS$)
94045          let FNADDTOSUBSARRAY("let FkeyClick=201",MAT SUBSCRIPTS$)
94050          let FNADDTOSUBSARRAY("let FkeyDblClick=202",MAT SUBSCRIPTS$)
94055          let FNADDTOSUBSARRAY("let FkeyRightClick=100",MAT SUBSCRIPTS$)
94060 ! 
94065          let SUBSCRIPTSALREADYSET=1
94070       end if 
94075    fnend 
94080    def FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,PRE$,MAT STRING$;___,INDEX)
94085       for INDEX=1 to UDIM(MAT STRING$)
94090          if LEN(TRIM$(STRING$(INDEX))) then 
94095             let FNADDTOSUBSARRAY("let "&PRE$&TRIM$(STRING$(INDEX))(1:30-LEN(TRIM$(PRE$)))&"="&STR$(INDEX),MAT SUBSCRIPTS$)
94100          end if 
94105       next INDEX
94110    fnend 
94115 ! 
94120 ! 
94125    dim TEMPSETSUBSCRIPTS$(1)*800
94130 Executesetsubscripts: ! Execute A Subscripts List Setting The Subscripts
94135    def FNEXECUTESETSUBSCRIPTS(MAT SUBS$,PREFIX$;___,INDEX)
94140       if FNCHECKBEFOREEXECUTESUBS(PREFIX$) then 
94145          mat TEMPSETSUBSCRIPTS$(0)
94150          for INDEX=1 to UDIM(MAT SUBS$)
94155             if LEN(TRIM$(SUBS$(INDEX))) then 
94160                let FNADDTOSUBSARRAY("let "&TRIM$(PREFIX$)&TRIM$(SUBS$(INDEX))(1:30-LEN(TRIM$(PREFIX$)))&"="&STR$(INDEX),MAT TEMPSETSUBSCRIPTS$)
94165             end if 
94170          next INDEX
94175          for INDEX=1 to UDIM(MAT TEMPSETSUBSCRIPTS$)
94180             execute TEMPSETSUBSCRIPTS$(INDEX)
94185          next INDEX
94190       end if 
94195    fnend 
94200 ! 
94205    dim ALREADYKNOW$(1)*40
94210    dim ALREADYKNOW(1)
94215 ! 
94220    def FNCHECKBEFOREEXECUTESUBS(PREFIX$;___,INDEX,FOUNDYET)
94225 ! .  ! check arrays to see if we already know
94230       if (INDEX:=SRCH(MAT ALREADYKNOW$,LWRC$(SCREENIO$(SI_SCREENCODE))&"|&|"&LWRC$(PREFIX$)))>0 then 
94235          let FOUNDYET=ALREADYKNOW(INDEX)
94240       else 
94245          do 
94250             for INDEX=SI_ENTERFN to SI_EXITFN
94255                if (FOUNDYET:=FNCHECKSINGLEFUNCTION(PREFIX$,SCREENIO$(INDEX))) then exit do 
94260             next INDEX
94265             for INDEX=1 to UDIM(MAT FUNCTION$)
94270                if (FOUNDYET:=FNCHECKSINGLEFUNCTION(PREFIX$,FUNCTION$(INDEX))) then exit do 
94275                if (FOUNDYET:=FNCHECKSINGLEFUNCTION(PREFIX$,CNVRTIN$(INDEX))) then exit do 
94280                if (FOUNDYET:=FNCHECKSINGLEFUNCTION(PREFIX$,CNVRTOUT$(INDEX))) then exit do 
94285             next INDEX
94290          loop WHILE 0
94295          let INDEX=UDIM(MAT ALREADYKNOW$)+1
94300          mat ALREADYKNOW$(INDEX)
94305          mat ALREADYKNOW(INDEX)
94310          let ALREADYKNOW$(INDEX)=LWRC$(SCREENIO$(SI_SCREENCODE))&"|&|"&LWRC$(PREFIX$)
94315          let ALREADYKNOW(INDEX)=FOUNDYET
94320       end if 
94325 ! 
94330       let FNCHECKBEFOREEXECUTESUBS=FOUNDYET
94335    fnend 
94340 ! 
94345    def FNCHECKSINGLEFUNCTION(PREFIX$,STRING$*255)
94350       if ~POS("{#%",TRIM$(STRING$)(1:1)) then 
94355          if TRIM$(STRING$)(1:1)="[" then let STRING$(1:POS(STRING$,"]"))=""
94360          if POS(STRING$,PREFIX$) then let FNCHECKSINGLEFUNCTION=1
94365       end if 
94370    fnend 
94375 ! 
94380    dim UNIQUECONTROLNAME$(1)*54
94385    def FNEXECUTEUNIQUESUBSCRIPTS(MAT CONTROLNAME$,PREFIX$)
94390       let FNGETUNIQUECONTROLNAME(MAT UNIQUECONTROLNAME$,MAT CONTROLNAME$)
94395       let FNEXECUTESETSUBSCRIPTS(MAT UNIQUECONTROLNAME$,PREFIX$)
94400    fnend 
94405 ! 
94410    def FNADDUNIQUEARRAYTOSUBS(MAT SUBSCRIPTS$,PREFIX$,MAT CONTROLNAME$)
94415       let FNGETUNIQUECONTROLNAME(MAT UNIQUECONTROLNAME$,MAT CONTROLNAME$)
94420       let FNADDARRAYTOSUBS(MAT SUBSCRIPTS$,PREFIX$,MAT UNIQUECONTROLNAME$)
94425    fnend 
94430 ! 
94435    def FNGETUNIQUECONTROLNAME(MAT UNIQUECONTROLNAME$,MAT CONTROLNAME$;___,INDEX)
94440       mat UNIQUECONTROLNAME$(UDIM(MAT CONTROLNAME$))
94445       for INDEX=1 to UDIM(MAT UNIQUECONTROLNAME$)
94450          let UNIQUECONTROLNAME$(INDEX)=FNUNIQUENAME$(MAT CONTROLNAME$,INDEX)
94455       next INDEX
94460    fnend 
94465 ! 
94470 ! 
94475    dim ADDTOSUBSCOUNT
94480 Addtosubsarray: ! Adds Subscripts To A Processing Effecient Array
94485    def FNADDTOSUBSARRAY(STRING$*50,MAT SUBS$;___,INDEX)
94490 ! 
94495       let ADDTOSUBSCOUNT+=1
94500       let INDEX=UDIM(MAT SUBS$)
94505 ! 
94510       if INDEX=0 OR ADDTOSUBSCOUNT>31 then 
94515          gosub Addnewone
94520       else 
94525          let SUBS$(INDEX)=SUBS$(INDEX)&": "&STRING$ soflow Erroraddnewone
94530       end if 
94535    fnend 
94540 ! 
94545 Erroraddnewone: gosub Addnewone : continue 
94550 Addnewone: ! Add A New Sub Line
94555    let ADDTOSUBSCOUNT=1
94560    let INDEX+=1
94565    mat SUBS$(INDEX)
94570    let SUBS$(INDEX)="*"&STRING$
94575    return 
94580 ! 
94585 Findsubscript: ! This Function Finds A Subscript And Returns Its Number
94590    def library FNFINDSUBSCRIPT(MAT SUBSCRIPTS$,PREFIX$,STRING$*40;___,INDEX,SUBSCRIPT,POSITION,EQUALS,COLON)
94595       do WHILE INDEX<UDIM(MAT SUBSCRIPTS$)
94600          let INDEX+=1
94605          if (POSITION:=POS(LWRC$(SUBSCRIPTS$(INDEX))," "&LWRC$(TRIM$(PREFIX$))&LWRC$(TRIM$(STRING$)))) then 
94610             let SUBSCRIPT=-1
94615             let EQUALS=POS(SUBSCRIPTS$(INDEX),"=",POSITION)
94620             let COLON=POS(SUBSCRIPTS$(INDEX),":",POSITION)
94625             if ~COLON then let COLON=LEN(SUBSCRIPTS$(INDEX))+1
94630             let SUBSCRIPT=VAL(SUBSCRIPTS$(INDEX)(EQUALS+1:COLON-1)) conv IGNORE
94635          end if 
94640       loop UNTIL SUBSCRIPT>0
94645       let FNFINDSUBSCRIPT=SUBSCRIPT
94650    fnend 
94655 ! 
94660    def FNSETFORCEVISIBILITY(SET)
94665       let FORCEVISIBILITY=FNFORCEVISIBILITY
94670       let FNCHANGEFORCEVISIBILITY(SET,1)
94675    fnend 
94680    def FNRESETFORCEVISIBILITY
94685       let FNCHANGEFORCEVISIBILITY(FORCEVISIBILITY,1)
94690    fnend 
94695    def FNCHANGEFORCEVISIBILITY(SET;FORCED,___,NEEDED,I)
94700       for I=1 to UDIM(MAT FRAMEKEYS$)
94705          if TRIM$(FRAMEKEYS$(I))<>"" then 
94710             let NEEDED=1
94715          end if 
94720       next I
94725       if NEEDED OR FORCED then 
94730          if SET then 
94735             if CURRENTFVSTATUS><2 then 
94740                execute "config force visibility on"
94745                let CURRENTFVSTATUS=2
94750             end if 
94755          else 
94760             if CURRENTFVSTATUS><1 then 
94765                execute "config force visibility off"
94770                let CURRENTFVSTATUS=1
94775             end if 
94780          end if 
94785       end if 
94790    fnend 
94795    dim CURRENTFVSTATUS
94800    def FNFORCEVISIBILITY(;___,FILENUMBER,LINE$*255,DONE,FVSTAT)
94805       if CURRENTFVSTATUS then 
94810          let FNFORCEVISIBILITY=CURRENTFVSTATUS-1
94815       else 
94820          execute "status config >config."&SESSION$
94825          open #(FILENUMBER:=FNGETFILENUMBER): "name=config."&SESSION$,display,input 
94830          do WHILE FILE(FILENUMBER)=0
94835             linput #FILENUMBER: LINE$ eof IGNORE
94840             if POS(UPRC$(LINE$),"FORCE VISIBILITY") then 
94845                if POS(UPRC$(LINE$),"ON") then 
94850                   let FVSTAT=1
94855                end if 
94860                let DONE=1
94865             end if 
94870          loop WHILE NOT DONE
94875          close #FILENUMBER: 
94880          execute "free config."&SESSION$
94885          let FNFORCEVISIBILITY=FVSTAT
94890          let CURRENTFVSTATUS=FVSTAT+1
94895       end if 
94900    fnend 
94905 ! 
94910 Stringfunction: ! This Returns True If The Passed In Function Is A String
94915    def FNSTRINGFUNCTION(FUNCTION$*255;___,START,PAREN)
94920       if TRIM$(FUNCTION$(1:1))="{" then 
94925          if LIBRARYLINKAGE then 
94930             let FNSTRINGFUNCTION=FNCHECKSTRINGFUNCTION(FUNCTION$) error Errorloadingcustomlibrary
94935          else 
94940             let FUNCTION$=FNREADCUSTOMFUNCTIONSTATEMENT$(FUNCTION$)
94945          end if 
94950       end if 
94955       if TRIM$(FUNCTION$(1:1))<>"{" then 
94960          let START=POS(LWRC$(FUNCTION$),"fn")
94965          let PAREN=POS(FUNCTION$,"(",START)
94970          if PAREN=0 then let PAREN=LEN(FUNCTION$)
94975          let FNSTRINGFUNCTION=POS(FUNCTION$(START:PAREN),"$")
94980       end if 
94985    fnend 
94990 ! 
94995 Errorloadingcustomlibrary: ! Error handler for errors that happen when trying to call your custom helper library
95000    if ERR=2280 then 
95005       print "There is a compile error in one of your Custom Functions for your screen,"
95010       print "that is preventing ScreenIO from linking to it. To see what the error is"
95015       print "type the following commands: "
95020       print "load "&SETTING_SCREENFOLDER$&"\"&TRIM$(SCREENIO$(SI_SCREENCODE))
95025       print "replace"
95030       print 
95035       print "This will cause BR to attempt to recompile your screen, showing you the actual error."
95040       print 
95045       print "or type ""GO"" and I will attempt to run those commands for you."
95050       pause 
95055       open #(X:=FNGETFILENUMBER): "name=tmp[session].$$$, replace",display,output 
95060       print #X: "load "&SETTING_SCREENFOLDER$&"\"&TRIM$(SCREENIO$(SI_SCREENCODE))
95065       print #X: "replace"
95070       close #X: 
95075       execute "proc tmp[session].$$$"
95080    else 
95085       print "Error "&STR$(ERR)&" occurred linking to your custom helper library. There may be an error in one of your custom functions."
95090    end if 
95095    stop 
95100 ! 
95105 Returnvalue: ! Convert A String To A Number According To Special Rules
95110    def FNRETURNVALUE(VALUE$*1000;___,NUMBER)
95115       let NUMBER=1                    !If Conversion Failed, Then Its A Non-Null String, Return True
95120       let NUMBER=VAL(VALUE$) conv IGNORE
95125       let FNRETURNVALUE=NUMBER
95130    fnend 
95135 ! 
95140    def FNDISPLAYLOADMESSAGE(;___,WINDOW)
95145       let FNCHANGEFORCEVISIBILITY(0)
95150       let WINDOW=FNOPENCENTEREDWINDOW(3,50,1,TRIM$(SCREENIO$(SI_LOCKWINDOW)))
95165       print #WINDOW, fields "1,1,CC 50;2,1,CC 50;3,1,CC 50" : "Now Reading Record - Requesting Write Permission", "If you see this message for more then a", "few seconds the record is probably in use."
95170       let FNDISPLAYLOADMESSAGE=WINDOW
95175       let FNRESETFORCEVISIBILITY
95180    fnend 
95185 ! 
95190    def FNASKLOCKERROR(;LOCKUSER$*800,FILENAME$*255,___,WINDOW,FUNCTION,BUTTON2$)
95195       if SCREENIO(SI_SCREENIOLOCKING) then 
95200          let BUTTON2$="Continue"
95205       else 
95210          let BUTTON2$="Read Only"
95215       end if 
95220       let FNCHANGEFORCEVISIBILITY(0)
95225       let WINDOW=FNOPENCENTEREDWINDOW(4,60,1,TRIM$(SCREENIO$(SI_LOCKWINDOW)),ROW,COL)
95230       print #WINDOW, fields "1,1,60/CC "&STR$(LEN(FILENAME$)+25) : "File Sharing Violation - "&FILENAME$
95235       print #WINDOW, fields "2,1,CC 60" : "This record is currently in use by"
95240       print #WINDOW, fields "3,1,60/CC "&STR$(LEN(LOCKUSER$)+5) : "user "&LOCKUSER$
95245       print #WINDOW, fields "4,10,CC 10,/W:W,B40;4,25,CC 10,/W:W,B41;4,40,CC 10,/W:W,B42" : "Retry",BUTTON2$,"Cancel"
95250       do 
95255          input #0, fields STR$(ROW+1)&","&STR$(COL+1)&",C 1,AEX" : KP$
95260          let FUNCTION=FKEY
95265          if FUNCTION=99 then let FUNCTION=42
95270          if FUNCTION=0 then let FUNCTION=40
95275       loop WHILE FUNCTION<40 OR FUNCTION>42
95280       let FNASKLOCKERROR=FUNCTION-39
95285       close #WINDOW: 
95290       let FNRESETFORCEVISIBILITY
95295    fnend 
95300 ! 
95305    def FNOPENCENTEREDWINDOW(ROWS,COLS;B,SPEC$*255,&ROW,&COL,___,RS,CS,SCREENROWS,SCREENCOLS,WINDOW)
95310       if B then 
95315          let RS=ROWS+2
95320          let CS=COLS+2
95325          let SPEC$=SPEC$&",Border=S"
95330       else 
95335          let RS=ROWS
95340          let CS=COLS
95345       end if 
95350       if ENV$("guimode")="ON" then 
95355          let FNREADSCREENSIZE(SCREENROWS,SCREENCOLS)
95360       else 
95365          let SCREENROWS=24 : let SCREENCOLS=80
95370       end if 
95375       let ROW=INT((SCREENROWS-(RS))/2)+2
95380       let COL=INT((SCREENCOLS-(CS))/2)+2
95385 ! 
95390       open #(WINDOW:=FNGETFILENUMBER): "SROW="&STR$(ROW)&",SCOL="&STR$(COL)&",ROWS="&STR$(ROWS)&",COLS="&STR$(COLS)&SPEC$,display,outin 
95395       let FNOPENCENTEREDWINDOW=WINDOW
95400    fnend 
95405 ! 
95410    dim LOCKUSER$(1)*255
95415    def FNRETRYLOCKEDERROR(KEY$*255,FILENUMBER;ONREAD,___,LOCKUSER$*800,CHOICE,_ERRLINE,_ERRNUMBER,__USR$*80,INDEX)
95420       let _ERRLINE=LINE
95425       let _ERRNUMBER=ERR
95430       if POS("0061_4148",CNVRT$("PIC(####)",ERR)) then 
95435          let FNREADLOCKEDUSERS(MAT LOCKUSER$)
95440          let LOCKUSER$=""
95445          if UDIM(MAT LOCKUSER$) then 
95450             let LOCKUSER$=LOCKUSER$(1)
95455             for INDEX=2 to UDIM(MAT LOCKUSER$)
95460                let LOCKUSER$=LOCKUSER$&" and "&LOCKUSER$(INDEX)
95465             next INDEX
95470          end if 
95475 ! 
95480 ! .      ! Here is where we link to our LOCKED event
95485          if LEN(TRIM$(SCREENIO$(SI_LOCKEDFN))) then 
95490             let FNRETRYLOCKEDERROR=FNEXECUTE(SCREENIO$(SI_LOCKEDFN))
95495          else if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") AND EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\locked.brs") then 
95500             let FNRETRYLOCKEDERROR=FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\locked.brs"))
95505          else 
95510             if ONREAD then 
95515                let CHOICE=FNASKLOCKERROR(LOCKUSER$,FILE$(FILENUMBER))
95520                if CHOICE=1 OR CHOICE=2 then 
95525                   let FNRETRYLOCKEDERROR=CHOICE
95530                end if 
95535             else 
95540                let CHOICE=MSGBOX("The current record is locked in file #"&STR$(FILENUMBER)&', "'&FILE$(FILENUMBER)&'", by user '&TRIM$(LOCKUSER$)&". Do you want to retry?","Record Locked","Okc","Qst")
95545                if CHOICE=1 then 
95550                   let FNRETRYLOCKEDERROR=1
95555                end if 
95560             end if 
95565          end if 
95570       end if 
95575    fnend 
95580    def FNRETRYTIMEOUTERROR(;___,WINDOW,ROWS,COLS,ROW,COL,COUNT)
95585       if LEN(SCREENIO$(SI_WAITFN)) then 
95590          let FNRESETFORCEVISIBILITY
95595          let FNRETRYTIMEOUTERROR=FNEXECUTE(SCREENIO$(SI_WAITFN))
95600       else if EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\") AND EXISTS(SETTING_FUNCTIONFOLDER$&"defaults\wait.brs") then 
95605          let FNRESETFORCEVISIBILITY
95610          let FNRETRYTIMEOUTERROR=FNEXECUTE(FNFUNCTIONSTRING$(SETTING_FUNCTIONFOLDER$&"defaults\wait.brs"))
95615       else 
95620          let FNCHANGEFORCEVISIBILITY(0)
95625          let WINDOW=FNOPENCENTEREDWINDOW(3,40,1,TRIM$(SCREENIO$(SI_LOCKWINDOW)))
95630          print #WINDOW, fields "1,1,CC 40" : "Your system has been idle for some time."
95635          print #WINDOW, fields "2,1,CC 40" : "Press any key to continue or you will"
95640          print #WINDOW, fields "3,1,CC 40" : "be logged out automatically."
95645          do WHILE COUNT<300           !30 Seconds
95650             let COUNT+=1
95655             let SLEEP(.1)
95660             if LEN(KSTAT$) then 
95665                let FNRETRYTIMEOUTERROR=1
95670                exit do 
95675             end if 
95680          loop 
95685          close #WINDOW: 
95690       end if 
95695       let FNCHANGEFORCEVISIBILITY(1)
95700    fnend 
95705 ! 
95710 ! .! We cannot count on the BR error retry and continue locations if we're calling custom code because they might be overwriting those errors in their own functions.
95715 ! .!  So we implement our own here, for the places where custom code could be called (Locked Errors and Timeouts)
95720 ! 
95725    dim RETRYPOINT$
95730    def FNSETRETRYPOINT(RP$)
95735       let RETRYPOINT$=RP$
95740    fnend 
95745 Retryspecial: ! Our special version of the Retry command
95750    if LWRC$(RETRYPOINT$) = "errorlocked1" then ! #Select# lwrc$(RetryPoint$) #Case# "errorlocked1"
95755       goto Errorlocked1retry
95760    else if LWRC$(RETRYPOINT$) = "errorlocked2" then ! #Case# "errorlocked2"
95765       goto Errorlocked2retry
95770    else if LWRC$(RETRYPOINT$) = "errorlocked3" then ! #Case# "errorlocked3"
95775       goto Errorlocked3retry
95780    else if LWRC$(RETRYPOINT$) = "errorlocked4" then ! #Case# "errorlocked4"
95785       goto Errorlocked4retry
95790    else if LWRC$(RETRYPOINT$) = "errorlocked1exit" then ! #Case# "errorlocked1exit"
95795       goto Errorlocked1exitretry
95800    else if LWRC$(RETRYPOINT$) = "errorlocked2exit" then ! #Case# "errorlocked2exit"
95805       goto Errorlocked2exitretry
95810    else if LWRC$(RETRYPOINT$) = "timeout1" then ! #Case# "timeout1"
95815       goto Timeout1retry
95820    else if LWRC$(RETRYPOINT$) = "timeout2" then ! #Case# "timeout2"
95825       goto Timeout2retry
95830    end if                             !#End Select#
95835    retry                              !Fall through at least try regular retry
95840 ! 
95845 Continuespecial: ! Our special version of the Continue command
95850    if LWRC$(RETRYPOINT$) = "errorlocked1" then ! #Select# lwrc$(RetryPoint$) #Case# "errorlocked1"
95855       goto Errorlocked1continue
95860    else if LWRC$(RETRYPOINT$) = "errorlocked2" then ! #Case# "errorlocked2"
95865       goto Errorlocked2continue
95870    else if LWRC$(RETRYPOINT$) = "errorlocked3" then ! #Case# "errorlocked3"
95875       goto Errorlocked3continue
95880    else if LWRC$(RETRYPOINT$) = "errorlocked4" then ! #Case# "errorlocked4"
95885       goto Errorlocked4continue
95890    else if LWRC$(RETRYPOINT$) = "errorlocked1exit" then ! #Case# "errorlocked1exit"
95895       goto Errorlocked1exitcontinue
95900    else if LWRC$(RETRYPOINT$) = "errorlocked2exit" then ! #Case# "errorlocked2exit"
95905       goto Errorlocked2exitcontinue
95910    else if LWRC$(RETRYPOINT$) = "timeout1" then ! #Case# "timeout1"
95915       goto Timeout1continue
95920    else if LWRC$(RETRYPOINT$) = "timeout2" then ! #Case# "timeout2"
95925       goto Timeout2continue
95930    end if                             !#End Select#
95935    continue                           !Fall through at least try regular continue
95940 ! 
99000 ! #Autonumber# 99000,10
99010 Open: ! ***** Function To Call Library Openfile And Proc Subs
99020    def FNOPEN(FILENAME$*255, MAT F$, MAT F, MAT FORM$; INPUTONLY, KEYNUM, DONT_SORT_SUBS, PATH$*255, MAT DESCR$, MAT FIELD_WIDTHS,SUPRESS_PROMPT,IGNORE_ERRORS,SUPPRESS_LOG,MAT DATEFMT$,___,INDEX)
99030       dim _FILEIOSUBS$(1)*800, _LOADEDSUBS$(1)*80
99040       let FNOPEN=FNOPENFILE(FILENAME$, MAT F$, MAT F, MAT FORM$, INPUTONLY, KEYNUM, DONT_SORT_SUBS, PATH$, MAT DESCR$, MAT FIELD_WIDTHS, MAT _FILEIOSUBS$, SUPRESS_PROMPT,IGNORE_ERRORS,PROGRAM$,SUPPRESS_LOG,MAT DATEFMT$)
99050       if SRCH(_LOADEDSUBS$,UPRC$(FILENAME$))<=0 then : mat _LOADEDSUBS$(UDIM(_LOADEDSUBS$)+1) : let _LOADEDSUBS$(UDIM(_LOADEDSUBS$))=UPRC$(FILENAME$) : for INDEX=1 to UDIM(MAT _FILEIOSUBS$) : execute (_FILEIOSUBS$(INDEX)) : next INDEX
99060    fnend 
99070 ! 
99080 ! 
99500 ! #Autonumber# 99500,10
99510 Ignore: continue 
99520 ! 
99530 Retryfivetimes: ! 
99540    let RETRYFIVETIMES+=1
99550    if RETRYFIVETIMES<10 then retry 
99560    continue 
99570 ! 
99580    dim RETRYACTION
99590    dim TRYTOCONTINUE
99600 Errorfileislocked: ! Ask The User To Retry Or Abort
99610    let RETRYACTION=FNRETRYLOCKEDERROR(KEY$,FDATAFILE,1)
99620    if RETRYACTION=1 then 
99630       goto Retryspecial
99640    else if RETRYACTION=2 then 
99650       let TRYTOCONTINUE=1
99660    else 
99670       let EXITMODE=1
99680       goto Continuespecial
99690    end if 
99700 ! 
99710 Errorfilelockedonexit: ! Ask The User To Retry Or Abort
99720    if FNRETRYLOCKEDERROR(KEY$,FDATAFILE) then 
99730       goto Retryspecial
99740    else 
99750       let EXITMODE=0                  !Cancel the exit
99760       goto Continuespecial
99770    end if 
99780 ! 
99790 Timeouterror: ! A Timeout Has Occured
99800    if FNRETRYTIMEOUTERROR then 
99810       goto Retryspecial
99820    else 
99830       let EXITMODE=1
99840       goto Continuespecial
99850    end if 
