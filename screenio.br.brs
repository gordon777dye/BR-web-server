61222                if GENERATE then 
61224 ! 
61226                   let FNREADSCREEN("",MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)  !Init Blank Screen
61228                   let FNGENERATEHEADER(GS_DATA$(GS_NAMEADDEDIT),GS_DATA$(GS_LAYOUT),MAT SCREENIO$,MAT SCREENIO,1)
61230                   mat GAPS=(0)
61232                   let TITLEFIELD=FNADDATITLE(GS_DATA$(GS_LAYOUT),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO,1)
61234                   let FNSKIPAGAP
61236 ! 
61238 ! .              ! Add a bunch of edit fields
61240                   for INDEX=1 to UDIM(MAT GS_FIELD$)
61242                      let NEWFIELD=FNADDANDCOLORCURRENTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO,GS_FIELD$(INDEX),GS_FIELDDESC$(INDEX),GS_FIELDSPEC$(INDEX),GS_DATESPEC$(INDEX))
61244                   next INDEX
61246 ! 
61248 ! .              ! Shrink title to match width of widest control
61250                   let RIGHTEDGE=0
61252                   for INDEX=1 to UDIM(MAT HPOSITION)
61254                      if INDEX><TITLEFIELD then 
61256                         let RIGHTEDGE=MAX(RIGHTEDGE,HPOSITION(INDEX)+WIDTH(INDEX)-1)
61258                      end if 
61260                   next INDEX
61262                   let WIDTH(TITLEFIELD)=RIGHTEDGE-8
61264 ! 
61266 ! .              ! Resize Screen
61268                   let FNRESIZESCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
61270 ! 
