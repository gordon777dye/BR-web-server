33970          let FNADDOASPEC("Protected:",-1*SF_PROTECTED,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33972          let FNADDOASPEC("Invisible:",-1*SF_INVISIBLE,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33974          let FNADDOASPEC("MultiSelect:",-1*SF_MULTISELECT,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33976          if FN42 then 
33978             let FNADDOASPEC("Gridlines:",-1*SF_GRIDLINES,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33980          end if 
33982 ! 
33984       else if TRIM$(LWRC$(TYPE$)) = "frame" then ! #Case#  "frame"
33986          let FNADDOASPEC("Border:",-1*SF_GRIDLINES,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,0,"Border (mat GridLines) - Put a border on the frame.")
33988          let FNADDOASPEC("Name:",SF_CONTROLNAME,50,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33990          let FNADDOASPEC("Caption:",SF_DESCRIPTION,60,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,0,"Caption (mat Description$) - Caption for the frame's Border.")
33992          let FNADDOASPEC("Picture File:",SF_PICTURE,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,0,"Picture (mat Picture$) - Picture to use for background of frame. Use this feature to place controls on top of pictures.")
33994          let FNADDOASPEC("Foreground Color:",SF_FGCOLOR,6,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33996          let FNADDOASPEC("Background Color:",SF_BGCOLOR,6,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33998          let FNADDOASPEC("Color Attr:",SF_ATTR,128,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,0,"Color Attributes (mat Attr$) - Color Attributes for the frame.")
34000          let FNADDOASPEC("User Data:",SF_USERDATA,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34002          let FNADDOASPEC("Invisible:",-1*SF_INVISIBLE,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34004 ! .       !
34006       else if TRIM$(LWRC$(TYPE$)) = "screen" then ! #Case# "screen"
34008          let FNADDOASPEC("Name:",SF_CONTROLNAME,50,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34010          let FNADDOASPEC("Screen:",SF_FIELDNAME,18,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,1,"Screen (mat FieldName$) - Select the target screen here.")
34012          let FNADDOASPEC("Function:",SF_FUNCTION,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,0,"Function (mat Function$) - Use this field to specify any values that need to be passed into the child screen. Example: ""ParentKey$=CurrentKey$"".")
34014          let FNADDOASPEC("User Data:",SF_USERDATA,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34016          let FNADDOASPEC("Protected:",-1*SF_PROTECTED,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34018          let FNADDOASPEC("Invisible:",-1*SF_INVISIBLE,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34020 ! 
34022       else if TRIM$(LWRC$(TYPE$)) = "combo" then ! #Case#  "combo"
34024          let FNADDOASPEC("Name:",SF_CONTROLNAME,50,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34026          let FNADDOASPEC("Field:",SF_FIELDNAME,50,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34028          let FNADDOASPEC("Data Width:",-1*SF_SPECWIDTH,3,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34030          let FNADDOASPEC("Caption Field:",SF_DESCRIPTION,60,MAT OAS_CAPTIONSPEC$, MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34032          let FNADDOASPEC("Attributes:",SF_ATTR,128,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34034          let FNADDOASPEC("Populate:",SF_FUNCTION,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,0,"Populate Function (mat Function$) - Populate and Validate event function. This function will be run when ScreenIO tries to populate the combo box, and any data placed in an array called mat ReturnData$ will be put in the combo box.")
34036          let FNADDOASPEC("Foreground Color:",SF_FGCOLOR,6,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34038          let FNADDOASPEC("Background Color:",SF_BGCOLOR,6,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34040          let FNADDOASPEC("Tooltip Text:",SF_TOOLTIP,1000,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34042          let FNADDOASPEC("Conversion:",SF_CNVRTIN,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34044          let FNADDOASPEC("User Data:",SF_USERDATA,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34046          let FNADDOASPEC("Protected:",-1*SF_PROTECTED,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34048          let FNADDOASPEC("Invisible:",-1*SF_INVISIBLE,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
34050          if FN42 then 
34052             let FNADDOASPEC("Select Only:",-1*SF_GRIDLINES,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS,0,"Select Only (mat GridLines) - Select this to make a Selection Box instead of a Combo Box.")
34054          end if 
34056       end if                          !#End Select#
34058    fnend 
34060 ! 
34062 Resetoaspecs: ! Reset Oa Specs
34064    def FNRESETOASPECS(MAT CSPEC$,MAT CDATA$,MAT SPEC$,MAT DAT$,MAT TTIP$,MAT SUBS,MAT BUTTONS)
34066 ! 
34068       mat CSPEC$(0)
34070       mat CDATA$(0)
34072       mat SPEC$(0)
34074       mat DAT$(0)
34076       mat TTIP$(0)
34078       mat SUBS(O)
34080       mat BUTTONS(0)
34082 ! 
34084    fnend 
34086 ! 
34088    def FNDEFAULTTOOLTIP$*255(SUB)
34090       if SUB = SF_CONTROLNAME then ! #Select# Sub #Case# Sf_ControlName
34092          let FNDEFAULTTOOLTIP$="Control Name (mat ControlName$) - Use to reference control in code, example: let Invisible(ctl_ControlName)=0"
34094       else if SUB = SF_FIELDNAME then ! #Case# Sf_FieldName
34096          let FNDEFAULTTOOLTIP$="Field Name (mat FieldName$) - Name of the field in the data file for when control is tied directly to data file."
34098       else if SUB = -1*SF_SPECWIDTH then ! #Case# -1*Sf_SpecWidth
34100          let FNDEFAULTTOOLTIP$="Spec Width (mat SpecWidth) - Maximum allowed width for the data. The user will be stopped from typing more characters then this."
34102       else if SUB = SF_DESCRIPTION then ! #Case# Sf_Description
34104          let FNDEFAULTTOOLTIP$="Description (mat Description$) - Control Name of the control that is the caption for this control. The specified control's movement will be tied to this control, to make screen design more convenient."
34106       else if SUB = SF_ATTR then ! #Case# Sf_Attr
34108          let FNDEFAULTTOOLTIP$="Attribute (mat Attr$) - Business Rules Control Attributes for the control. This can be references to attributes defined in your brconfig.sys file, or hardcoded control attributes."
34110       else if SUB = SF_FUNCTION then ! #Case# Sf_Function
34112          let FNDEFAULTTOOLTIP$="Function (mat Function$) - Validation function for the control. The selected function will be run any time the data in this control changes. This can be used to update related fields on the screen."
34114       else if SUB = SF_FGCOLOR then ! #Case# sf_fgcolor
34116          let FNDEFAULTTOOLTIP$="Foreground Color (mat FgColor$) - Click to select the Foreground Color for the control."
34118       else if SUB = SF_BGCOLOR then ! #Case# sf_bgcolor
34120          let FNDEFAULTTOOLTIP$="Background Color (mat BgColor$) - Click to select the Background Color for the control."
34122       else if SUB = SF_JUSTIFY then ! #Case# Sf_Justify
34124          let FNDEFAULTTOOLTIP$="Justification Spec (mat Justify$) - Business Rules Justification Spec: C=Center, R=Right, L=Lowercase and U=Uppercase."
34126       else if SUB = SF_TOOLTIP then ! #Case# Sf_Tooltip
34128          let FNDEFAULTTOOLTIP$="Tooltip Text (mat Tooltip$) - Help text to be shown when the user hovers the mouse over this control."
34130       else if SUB = SF_CNVRTIN then ! #Case# Sf_CnvrtIn
34132          let FNDEFAULTTOOLTIP$="Conversion Spec (mat CnvrtIn$) - ScreenIO Conversion Spec, choose from any valid FMT(, PIC( or DATE( spec."
34134       else if SUB = SF_CNVRTOUT then ! #Case# Sf_CnvrtOut
34136          let FNDEFAULTTOOLTIP$="Disk Date Format (mat CnvrtOut$) - Use this field in conjunction with the Conversion field, to unpack a date field that is stored on disk like DATE(YYMMDD), in order to enable ScreenIO's Date Processing for dates that aren't Julian."
34138       else if SUB = SF_USERDATA then ! #Case# Sf_UserData
34140          let FNDEFAULTTOOLTIP$="UserData (mat UserData$) - Whatever typed here will be available in an array called Mat UserData$ that can be examined by your functions. To access this value in a function, use UserData$(ControlIndex). This value is not used by ScreenIO."
34142       else if SUB = -1*SF_PROTECTED then ! #Case# -1*Sf_Protected
34144          let FNDEFAULTTOOLTIP$="Protected (mat Protected) - If this is checked, the control will be kept out of the input fields statement and will be read only to the user."
34146       else if SUB = -1*SF_INVISIBLE then ! #Case# -1*Sf_Invisible
34148          let FNDEFAULTTOOLTIP$="Invisible (mat Invisible) - If this is checked, the control will be kept off the screen, making it invisible to the user."
34150       else if SUB = SF_PARENT then ! #Case# Sf_Parent
34152          let FNDEFAULTTOOLTIP$="Parent Control (mat Parent$) - Click this button to tie the filter/search box to a listview. Should be done automatically if you added the listview first."
34154       else if SUB = SF_TRUEVALUE then ! #Case# Sf_TrueValue
34156          let FNDEFAULTTOOLTIP$="True Value (mat TrueValue$) - The value to save in the data if the box is checked. (Used when reading too.)"
34158       else if SUB = SF_FALSEVALUE then ! #Case# Sf_FalseValue
34160          let FNDEFAULTTOOLTIP$="False Value (mat FalseValue$) - The value to save in the data if the box is unchecked. (Used when reading too.)"
34162       else if SUB = -1*SF_GRIDLINES then ! #Case# -1*Sf_GridLines
34164          let FNDEFAULTTOOLTIP$="Grid Lines (mat GridLines) - Draw Gridlines to make a listview look like a grid."
34166       else if SUB = -1*SF_MULTISELECT then ! #Case# -1*Sf_MultiSelect
34168          let FNDEFAULTTOOLTIP$="Multiselect (mat Multiselect) - Check this checkbox to make a multiselect listview. Use mat SelectedKeys$ in your functions to see which records are selected."
34170       end if                          !#End Select#
34172    fnend 
34174 ! 
34176 ! 
34178 Addoaspec: ! Add A Spec
34180    def FNADDOASPEC(CAPTION$*30,SUB,WIDTH,MAT CSPEC$,MAT CDATA$,MAT SPEC$,MAT DAT$, MAT TTIP$,MAT SUBS, MAT BUTTONS;FORCEBUTTON,TOOLTIP$*255,___,INDEX)
34182 ! 
34184       let INDEX=UDIM(MAT CSPEC$)+1
34186       mat CSPEC$(INDEX)
34188       mat CDATA$(INDEX)
34190       mat SPEC$(INDEX)
34192       mat DAT$(INDEX)
34194       mat TTIP$(INDEX)
34196       mat SUBS(INDEX)
34198       mat BUTTONS(INDEX)
34200 ! 
34202       if TOOLTIP$="" then 
34204          let TOOLTIP$=FNDEFAULTTOOLTIP$(SUB)
34206       end if 
34208 ! 
34210       let FNFIXTOOLTIPS(TOOLTIP$)
34212 ! 
34214       let CSPEC$(INDEX)=STR$(INDEX)&",1,"&STR$(INT(LEN(CAPTION$)*4/5)+2)&"/CL "&STR$(LEN(CAPTION$))
34216       let CDATA$(INDEX)=CAPTION$
34218       let TTIP$(INDEX)=TOOLTIP$
34220       let SUBS(INDEX)=SUB
34222       let BUTTONS(INDEX)=0
34224 ! 
34226       if SUB = SF_FGCOLOR OR SUB = SF_BGCOLOR OR SUB = SF_PARENT then ! #Select# Sub #Case# Sf_Fgcolor # Sf_Bgcolor # Sf_Parent
34228          let SPEC$(INDEX)=STR$(INDEX)&","&STR$(INT(LEN(CAPTION$)*4/5)+4)&","&STR$(MIN(32-(INT(LEN(CAPTION$)*4/5)+2),WIDTH+3))&"/CC "&STR$(WIDTH)&",/W:W,B"&STR$(1000+INDEX)
34230          let BUTTONS(INDEX)=1
34232 ! 
34234       else if SUB = SF_JUSTIFY then ! #Case# Sf_Justify
34236          let SPEC$(INDEX)=STR$(INDEX)&","&STR$(INT(LEN(CAPTION$)*4/5)+3)&","&STR$(MIN(32-(INT(LEN(CAPTION$)*4/5)+2),WIDTH+3))&"/COMBO "&STR$(WIDTH)&",/W:#FFFF77"
34238 ! 
34240       else if SUB = SF_FUNCTION OR SUB = SF_CNVRTIN OR SUB = SF_CNVRTOUT OR SUB = SF_PICTURE then ! #Case# Sf_Function # Sf_Cnvrtin # Sf_Cnvrtout # Sf_Picture
34242          let SPEC$(INDEX)=STR$(INDEX)&","&STR$(INT(LEN(CAPTION$)*4/5)+3)&","&STR$(32-(INT(LEN(CAPTION$)*4/5)+8))&"/V "&STR$(WIDTH)&",S/W:#FFFF77"
34244 ! 
34246       else if SUB = -1*SF_PROTECTED OR SUB = -1*SF_INVISIBLE OR SUB = -1*SF_MULTISELECT OR SUB = -1*SF_GRIDLINES then ! #Case# -1*Sf_Protected # -1*Sf_Invisible # -1*Sf_Multiselect # -1*Sf_GridLines
34248          let SPEC$(INDEX)=STR$(INDEX)&","&STR$(INT(LEN(CAPTION$)*4/5)+3)&","&STR$(32-(INT(LEN(CAPTION$)*4/5)+2))&"/CHECK "&STR$(WIDTH)
34250 ! 
34252       else ! #Case Else#
34254          let SPEC$(INDEX)=STR$(INDEX)&","&STR$(INT(LEN(CAPTION$)*4/5)+3)&","&STR$(32-(INT(LEN(CAPTION$)*4/5)+2))&"/V "&STR$(WIDTH)&",S/W:#FFFF77"
34256 ! 
34258          if FORCEBUTTON then 
34260             let SPEC$(INDEX)=STR$(INDEX)&","&STR$(INT(LEN(CAPTION$)*4/5)+4)&","&STR$(30-(INT(LEN(CAPTION$)*4/5)+2))&"/CC "&STR$(WIDTH)&",/W:W,B"&STR$(1000+INDEX)
34262             let BUTTONS(INDEX)=1
34264          end if 
34266 ! 
34268       end if                          !#End Select#
34270 ! 
34272    fnend 
34274 ! 
34276 Objecttoscreen: ! Put Object Data Into Input Data Based On Type
34278    def FNOBJECTTOSCREEN(CONTROL,MAT OAS_SUBS,MAT OAS_DATA$,MAT OAS_SPEC$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX)
34280       for INDEX=1 to UDIM(MAT OAS_SUBS)
34282          if OAS_SUBS(INDEX) = SF_CONTROLNAME then ! #Select# Oas_Subs(Index)   #Case# Sf_Controlname
34284             let OAS_DATA$(INDEX)=CONTROLNAME$(CONTROL)
34286 ! 
34288          else if OAS_SUBS(INDEX) = SF_FIELDNAME then ! #Case# Sf_Fieldname
34290             let OAS_DATA$(INDEX)=FIELDNAME$(CONTROL)
34292 ! 
34294          else if OAS_SUBS(INDEX) = SF_DESCRIPTION then ! #Case# Sf_Description
34296             let OAS_DATA$(INDEX)=DESCRIPTION$(CONTROL)
34298 ! 
34300          else if OAS_SUBS(INDEX) = -1*SF_SPECWIDTH then ! #Case# -1*Sf_Specwidth
34302             let OAS_DATA$(INDEX)=STR$(SPECWIDTH(CONTROL))
34304 ! 
34306          else if OAS_SUBS(INDEX) = SF_TRUEVALUE then ! #Case# Sf_Truevalue
34308             let OAS_DATA$(INDEX)=TRUEVALUE$(CONTROL)
34310 ! 
34312          else if OAS_SUBS(INDEX) = SF_FALSEVALUE then ! #Case# Sf_Falsevalue
34314             let OAS_DATA$(INDEX)=FALSEVALUE$(CONTROL)
34316 ! 
34318          else if OAS_SUBS(INDEX) = SF_FUNCTION then ! #Case# Sf_Function
34320             let OAS_DATA$(INDEX)=FUNCTION$(CONTROL)
34322 ! 
34324          else if OAS_SUBS(INDEX) = SF_PICTURE then ! #Case# Sf_Picture
34326             let OAS_DATA$(INDEX)=PICTURE$(CONTROL)
34328 ! 
34330          else if OAS_SUBS(INDEX) = SF_FGCOLOR then ! #Case# Sf_Fgcolor
34332             let OAS_DATA$(INDEX)=FGCOLOR$(CONTROL)
34334             let FNADJUSTSPECCOLOR(OAS_SPEC$(INDEX),OAS_DATA$(INDEX))
34336 ! 
34338          else if OAS_SUBS(INDEX) = SF_BGCOLOR then ! #Case# Sf_Bgcolor
34340             let OAS_DATA$(INDEX)=BGCOLOR$(CONTROL)
34342             let FNADJUSTSPECCOLOR(OAS_SPEC$(INDEX),OAS_DATA$(INDEX))
34344 ! 
34346          else if OAS_SUBS(INDEX) = SF_JUSTIFY then ! #Case# Sf_Justify
34348             let OAS_DATA$(INDEX)="C"&JUSTIFY$(CONTROL)
34350 ! 
34352          else if OAS_SUBS(INDEX) = SF_PARENT then ! #Case# Sf_Parent
34354             let OAS_DATA$(INDEX)=PARENT$(CONTROL)
34356 ! 
34358          else if OAS_SUBS(INDEX) = SF_ATTR then ! #Case# Sf_Attr
34360             let OAS_DATA$(INDEX)=ATTR$(CONTROL)
34362 ! 
34364          else if OAS_SUBS(INDEX) = -1*SF_PROTECTED then ! #Case# -1*Sf_Protected
34366             if PROTECTED(CONTROL) then 
34368                let OAS_DATA$(INDEX)="^"
34370             else 
34372                let OAS_DATA$(INDEX)=""
34374             end if 
34376 ! 
34378          else if OAS_SUBS(INDEX) = -1*SF_INVISIBLE then ! #Case# -1*Sf_Invisible
34380             if INVISIBLE(CONTROL) then 
34382                let OAS_DATA$(INDEX)="^"
34384             else 
34386                let OAS_DATA$(INDEX)=""
34388             end if 
34390 ! 
34392          else if OAS_SUBS(INDEX) = SF_TOOLTIP then ! #Case# Sf_Tooltip
34394             let OAS_DATA$(INDEX)=TOOLTIP$(CONTROL)
34396 ! 
34398          else if OAS_SUBS(INDEX) = SF_CNVRTIN then ! #Case# Sf_Cnvrtin
34400             let OAS_DATA$(INDEX)=CNVRTIN$(CONTROL)
34402 ! 
34404          else if OAS_SUBS(INDEX) = SF_CNVRTOUT then ! #Case# Sf_Cnvrtout
34406             let OAS_DATA$(INDEX)=CNVRTOUT$(CONTROL)
34408 ! 
34410          else if OAS_SUBS(INDEX) = -1*SF_MULTISELECT then ! #Case# -1*Sf_Multiselect
34412             if MULTISELECT(CONTROL) then 
34414                let OAS_DATA$(INDEX)="^"
34416             else 
34418                let OAS_DATA$(INDEX)=""
34420             end if 
34422 ! 
34424          else if OAS_SUBS(INDEX) = -1*SF_GRIDLINES then ! #Case# -1*Sf_GridLines
34426             if GRIDLINES(CONTROL) then 
34428                let OAS_DATA$(INDEX)="^"
34430             else 
34432                let OAS_DATA$(INDEX)=""
34434             end if 
34436 ! 
34438          else if OAS_SUBS(INDEX) = SF_USERDATA then ! #Case# Sf_Userdata
34440             let OAS_DATA$(INDEX)=USERDATA$(CONTROL)
34442 ! 
34444          end if                       !#End Select#
34446       next INDEX
34448    fnend 
34450 ! 
34452 Screentoobject: !  Put Input Data Back In  The Objects
34454    def FNSCREENTOOBJECT(CONTROL,MAT OAS_SUBS,MAT OAS_DATA$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,TEMPWIDTH,CHOICE,ASKEDALREADY,TEMP)
34456 ! 
34458       for INDEX=1 to UDIM(MAT OAS_SUBS)
34460          if OAS_SUBS(INDEX) = SF_CONTROLNAME then ! #Select# Oas_Subs(Index)   #Case#    Sf_Controlname
34462             let FNSAVETOARRAY$(CONTROL,MAT CONTROLNAME$,SREP$(TRIM$(OAS_DATA$(INDEX))," ","_"))
34464 ! 
34466          else if OAS_SUBS(INDEX) = SF_FIELDNAME then ! #Case# Sf_Fieldname
34468             let FNSAVETOARRAY$(CONTROL,MAT FIELDNAME$,OAS_DATA$(INDEX))
34470 ! 
34472          else if OAS_SUBS(INDEX) = -1*SF_SPECWIDTH then ! #Case# -1*Sf_Specwidth
34474             let TEMPWIDTH=-999
34476             let TEMPWIDTH = VAL(OAS_DATA$(INDEX)) conv IGNORE
34478             if TEMPWIDTH>-999 then 
34480                if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="listview" then 
34482                   let TEMP=TEMPWIDTH
34484                else 
34486                   let TEMP=MAX(TEMPWIDTH,1)
34488                end if 
34490                let FNSAVETOARRAY(CONTROL,MAT SPECWIDTH,TEMP)
34492             end if 
34494 ! 
34496          else if OAS_SUBS(INDEX) = SF_DESCRIPTION then ! #Case# Sf_Description
34498             let FNSAVETOARRAY$(CONTROL,MAT DESCRIPTION$,OAS_DATA$(INDEX))
34500 ! 
34502          else if OAS_SUBS(INDEX) = SF_TRUEVALUE then ! #Case# Sf_Truevalue
34504             let FNSAVETOARRAY$(CONTROL,MAT TRUEVALUE$,OAS_DATA$(INDEX))
34506 ! 
34508          else if OAS_SUBS(INDEX) = SF_FALSEVALUE then ! #Case# Sf_Falsevalue
34510             let FNSAVETOARRAY$(CONTROL,MAT FALSEVALUE$,OAS_DATA$(INDEX))
34512 ! 
34514          else if OAS_SUBS(INDEX) = SF_FUNCTION then ! #Case# Sf_Function
34516             let FNSAVETOARRAY$(CONTROL,MAT FUNCTION$,OAS_DATA$(INDEX))
34518 ! 
34520          else if OAS_SUBS(INDEX) = SF_PICTURE then ! #Case# Sf_Picture
34522             if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="filter" then 
34524                let FNCLEANFILTER(OAS_DATA$(INDEX))
34526             end if 
34528             let FNSAVETOARRAY$(CONTROL,MAT PICTURE$,OAS_DATA$(INDEX))
34530 ! 
34532          else if OAS_SUBS(INDEX) = SF_FGCOLOR then ! #Case# Sf_Fgcolor
34534             if TRIM$(OAS_DATA$(INDEX))="" OR FNVALIDHEXCOLOR(OAS_DATA$(INDEX)) then 
34536                let FNSAVETOARRAY$(CONTROL,MAT FGCOLOR$,OAS_DATA$(INDEX))
34538             end if 
34540 ! 
34542          else if OAS_SUBS(INDEX) = SF_BGCOLOR then ! #Case# Sf_Bgcolor
34544             if TRIM$(OAS_DATA$(INDEX))="" OR FNVALIDHEXCOLOR(OAS_DATA$(INDEX)) then 
34546                let FNSAVETOARRAY$(CONTROL,MAT BGCOLOR$,OAS_DATA$(INDEX))
34548             end if 
34550 ! 
34552          else if OAS_SUBS(INDEX) = SF_JUSTIFY then ! #Case# Sf_Justify
34554             if FNVALIDJUSTIFY(OAS_DATA$(INDEX)) then 
34556                let FNSAVETOARRAY$(CONTROL,MAT JUSTIFY$,TRIM$(OAS_DATA$(INDEX)(2:2)))
34558             end if 
34560 ! 
34562          else if OAS_SUBS(INDEX) = SF_PARENT then ! #Case# Sf_Parent
34564             if FNFINDTARGET(OAS_DATA$(INDEX),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
34566                let FNSAVETOARRAY$(CONTROL,MAT PARENT$,OAS_DATA$(INDEX))
34568             end if 
34570 ! 
34572          else if OAS_SUBS(INDEX) = SF_ATTR then ! #Case# Sf_Attr
34574             let FNSAVETOARRAY$(CONTROL,MAT ATTR$,OAS_DATA$(INDEX))
34576 ! 
34578          else if OAS_SUBS(INDEX) = -1*SF_PROTECTED then ! #Case# -1*Sf_Protected
34580             if OAS_DATA$(INDEX)(1:1)="^" then 
34582                let TEMP=1
34584             else 
34586                let TEMP=0
34588             end if 
34590             let FNSAVETOARRAY(CONTROL,MAT PROTECTED,TEMP)
34592 ! 
34594          else if OAS_SUBS(INDEX) = -1*SF_INVISIBLE then ! #Case# -1*Sf_Invisible
34596             if OAS_DATA$(INDEX)(1:1)="^" then 
34598                let TEMP=1
34600             else 
34602                let TEMP=0
34604             end if 
34606             let FNSAVETOARRAY(CONTROL,MAT INVISIBLE,TEMP)
34608 ! 
34610          else if OAS_SUBS(INDEX) = SF_TOOLTIP then ! #Case# Sf_Tooltip
34612             let FNSAVETOARRAY$(CONTROL,MAT TOOLTIP$,OAS_DATA$(INDEX))
34614 ! 
34616          else if OAS_SUBS(INDEX) = SF_CNVRTIN then ! #Case# Sf_Cnvrtin
34618             let OAS_DATA$(INDEX)=FNFIXDATESPEC$(OAS_DATA$(INDEX))
34620             let FNSAVETOARRAY$(CONTROL,MAT CNVRTIN$,OAS_DATA$(INDEX))
34622 ! 
34624          else if OAS_SUBS(INDEX) = SF_CNVRTOUT then ! #Case# Sf_Cnvrtout
34626             let OAS_DATA$(INDEX)=FNFIXDATESPEC$(OAS_DATA$(INDEX))
34628             let FNSAVETOARRAY$(CONTROL,MAT CNVRTOUT$,OAS_DATA$(INDEX))
34630 ! 
34632          else if OAS_SUBS(INDEX) = -1*SF_MULTISELECT then ! #Case# -1*Sf_Multiselect
34634             if OAS_DATA$(INDEX)(1:1)="^" then let TEMP=1 else let TEMP=0
34636             let FNSAVETOARRAY(CONTROL,MAT MULTISELECT,TEMP)
34638 ! 
34640          else if OAS_SUBS(INDEX) = -1*SF_GRIDLINES then ! #Case# -1*Sf_GridLines
34642             if OAS_DATA$(INDEX)(1:1)="^" then let TEMP=1 else let TEMP=0
34644             let FNSAVETOARRAY(CONTROL,MAT GRIDLINES,TEMP)
34646 ! 
34648          else if OAS_SUBS(INDEX) = SF_USERDATA then ! #Case# Sf_Userdata
34650             let FNSAVETOARRAY$(CONTROL,MAT USERDATA$,OAS_DATA$(INDEX))
34652 ! 
34654          end if                       !#End Select#
34656       next INDEX
34658    fnend 
34660 ! 
34662    def FNFIXDATESPEC$*255(DATESPEC$*255;___,P)
34664       let P=POS(UPRC$(DATESPEC$),"DATE$(")
34666       if P>0 then 
34668          let DATESPEC$(P+4:P+5)="("   !Remove $ if its there after a date$ thing
34670       end if 
34672       let FNFIXDATESPEC$=DATESPEC$
34674    fnend 
34676 ! 
34678    def FNSAVETOARRAY$(CONTROL,MAT ARRAY$,VALUE$*1000;___,INDEX)
34680       if TRIM$(VALUE$)<>TRIM$(ARRAY$(CONTROL)) then 
34682          let ARRAY$(CONTROL)=VALUE$
34684          if UDIM(MAT SELECTEDCONTROLS)>=CONTROL AND SELECTEDCONTROLS(CONTROL) then 
34686             if ~ASKEDALREADY then 
34688                let CHOICE=MSGBOX("Would you like to copy the changes to all selected controls?","Change Many?","yN","QST")
34690                let ASKEDALREADY=1
34692             end if 
34694             if CHOICE=2 then 
34696                for INDEX=1 to UDIM(MAT SELECTEDCONTROLS)
34698                   if SELECTEDCONTROLS(INDEX) then 
34700                      let ARRAY$(INDEX)=VALUE$
34702                   end if 
34704                next INDEX
34706             end if 
34708          end if 
34710       end if 
34712    fnend 
34714    def FNSAVETOARRAY(CONTROL,MAT ARRAY,VALUE;___,INDEX)
34716       if VALUE<>ARRAY(CONTROL) then 
34718          let ARRAY(CONTROL)=VALUE
34720          if UDIM(MAT SELECTEDCONTROLS)>=CONTROL AND SELECTEDCONTROLS(CONTROL) then 
34722             if ~ASKEDALREADY then 
34724                let CHOICE=MSGBOX("Would you like to copy the changes to all selected controls?","Change Many?","yN","QST")
34726                let ASKEDALREADY=1
34728             end if 
34730             if CHOICE=2 then 
34732                for INDEX=1 to UDIM(MAT SELECTEDCONTROLS)
34734                   if SELECTEDCONTROLS(INDEX) then 
34736                      let ARRAY(INDEX)=VALUE
34738                   end if 
34740                next INDEX
34742             end if 
34744          end if 
34746       end if 
34748    fnend 
34750 ! 
34752    dim JUSTIFYOPTIONS$(1)
34754 Validjustify: ! Validates The Justification Selection
34756    def FNVALIDJUSTIFY(JUSTIFY$)
34758       if SRCH(MAT JUSTIFYOPTIONS$,TRIM$(JUSTIFY$))>0 then let FNVALIDJUSTIFY=1
34760    fnend 
34762 ! 
34764 Findtarget: ! 
34766    def FNFINDTARGET(PARENT$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX)
34768       for INDEX=1 to UDIM(MAT FIELDTYPE$)
34770          if FIELDTYPE$(INDEX)="LISTVIEW" AND PARENT$(INDEX)=PARENT$ then 
34772             let FNFINDTARGET=INDEX
34774          end if 
34776       next INDEX
34778    fnend 
34780 ! 
34782 Populatejustify: ! Populate The Justification Textbox
34784    def FNPOPULATEJUSTIFY(SPEC$*40,WINDOW)
34786       mat JUSTIFYOPTIONS$(5)
34788       let JUSTIFYOPTIONS$(1)="C" !:
            let JUSTIFYOPTIONS$(2)="CC" !:
            let JUSTIFYOPTIONS$(3)="CR" !:
            let JUSTIFYOPTIONS$(4)="CU" !:
            let JUSTIFYOPTIONS$(5)="CL"
34790 ! 
34792       print #WINDOW, fields SPEC$(1:POS(SPEC$,",",-1))&"=" : MAT JUSTIFYOPTIONS$
34794    fnend 
34796 ! 
34798    def FNFIXALLCHILDSCREENSIZE(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX)
34800       for INDEX=1 to UDIM(MAT FIELDTYPE$)
34802          if LWRC$(TRIM$(FIELDTYPE$(INDEX))) = "screen" then ! #Select# lwrc$(trim$(FieldType$(Index))) #Case# "screen"
34804             let FNREADCHILDSCREENSIZE(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
34806          end if                       !#End Select#
34808       next INDEX
34810    fnend 
34812 ! 
34814    def FNREADCHILDSCREENSIZE(INDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,BORDERSIZE,SCREENATTR$*255)
34816       let WIDTH(INDEX)=FNREADUNOPENEDNUMBER("screenio",TRIM$(FIELDNAME$(INDEX)),SI_HSIZE)
34818       let HEIGHT(INDEX)=FNREADUNOPENEDNUMBER("screenio",TRIM$(FIELDNAME$(INDEX)),SI_VSIZE)
34820       let GRIDLINES(INDEX)=FNREADUNOPENEDNUMBER("screenio",TRIM$(FIELDNAME$(INDEX)),SI_BORDER)
34822       let SCREENATTR$=FNREADUNOPENEDDESCRIPTION$("screenio",TRIM$(FIELDNAME$(INDEX)),SI_ATTRIBUTES)
34824 ! 
34826       if POS(LWRC$(TRIM$(SCREENATTR$)),"border") then let GRIDLINES(INDEX)=1
34828 ! 
34830       if GRIDLINES(INDEX) then let BORDERSIZE=2
34832 ! 
34834       if WIDTH(INDEX)+BORDERSIZE>SCREENIO(SI_HSIZE) then let SCREENIO(SI_HSIZE)=WIDTH(INDEX)+BORDERSIZE
34836       if HEIGHT(INDEX)+BORDERSIZE>SCREENIO(SI_VSIZE) then let SCREENIO(SI_VSIZE)=HEIGHT(INDEX)+BORDERSIZE
34838       let VPOSITION(INDEX)=MIN(VPOSITION(INDEX),SCREENIO(SI_VSIZE)-HEIGHT(INDEX)+1-(BORDERSIZE/2))
34840       let HPOSITION(INDEX)=MIN(HPOSITION(INDEX),SCREENIO(SI_HSIZE)-WIDTH(INDEX)+1-(BORDERSIZE/2))
34842    fnend 
34844 ! 
35000 ! #Autonumber# 35000,1
35001 ! =============================== File Read/Write ===========================
35002 ! = This Next Section And These Variables Are All For File Reads And Writes =
35003 ! ===========================================================================
35004    dim SCREENFLD$(1)*1000, SCREENFLD(1), TEMPSCREENFLD$(1)*1000, TEMPSCREENFLD(1), TEMPSCREENIO$(1)*255, TEMPSCREENIO(1), FSCREENIO, FSCREENFLD, STATIC_SCREENNAME$
35005 Readscreen: ! Read The Screen And Populate The Given Arrays
35006    def FNREADSCREEN(SCREENNAME$,MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;SKIPPRESERVE,___, INDEX)
35007       let SCREENNAME$=UPRC$(TRIM$(SCREENNAME$))
35008       if TRIM$(SCREENNAME$)="" then 
35009 ! 
35010          mat SCREENIO$=("") : mat SCREENIO=(0)
35011          let FNRESIZECONTROLARRAYS(0, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35012 ! 
35013          let SCREENIO(SI_VSIZE)=24
35014          let SCREENIO(SI_HSIZE)=80
35015 ! 
35016          let CONTROL=0
35017 ! 
35018          let FNREADSCREEN=1           !New Screen Initialized
35019          let STATIC_SCREENNAME$=SCREENNAME$
35020          let FNPRESERVESCREENARRAYS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35021       else 
35022 ! .   ! Load Screen
35023          read #FSCREENIO, using FORM$(FSCREENIO), key=FNKEY$(FSCREENIO,SCREENNAME$), release: MAT SCREENIO$, MAT SCREENIO nokey IGNORE
35024          if FILE(FSCREENIO)=0 then 
35025 ! 
35026             restore #FSCREENFLD, key=FNKEY$(FSCREENFLD,SCREENNAME$): nokey IGNORE
35027 ! 
35028             let FNRESIZECONTROLARRAYS(0, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35029 ! 
35030             do WHILE FILE(FSCREENFLD)=0
35031                read #FSCREENFLD, using FORM$(FSCREENFLD), release: MAT SCREENFLD$, MAT SCREENFLD eof IGNORE
35032 ! 
35033                if FILE(FSCREENFLD)=0 AND TRIM$(SCREENFLD$(SF_SCREENCODE))=TRIM$(SCREENNAME$) then 
35034                   let INDEX=UDIM(MAT CONTROLNAME$)+1
35035                   let FNRESIZECONTROLARRAYS(INDEX, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35036 ! 
35037                   let CONTROLNAME$(INDEX)=SCREENFLD$(SF_CONTROLNAME) !:
                        let FIELDNAME$(INDEX)=SCREENFLD$(SF_FIELDNAME) !:
                        let DESCRIPTION$(INDEX)=SCREENFLD$(SF_DESCRIPTION) !:
                        let VPOSITION(INDEX)=SCREENFLD(SF_VPOSITION) !:
                        let HPOSITION(INDEX)=SCREENFLD(SF_HPOSITION) !:
                        let FIELDTYPE$(INDEX)=SCREENFLD$(SF_FIELDTYPE) !:
                        let SPECWIDTH(INDEX)=SCREENFLD(SF_SPECWIDTH) !:
                        let WIDTH(INDEX)=SCREENFLD(SF_WIDTH) !:
                        let HEIGHT(INDEX)=SCREENFLD(SF_HEIGHT) !:
                        let TRUEVALUE$(INDEX)=SCREENFLD$(SF_TRUEVALUE) !:
                        let FALSEVALUE$(INDEX)=SCREENFLD$(SF_FALSEVALUE) !:
                        let FUNCTION$(INDEX)=SCREENFLD$(SF_FUNCTION) !:
                        let PICTURE$(INDEX)=SCREENFLD$(SF_PICTURE)
35038                   let PARENT$(INDEX)=SCREENFLD$(SF_PARENT) !:
                        let FGCOLOR$(INDEX)=SCREENFLD$(SF_FGCOLOR) !:
                        let BGCOLOR$(INDEX)=SCREENFLD$(SF_BGCOLOR) !:
                        let JUSTIFY$(INDEX)=SCREENFLD$(SF_JUSTIFY) !:
                        let ATTR$(INDEX)=SCREENFLD$(SF_ATTR) !:
                        let PROTECTED(INDEX)=SCREENFLD(SF_PROTECTED) !:
                        let INVISIBLE(INDEX)=SCREENFLD(SF_INVISIBLE) !:
                        let TOOLTIP$(INDEX)=SCREENFLD$(SF_TOOLTIP) !:
                        let CNVRTIN$(INDEX)=SCREENFLD$(SF_CNVRTIN) !:
                        let CNVRTOUT$(INDEX)=SCREENFLD$(SF_CNVRTOUT) !:
                        let MULTISELECT(INDEX)=SCREENFLD(SF_MULTISELECT) !:
                        let GRIDLINES(INDEX)=SCREENFLD(SF_GRIDLINES) !:
                        let USERDATA$(INDEX)=SCREENFLD$(SF_USERDATA)
35039                end if 
35040             loop WHILE TRIM$(SCREENFLD$(SF_SCREENCODE))=TRIM$(SCREENNAME$)
35041             let FNREADSCREEN=1        !Screen Read Successful
35042             if ~SKIPPRESERVE then 
35043                let STATIC_SCREENNAME$=SCREENNAME$
35044                let FNPRESERVESCREENARRAYS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35045             end if 
35046             let FNFIXALLCHILDSCREENSIZE(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35047          else 
35048             let FNREADSCREEN=0        !Screen Not Found
35049          end if 
35050       end if 
35051    fnend 
35052 ! 
35053    def FNLAUNCHSCREEN(SCREENCODE$;NUMBER,___,FILENUMBER,DESIGNERPATH$)
35054 ! .  ! Build a proc to run the screen
35055       open #(FILENUMBER:=FNGETFILENUMBER): "name=launch"&SESSION$&STR$(NUMBER)&".$$$, replace", display, output 
35056       print #FILENUMBER: "proc noecho"
35057       if EXISTS(SREP$(SETTING_SCREENIOPATH$&".br","screenio.br","design.br")) then 
35058          print #FILENUMBER: "load "&SREP$(SETTING_SCREENIOPATH$&".br","screenio.br","design")
35059       else 
35060          print #FILENUMBER: "load "&SETTING_SCREENIOPATH$
35061       end if 
35062       print #FILENUMBER: "5 let fnAutoCallScreen("""&SCREENCODE$&""")"
35063       print #FILENUMBER: "6 execute ""system"""
35064       print #FILENUMBER: "run"
35065       close #FILENUMBER: 
35066 ! 
35067       execute "system -C -M "&FNGETBREXE$&" -"&FNGETWBCFG$&" proc launch"&SESSION$&STR$(NUMBER)&".$$$"
35068    fnend 
35069 ! 
35070 Writescreen: !  Write The Results To Disk
35071    def FNWRITESCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;WAITFORCOMPLETE,___,INDEX,WRITEERROR,BACKUPFILE)
35072 ! 
35073       if LEN(TRIM$(SCREENIO$(SI_SCREENCODE)))>0 then 
35074          let SCREENIO(SI_VERSION)+=1
35075          let FNWRITEBACKUP(MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35076 ! 
35077          let SCREENIO(SI_MODIFYDATE)=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")
35078          let SCREENIO$(SI_MODIFYUSER)=LOGIN_NAME$
35079          if (TRIM$(STATIC_SCREENNAME$)<>TRIM$(SCREENIO$(SI_SCREENCODE))) then 
35080             restore #FSCREENIO, key=FNKEY$(FSCREENIO,SCREENIO$(SI_SCREENCODE)): nokey IGNORE
35081             if FILE(FSCREENIO)<>0 then 
35082                let SCREENIO(SI_CREATEDATE)=DAYS(DATE$("mm/dd/ccyy"),"mm/dd/ccyy")
35083                let SCREENIO$(SI_CREATEUSER)=LOGIN_NAME$
35084                write #FSCREENIO, using FORM$(FSCREENIO) : MAT SCREENIO$, MAT SCREENIO
35085                let WRITEERROR=0
35086             else 
35087                let CHOICE=MSGBOX(TRIM$(SCREENIO$(SI_SCREENCODE))&" already exists. Do you wish to overwrite it?","Confirm overwrite","yN","QST")
35088                if CHOICE=2 then ! 2 Is Yes
35089                   rewrite #FSCREENIO, using FORM$(FSCREENIO),key=FNKEY$(FSCREENIO,SCREENIO$(SI_SCREENCODE)) : MAT SCREENIO$, MAT SCREENIO
35090 ! .              ! let Fndeleteallfields(Screenio$(Si_Screencode))
35091                   let WRITEERROR=0
35092                else 
35093                   let WRITEERROR=1
35094                end if 
35095             end if 
35096          else 
35097             restore #FSCREENIO, key=FNKEY$(FSCREENIO,SCREENIO$(SI_SCREENCODE)): nokey IGNORE
35098             if FILE(FSCREENIO)=0 then 
35099                rewrite #FSCREENIO, using FORM$(FSCREENIO), key=FNKEY$(FSCREENIO,SCREENIO$(SI_SCREENCODE)) : MAT SCREENIO$, MAT SCREENIO
35100 ! .           ! let Fndeleteallfields(Screenio$(Si_Screencode))
35101                let WRITEERROR=0
35102             else ! Record Must Have Been Deleted By An Outside Process
35103                write #FSCREENIO, using FORM$(FSCREENIO) : MAT SCREENIO$, MAT SCREENIO
35104 ! .           ! let Fndeleteallfields(Screenio$(Si_Screencode))
35105                let WRITEERROR=0
35106             end if 
35107          end if 
35108 ! 
35109          if ~WRITEERROR then 
35110 ! .        ! Restore ScreenFld file to first one for that screen.
35111             mat SCREENFLD$=("") : mat SCREENFLD=(0)
35112             let SCREENFLD$(SF_SCREENCODE)=SCREENIO$(SI_SCREENCODE)
35113             restore #FSCREENFLD, key=FNBUILDKEY$("screenfld", MAT SCREENFLD$, MAT SCREENFLD) : nokey IGNORE
35114             let INDEX=0
35115 ! .        ! Loop through and update all the records that are there first.
35116             do UNTIL INDEX>=UDIM(MAT CONTROLNAME$) OR FILE(FSCREENFLD)
35117                read #FSCREENFLD, using FORM$(FSCREENFLD) : MAT SCREENFLD$, MAT SCREENFLD eof IGNORE
35118                if FILE(FSCREENFLD)=0 AND SCREENFLD$(SF_SCREENCODE)=SCREENIO$(SI_SCREENCODE) then 
35119 ! .              ! Each entry of the loop, if the read screenflds matches this screen, update the record.
35120                   let INDEX+=1
35121                   let FNBUILDSCREENFLD(SCREENIO$(SI_SCREENCODE),MAT SCREENFLD$,MAT SCREENFLD,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35122                   rewrite #FSCREENFLD, using FORM$(FSCREENFLD) : MAT SCREENFLD$, MAT SCREENFLD
35123                end if 
35124             loop WHILE SCREENFLD$(SF_SCREENCODE)=SCREENIO$(SI_SCREENCODE)
35125 ! 
35126 ! .        ! Go through the file and delete any extras.
35127             do WHILE FILE(FSCREENFLD)=0 AND SCREENFLD$(SF_SCREENCODE)=SCREENIO$(SI_SCREENCODE)
35128                read #FSCREENFLD, using FORM$(FSCREENFLD) : MAT SCREENFLD$, MAT SCREENFLD eof IGNORE
35129                if FILE(FSCREENFLD)=0 AND SCREENFLD$(SF_SCREENCODE)=SCREENIO$(SI_SCREENCODE) then 
35130                   delete #FSCREENFLD: 
35131                end if 
35132             loop 
35133 ! 
35134 ! .        ! Now save the rest
35135             for INDEX=INDEX+1 to UDIM(MAT CONTROLNAME$)
35136                let FNBUILDSCREENFLD(SCREENIO$(SI_SCREENCODE),MAT SCREENFLD$,MAT SCREENFLD,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35137                write #FSCREENFLD, using FORM$(FSCREENFLD) : MAT SCREENFLD$, MAT SCREENFLD
35138             next INDEX
35139 ! 
35140 ! .        ! Break any locks
35141             restore #FSCREENFLD, release: 
35142 ! 
35143             let FNCOMPILEHELPERLIBRARY(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,"",WAITFORCOMPLETE)
35144 ! 
35145             let STATIC_SCREENNAME$=SCREENIO$(SI_SCREENCODE)
35146             let FNPRESERVESCREENARRAYS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35147          end if 
35148       else 
35149          let MSGBOX("Window Name cannot be blank when saving screen.","Error","OK","ERR")
35150          let WRITEERROR=1             !No Screen Name Passed In
35151       end if 
35152 ! 
35153       let FNWRITESCREEN=~WRITEERROR
35154    fnend 
35155 ! 
35156    def FNBUILDSCREENFLD(SCREENCODE$*64,MAT SCREENFLD$,MAT SCREENFLD,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35157       let SCREENFLD$(SF_SCREENCODE) = SCREENIO$(SI_SCREENCODE) !:
            let SCREENFLD$(SF_CONTROLNAME) = CONTROLNAME$(INDEX) !:
            let SCREENFLD$(SF_FIELDNAME) = FIELDNAME$(INDEX) !:
            let SCREENFLD$(SF_DESCRIPTION) = DESCRIPTION$(INDEX) !:
            let SCREENFLD(SF_VPOSITION) = VPOSITION(INDEX) !:
            let SCREENFLD(SF_HPOSITION) = HPOSITION(INDEX) !:
            let SCREENFLD$(SF_FIELDTYPE) = FIELDTYPE$(INDEX) !:
            let SCREENFLD(SF_SPECWIDTH) = SPECWIDTH(INDEX) !:
            let SCREENFLD(SF_WIDTH) = WIDTH(INDEX) !:
            let SCREENFLD(SF_HEIGHT) = HEIGHT(INDEX) !:
            let SCREENFLD$(SF_TRUEVALUE) = TRUEVALUE$(INDEX) !:
            let SCREENFLD$(SF_FALSEVALUE) = FALSEVALUE$(INDEX) !:
            let SCREENFLD$(SF_FUNCTION) = FUNCTION$(INDEX)
35158       let SCREENFLD$(SF_PICTURE) = PICTURE$(INDEX) !:
            let SCREENFLD$(SF_PARENT) = PARENT$(INDEX) !:
            let SCREENFLD$(SF_FGCOLOR) = FGCOLOR$(INDEX) !:
            let SCREENFLD$(SF_BGCOLOR) = BGCOLOR$(INDEX) !:
            let SCREENFLD$(SF_JUSTIFY) = JUSTIFY$(INDEX) !:
            let SCREENFLD$(SF_ATTR) = ATTR$(INDEX) !:
            let SCREENFLD(SF_PROTECTED) = PROTECTED(INDEX) !:
            let SCREENFLD(SF_INVISIBLE) = INVISIBLE(INDEX) !:
            let SCREENFLD$(SF_TOOLTIP) = TOOLTIP$(INDEX) !:
            let SCREENFLD$(SF_CNVRTIN) = CNVRTIN$(INDEX) !:
            let SCREENFLD$(SF_CNVRTOUT) = CNVRTOUT$(INDEX) !:
            let SCREENFLD(SF_MULTISELECT) = MULTISELECT(INDEX) !:
            let SCREENFLD(SF_GRIDLINES) = GRIDLINES(INDEX) !:
            let SCREENFLD$(SF_USERDATA) = USERDATA$(INDEX)
35159    fnend 
35160 ! 
35161 Closescreenfiles: !  Closes The Screen Files If They Are Open
35162    def FNCLOSESCREENFILES
35163       if FSCREENIO<>0 AND FILE(FSCREENIO)<>-1 then 
35164          let FNCLOSEFILE(FSCREENIO,"screenio","",1)
35165       end if 
35166       if FSCREENFLD<>0 AND FILE(FSCREENFLD)<>-1 then 
35167          let FNCLOSEFILE(FSCREENFLD,"screenfld","",1)
35168       end if 
35169    fnend 
35170 ! 
35171 Openscreenfiles: ! Open The Screen Files If They Aren't open yet
35172    def FNOPENSCREENFILES(MAT SCREENIO$,MAT SCREENIO)
35173       if FSCREENIO=0 OR FILE(FSCREENIO)=-1 then 
35174          let FSCREENIO=FNOPEN("screenio",MAT SCREENIO$, MAT SCREENIO, MAT FORM$)
35175          mat TEMPSCREENIO$(UDIM(MAT SCREENIO$))
35176          mat TEMPSCREENIO(UDIM(MAT SCREENIO))
35177       end if 
35178       if FSCREENFLD=0 OR FILE(FSCREENFLD)=-1 then 
35179          let FSCREENFLD=FNOPEN("screenfld",MAT SCREENFLD$, MAT SCREENFLD, MAT FORM$)
35180          mat TEMPSCREENFLD$(UDIM(MAT SCREENFLD$))
35181          mat TEMPSCREENFLD(UDIM(MAT SCREENFLD))
35182       end if 
35183    fnend 
35184 ! 
35185 Deletescreen: ! Deletes The Given Screen
35186    def FNDELETESCREEN(SCREENCODE$)
35187       delete #FSCREENIO, key=FNKEY$(FSCREENIO,SCREENCODE$): nokey IGNORE
35188       let FNDELETEALLFIELDS(SCREENCODE$)
35189    fnend 
35190 ! 
35191 Readallscreencodes: ! Read All The Screen Codes From The Screenio File
35192    def FNREADALLSCREENCODES(MAT LIST$,MAT CREATE,MAT MODIFY,MAT VERS,MAT CREATEUSER$,MAT MODIFYUSER$,MAT PROJECT$,MAT NOTES$)
35193       restore #FSCREENIO: 
35194       mat LIST$(0) !:
            mat CREATE(0) !:
            mat MODIFY(0) !:
            mat VERS(0) !:
            mat CREATEUSER$(0) !:
            mat MODIFYUSER$(0) !:
            mat PROJECT$(0) !:
            mat NOTES$(0)
35195       do WHILE FILE(FSCREENIO)=0
35196          read #FSCREENIO, using FORM$(FSCREENIO), release: MAT TEMPSCREENIO$, MAT TEMPSCREENIO eof IGNORE
35197          if FILE(FSCREENIO)=0 then 
35198             mat LIST$(UDIM(MAT LIST$)+1) !:
                  mat CREATE(UDIM(MAT LIST$)) !:
                  mat MODIFY(UDIM(MAT LIST$)) !:
                  mat VERS(UDIM(MAT LIST$)) !:
                  mat CREATEUSER$(UDIM(MAT LIST$)) !:
                  mat MODIFYUSER$(UDIM(MAT LIST$)) !:
                  mat PROJECT$(UDIM(MAT LIST$)) !:
                  mat NOTES$(UDIM(MAT LIST$))
35199             let LIST$(UDIM(MAT LIST$))=TEMPSCREENIO$(SI_SCREENCODE) !:
                  let CREATE(UDIM(MAT LIST$))=TEMPSCREENIO(SI_CREATEDATE) !:
                  let MODIFY(UDIM(MAT LIST$))=TEMPSCREENIO(SI_MODIFYDATE) !:
                  let VERS(UDIM(MAT LIST$))=TEMPSCREENIO(SI_VERSION) !:
                  let CREATEUSER$(UDIM(MAT LIST$))=TEMPSCREENIO$(SI_CREATEUSER) !:
                  let MODIFYUSER$(UDIM(MAT LIST$))=TEMPSCREENIO$(SI_MODIFYUSER) !:
                  let PROJECT$(UDIM(MAT LIST$))=TEMPSCREENIO$(SI_PROJECT) !:
                  let NOTES$(UDIM(MAT LIST$))=TEMPSCREENIO$(SI_NOTES)
35200          end if 
35201       loop 
35202    fnend 
35203 ! 
35204 Deleteallfields: ! Delete All  The Controls For The Associated Screen So They Can Be Resaved
35205    def FNDELETEALLFIELDS(SCREENNAME$)
35206       restore #FSCREENFLD,key=FNKEY$(FSCREENFLD,SCREENNAME$): nokey IGNORE
35207       do WHILE FILE(FSCREENFLD)=0
35208          read #FSCREENFLD, using FORM$(FSCREENFLD) : MAT TEMPSCREENFLD$, MAT TEMPSCREENFLD eof IGNORE
35209          if FILE(FSCREENFLD)=0 AND TRIM$(TEMPSCREENFLD$(SF_SCREENCODE))=TRIM$(SCREENNAME$) then 
35210             delete #FSCREENFLD: 
35211          end if 
35212       loop WHILE TRIM$(TEMPSCREENFLD$(SF_SCREENCODE))=TRIM$(SCREENNAME$)
35213    fnend 
35214 ! 
35215 Resizecontrolarrays: !  Resize The Given Arrays  To The Given Size
35216    def FNRESIZECONTROLARRAYS(NEWSIZE, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35217       mat CONTROLNAME$(NEWSIZE) !:
            mat FIELDNAME$(NEWSIZE) !:
            mat DESCRIPTION$(NEWSIZE) !:
            mat VPOSITION(NEWSIZE) !:
            mat HPOSITION(NEWSIZE) !:
            mat FIELDTYPE$(NEWSIZE) !:
            mat SPECWIDTH(NEWSIZE) !:
            mat WIDTH(NEWSIZE) !:
            mat HEIGHT(NEWSIZE) !:
            mat TRUEVALUE$(NEWSIZE) !:
            mat FALSEVALUE$(NEWSIZE) !:
            mat FUNCTION$(NEWSIZE) !:
            mat PICTURE$(NEWSIZE)
35218       mat PARENT$(NEWSIZE) !:
            mat FGCOLOR$(NEWSIZE) !:
            mat BGCOLOR$(NEWSIZE) !:
            mat JUSTIFY$(NEWSIZE) !:
            mat ATTR$(NEWSIZE) !:
            mat PROTECTED(NEWSIZE) !:
            mat INVISIBLE(NEWSIZE) !:
            mat TOOLTIP$(NEWSIZE) !:
            mat CNVRTIN$(NEWSIZE) !:
            mat CNVRTOUT$(NEWSIZE) !:
            mat MULTISELECT(NEWSIZE) !:
            mat GRIDLINES(NEWSIZE) !:
            mat USERDATA$(NEWSIZE)
35219    fnend 
35220 ! 
35221 Copycontrolarrays: ! Copies All The Values From One Control To Another
35222    def FNCOPYCONTROLARRAYS(TO,FROM,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35223       let CONTROLNAME$(TO)=CONTROLNAME$(FROM) !:
            let FIELDNAME$(TO)=FIELDNAME$(FROM) !:
            let DESCRIPTION$(TO)=DESCRIPTION$(FROM) !:
            let VPOSITION(TO)=VPOSITION(FROM) !:
            let HPOSITION(TO)=HPOSITION(FROM) !:
            let FIELDTYPE$(TO)=FIELDTYPE$(FROM) !:
            let SPECWIDTH(TO)=SPECWIDTH(FROM) !:
            let WIDTH(TO)=WIDTH(FROM) !:
            let HEIGHT(TO)=HEIGHT(FROM) !:
            let TRUEVALUE$(TO)=TRUEVALUE$(FROM) !:
            let FALSEVALUE$(TO)=FALSEVALUE$(FROM) !:
            let FUNCTION$(TO)=FUNCTION$(FROM) !:
            let PICTURE$(TO)=PICTURE$(FROM)
35224       let PARENT$(TO)=PARENT$(FROM) !:
            let FGCOLOR$(TO)=FGCOLOR$(FROM) !:
            let BGCOLOR$(TO)=BGCOLOR$(FROM) !:
            let JUSTIFY$(TO)=JUSTIFY$(FROM) !:
            let ATTR$(TO)=ATTR$(FROM) !:
            let PROTECTED(TO)=PROTECTED(FROM) !:
            let INVISIBLE(TO)=INVISIBLE(FROM) !:
            let TOOLTIP$(TO)=TOOLTIP$(FROM) !:
            let CNVRTIN$(TO)=CNVRTIN$(FROM) !:
            let CNVRTOUT$(TO)=CNVRTOUT$(FROM) !:
            let MULTISELECT(TO)=MULTISELECT(FROM) !:
            let GRIDLINES(TO)=GRIDLINES(FROM) !:
            let USERDATA$(TO)=USERDATA$(FROM)
35225    fnend 
