48524 Definebuttons: ! Define Toolbar Buttons
48526    def FNDEFINEBUTTONS(MAT BUTTONS$, MAT TOOLTIP$)
48528       mat BUTTONS$(14) : mat TOOLTIP$(14)
48530 ! 
48532       let BUTTONS$(1)="Field" !:
            let TOOLTIP$(1)="Add the selected Database Field"
48534 ! 
48536       let BUTTONS$(2)="Text Box" !:
            let TOOLTIP$(2)="Add a blank Text Box field"
48538 ! 
48540       let BUTTONS$(3)="Caption" !:
            let TOOLTIP$(3)="Add an empty Caption"
48542 ! 
48544       let BUTTONS$(4)="Check Box" !:
            let TOOLTIP$(4)="Add a blank Check Box field"
48546 ! 
48548       let BUTTONS$(5)="Combo Box" !:
            let TOOLTIP$(5)="Add a combo box control."
48550 ! 
48552       let BUTTONS$(6)="Listview" !:
            let TOOLTIP$(6)="Add a listview control"
48554 ! 
48556       let BUTTONS$(7)="Search Box" !:
            let TOOLTIP$(7)="Add a Search Box to a Listview Control"
48558 ! 
48560       let BUTTONS$(8)="Filter Box" !:
            let TOOLTIP$(8)="Add a BR filter box. (4.3+)"
48562 ! 
48564       let BUTTONS$(9)="Button" !:
            let TOOLTIP$(9)="Add a Button"
48566 ! 
48568       let BUTTONS$(10)="Picture" !:
            let TOOLTIP$(10)="Add a Picture"
48570 ! 
48572       let BUTTONS$(11)="~ Calendar ~"
48574       let TOOLTIP$(11)="Add button that links to a date picker.(Coming Soon)"
48576 ! 
48578       let BUTTONS$(12)="Frame" !:
            let TOOLTIP$(12)="Add a border for visual grouping."
48580 ! 
48582       let BUTTONS$(13)="Screen" !:
            let TOOLTIP$(13)="Add an entire screen as a child control."
48584 ! 
48586       let BUTTONS$(14)="Skip a Space" !:
            let TOOLTIP$(14)="Skip the next row for Automatic Placement"
48588 ! 
48590       let FNFIXTOOLTIPS(MAT TOOLTIP$)
48592    fnend 
48594 ! 
48596 Processbuttons: ! Process A Button Click Here
48598    def FNPROCESSBUTTON(BUTTON$,&MODE,&CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,NEWCONTROL,RELATEDCONTROL)
48600       if BUTTON$ = "field" then ! #Select# Button$ #Case# "field"
48602          let NEWCONTROL=FNADDANDCOLORCURRENTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO)
48604          if NEWCONTROL then 
48606             let MODE=INPUTEDITORMOVEMODE
48608             let CONTROL=NEWCONTROL
48610          end if 
48612 ! 
48614       else if BUTTON$ = "text box" then ! #Case# "text box"
48616          let NEWCONTROL=FNADDTEXTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48618          if NEWCONTROL then 
48620             let MODE=INPUTEDITORMOVEMODE
48622             let CONTROL=NEWCONTROL
48624             let FGCOLOR$(NEWCONTROL)="W"
48626             let BGCOLOR$(NEWCONTROL)="W"
48628          end if 
48630 ! 
48632       else if BUTTON$ = "caption" then ! #Case# "caption"
48634          let NEWCONTROL=FNADDCAPTION(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48636          if NEWCONTROL then 
48638             let MODE=INPUTEDITORMOVEMODE
48640             let CONTROL=NEWCONTROL
48642             if TRIM$(SCREENIO$(SI_FGCOLOR))<>"" then 
48644                let FGCOLOR$(NEWCONTROL)=TRIM$(SCREENIO$(SI_FGCOLOR))
48646             end if 
48648          end if 
48650 ! 
48652       else if BUTTON$ = "check box" then ! #Case# "check box"
48654          let NEWCONTROL=FNADDCHECKBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48656          if NEWCONTROL then 
48658             let MODE=INPUTEDITORMOVEMODE
48660             let CONTROL=NEWCONTROL
48662          end if 
48664          if TRIM$(SCREENIO$(SI_FGCOLOR))<>"" then 
48666             let FGCOLOR$(NEWCONTROL)=TRIM$(SCREENIO$(SI_FGCOLOR))
48668          end if 
48670 ! 
48672       else if BUTTON$ = "search box" then ! #Case# "search box"
48674          let NEWCONTROL=FNADDSEARCHBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MODE,CONTROL)
48676          if NEWCONTROL then 
48678             let MODE=INPUTEDITORMOVEMODE
48680             let CONTROL=NEWCONTROL
48682             let FGCOLOR$(NEWCONTROL)="W"
48684             let BGCOLOR$(NEWCONTROL)="W"
48686          end if 
48688 ! 
48690       else if BUTTON$ = "filter box" then ! #Case# "filter box"
48692          let NEWCONTROL=FNADDFILTERBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MODE,CONTROL)
48694          if NEWCONTROL then 
48696             let MODE=INPUTEDITORMOVEMODE
48698             let CONTROL=NEWCONTROL
48700             let FGCOLOR$(NEWCONTROL)="W"
48702             let BGCOLOR$(NEWCONTROL)="W"
48704          end if 
48706 ! 
48708       else if BUTTON$ = "calendar" then ! #Case# "calendar"
48710          let NEWCONTROL=FNADDCALENDAR(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MODE,CONTROL)
48712          if NEWCONTROL then 
48714             let MODE=INPUTEDITORMOVEMODE
48716             let CONTROL=NEWCONTROL
48718             let FGCOLOR$(NEWCONTROL)="W"
48720             let BGCOLOR$(NEWCONTROL)="W"
48722          end if 
48724 ! 
48726       else if BUTTON$ = "listview" then ! #Case# "listview"
48728          let NEWCONTROL=FNADDLISTVIEW(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48730          if NEWCONTROL then 
48732             let MODE=INPUTEDITORMOVEMODE
48734             let CONTROL=NEWCONTROL
48736             let FGCOLOR$(NEWCONTROL)="W"
48738             let BGCOLOR$(NEWCONTROL)="W"
48740          end if 
48742 ! 
48744       else if BUTTON$ = "button" then ! #Case# "button"
48746          let NEWCONTROL=FNADDBUTTON(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48748          if NEWCONTROL then 
48750             let MODE=INPUTEDITORMOVEMODE
48752             let CONTROL=NEWCONTROL
48754             let FGCOLOR$(NEWCONTROL)="W"
48756             let BGCOLOR$(NEWCONTROL)="W"
48758          end if 
48760 ! 
48762       else if BUTTON$ = "picture" then ! #Case# "picture"
48764          let NEWCONTROL=FNADDPICTURE(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48766          if NEWCONTROL then 
48768             let MODE=INPUTEDITORMOVEMODE
48770             let CONTROL=NEWCONTROL
48772          end if 
48774       else if BUTTON$ = "screen" then ! #Case# "screen"
48776          let NEWCONTROL=FNADDSCREEN(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48778          if NEWCONTROL then 
48780             let MODE=INPUTEDITORMOVEMODE
48782             let CONTROL=NEWCONTROL
48784          end if 
48786 ! 
48788       else if BUTTON$ = "frame" then ! #Case# "frame"
48790          let NEWCONTROL=FNADDFRAME(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48792          if NEWCONTROL then 
48794             let MODE=INPUTEDITORMOVEMODE
48796             let CONTROL=NEWCONTROL
48798          end if 
48800 ! 
48802       else if BUTTON$ = "combo box" then ! #Case# "combo box"
48804          let NEWCONTROL=FNADDCOMBO(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48806          if NEWCONTROL then 
48808             let MODE=INPUTEDITORMOVEMODE
48810             let CONTROL=NEWCONTROL
48812          end if 
48814 ! 
48816       else if BUTTON$ = "skip a space" then ! #Case# "skip a space"
48818          let FNSKIPAGAP
48820 ! 
48822       else ! #Case Else#
48824          let MSGBOX("This control type is not supported yet.","Control not supported","Ok","INF")
48826 ! 
48828       end if                          !#End Select#
48830    fnend 
48832 ! 
48834    dim WARNEDYET
48836    dim TEMPCLIP$*100000
48838    def FNADDTOCLIPBOARD(&CLIPBOARD$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,CHILD)
48840 ! 
48842       let TEMPCLIP$=""
48844       let FNCLIPBOARDADD(TEMPCLIP$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48846 ! 
48848 ! .   ! Add listview children to clipboard also.
48850       if LWRC$(FIELDTYPE$(CONTROL))="listview" then 
48852          for CHILD=1 to UDIM(MAT FIELDTYPE$)
48854             if PARENT$(CHILD)=PARENT$(CONTROL) AND LWRC$(FIELDTYPE$(CHILD))="listchld" then 
48856                let FNCLIPBOARDADD(TEMPCLIP$,CHILD,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48858             end if 
48860          next CHILD
48862       end if 
48864 ! 
48866       if LEN(CLIPBOARD$)=0 then let WARNEDYET=0
48868 ! 
48870       if LEN(CLIPBOARD$)+LEN(TEMPCLIP$)>999999 then 
48872          if ~WARNEDYET then 
48874             let MSGBOX("The Clipboard cannot hold that many controls.","Clipboard is full")
48876             let WARNEDYET=1
48878          end if 
48880       else 
48882          let CLIPBOARD$=CLIPBOARD$&TEMPCLIP$
48884          let FNADDTOCLIPBOARD=1
48886       end if 
48888    fnend 
48890 ! 
48892    def FNCLIPBOARDADD(&CLIP$,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48894       let CLIP$=CLIP$&TRIM$(CONTROLNAME$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(FIELDNAME$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(DESCRIPTION$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(VPOSITION(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(HPOSITION(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(FIELDTYPE$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(SPECWIDTH(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(WIDTH(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(HEIGHT(CONTROL))&"_#_"
48896       let CLIP$=CLIP$&TRIM$(TRUEVALUE$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(FALSEVALUE$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(FUNCTION$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(PICTURE$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(PARENT$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(FGCOLOR$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(BGCOLOR$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(JUSTIFY$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(ATTR$(CONTROL))&"_#_"
48898       let CLIP$=CLIP$&STR$(MULTISELECT(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(GRIDLINES(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(PROTECTED(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&STR$(INVISIBLE(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(TOOLTIP$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(CNVRTIN$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(CNVRTOUT$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&TRIM$(USERDATA$(CONTROL))&"_#_" !:
            let CLIP$=CLIP$&"#!!#"&CHR$(13)
48900    fnend 
48902 ! 
48904    def FNADDCONTROLSFROMCLIPBOARD(&CLIPBOARD$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,ADDED)
48906       let CLIPBOARD$=SREP$(CLIPBOARD$,CHR$(13),"")  !Strip Cr's
48908       do WHILE POS(CLIPBOARD$,"#!!#")
48910 ! .      ! Read one control and add it to screen
48912          let ADDED+=FNADDCONTROLFROMCLIP(CLIPBOARD$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
48914 ! .      ! Strip it from Clipboard
48916          if POS(CLIPBOARD$,"#!!#") then 
48918             let CLIPBOARD$(1:POS(CLIPBOARD$,"#!!#")+3)=""
48920          end if 
48922       loop 
48924       if ADDED then let FNADDCONTROLSFROMCLIPBOARD=1
48926    fnend 
48928    def FNADDCONTROLFROMCLIP(&CLIPBOARD$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,CONTROLNAME$*50,FIELDNAME$*50,DESCRIPTION$*255,VPOSITION,HPOSITION,FIELDTYPE$,SPECWIDTH,WIDTH,HEIGHT,TRUEVALUE$*60,FALSEVALUE$*60,FUNCTION$*255,PICTURE$*255,PARENT$*20,FGCOLOR$,BGCOLOR$,PROTECTED,INVISIBLE,TOOLTIP$*255,CNVRTIN$*255,CNVRTOUT$*255,MULTISELECT,GRIDLINES,USERDATA$*255,JUSTIFY$,ATTR$*255,CONTROL)
48930       let BROKEN=0
48932       if ~BROKEN then let CONTROLNAME$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48934       if ~BROKEN then let FIELDNAME$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48936       if ~BROKEN then let DESCRIPTION$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48938       if ~BROKEN then let VPOSITION=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48940       if ~BROKEN then let HPOSITION=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48942       if ~BROKEN then let FIELDTYPE$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48944       if ~BROKEN then let SPECWIDTH=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48946       if ~BROKEN then let WIDTH=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48948       if ~BROKEN then let HEIGHT=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48950       if ~BROKEN then let TRUEVALUE$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48952       if ~BROKEN then let FALSEVALUE$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48954       if ~BROKEN then let FUNCTION$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48956       if ~BROKEN then let PICTURE$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48958       if ~BROKEN then let PARENT$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48960       if ~BROKEN then let FGCOLOR$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48962       if ~BROKEN then let BGCOLOR$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48964       if ~BROKEN then let JUSTIFY$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48966       if ~BROKEN then let ATTR$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48968       if ~BROKEN then let MULTISELECT=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48970       if ~BROKEN then let GRIDLINES=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48972       if ~BROKEN then let PROTECTED=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48974       if ~BROKEN then let INVISIBLE=VAL(FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_")) conv Badclipboard
48976       if ~BROKEN then let TOOLTIP$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48978       if ~BROKEN then let CNVRTIN$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48980       if ~BROKEN then let CNVRTOUT$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48982       if ~BROKEN then let USERDATA$=FNGETCLIP$(BROKEN,CLIPBOARD$,"_#_") soflow Badclipboard
48984       if ~BROKEN then 
48986          let CONTROL=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1) !:
               let CONTROLNAME$(CONTROL)=CONTROLNAME$ !:
               let FIELDNAME$(CONTROL)=FIELDNAME$ !:
               let DESCRIPTION$(CONTROL)=DESCRIPTION$ !:
               let VPOSITION(CONTROL)=VPOSITION !:
               let HPOSITION(CONTROL)=HPOSITION !:
               let FIELDTYPE$(CONTROL)=FIELDTYPE$ !:
               let SPECWIDTH(CONTROL)=SPECWIDTH !:
               let WIDTH(CONTROL)=WIDTH !:
               let HEIGHT(CONTROL)=HEIGHT !:
               let TRUEVALUE$(CONTROL)=TRUEVALUE$ !:
               let FALSEVALUE$(CONTROL)=FALSEVALUE$ !:
               let FUNCTION$(CONTROL)=FUNCTION$ !:
               let PICTURE$(CONTROL)=PICTURE$
48988          let PARENT$(CONTROL)=PARENT$ !:
               let FGCOLOR$(CONTROL)=FGCOLOR$ !:
               let BGCOLOR$(CONTROL)=BGCOLOR$ !:
               let JUSTIFY$(CONTROL)=JUSTIFY$ !:
               let ATTR$(CONTROL)=ATTR$ !:
               let PROTECTED(CONTROL)=PROTECTED !:
               let INVISIBLE(CONTROL)=INVISIBLE !:
               let TOOLTIP$(CONTROL)=TOOLTIP$ !:
               let CNVRTIN$(CONTROL)=CNVRTIN$ !:
               let CNVRTOUT$(CONTROL)=CNVRTOUT$ !:
               let MULTISELECT(CONTROL)=MULTISELECT !:
               let GRIDLINES(CONTROL)=GRIDLINES !:
               let USERDATA$(CONTROL)=USERDATA$ !:
               let FNADDCONTROLFROMCLIP=1
48990       else 
48992          print BELL;
48994       end if 
48996    fnend 
48998 ! 
49000    def FNGETCLIP$*255(&BROKEN,&CLIPBOARD$,TERMINATOR$)
49002       if POS(CLIPBOARD$,TERMINATOR$)>0 then 
49004          let FNGETCLIP$=TRIM$(CLIPBOARD$(1:POS(CLIPBOARD$,TERMINATOR$)-1)) soflow Badclipboard
49006          let CLIPBOARD$(1:POS(CLIPBOARD$,TERMINATOR$)+LEN(TERMINATOR$)-1)=""
49008       else 
49010          let BROKEN=1
49012       end if 
49014    fnend 
49016 Badclipboard: let BROKEN=1 : continue 
49018 ! 
49020 ! 
49022 Defineattributeswindow: !  Define Window Attributes Input Fields
49024    def FNDEFINEATTRIBUTESWINDOW(MAT ATTRIBUTECAPTIONS$, MAT ATTRIBUTECAPSPEC$,MAT ATTRIBUTESPEC$,MAT ATTRIBUTEDATA$,MAT ATTRIBUTETTIP$,MAT ATTRIBUTESUBS;___,INDEX,TTLEV)
49026 ! 
49028       mat ATTRIBUTECAPTIONS$(21) : mat ATTRIBUTECAPSPEC$(21) !:
            mat ATTRIBUTESPEC$(21) : mat ATTRIBUTEDATA$(21) !:
            mat ATTRIBUTETTIP$(21) : mat ATTRIBUTESUBS(21)
49030 ! 
49032       let ATTRIBUTECAPTIONS$(1)= "Window Name:" !:
            let ATTRIBUTECAPSPEC$(1)= "1,1,C 12" !:
            let ATTRIBUTESPEC$(1)= "1,16,9/CU 18,S,1101" !:
            let ATTRIBUTESUBS(1)= SI_SCREENCODE !:
            let ATTRIBUTETTIP$(1)="The name of the screen, required in order to save the screen."
49034 ! 
49036       let ATTRIBUTECAPTIONS$(2)= "Project:" !:
            let ATTRIBUTECAPSPEC$(2)= "2,1,C 8" !:
            let ATTRIBUTESPEC$(2)= "2,9,16/V 255,S,1102" !:
            let ATTRIBUTESUBS(2)= SI_PROJECT !:
            let ATTRIBUTETTIP$(2)="The project this screen is associated with. Optional Notes field."
49038 ! .  !
49040       let ATTRIBUTECAPTIONS$(3)= "Notes:" !:
            let ATTRIBUTECAPSPEC$(3)= "3,1,5/C 6" !:
            let ATTRIBUTESPEC$(3)= "3,7,18/V 255,S,1103" !:
            let ATTRIBUTESUBS(3)=SI_NOTES !:
            let ATTRIBUTETTIP$(3)="Notes. Can be anything you want."
49042 ! 
49044       let ATTRIBUTECAPTIONS$(4)= "Caption:" !:
            let ATTRIBUTECAPSPEC$(4)= "4,1,C 8" !:
            let ATTRIBUTESPEC$(4)= "4,9,16/V 60,S,1104" !:
            let ATTRIBUTESUBS(4)= SI_CAPTION !:
            let ATTRIBUTETTIP$(4)="Caption to display in the windows taskbar when running screen."
49046 ! .   !
49048       let ATTRIBUTECAPTIONS$(5)= "Rows:" !:
            let ATTRIBUTECAPSPEC$(5)= "5,1,C 5" !:
            let ATTRIBUTESPEC$(5)= "5,8,5/CR 3,S,1105" !:
            let ATTRIBUTESUBS(5)=-1*SI_VSIZE !:
            let ATTRIBUTETTIP$(5)="Height of screen in Rows."
49050 ! 
49052       let ATTRIBUTECAPTIONS$(6)= "Cols:" !:
            let ATTRIBUTECAPSPEC$(6)= "5,14,C 5" !:
            let ATTRIBUTESPEC$(6)= "5,20,5/CR 3,S,1106" !:
            let ATTRIBUTESUBS(6)=-1*SI_HSIZE !:
            let ATTRIBUTETTIP$(6)="Width of screen in columns."
49054 ! 
