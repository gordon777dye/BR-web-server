33534 Setcurfld: !  Set  The Curfld Of The Control
33536    def FNSETLASTCURFLD(CONTROL,CFLD)
33538       let STATIC_LASTCONTROL=CONTROL
33540       let STATIC_LASTCURFLD=CFLD
33542    fnend 
33544 ! 
33546 Copyoasinputspec: ! Copy The Oas Input Specs To The Input Spec Arrays
33548    def FNCOPYOASINPUTSPEC(MAT INSPEC$,MAT INDATA$, MAT INHELP$, MAT ALLSPEC$, MAT ALLDATA$, MAT ALLHELP$, MAT ALLSUBS, MAT BUTTONS;___,INDEX,COUNT)
33550       mat INSPEC$(0) : mat INDATA$(0) : mat INHELP$(0)
33552       for INDEX=1 to UDIM(MAT ALLSUBS)
33554          if ~BUTTONS(INDEX) then 
33556             let COUNT=UDIM(MAT INSPEC$)+1
33558             mat INSPEC$(COUNT) : mat INDATA$(COUNT) : mat INHELP$(COUNT)
33560             let INSPEC$(COUNT)=ALLSPEC$(INDEX)
33562             let INDATA$(COUNT)=ALLDATA$(INDEX)
33564             let INHELP$(COUNT)=ALLHELP$(INDEX)
33566          end if 
33568       next INDEX
33570    fnend 
33572 ! 
33574 Copybackoasinputspec: ! Copy The Oas Input Specs Back To The All Spec Arrays
33576    def FNCOPYBACKOASINPUTSPEC(MAT INSPEC$,MAT INDATA$, MAT ALLSPEC$, MAT ALLDATA$, MAT ALLSUBS, MAT BUTTONS;___,INDEX,COUNT)
33578       let COUNT=0
33580       for INDEX=1 to UDIM(MAT ALLSUBS)
33582          if ~BUTTONS(INDEX) then 
33584             let COUNT+=1
33586             let ALLSPEC$(INDEX)=INSPEC$(COUNT)
33588             let ALLDATA$(INDEX)=INDATA$(COUNT)
33590          end if 
33592       next INDEX
33594    fnend 
33596 ! 
33598 Adjustspeccolor: ! Adjust The Background Color Of The Given Spec
33600    def FNADJUSTSPECCOLOR(&SPEC$,COLOR$*60;___,FC$)
33602       if POS(SPEC$,",/") then 
33604          if FNVALIDHEXCOLOR(COLOR$) then 
33606             if LEN(TRIM$(COLOR$))=6 then 
33608                let SPEC$(POS(SPEC$,",/")+1:POS(SPEC$,",",POS(SPEC$,",/")+1)-1) = FNBUILDCOLOR$(COLOR$)
33610             else 
33612                if UPRC$(TRIM$(COLOR$))="T" then 
33614                   let SPEC$(POS(SPEC$,",/")+1:POS(SPEC$,",",POS(SPEC$,":"))-1) = "/#FFFFFF:"&TRIM$(COLOR$)
33616                else 
33618                   let SPEC$(POS(SPEC$,",/")+1:POS(SPEC$,",",POS(SPEC$,":"))-1) = "/#000000:"&TRIM$(COLOR$)
33620                end if 
33622             end if 
33624          else 
33626             let SPEC$(POS(SPEC$,":")+1:POS(SPEC$,",",POS(SPEC$,":"))-1) = "W"
33628          end if 
33630       end if 
33632    fnend 
33634 ! 
33636 Openobjectattributeswindow: !  Open The Attributes Window In A Place It Wont Be Off The Screen
33638    def FNOPENOBJECTATTRIBUTESWINDOW(CONTROL,ROWSIZE,COLSIZE,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,WINDOW,ROW,COL,SCREENROWSIZE,SCREENCOLSIZE,BORDERSIZE)
33640       let ROW=VPOSITION(CONTROL)
33642       let COL=HPOSITION(CONTROL)
33644       if (LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="frame" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="screen") AND GRIDLINES(CONTROL) then let BORDERSIZE=1
33646       let FNCALCULATEREALPOSITION(ROW, COL)
33648       let FNGETSCREENSIZE(SCREENROWSIZE,SCREENCOLSIZE)
33650       let ROW=ROW+MAX(HEIGHT(CONTROL),1)+1+BORDERSIZE  !Try It Below First
33652       let COL=COL
33654       if (ROW)+(ROWSIZE+1)>SCREENROWSIZE then !  If It Doesnt Fit Below
33656          let ROW=(ROW-2-BORDERSIZE)-(ROWSIZE+2)  !Try It Above
33658       end if 
33660       if (ROW)+(ROWSIZE+1)>SCREENROWSIZE then !  If It Still Doesnt Fit
33662          let ROW=SCREENROWSIZE-(ROWSIZE+1)  !Move It So It Does Fit
33664       end if 
33666       if (COL)+(COLSIZE)>SCREENCOLSIZE then !  If It Doesnt Fit To The Right
33668          let COL=COL+WIDTH(CONTROL)-(COLSIZE)  !Try It To The Left
33670       end if 
33672       if (COL)+(COLSIZE)>SCREENCOLSIZE then ! If It Still Doesnt Fit
33674          let COL=SCREENCOLSIZE-(COLSIZE+1)  !Move It So It Does Fit
33676       end if 
33678       open #(WINDOW:=FNGETFILENUMBER) : "SROW="&STR$(ROW)&",SCOL="&STR$(COL)&",ROWS="&STR$(ROWSIZE)&",COLS="&STR$(COLSIZE)&",Border=S,Caption=Control "&STR$(CONTROL),display,outin 
33680       let FNOPENOBJECTATTRIBUTESWINDOW=WINDOW
33682    fnend 
33684 ! 
33686 Calculaterealposition: !  Calculates The Real Position Of An Object From Window 0
33688    def FNCALCULATEREALPOSITION(&ROW,&COL;___,EDITROW, EDITCOL)
33690       let FNGETEDITORPOSITION(EDITROW,EDITCOL)
33692       let ROW+=EDITROW-1
33694       let COL+=EDITCOL-1
33696    fnend 
