60836 ! 
60838 ! 
60840    dim SCREENSIZE(4), FONTSIZE(2)
60842 Readscreensize: ! Return The Screen Size Of Window 0 In Terms Of Rows And Columns
60844    def FNREADSCREENSIZE(&ROWS,&COLS;PARENTWINDOW)
60846       if ~FN42E then 
60848          let FNOLDREADSCREENSIZE(ROWS,COLS,PARENTWINDOW)
60850       else 
60852          let FILE(PARENTWINDOW,"USABLE_RECT",MAT SCREENSIZE)
60854          let FILE(PARENTWINDOW,"FONTSIZE",MAT FONTSIZE)
60856          let ROWS=(SCREENSIZE(4)/FONTSIZE(1))
60858          let COLS=(SCREENSIZE(3)/FONTSIZE(2))
60860       end if 
60862    fnend 
60864 ! 
60866    def FNOLDREADSCREENSIZE(&ROWS,&COLS;PARENTWINDOW,___,FFILE,STRING$*2000,SROW,SCOL,EROW,ECOL,POSITION)
60868       if ENV$("guimode")<>"ON" then 
60870          let ROWS=VAL(ENV$("screensize_rows")) conv IGNORE
60872          let COLS=VAL(ENV$("screensize_cols")) conv IGNORE
60874          if ~ROWS then let ROWS=24
60876          if ~COLS then let COLS=80
60878       else 
60880          execute "Status Files >[SESSION].tmp"
60882          open #(FFILE:=FNGETFILENUMBER) : "name=[SESSION].tmp",display,input 
60884 ! 
60886          do WHILE FILE(FFILE)=0
60888             linput #FFILE: STRING$ eof IGNORE
60890          loop UNTIL STRING$(1:5)="-----"
60892          do WHILE FILE(FFILE)=0
60894             linput #FFILE: STRING$ eof IGNORE
60896          loop UNTIL (LWRC$(STRING$)(1:4)="open") AND TRIM$(STRING$(POS(STRING$,"#")+1:POS(STRING$,"#")+5))=STR$(PARENTWINDOW)
60898          if FILE(FFILE)=0 then 
60900             linput #FFILE: STRING$ eof IGNORE
60902          end if 
60904 ! 
60906          close #FFILE: 
60908          execute "Free [SESSION].tmp" error Retryfivetimes
60910 ! 
60912          if (POSITION:=POS(UPRC$(STRING$),"SROW=")) then 
60914             let SROW=VAL(STRING$(POSITION+5:POS(STRING$,",",POSITION)-1)) conv IGNORE
60916          end if 
60918          if (POSITION:=POS(UPRC$(STRING$),"SCOL=")) then 
60920             let SCOL=VAL(STRING$(POSITION+5:POS(STRING$,",",POSITION)-1)) conv IGNORE
60922          end if 
60924          if (POSITION:=POS(UPRC$(STRING$),"EROW=")) then 
60926             let EROW=VAL(STRING$(POSITION+5:POS(STRING$,",",POSITION)-1)) conv IGNORE
60928          end if 
60930          if (POSITION:=POS(UPRC$(STRING$),"ECOL=")) then 
60932             let ECOL=VAL(STRING$(POSITION+5:POS(STRING$,",",POSITION)-1)) conv IGNORE
60934          end if 
60936          if SROW AND EROW then let ROWS=EROW-SROW+1
60938          if SCOL AND ECOL then let COLS=ECOL-SCOL+1
60940       end if 
60942    fnend 
60944 ! 
60946 ! **********************************************************************
60948 ! Functions To Get Info From Config.Sys Files. By Susan Smith. Updated By Gabriel Bakker - To Save Time By Running Only Once.
60950    dim CONFIGFILE$*300
60952    dim EXECUTABLEFILE$*300
60954 ! 
60956    def FNGETWBCFG$*255
60958       if CONFIGFILE$="" then 
60960          let FNREADCONFIGANDEXE
60962       end if 
60964       let FNGETWBCFG$=CONFIGFILE$
60966    fnend 
60968 ! 
60970    def FNGETBREXE$*255
60972       if EXECUTABLEFILE$="" then 
60974          let FNREADCONFIGANDEXE
60976       end if 
60978       let FNGETBREXE$=EXECUTABLEFILE$
60980    fnend 
60982 ! 
60984    dim CONFIGSTAT$*30000
60986    def FNREADCONFIGANDEXE(;___,CR$,FILENUMBER,QSTART,QEND)
60988       let CR$=HEX$("0D0A")
60990       execute "status files >TEMPFILE.[session]"
60992       if EXISTS("TEMPFILE.[session]") then 
60994          open #(FILENUMBER:=FNGETFILENUMBER): "name=TEMPFILE.[session],eol=none",display,input error IGNORE
60996          if ~FILE(FILENUMBER) then 
60998             linput #FILENUMBER: CONFIGSTAT$
61000             close #FILENUMBER: 
61002 ! 
61004             let QSTART=POS(UPRC$(CONFIGSTAT$),"CONFIG FILE")
61006             if QSTART>0 then 
61008                let CONFIGFILE$=CONFIGSTAT$(QSTART+13:QSTART+300)
61010                let QEND=POS(CONFIGFILE$,CR$)
61012                let CONFIGFILE$=CONFIGFILE$(1:QEND-1)
61014                if CONFIGFILE$(1:1)=":" then let CONFIGFILE$=OS_FILENAME$(CONFIGFILE$)
61016             end if 
61018 ! 
61020             let QSTART=POS(UPRC$(CONFIGSTAT$),"EXECUTABLE FILE")
61022             if QSTART>0 then 
61024                let EXECUTABLEFILE$=CONFIGSTAT$(QSTART+17:QSTART+300)
61026                let QEND=POS(EXECUTABLEFILE$,CR$)
61028                let EXECUTABLEFILE$=EXECUTABLEFILE$(1:QEND-1)
61030                if EXECUTABLEFILE$(1:1)=":" then let EXECUTABLEFILE$=OS_FILENAME$(EXECUTABLEFILE$)
61032             end if 
61034          end if 
61036       end if 
61038       if EXISTS("c:\TEMPFILE.[session]") then execute "free TEMPFILE.[session] -N"
61040    fnend 
61042 ! 
61044    def library FNMAKESCREEN(;LAYOUT$,LAUNCHSCREEN,___,NOLAUNCH,EXTERNALLAUNCH)
61046       if LAUNCHSCREEN then let EXTERNALLAUNCH=1 else let NOLAUNCH=1
61048       if FNWARNMESSAGE then execute "system"
61050       let FNSETTINGS                  !Also includes library linkage to FileIO
61052       let FNDEFINEINPUTMODES
61054       let FNOPENSCREENFILES(MAT SCREENIO$,MAT SCREENIO)
61056 ! 
61058       let SCREENIO$(SI_FILELAY)=LAYOUT$
61060       let FNGENERATESCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,NOLAUNCH,EXTERNALLAUNCH)  !Change it to always launch both screens in an external process or don't, depending on what they say.
61062    fnend 
61064 ! 
61066    dim GS_DATA$(7)
61068    dim GS_FIELD$(1)*64,GS_FIELDSPEC$(1)*32,GS_FIELDDESC$(1)*255,GS_DATESPEC$(1)*64,GS_LAUNCHLIST$(1)*64
61070 ! 
61072    def FNGENERATESCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;NOLAUNCH,EXTERNALLAUNCH,___,GENERATE,NEWFIELD,INDEX,LISTVIEWFIELD,RIGHTEDGE,TITLEFIELD,STOPHERE,OPENOTHERWINDOW,CAPTIONINDEX,CANCELBUTTON,SAVEBUTTON,ADDBUTTON,EDITBUTTON,DELETEBUTTON)
61074       let GS_LAYOUT=1 : let GS_BUILDLISTVIEW=2 : let GS_NAMELISTVIEW=3 : let GS_BUILDADDEDIT=4
61076       let GS_NAMEADDEDIT=5 : let GS_BUILDCOMBO=6 : let GS_NAMECOMBO=7
61078 ! 
61080       mat GS_LAUNCHLIST$(0)
61082 ! 
61084 ! .  ! Set Input Defaults
61086       let GS_DATA$(GS_BUILDLISTVIEW)=GS_DATA$(GS_BUILDADDEDIT)="^"
61088       if LEN(TRIM$(SCREENIO$(SI_FILELAY))) then 
61090          let GS_DATA$(GS_LAYOUT)=GS_LASTCHOICE$=TRIM$(SCREENIO$(SI_FILELAY))
61092          let GS_DATA$(GS_NAMELISTVIEW)=UPRC$(TRIM$(SCREENIO$(SI_FILELAY)))(1:14)&"LIST"
61094          let GS_DATA$(GS_NAMEADDEDIT)=UPRC$(TRIM$(SCREENIO$(SI_FILELAY)))(1:14)&"EDIT"
61096          let GS_DATA$(GS_NAMECOMBO)=UPRC$(TRIM$(SCREENIO$(SI_FILELAY)))(1:13)&"COMBO"
61098       end if 
61100       let GENERATE=FNINPUTMAINPAGE(MAT GS_DATA$)
61102       if GENERATE then 
61104 ! .     ! Put the generate screen code here.
61106          if GS_DATA$(GS_BUILDLISTVIEW)(1:1)="^" then ! Create Listview Screen
61108             let GENERATE=FNINPUTFIELDS(GS_DATA$(GS_LAYOUT),"Select fields for Listview",MAT GS_FIELD$,MAT GS_FIELDSPEC$,MAT GS_FIELDDESC$,MAT GS_DATESPEC$)
61110 ! 
61112             if GENERATE then 
61114                let FNREADSCREEN("",MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)  !Init Blank Screen
61116                let FNGENERATEHEADER(GS_DATA$(GS_NAMELISTVIEW),GS_DATA$(GS_LAYOUT),MAT SCREENIO$,MAT SCREENIO)
61118 ! 
61120                mat GAPS=(0)
61122                let TITLEFIELD=FNADDATITLE(GS_DATA$(GS_LAYOUT),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO)
61124                let FNSKIPAGAP
61126                let FNSKIPAGAP
61128 ! 
61130 ! .           ! Add a listview, make it big
61132                let LISTVIEWFIELD=FNADDLISTVIEW(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
61134                let HPOSITION(LISTVIEWFIELD)=10
61136                let WIDTH(LISTVIEWFIELD)=SCREENIO(SI_HSIZE)-18
61138                let HEIGHT(LISTVIEWFIELD)=SCREENIO(SI_VSIZE)-8
61140                let FGCOLOR$(LISTVIEWFIELD)="W"
61142                let BGCOLOR$(LISTVIEWFIELD)="W"
61144 ! 
61146 ! .           ! Add some columns
61148                for INDEX=1 to UDIM(MAT GS_FIELD$)
61150                   let NEWFIELD=FNADDCURRENTLISTCHLD(PARENT$(LISTVIEWFIELD),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,GS_FIELD$(INDEX),GS_FIELDDESC$(INDEX),GS_FIELDSPEC$(INDEX),GS_DATESPEC$(INDEX))
61152                next INDEX
61154 ! 
61156 ! .           ! Add a Filter box
61158                if FN43 then 
61160                   let NEWFIELD=FNADDFILTERBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,INPUTEDITORMODE,LISTVIEWFIELD)
61162                else 
61164                   let NEWFIELD=FNADDSEARCHBOX(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,INPUTEDITORMODE,LISTVIEWFIELD)
61166                end if 
61168 ! 
61170                let SPECWIDTH(LISTVIEWFIELD)=1  !Set it to search 1st column
61172                let FGCOLOR$(NEWFIELD)="W"
61174                let BGCOLOR$(NEWFIELD)="W"
61176 ! 
61178 ! .           ! Add Exit Buttons
61180                let FNADDEXITBUTTONS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
61182 ! 
61184 ! .           ! If there's also an add/edit screen then
61186                if GS_DATA$(GS_BUILDADDEDIT)(1:1)="^" then ! Create Add/Edit Screen
61188 ! .              ! Add Add/Edit/Delete buttons
61190                   let FNADDAEBUTTONS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,GS_DATA$(GS_NAMEADDEDIT))
61192                end if 
61194 ! 
61196 ! .           ! Save the screen
61198                if FNWRITESCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
61200                   let FNLAUNCHLATER(GS_DATA$(GS_NAMELISTVIEW))
61202                else 
61204                   let MSGBOX("Error saving listview screen.")
61206                   let STOPHERE=1
61208                end if 
61210             end if 
61212          end if 
61214 ! 
61216          if ~STOPHERE then 
61218             if GS_DATA$(GS_BUILDADDEDIT)(1:1)="^" then ! Create Add/Edit Screen
