47660 ! 
47670    def FNCHECKFORUPDATES(;___,CONNECTION,V,STRING$*1000,WINDOW)
47680       open #(WINDOW:=FNGETFILENUMBER): "srow=10,scol=40,rows=1,cols=30,Border=S",display,outin 
47690       print #WINDOW, fields "1,1,CC 30" : "Contacting Server..."
47700       open #(CONNECTION:=FNGETFILENUMBER): "name=http://www.sageax.com/downloads/ScreenIOVersion.txt, http=client",display,outin error IGNORE
47710       if FILE(CONNECTION)=0 then 
47720          print #CONNECTION: " "       !Required in BR 4.2. You have to print something to the connection before you can input from it. Optional in 4.3+
47730          linput #CONNECTION: STRING$ eof IGNORE
47740          close #CONNECTION: 
47750          close #WINDOW: 
47760          let V=-999
47770          let V=VAL(STRING$) conv IGNORE
47780          if V=-999 then 
47790             let MSGBOX("There was an error checking the latest version on the Server. Check your internet connection, or try again later."&HEX$("0D0A0D0A")&"If the problem persists, please contact Gabriel Bakker at gabriel.bakker@gmail.com.","Connection Failed","Ok","EXCL")
47800          else if V>FNVERSION then 
47810             if (2==MSGBOX("A newer version (ScreenIO v"&STR$(V)&") is available. (You're currently running ScreenIO v"&STR$(FNVERSION)&")."&HEX$("0D0A0D0A")&"Would you like to download the update from our website?","Update Y/N?","Yn","QST")) then 
47820                execute "sy -C -M start http://www.sageax.com/downloads/ScreenIO.zip"
47830             end if 
47840          else 
47850             let MSGBOX("Your version is up to date!"&HEX$("0D0A0D0A")&"You are running ScreenIO v"&STR$(FNVERSION)&", the current version.","ScreenIO is Up to Date","Ok","EXCL")
47860          end if 
47870       else 
47880          let MSGBOX("The server, www.sageax.com, could not be reached. Check your internet connection, or try again later."&HEX$("0D0A0D0A")&"If the problem persists, please contact Gabriel Bakker at gabriel.bakker@gmail.com.","Connection Failed","Ok","EXCL")
47890          close #WINDOW: 
47900          if FILE(CONNECTION)><-1 then close #CONNECTION: 
47910       end if 
47920    fnend 
47930 ! 
48000 !  #Autonumber# 48000,2
48002 !  ======================================================================
48004 !  ============================ Definitions =============================
48006 !  ======================================================================
48008 !  These Functions Define The Way The Windows Menu,  Buttons,  Etc Look
48010 !  And The Actions Associated With Them
48012 ! 
48014 Definewindowsmenu: !  Define The Windows Menu
48016    def FNDEFINEWINDOWSMENU(MAT M$, MAT PGM$, MAT STATUS$;___,INDEX)
48018 ! 
48020       restore Definewindowsmenu
48022       data "&File","","","  &New","new","E","  &Load","load","E","  &Save and Compile","save","E","  &Compile","recompileone","E","  Save and &Test","saveandtest","E","  -","","","  E&xport Screen","export","E","  &Import Screen","import","E","  -","","","  &Purge ScreenFlds File","purge","E","  Recompile &All Screens","recompile","E","  -","","","  &FileIO","fileio","E","  New &Window","newwindow","E","  &Run Application","brconsole","E","  &Explore Local Folder","windowsexplorer","E","  -","","","  &Quit","quit","E"
48024       data "&Options","","","  Click To &Move","clickmove","ECX","  Preview &Listviews","poplist","ECX","  Real-Time &Filters","filter","EC"
48026       data "&Tools","","","  Power &Search","search","E","  &Code Explorer","codeexplore","E","  -","","","  &Generate Screen","generatescreen","E","  &Generate Code","generatecode","E","  -","","","  &Orphaned Functions","orphanedfunctions","E"
48028       data "&Control","","","  Add &Field","field","E","  Add E&xit Buttons","exit buttons","E","  Add &Add/Edit Buttons","ae buttons","E","  Add Add/Edit/&Delete Buttons","aed buttons","E","  -","","","  Add &Text Box","text box","E","  Add &Caption","caption","E","  Add C&heck Box","check box","E","  Add C&ombo Box","combo box","E","  Add &Listview","listview","E","  Add &Search Box","search box","E","  Add F&ilter Box","filter box","E","  Add &Button","button","E","  Add &Picture","picture","E"
48030 ! .  ! data "  Add C&alendar Button","calendar","E"
48032       data "  Add &Frame","frame","E","  Add Sc&reen","screen","E","  -","","","  S&kip a Space","skip a space","E","  -","","","  Change Control T&ype","changetype","E"
48034       data "&Screen","","","  &Adjust Screen Size","resize screen","E","  &Move Controls","movemode","E","  &Draw Movement Grid","drawdots","E","  Visit &Checklist","debuglist","E","  -","","","  Set &FG Color","setfgcolor","E","  Set &BG Color","setbgcolor","E","  Select File &Layout","selectlayout","E","  Set &Events","events","E","  Set Tab &Order","taborder","E","  -","","","  Configure &Debug","debug","E","  Configure &Styles","protected","E","  -","","","  &Test Screen","test","E"
48036       data "&Help","","","  &Documentation","help","E","  &Recent Changes","recentchanges","E","  -","","","  Check for &Updates","checkupdates","E","  &About","about","E"
48038 ! 
48040       mat M$(0) : mat PGM$(0) : mat STATUS$(0)
48042 Readnextmenu: ! Read The Next Menu Option Here
48044       mat M$(UDIM(MAT M$)+1) : mat PGM$(UDIM(MAT M$)) : mat STATUS$(UDIM(MAT M$))
48046       read M$(UDIM(MAT M$)), PGM$(UDIM(MAT M$)), STATUS$(UDIM(MAT M$)) eof Donereadmenu
48048       goto Readnextmenu
48050 Donereadmenu: !  Finished Reading The Menu
48052 ! 
48054       let FNSETTINGS
48056 ! 
48058 ! .   ! Apply Checkmark Environment Variables
48060       for INDEX=1 to UDIM(MAT PGM$)
48062          if POS(UPRC$(STATUS$(INDEX)),"C") then 
48064             if POS(UPRC$(TRIM$(ENV$(PGM$(INDEX)))),"Y") then 
48066                if ~(POS(UPRC$(STATUS$(INDEX)),"X")) then 
48068                   let STATUS$(INDEX)=STATUS$(INDEX)&"X"
48070                end if 
48072             else if POS(UPRC$(TRIM$(ENV$(PGM$(INDEX)))),"N") then 
48074                let STATUS$(INDEX)=SREP$(UPRC$(STATUS$(INDEX)),"X","")
48076             else 
48078 ! .           ! No env dollar, use ini file, then update setenv
48080                if LWRC$(TRIM$(PGM$(INDEX))) = "clickmove" then ! #Select# lwrc$(trim$(Pgm$(Index))) #Case# "clickmove"
48082                   if SETTING_CLICKTOMOVE then 
48084                      if ~(POS(UPRC$(STATUS$(INDEX)),"X")) then 
48086                         let STATUS$(INDEX)=STATUS$(INDEX)&"X"
48088                      end if 
48090                   else 
48092                      let STATUS$(INDEX)=SREP$(UPRC$(STATUS$(INDEX)),"X","")
48094                   end if 
48096                else if LWRC$(TRIM$(PGM$(INDEX))) = "poplist" then ! #Case# "poplist"
48098                   if SETTING_PREVIEWLISTVIEWS then 
48100                      if ~(POS(UPRC$(STATUS$(INDEX)),"X")) then 
48102                         let STATUS$(INDEX)=STATUS$(INDEX)&"X"
48104                      end if 
48106                   else 
48108                      let STATUS$(INDEX)=SREP$(UPRC$(STATUS$(INDEX)),"X","")
48110                   end if 
48112                else if LWRC$(TRIM$(PGM$(INDEX))) = "filter" then ! #Case# "filter"
48114                   if SETTING_REALTIMEFILTERS then 
48116                      if ~(POS(UPRC$(STATUS$(INDEX)),"X")) then 
48118                         let STATUS$(INDEX)=STATUS$(INDEX)&"X"
48120                      end if 
48122                   else 
48124                      let STATUS$(INDEX)=SREP$(UPRC$(STATUS$(INDEX)),"X","")
48126                   end if 
48128 ! .           ! else if lwrc$(trim$(Pgm$(Index))) = "debugmode" then  ! #Case# "debugmode"
48130 ! .           !    if setting_DebugMode then
48132 ! .           !       if ~(Pos(Uprc$(Status$(Index)),"X")) then
48134 ! .           !          let Status$(Index)=Status$(Index)&"X"
48136 ! .           !       end if
48138 ! .           !    else 
48140 ! .           !       let Status$(Index)=Srep$(Uprc$(Status$(Index)),"X","")
48142 ! .           !    end if
48144                end if                 !#End Select#
48146 ! 
48148                if POS(UPRC$(STATUS$(INDEX)),"X") then 
48150                   let SETENV(PGM$(INDEX),"Y")
48152                else 
48154                   let SETENV(PGM$(INDEX),"N")
48156                end if 
48158             end if 
48160          end if 
48162       next INDEX
48164 ! 
48166    fnend 
48168 ! 
48170 Processwindowsmenu: !   Process A  Command From  The Windows Menu
48172    def FNPROCESSWINDOWSMENU(MAT SCREENIO$, MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,SCREEN$)
48174 ! 
48176       dim MENUNEW, MENULOAD, MENUSAVE, MENUQUIT, MENUABOUT, MENURECENTCHANGES, MENUHELP, MENUEVENTS, MENUTABORDER, MENUEXPORT, MENUIMPORT, MENURECOMPILE, MENUTEST, MENURECOMPILEONE, MENUPURGE, MENUDEBUG, MENUFGCOLOR, MENUBGCOLOR, MENUSELECTLAYOUT, MENUMOVEMENT, MENUDEBUGLIST, MENUFIELDSLIST, MENUADDCONTROL, MENUPROTECTED
48178 ! 
48180       let MENUNEW=1 : let MENULOAD=2 : let MENUSAVE=3 : let MENUQUIT=4 !:
            let MENUABOUT=5 : let MENUHELP=6 : let MENUEVENTS=7 : let MENUTABORDER=8 !:
            let MENUEXPORT=9 : let MENUIMPORT=10 : let MENURECOMPILE=11 : let MENUTEST=12 !:
