03000 !  #Autonumber# 3000,10
03010 !  ***************************************************************
03020 !  *                       Default Settings                      *
03030 !  ***************************************************************
03040 !  To modify these settings, make your own ScreenIO.ini file
03050 !  and place it in the root folder, or the screenio folder.
03060 !  copy and past the following default settings into it and
03070 !  modify them as necessary.
03080 ! 
03090 !  You want only the actual settings, not the function definition.
03100 ! 
03110    def FNDEFAULTSETTINGS
03120       let SETTING_FILEIOPATH$="fileio" !:
            let SETTING_SCREENIOPATH$="screenio" !:
            let SETTING_LEXIPATH$="lexi" !:
            let SETTING_CLOCKPATH$="clocks\clock" !:
            let SETTING_IMAGEPATH$="images" !:
            let SETTING_BREXECUTABLE$="auto" !:
            let SETTING_BATCHFILECOMMAND$="none" !:
            let SETTING_SCREENFOLDER$="screenio" !:
            let SETTING_FUNCTIONFOLDER$="function\" !:
            let SETTING_DATEFORMATDISPLAY$="m/d/cy"
03130       let SETTING_ENABLELOGGING=0 !:
            let SETTING_CLICKTOMOVE=1 !:
            let SETTING_PREVIEWLISTVIEWS=1 !:
            let SETTING_REALTIMEFILTERS=0 !:
            let SETTING_DETAILEDCOMMENTS=1 !:
            let SETTING_LOAD_FILTER=0 !:
            let SETTING_FUNCTIONSEL_FILTER=1 !:
            let SETTING_PAD_FUNCTIONS=0 !:
            let SETTING_DEBUG_LOCKED_MSG=0
03140    fnend 
03150 ! 
03160    def FNPARSESETTINGS
03170       if SETTING_FUNCTIONFOLDER$(LEN(SETTING_FUNCTIONFOLDER$):LEN(SETTING_FUNCTIONFOLDER$))><"\" then let SETTING_FUNCTIONFOLDER$=SETTING_FUNCTIONFOLDER$&"\"
03180       if SETTING_SCREENFOLDER$(LEN(SETTING_SCREENFOLDER$):LEN(SETTING_SCREENFOLDER$))="\" then let SETTING_SCREENFOLDER$=SETTING_SCREENFOLDER$(1:LEN(SETTING_SCREENFOLDER$)-1)
03190       if SETTING_IMAGEPATH$(LEN(SETTING_IMAGEPATH$):LEN(SETTING_IMAGEPATH$))="\" then let SETTING_IMAGEPATH$=SETTING_IMAGEPATH$(1:LEN(SETTING_IMAGEPATH$)-1)
03200       if SETTING_CLOCKPATH$(LEN(SETTING_CLOCKPATH$):LEN(SETTING_CLOCKPATH$))="\" then let SETTING_CLOCKPATH$=SETTING_CLOCKPATH$(1:LEN(SETTING_CLOCKPATH$)-1)
03210    fnend 
03220 ! 
04000 !  #Autonumber# 4000,10
04010 !  ***************************************************************
04020 !  *                       Screen Designer                       *
04030 !  ***************************************************************
04040 Screendesignerdims: ! Dimension Variables
04050 ! 
04060    dim SETTING_ENABLELOGGING, SETTING_PREVIEWLISTVIEWS, SETTING_REALTIMEFILTERS, SETTING_DETAILEDCOMMENTS, SETTING_DEBUG_LOCKED_MSG, SETTING_PAD_FUNCTIONS, SETTING_FUNCTIONSEL_FILTER, SETTING_FILEIOPATH$*255, SETTING_LEXIPATH$*255, SETTING_SCREENIOPATH$*255, SETTING_CLOCKPATH$*255, SETTING_BATCHFILECOMMAND$*1024, SETTING_BREXECUTABLE$*255, SETTING_IMAGEPATH$*255, SETTING_SCREENFOLDER$*255, SETTING_FUNCTIONFOLDER$*255, SETTING_DATEFORMATDISPLAY$*64, SETTING_CLICKTOMOVE
04070 ! 
04080 !  File Arrays
04090    dim SCREENIO$(1)*255, SCREENIO(1)
04100 ! 
04110 !  Screen Control Arrays
04120    dim CONTROLNAME$(1)*50, FIELDNAME$(1)*50, DESCRIPTION$(1)*255, VPOSITION(1), HPOSITION(1),FIELDTYPE$(1)*8, SPECWIDTH(1), WIDTH(1), HEIGHT(1), TRUEVALUE$(1)*60, FALSEVALUE$(1)*60, FUNCTION$(1)*255, PICTURE$(1)*255, PARENT$(1)*20, FGCOLOR$(1)*6, BGCOLOR$(1)*6, JUSTIFY$(1)*1, ATTR$(1)*128, MULTISELECT(1), GRIDLINES(1), PROTECTED(1), INVISIBLE(1), TOOLTIP$(1)*1000, CNVRTIN$(1)*255, CNVRTOUT$(1)*255, USERDATA$(1)*255
04130    dim FORM$(1)*2000, FIELDSSSUBS$(1)*50, FIELDSNSUBS$(1)*50, FRAMEWINDOWS(1), FRAMEKEYS$(1), FRAMESPECCONTROL$(1)*255
04140    dim FIELDSSSPEC$(1)*30, FIELDSNSPEC$(1)*30, FIELDSSDESCRIPTION$(1)*255, FIELDSNDESCRIPTION$(1)*255, FIELDSSPOS(1),FIELDSNPOS(1), FIELDSSDATEFORMAT$(1)*64, FIELDSNDATEFORMAT$(1)*64
04150    dim SELECTEDCONTROLS(1)
04160 ! 
04170 Endscreendesignerdims: ! 
04180 ! 
11800 !  #Autonumber# 11800,10
11810 Constants: ! Define Preprocessed Constants
11820 !   .   #Define#  [[Screencontrols]]   = "mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$, mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat Multiselect, mat UserData$, mat GridLines"
11830 !   .   #Define#  [[Screencontrols1]]  = "mat ControlName$,mat FieldName$,mat Description$,mat VPosition,mat HPosition,mat FieldType$,mat SpecWidth,mat Width,mat Height,mat TrueValue$,mat FalseValue$,mat Function$,mat Picture$,mat Parent$,mat FGColor$,mat BGColor$,mat Justify$, mat Attr$,"
11840 !   .   #Define#  [[Screencontrols2]]  = " mat Protected, mat Invisible, mat Tooltip$, mat CnvrtIn$, mat CnvrtOut$, mat MultiSelect,mat UserData$,mat GridLines"
11850 ! 
12000 !  #Autonumber# 12000,10
12010 Designscreen: !  Preforms Environment Testing And Launches The Screen Designer
12020    def library FNDESIGNSCREEN(;SCREENNAME$)
12030       if TRIM$(ENV$("guimode"))="" then 
12040          print "Please use a New GUI version of BR to design your screens."
12050       else 
12060          let FNLOADANDEDITSCREEN(SCREENNAME$)
12070       end if 
12080    fnend 
12090 ! 
12100    def FNAUTOCALLSCREEN(;SCREENNAME$)  !Helper function for self-calling screens.
12110       library : FNDESIGNSCREEN
12120       let FNDESIGNSCREEN(SCREENNAME$)
12130    fnend 
12140 ! 
13000 !  #Autonumber# 13000,10
13010 Loadandeditscreen: !  Load Files And Launch Main Screen Designer
13020    def FNLOADANDEDITSCREEN(;SCREENNAME$,___,WINDOW,TURNGUIBACKOFF, FSCREENIO,FSCREENFLD,SAVEONEXIT,OLDROWS,OLDCOLS,FORCEVISIBILITY)
13030 ! 
13050       let FNSETTINGS                  !Also includes library linkage to FileIO
13060 ! 
13070       let FNOPENSCREENFILES(MAT SCREENIO$,MAT SCREENIO)
13080 ! 
13090       if FNREADSCREEN(SCREENNAME$, MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then !  Successful Read
13100          let TURNGUIBACKOFF=(ENV$("guimode")=="OFF")
13110          if TURNGUIBACKOFF then execute "config gui on"
13120 ! 
13130          let FNSETFORCEVISIBILITY(0)
13140          let FNREADSCREENSIZE(OLDROWS,OLDCOLS)
13150 ! 
13160          let FNEDITSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
13170 ! 
13180          open #0: "rows="&STR$(OLDROWS)&",cols="&STR$(OLDCOLS),display,outin 
13190          if TURNGUIBACKOFF then execute "config gui off"
13200          let FNRESETFORCEVISIBILITY
13210       end if 
13220    fnend 
13230 ! 
14000 !  #Autonumber# 14000,10
14010 Editscreen: ! Main Screen Designer
14020    def FNEDITSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,WDEBUG,WEDITOR,WTOOLBAR,DEBUGSIZE,WACTIVEWINDOW,MODE,CONTROL,FUNCTION)
14030       dim DISPLAYREF_SCREENIO$(1)*255
14040       dim DISPLAYREF_SCREENIO(1)
14050 ! 
14060       mat DISPLAYREF_SCREENIO$(UDIM(MAT SCREENIO$))
14070       mat DISPLAYREF_SCREENIO(UDIM(MAT SCREENIO))
14080 ! 
14090       let FNDEFINEINPUTMODES
14100       do 
14110 ! 
14120 ! .   !  Update Screen If Anything Changes
14130          if ~(FNSAMEAS(MAT DISPLAYREF_SCREENIO$,MAT SCREENIO$) AND FNSAMEA(MAT DISPLAYREF_SCREENIO,MAT SCREENIO)) then 
14140             let FNREDRAWENTIRESCREEN(WTOOLBAR,WDEBUG,WEDITOR,MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
14150 ! 
14160             mat DISPLAYREF_SCREENIO$=SCREENIO$
14170             mat DISPLAYREF_SCREENIO=SCREENIO
14180 ! 
14190             let FNREPOPULATEFIELDSLISTVIEW(SCREENIO$(SI_FILELAY))
14200             let DISPLAYREF_SCREENIO$(SI_FILELAY)=SCREENIO$(SI_FILELAY)
14210          else 
14220 ! .      !  Update Field List Dropdown If It Changes
14230             if DISPLAYREF_SCREENIO$(SI_FILELAY)<>SCREENIO$(SI_FILELAY) then 
14240                let FNREPOPULATEFIELDSLISTVIEW(SCREENIO$(SI_FILELAY))
14250                let DISPLAYREF_SCREENIO$(SI_FILELAY)=SCREENIO$(SI_FILELAY)
14260             end if 
14270          end if 
14280          let FNCOLORDEBUGACTIVE((MODE==INPUTDEBUGMODE))
14290          let FNCOLORFIELDSACTIVE((MODE==INPUTFIELDLISTMODE))
14300          let FNCOLORATTRIBUTEACTIVE((MODE==INPUTATTRIBUTESMODE),MAT SCREENIO$,MAT SCREENIO)
14310 ! 
14320          if FNVALIDATEFIELDS(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then !  Update Validate Drop Down
14330 ! .        ! if we're in Movement mode or fields list mode, dont erase dots
14340             if (MODE=INPUTEDITORMOVEMODE OR MODE=INPUTEDITORMODE OR MODE=INPUTLISTVIEWMODE) AND (LASTMODE=INPUTEDITORMOVEMODE OR LASTMODE=INPUTEDITORMODE OR LASTMODE=INPUTLISTVIEWMODE) then 
14350                let FNRENDERSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
14360             else 
14370                let FNRENDERSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
14380             end if 
14390          end if 
14400 ! 
14410          let LASTMODE=MODE
14420          let FNCHECKPOINT(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)  !Save Undo Information
14430 ! 
14440          let FUNCTION=FNPREFORMINPUT(MODE,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
14450          let FNPROCESSCOMMAND(FUNCTION, CURFLD, MODE,CONTROL,MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
14460 ! 
14470       loop UNTIL MODE=QUITMODE
14480 ! 
14490       let FNTRYTOCLOSE(WEDITOR)
14500       let FNCLOSEDEBUGWINDOW
14510       let FNCLOSETOOLBARWINDOW
14520       let FNCLOSEEDITORWINDOW
14530 ! 
14540       let FNCLEARWINDOWSMENU
14550       let FNCLOSESCREENFILES
14560 ! 
14570       close #0: 
14580 ! 
14590    fnend 
14600 ! 
16000 !  #Autonumber# 16000,5
16005 ! *****************************************************************
16010 ! ************************ Main Input Loop ************************
16015 ! *****************************************************************
16020 Definemodes: !  Define The Input Spec Modes
16025    def FNDEFINEINPUTMODES
16030       dim INPUTATTRIBUTESMODE, INPUTFIELDLISTMODE, INPUTEDITORMODE, INPUTEDITORMOVEMODE, INPUTDEBUGMODE, QUITMODE, SELECTCOLORMODE, SELECTFILELAYMODE, INPUTLISTVIEWMODE, SELECTEVENTSMODE, SETTABORDERMODE, CONFIGUREDEBUGMODE, CONFIGUREPROTECTEDMODE
16035 ! 
16040       let INPUTATTRIBUTESMODE=1 !:
            let INPUTFIELDLISTMODE=2 !:
            let INPUTEDITORMODE=3 !:
            let INPUTEDITORMOVEMODE=4 !:
            let INPUTDEBUGMODE=5 !:
            let QUITMODE=6 !:
            let SELECTCOLORMODE=7 !:
            let SELECTFILELAYMODE=8 !:
            let INPUTLISTVIEWMODE=9 !:
            let SELECTEVENTSMODE=10 !:
            let SETTABORDERMODE=11 !:
            let CONFIGUREDEBUGMODE=12 !:
            let CONFIGUREPROTECTEDMODE=13
16045    fnend 
16050 ! 
16055 ! 
16060 ! 
16065 Preforminput: !  Preform Main Input Operation
16070    def FNPREFORMINPUT(&MODE,&CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,WINDOW,FUNCTION,TEMPCOLOR$,INDEX)
16075       dim INPUTTOOLTIPS$(1)*255, INPUTSPEC$(1)*60, INPUTDATA$(1)*255, INPUTTTIP$(1)*255, INPUTSUBS(1), INPUTSPEC$*40, INPUTDATA, INPUTONLYSPEC$(1)*60, INPUTONLYDATA$(1)*255, INPUTONLYTTIP$(1)*255
16080 ! 
16085 ! .  ! Ensure that Mode is Valid
16090       if MODE<1 OR MODE>13 then let MODE=INPUTFIELDLISTMODE
16095       if MODE=INPUTFIELDLISTMODE AND FNGETFIELDSCOUNT=0 then let MODE=INPUTATTRIBUTESMODE
16100       if (MODE=INPUTLISTVIEWMODE OR MODE=INPUTEDITORMODE OR MODE=INPUTEDITORMOVEMODE OR MODE=SETTABORDERMODE) AND (UDIM(FIELDTYPE$)=0) then let MODE=INPUTATTRIBUTESMODE
16105       if MODE=INPUTEDITORMODE AND UDIM(MAT FIELDTYPE$)>=CONTROL AND LWRC$(FIELDTYPE$(CONTROL))="listchld" then 
16110          let MODE=INPUTLISTVIEWMODE
16115          for INDEX=1 to UDIM(MAT PARENT$)
16120             if LWRC$(TRIM$(PARENT$(INDEX)))=LWRC$(TRIM$(PARENT$(CONTROL))) AND LWRC$(FIELDTYPE$(INDEX))="listview" then 
16125                let CONTROL=INDEX
16130             end if 
16135          next INDEX
16140       end if 
16145 ! 
16150       if MODE = INPUTATTRIBUTESMODE then ! #Select# Mode #Case# Inputattributesmode
16155          let WINDOW=FNGETATTRIBUTESWINDOW
16160          let FNGETATTRIBUTESPEC(MAT INPUTSPEC$,MAT INPUTDATA$,MAT INPUTTTIP$,MAT INPUTSUBS)
16165 ! 
16170          if CONTROL<>0 AND SRCH(MAT INPUTSUBS,CONTROL)>0 then 
16175             let CURFLD(SRCH(MAT INPUTSUBS,CONTROL))
16180          end if 
16185 ! 
16190          let FNFILETOSCREEN(MAT SCREENIO$,MAT SCREENIO, MAT INPUTDATA$,MAT INPUTSUBS)
16195 ! 
16200          let FNADJUSTCOLORBUTTONS(MAT INPUTSPEC$,MAT INPUTDATA$,MAT INPUTSUBS)
16205 ! 
16210          let FNCOPYATTRINPUTSPEC(MAT INPUTONLYSPEC$,MAT INPUTONLYDATA$,MAT INPUTONLYTTIP$,MAT INPUTSPEC$,MAT INPUTDATA$,MAT INPUTTTIP$,MAT INPUTSUBS)
16215          print #WINDOW, fields MAT INPUTSPEC$, help MAT INPUTTTIP$ : MAT INPUTDATA$
16220 ! 
16225          execute "config keyboard 16 2200"  !Ctrl-V To Ctrl-F8 (Fkey 34)
16230          execute "config keyboard 0B00 0A0A0A636F6E206B657920636C6561720D"  !Shift F1 Key To "con key clear<CR>"
16235          do 
16240             rinput #WINDOW, fields MAT INPUTONLYSPEC$, help MAT INPUTONLYTTIP$ : MAT INPUTONLYDATA$
16245             let IO_SCREENCODESUBS=SRCH(MAT INPUTSUBS,SI_SCREENCODE)
16250             let INPUTONLYDATA$(IO_SCREENCODESUBS)=FNCLEANSCREENCODE$(INPUTONLYDATA$(IO_SCREENCODESUBS))  !This keeps things from screwing up for leading spaces
16255 ! 
16260             if FKEY=34 then 
16265                let CLIPBOARD$=ENV$("clipboard")(1:999999)
16270                if POS(CLIPBOARD$,"#!!") AND POS(CLIPBOARD$,"_#_") then 
16275                   if FNADDCONTROLSFROMCLIPBOARD(CLIPBOARD$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
16280 ! .                  ! Select new controls
16285                      let OLDSIZE=UDIM(MAT SELECTEDCONTROLS)
16290                      mat SELECTEDCONTROLS(UDIM(MAT CONTROLNAME$))=(0)
16295                      mat SELECTEDCONTROLS(OLDSIZE+1:UDIM(MAT SELECTEDCONTROLS))=(1)
16300 ! 
16305                      let CONTROL=OLDSIZE+1
16310                      let MODE=INPUTEDITORMOVEMODE
16315                   end if 
16320                else 
16325                   print #WINDOW, fields INPUTONLYSPEC$(CURFLD) : CLIPBOARD$(1:255) soflow Ignoreclipboard
16330                   let INPUTONLYDATA$(CURFLD)=CLIPBOARD$(1:255)
16335 Ignoreclipboard: ! Continue
16340                   let CURFLD(CURFLD,FKEY)
16345                end if 
16350             end if 
16355          loop WHILE FKEY=34 AND MODE<>INPUTEDITORMOVEMODE
16360          execute "config keyboard clear"
16365 ! 
16370          let FNCOPYBACKATTRINPUTSPEC(MAT INPUTONLYSPEC$,MAT INPUTONLYDATA$,MAT INPUTSPEC$,MAT INPUTDATA$,MAT INPUTSUBS)
16375          let FNSCREENTOFILE(MAT SCREENIO$, MAT SCREENIO, MAT INPUTDATA$, MAT INPUTSUBS)
16380 ! 
16385          if SCREENIO(SI_VSIZE)<1 then let SCREENIO(SI_VSIZE)=1
16390          if SCREENIO(SI_HSIZE)<1 then let SCREENIO(SI_HSIZE)=1
16395          if SCREENIO(SI_VSIZE)>120 then let SCREENIO(SI_VSIZE)=120
16400          if SCREENIO(SI_HSIZE)>220 then let SCREENIO(SI_HSIZE)=220
16405 ! 
16410          let CONTROL=INPUTSUBS(CURFLD)
16415          let FUNCTION=FKEY
16420 ! 
16425       else if MODE = INPUTFIELDLISTMODE then ! #Case#  Inputfieldlistmode
16430          let WINDOW=FNGETFIELDSWINDOW
16435          let FNGETFIELDSSPEC(INPUTSPEC$)
16440          rinput #WINDOW, fields INPUTSPEC$ : INPUTDATA
16445          let FUNCTION=FKEY
16450 ! 
16455       else if MODE = INPUTEDITORMODE then ! #Case# Inputeditormode
16460          let FUNCTION=FNPREFORMEDITORINPUT(MODE,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
16465 ! 
16470       else if MODE = INPUTEDITORMOVEMODE then ! #Case# Inputeditormovemode
16475          let FUNCTION=FNPREFORMOBJECTMOVEMENT(MODE,CONTROL,MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
16480 ! 
16485       else if MODE = INPUTLISTVIEWMODE then ! #Case# Inputlistviewmode
16490          let FUNCTION=FNINPUTLISTVIEWFIELDS(MODE,CONTROL,MAT SCREENIO$,MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
16495 ! 
16500       else if MODE = INPUTDEBUGMODE then ! #Case# Inputdebugmode
16505          let WINDOW=FNGETDEBUGWINDOW
16510          let FNGETDEBUGSPEC(INPUTSPEC$)
16515          rinput #WINDOW, fields INPUTSPEC$ : INPUTDATA
16520          let FUNCTION=FKEY
16525 ! 
16530       else if MODE = SELECTCOLORMODE then ! #Case# Selectcolormode
16535          let TEMPCOLOR$=FNCOLORPICKER$(SCREENIO$(CONTROL),0,0,"Select Color",FUNCTION)
16540          if FNVALIDHEXCOLOR(TEMPCOLOR$) OR TEMPCOLOR$="" then 
16545             let SCREENIO$(CONTROL)=TEMPCOLOR$
16550          end if 
16555          let MODE=INPUTATTRIBUTESMODE
16560 ! 
16565       else if MODE = SELECTFILELAYMODE then ! #Case# Selectfilelaymode
16570          let SCREENIO$(CONTROL)=FNSELECTLAYOUT$(SCREENIO$(CONTROL),FUNCTION)
16575 ! .     ! let Displayref_Screenio$(Si_Filelay)="" ! Trigger redraw no matter what
16580          let MODE=INPUTATTRIBUTESMODE
16585 ! 
16590       else if MODE = SELECTEVENTSMODE then ! #Case# Selecteventsmode
16595          let FNSELECTEVENTS(MAT SCREENIO$,MAT SCREENIO,FUNCTION)
16600          let MODE=INPUTATTRIBUTESMODE
16605 ! 
16610       else if MODE = SETTABORDERMODE then ! #Case# Settabordermode
16615          let FNSETTABORDER(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,FUNCTION)
16620          let MODE=INPUTATTRIBUTESMODE
16625 ! 
16630       else if MODE = CONFIGUREDEBUGMODE then ! #Case# Configuredebugmode
16635          let FNCONFIGUREDEBUG(MAT SCREENIO$,MAT SCREENIO,FUNCTION)
16640          let MODE=INPUTATTRIBUTESMODE
16645 ! 
16650       else if MODE = CONFIGUREPROTECTEDMODE then ! #Case# ConfigureProtectedMode
16655          let FNCONFIGUREPROTECTED(MAT SCREENIO$,MAT SCREENIO,FUNCTION)
16660          let MODE=INPUTATTRIBUTESMODE
16665 ! 
16670       end if                          !#End Select#
16675       let FNPREFORMINPUT=FUNCTION
16680 ! 
16685    fnend 
16690 ! 
16695    def FNCLEANSCREENCODE$(TEXT$;___,Z,GOODLETTERS$,OUTTEXT$)
16700       let TEXT$=TRIM$(UPRC$(TEXT$))
16705       for Z=1 to LEN(TEXT$)
16710          if POS("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.",TEXT$(Z:Z)) then 
16715             let OUTTEXT$=OUTTEXT$&TEXT$(Z:Z)
16720          end if 
16725       next Z
16730       let FNCLEANSCREENCODE$=OUTTEXT$
16735    fnend 
16740 ! 
16745 Adjustcolorbuttons: ! Adjust The Colors Of The Buttons For The Attributes Window
16750    def FNADJUSTCOLORBUTTONS(MAT SPEC$,MAT DATA$,MAT SUBS;___,INDEX)
16755       for INDEX=1 to UDIM(MAT SUBS)
16760          if SUBS(INDEX) = SI_FGCOLOR OR SUBS(INDEX) = SI_BGCOLOR then ! #Select# Subs(Index) #Case# Si_Fgcolor # Si_Bgcolor
16765             let FNADJUSTSPECCOLOR(SPEC$(INDEX),DATA$(INDEX))
16770          end if                       !#End Select#
16775       next INDEX
16780    fnend 
16785 ! 
16790 Copyattrinputspec: ! Copy The Attr Input Specs To The Input Spec Arrays
16795    def FNCOPYATTRINPUTSPEC(MAT INSPEC$,MAT INDATA$, MAT INTTIP$, MAT ALLSPEC$, MAT ALLDATA$, MAT ALLTTIP$, MAT ALLSUBS;___,INDEX,COUNT)
16800       mat INSPEC$(0) : mat INDATA$(0)
16805       for INDEX=1 to UDIM(MAT ALLSUBS)
16810          if ALLSUBS(INDEX) = SI_FGCOLOR OR ALLSUBS(INDEX) = SI_BGCOLOR OR ALLSUBS(INDEX) = SI_FILELAY OR ALLSUBS(INDEX) = 0 then ! #Select# Allsubs(Index) #Case# Si_Fgcolor # Si_Bgcolor # Si_Filelay # 0
16815          else ! #Case Else#
16820             let COUNT=UDIM(MAT INSPEC$)+1
16825             mat INSPEC$(COUNT) : mat INDATA$(COUNT) : mat INTTIP$(COUNT)
16830             let INSPEC$(COUNT)=ALLSPEC$(INDEX)
16835             let INDATA$(COUNT)=ALLDATA$(INDEX)
16840             let INTTIP$(COUNT)=ALLTTIP$(INDEX)
16845          end if                       !#End Select#
16850       next INDEX
16855    fnend 
16860 ! 
16865 Copybackattrinputspec: ! Copy The Attr Input Specs Back To The All Spec Arrays
16870    def FNCOPYBACKATTRINPUTSPEC(MAT INSPEC$,MAT INDATA$, MAT ALLSPEC$, MAT ALLDATA$, MAT ALLSUBS;___,INDEX,COUNT)
16875       let COUNT=0
16880       for INDEX=1 to UDIM(MAT ALLSUBS)
16885          if ALLSUBS(INDEX) = SI_FGCOLOR OR ALLSUBS(INDEX) = SI_BGCOLOR OR ALLSUBS(INDEX) = SI_FILELAY OR ALLSUBS(INDEX) = 0 then ! #Select# Allsubs(Index) #Case# Si_Fgcolor # Si_Bgcolor # Si_Filelay # 0
16890          else ! #Case Else#
16895             let COUNT+=1
16900             let ALLSPEC$(INDEX)=INSPEC$(COUNT)
16905             let ALLDATA$(INDEX)=INDATA$(COUNT)
16910          end if                       !#End Select#
16915       next INDEX
16920    fnend 
16925 ! 
16930 Processcommand: !  Process The User Command Here
16935    def FNPROCESSCOMMAND(FUNCTION,FIELD,&MODE,&CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,BUTTON$,MENUCOMPLETE,NEWCONTROL,RELATEDCONTROL)
16940 ! 
16945       if FUNCTION=98 then 
16950          let MENUCOMPLETE = FNPROCESSWINDOWSMENU(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
16955          if MENUCOMPLETE = MENUQUIT then ! #Select# Menucomplete #Case# Menuquit
16960             let MODE=QUITMODE
16965          else if MENUCOMPLETE = MENULOAD OR MENUCOMPLETE = MENUNEW then ! #Case# Menuload # MenuNew
16970             let FNCLOSEFRAMEWINDOWS
16975             mat GAPS=(0)
16980             let MODE=INPUTATTRIBUTESMODE
16985             let CONTROL=1
16990          else if MENUCOMPLETE = MENUEVENTS then ! #Case# Menuevents
16995             let MODE=SELECTEVENTSMODE
17000          else if MENUCOMPLETE = MENUDEBUG then ! #Case# Menudebug
17005             let MODE=CONFIGUREDEBUGMODE
17010          else if MENUCOMPLETE = MENUPROTECTED then ! #Case# MenuProtected
17015             let MODE=CONFIGUREPROTECTEDMODE
17020          else if MENUCOMPLETE = MENUTABORDER then ! #Case# Menutaborder
17025             let MODE=SETTABORDERMODE
17030          else if MENUCOMPLETE = MENUFGCOLOR then ! #Case# Menufgcolor
17035             let MODE=SELECTCOLORMODE
17040             let CONTROL=SI_FGCOLOR
17045          else if MENUCOMPLETE = MENUBGCOLOR then ! #Case# Menubgcolor
17050             let MODE=SELECTCOLORMODE
17055             let CONTROL=SI_BGCOLOR
17060          else if MENUCOMPLETE = MENUSELECTLAYOUT then ! #Case# Menuselectlayout
17065             let MODE=SELECTFILELAYMODE
17070             let CONTROL=SI_FILELAY
17075          else if MENUCOMPLETE = MENUMOVEMENT then ! #Case# Menumovement
17080             let MODE=INPUTEDITORMOVEMODE
17085          else if MENUCOMPLETE = MENUDEBUGLIST then ! #Case# Menudebuglist
17090             let MODE=INPUTDEBUGMODE
17095          else if MENUCOMPLETE = MENUFIELDSLIST then ! #Case# Menufieldslist
17100             let MODE=INPUTFIELDSLISTMODE
17105          else if MENUCOMPLETE = MENUADDCONTROL then ! #Case# Menuaddcontrol
17110             let BUTTON$=MENU$
17115          end if                       !#End Select#
17120       end if 
17125 ! 
17130       if FUNCTION=93 OR FKEY=93 then 
17135          if FNOKTOPROCEED(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
17140             let MODE=QUITMODE
17145          end if 
17150       end if 
17155 ! 
17160       if FUNCTION=99 then 
17165          mat SELECTEDCONTROLS=(0)
17170          let MODE=INPUTATTRIBUTESMODE
17175          let CONTROL=1
17180       end if 
17185 ! 
17190       if FUNCTION>=1100 AND FUNCTION<1200 then !  Process Attributes Click
17195          let CONTROL = FNSETINPUTATTRIBUTESCONTROL(FUNCTION)
17200          if CONTROL = SI_FGCOLOR OR CONTROL = SI_BGCOLOR then ! #Select# Control #Case# Si_Fgcolor # Si_Bgcolor
17205             let MODE=SELECTCOLORMODE
17210          else if CONTROL = SI_FILELAY then ! #Case# Si_Filelay
17215             let MODE=SELECTFILELAYMODE
17220          else if CONTROL = 0 then ! #Case# 0
17225             if FUNCTION-1100=20 then 
17230                let MODE=SELECTEVENTSMODE
17235             else if FUNCTION-1100=21 then 
17240                let MODE=SETTABORDERMODE
17245             end if 
17250          else ! #Case Else#
17255             let MODE=INPUTATTRIBUTESMODE
17260          end if                       !#End Select#
17265       end if 
17270 ! 
17275       if FUNCTION=1200 OR (FUNCTION=201 AND MODE=INPUTDEBUGMODE) then !  Process Debug Click/Enter
17280          if MODE=INPUTDEBUGMODE then 
17285             let FNREADDEBUG(MODE,CONTROL)
17290          else 
17295             let MODE=INPUTDEBUGMODE
17300             let CONTROL=0
17305          end if 
17310       end if 
17315 ! 
17320       if FUNCTION=44 then ! Alt-Z Is Undo
17325          let FNUNDO(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
17330          mat SELECTEDCONTROLS=(0)
17335       end if 
17340       if FUNCTION=19 then ! Alt-R Is Redo
17345          let FNREDO(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
17350       end if 
17355 ! 
17360       if FUNCTION=1300 OR (FUNCTION=201 AND MODE=INPUTFIELDLISTMODE) then !  Process Fieldslist Click/Enter
17365          if MODE=INPUTFIELDLISTMODE then 
17370             let NEWCONTROL = FNADDANDCOLORCURRENTFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,MAT SCREENIO$,MAT SCREENIO)
17375          else 
17380             let MODE=INPUTFIELDLISTMODE
17385             let CONTROL=0
17390          end if 
17395       end if 
17400 ! 
17405       if FUNCTION>=1400 AND FUNCTION<1500 then !  Process Button
17410          let BUTTON$ = LWRC$(FNREADBUTTON$(FUNCTION))
17415       end if 
17420 ! 
17425       if LEN(BUTTON$) then 
17430          let FNPROCESSBUTTON(BUTTON$,MODE,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
17435       end if 
17440 ! 
17445       if FUNCTION>=1500 AND FUNCTION<=1500+UDIM(MAT CONTROLNAME$) then 
17450          if (CONTROL=FUNCTION-1500) then 
17455             if (MODE=INPUTEDITORMOVEMODE) then 
17460                let MODE=INPUTEDITORMODE
17465             else if MODE=INPUTEDITORMODE AND LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="listview" then 
17470                let MODE=INPUTLISTVIEWMODE
17475             else 
17480                let MODE=INPUTEDITORMOVEMODE
17485             end if 
17490          else 
17495             let MODE=INPUTEDITORMOVEMODE
17500          end if 
17505          let CONTROL=FUNCTION-1500
17510       end if 
17515    fnend 
17520 ! 
18000 !  #Autonumber# 18000,2
18002 ! *****************************************************************
18004 ! ************************ Set Tab Order **************************
18006 ! *****************************************************************
18008 Settaborder: ! Opens A Child Window To Select Event Handler Functions
18010    def FNSETTABORDER(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;&FUNCTION,___,INDEX,WINDOW)
18012       dim NEWTABORDER(1)
18014       dim OLDTABINDEX(1)
18016       dim NEWTABORDERSPEC$(1)*255
18018 ! 
18020       let WINDOW=FNGETEDITORWINDOW
18022 ! 
18024       if WINDOW then 
18026          mat NEWTABORDER(0)
18028          mat OLDTABINDEX(0)
18030          mat NEWTABORDERSPEC$(0)
18032          for INDEX=1 to UDIM(MAT FIELDTYPE$)
18034             if FNISINPUT(FIELDTYPE$(INDEX)) then 
18036                mat NEWTABORDER(UDIM(MAT NEWTABORDER)+1)
18038                let NEWTABORDER(UDIM(MAT NEWTABORDER))=UDIM(MAT NEWTABORDER)
18040                mat NEWTABORDERSPEC$(UDIM(MAT NEWTABORDER))
18042                let NEWTABORDERSPEC$(UDIM(MAT NEWTABORDER))=STR$(VPOSITION(INDEX))&","&STR$(HPOSITION(INDEX))&","&STR$(WIDTH(INDEX))&"/NZ 3,S/#000000:#99CCFF,"&STR$(1500+UDIM(MAT NEWTABORDER))
18044                mat OLDTABINDEX(UDIM(MAT NEWTABORDER))
18046                let OLDTABINDEX(UDIM(MAT NEWTABORDER))=INDEX
18048             end if 
18050          next INDEX
18052 ! 
18054          if UDIM(MAT NEWTABORDER) then 
18056             let INDEX=0
18058 ! 
18060             let FNCHANGEFORCEVISIBILITY(1)
18062             do 
18064                print #WINDOW, fields MAT NEWTABORDERSPEC$ : MAT NEWTABORDER
18066                input #0, fields "1,2,C 1,AEX" : KEY$
18068                let FUNCTION=FKEY
18070 ! 
18072                if FUNCTION>1500 AND FUNCTION<=1500+UDIM(MAT NEWTABORDER) then 
18074                   let INDEX+=1
18076                   let NEWTABORDER(FUNCTION-1500)=INDEX
18078                   let NEWTABORDERSPEC$(FUNCTION-1500)=NEWTABORDERSPEC$(FUNCTION-1500)(1:POS(NEWTABORDERSPEC$(FUNCTION-1500),",",-1)-1)&",-1"
18080                   let NEWTABORDERSPEC$(FUNCTION-1500)=SREP$(NEWTABORDERSPEC$(FUNCTION-1500),"#99CCFF","#00FF00")
18082                end if 
18084             loop UNTIL INDEX=UDIM(MAT NEWTABORDER) OR FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR FUNCTION=44 OR FUNCTION=19 OR ((FUNCTION>1100) AND (FUNCTION<1500))
18086             let FNCHANGEFORCEVISIBILITY(0)
18088 ! 
18090             if INDEX=UDIM(MAT NEWTABORDER) then 
18092                let FNSETSORTARRAYS(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
18094                for INDEX=1 to UDIM(MAT NEWTABORDER)
18096                   let FNGETSORTARRAY(OLDTABINDEX(INDEX),OLDTABINDEX(NEWTABORDER(INDEX)),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
18098                next INDEX
18100             end if 
18102          end if 
18104       end if 
18106    fnend 
18108 ! 
18110    dim SRT_CONTROLNAME$(1)*50, SRT_FIELDNAME$(1)*50, SRT_DESCRIPTION$(1)*255
18112    dim SRT_VPOSITION(1), SRT_HPOSITION(1), SRT_FIELDTYPE$(1)*8, SRT_SPECWIDTH(1), SRT_WIDTH(1), SRT_HEIGHT(1)
18114    dim SRT_TRUEVALUE$(1)*60, SRT_FALSEVALUE$(1)*60
18116    dim SRT_FUNCTION$(1)*255, SRT_PICTURE$(1)*255, SRT_PARENT$(1)*20
18118    dim SRT_FGCOLOR$(1)*6, SRT_BGCOLOR$(1)*6, SRT_JUSTIFY$(1)*1, SRT_ARRT$(1)*128, SRT_MULTISELECT(1), SRT_GRIDLINES(1)
18120    dim SRT_PROTECTED(1), SRT_INVISIBLE(1), SRT_TOOLTIP$(1)*1000, SRT_CNVRTIN$(1)*255, SRT_CNVRTOUT$(1)*255, SRT_USERDATA$(1)*255
18122 ! 
18124 Setsortarrays: !  Store The Controls In The Sort Arrays
18126    def FNSETSORTARRAYS(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
18128       mat SRT_CONTROLNAME$(UDIM(MAT CONTROLNAME$)) = CONTROLNAME$ !:
            mat SRT_FIELDNAME$(UDIM(MAT FIELDNAME$)) = FIELDNAME$ !:
            mat SRT_DESCRIPTION$(UDIM(MAT DESCRIPTION$)) = DESCRIPTION$ !:
            mat SRT_VPOSITION(UDIM(MAT VPOSITION)) = VPOSITION !:
            mat SRT_HPOSITION(UDIM(MAT HPOSITION)) = HPOSITION !:
            mat SRT_FIELDTYPE$(UDIM(MAT FIELDTYPE$)) = FIELDTYPE$ !:
            mat SRT_SPECWIDTH(UDIM(MAT SPECWIDTH)) = SPECWIDTH !:
            mat SRT_WIDTH(UDIM(MAT WIDTH)) = WIDTH !:
            mat SRT_HEIGHT(UDIM(MAT HEIGHT)) = HEIGHT !:
            mat SRT_TRUEVALUE$(UDIM(MAT TRUEVALUE$)) = TRUEVALUE$ !:
            mat SRT_FALSEVALUE$(UDIM(MAT FALSEVALUE$)) = FALSEVALUE$ !:
            mat SRT_FUNCTION$(UDIM(MAT FUNCTION$)) = FUNCTION$
18130       mat SRT_PICTURE$(UDIM(MAT PICTURE$)) = PICTURE$ !:
            mat SRT_PARENT$(UDIM(MAT PARENT$)) = PARENT$ !:
            mat SRT_FGCOLOR$(UDIM(MAT FGCOLOR$)) = FGCOLOR$ !:
            mat SRT_BGCOLOR$(UDIM(MAT BGCOLOR$)) = BGCOLOR$ !:
            mat SRT_JUSTIFY$(UDIM(MAT JUSTIFY$)) = JUSTIFY$ !:
            mat SRT_ATTR$(UDIM(MAT ATTR$)) = ATTR$ !:
            mat SRT_PROTECTED(UDIM(MAT PROTECTED)) = PROTECTED !:
            mat SRT_INVISIBLE(UDIM(MAT INVISIBLE)) = INVISIBLE !:
            mat SRT_TOOLTIP$(UDIM(MAT TOOLTIP$)) = TOOLTIP$ !:
            mat SRT_CNVRTIN$(UDIM(MAT CNVRTIN$)) = CNVRTIN$ !:
            mat SRT_CNVRTOUT$(UDIM(MAT CNVRTOUT$)) = CNVRTOUT$ !:
            mat SRT_MULTISELECT(UDIM(MAT MULTISELECT)) = MULTISELECT !:
            mat SRT_GRIDLINES(UDIM(MAT GRIDLINES)) = GRIDLINES !:
            mat SRT_USERDATA$(UDIM(MAT USERDATA$))=USERDATA$
18132    fnend 
18134 ! 
18136 Getsortarray: ! Sort The Selected Control Out Of The Sort Arrays
18138    def FNGETSORTARRAY(FROM,TO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
18140       let CONTROLNAME$(TO) = SRT_CONTROLNAME$(FROM) !:
            let FIELDNAME$(TO) = SRT_FIELDNAME$(FROM) !:
            let DESCRIPTION$(TO) = SRT_DESCRIPTION$(FROM) !:
            let VPOSITION(TO) = SRT_VPOSITION(FROM) !:
            let HPOSITION(TO) = SRT_HPOSITION(FROM) !:
            let FIELDTYPE$(TO) = SRT_FIELDTYPE$(FROM) !:
            let SPECWIDTH(TO) = SRT_SPECWIDTH(FROM) !:
            let WIDTH(TO) = SRT_WIDTH(FROM) !:
            let HEIGHT(TO) = SRT_HEIGHT(FROM) !:
            let TRUEVALUE$(TO) = SRT_TRUEVALUE$(FROM) !:
            let FALSEVALUE$(TO) = SRT_FALSEVALUE$(FROM) !:
            let FUNCTION$(TO) = SRT_FUNCTION$(FROM) !:
            let PICTURE$(TO) = SRT_PICTURE$(FROM) !:
            let PARENT$(TO) = SRT_PARENT$(FROM)
18142       let FGCOLOR$(TO) = SRT_FGCOLOR$(FROM) !:
            let BGCOLOR$(TO) = SRT_BGCOLOR$(FROM) !:
            let JUSTIFY$(TO) = SRT_JUSTIFY$(FROM) !:
            let ATTR$(TO) = SRT_ATTR$(FROM) !:
            let PROTECTED(TO) = SRT_PROTECTED(FROM) !:
            let INVISIBLE(TO) = SRT_INVISIBLE(FROM) !:
            let TOOLTIP$(TO) = SRT_TOOLTIP$(FROM) !:
            let CNVRTIN$(TO) = SRT_CNVRTIN$(FROM) !:
            let CNVRTOUT$(TO) = SRT_CNVRTOUT$(FROM) !:
            let MULTISELECT(TO) = SRT_MULTISELECT(FROM) !:
            let GRIDLINES(TO) = SRT_GRIDLINES(FROM) !:
            let USERDATA$(TO) = SRT_USERDATA$(FROM)
18144    fnend 
18146 ! 
18148 ! *****************************************************************
18150 ! ************************* Move Control **************************
18152 ! *****************************************************************
18154    dim DOTSPRINTED, SETTINGTEMPDOTS
18156    dim CLIPBOARD$*999999
18158 Preformobjectmovement: ! Highlight An Object And Allow Them To Move It Around.
18160    def FNPREFORMOBJECTMOVEMENT(&MODE, &CONTROL, MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,NEWV,NEWH,NEWW,NEWHTH,KEY$,FUNCTION,TH,TV,EXITMOVEMENT,WWINDOW,RELATEDCONTROL,INDEX,OLDSIZE,OLDSETTING,SUCCESS)
18162       if CONTROL<1 then let CONTROL=1
18164       if CONTROL>UDIM(MAT FIELDTYPE$) then let CONTROL=UDIM(MAT FIELDTYPE$)
18166       if CONTROL>0 then 
18168          let WWINDOW=FNGETEDITORWINDOW
18170 ! 
18172          if WWINDOW then 
18174             let NEWV=VPOSITION(CONTROL) : let NEWH=HPOSITION(CONTROL)
18176             let NEWW=WIDTH(CONTROL) : let NEWHTH=HEIGHT(CONTROL)
18178 ! 
18180             execute "config keyboard 0B 0F00"  !Up To Shift F5  (Fkey 15)
18182             execute "config keyboard 0A 1000"  !Dn To Shift F6  (Fkey 16)
18184             execute "config keyboard 0E 1100"  !Lf To Shift F7  (Fkey 17)
18186             execute "config keyboard 0C 1200"  !Rt To Shift F8  (Fkey 18)
18188             execute "config keyboard 08 2000"  !<- To (Fkey 32) - 19 Is Taken
18190             execute "config keyboard 20 1400"  !Sp To Shift F10 (Fkey 20)
