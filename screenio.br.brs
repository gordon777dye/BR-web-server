49164 Showabout: !   *****  This Shows  The About Page
49166    def FNSHOWABOUT(;___,ABOUT, COVER, X$, FUNCTION )
49168       open #(ABOUT:=FNGETFILENUMBER) : "srow=5,scol=20,rows=23,cols=60,Border=S", display,outin 
49170       print #ABOUT, fields "2,8,P 7/18,,35" : SETTING_IMAGEPATH$&"\sageax.png:ISOTROPIC"
49172       print #ABOUT, fields "2,30,CC 30" : "Screen IO Library - Designer"
49174       print #ABOUT, fields "4,30,CC 30" : "Copyright 2008 Gabriel Bakker"
49176       print #ABOUT, fields "6,30,CC 30" : "Sage AX"
49178       print #ABOUT, fields "7,30,CC 30,U/#0000FF:W,35" : "http://www.sageax.com"
49180       print #ABOUT, fields "10,2,CC 58" : "This library was designed as an addon for FileIO"
49182       print #ABOUT, fields "11,2,CC 58" : "to be an all in one program generation system."
49184       print #ABOUT, fields "13,2,CC 58" : "Special thanks to Chris Shields for helping to salvage"
49186       print #ABOUT, fields "14,2,CC 58" : "the source code after a disasterous theft."
49188       print #ABOUT, fields "16,2,CC 58" : "Special thanks to Susan Smith for support, testing,"
49190       print #ABOUT, fields "17,2,CC 58" : "ideas and extensive encouragement during development."
49192       print #ABOUT, fields "19,2,CC 58" : "Special thanks to Mikhail Zheleznov for encouragement,"
49194       print #ABOUT, fields "20,2,CC 58" : "enthusiasm, many new ideas, and hours of testing."
49196       print #ABOUT, fields "22,15,CC 10,/W:W,B37;22,35,CC 10,/W:W,B38" : "OK","Thank You"
49198       print #ABOUT, fields "23,40,CR 20" : "Version "&STR$(FNVERSION)
49200       open #(COVER:=FNGETFILENUMBER) : "srow=12,scol=2,rows=1,cols=3,parent="&STR$(ABOUT),display, outin 
49202       do 
49204          let X$=""
49206          rinput #ABOUT, fields "12,3,CU 1,AEX" : X$
49208          let FUNCTION=FKEY
49210          if FUNCTION = 35 then ! #Select# Function #Case# 35
49212             execute "system -c -M start http://www.sageax.com"
49214          else if FUNCTION = 38 OR X$="S" then ! #Case# 38 or X$="S"
49216             let FNSUPPORTERS
49218          end if                       !#End Select#
49220       loop UNTIL FUNCTION=37 OR FUNCTION=99 OR FUNCTION=0 OR FKEY=93 OR FUNCTION=93  !Esc,  Enter,  Or Ok Button or exit button
49222       close #COVER: 
49224       close #ABOUT: 
49226    fnend 
49228 ! 
49230    dim SUPPORTERSPEC$(8)*32, SUPPORTEROUT$(8)*64, SUPPORTERNAME$(36)*64
49232 ! 
49234 Supporters: !   *****  This Shows  The About Page
49236    def FNSUPPORTERS(;___,ABOUT,X$,FUNCTION,I,SMOOTHSCROLL,COUNTER,NAMEINDEX,DISPLAYFROM,SUPPRESSNAMES,INDEX,LOOPING)
49238       let SUPPORTERNAME$(1)="Susan Smith" !:
            let SUPPORTERNAME$(2)="SMS Software" !:
            let SUPPORTERNAME$(3)="" !:
            let SUPPORTERNAME$(4)="Bart Fusco" !:
            let SUPPORTERNAME$(5)="Foxtree IPM" !:
            let SUPPORTERNAME$(6)="" !:
            let SUPPORTERNAME$(7)="Percy J Comeaux" !:
            let SUPPORTERNAME$(8)="Erisa" !:
            let SUPPORTERNAME$(9)="" !:
            let SUPPORTERNAME$(10)="George Tisdale" !:
            let SUPPORTERNAME$(11)="Tisdale Certified Public Accountants" !:
            let SUPPORTERNAME$(12)="" !:
            let SUPPORTERNAME$(13)="Luis Gomez and John Curry" !:
            let SUPPORTERNAME$(14)="Commercial Legal Software" !:
            let SUPPORTERNAME$(15)="" !:
            let SUPPORTERNAME$(16)="Pete Klug"
49240       let SUPPORTERNAME$(17)="Commercial Testing Laboratory" !:
            let SUPPORTERNAME$(18)="" !:
            let SUPPORTERNAME$(19)="Richard Forrester" !:
            let SUPPORTERNAME$(20)="Sys-Corp Services" !:
            let SUPPORTERNAME$(21)="" !:
            let SUPPORTERNAME$(22)="Mike Storlazzi" !:
            let SUPPORTERNAME$(23)="Payrolls Unlimited" !:
            let SUPPORTERNAME$(24)="" !:
            let SUPPORTERNAME$(25)="Doug Meenen and Stephen Koger" !:
            let SUPPORTERNAME$(26)="Management Advisory Computer Systems" !:
            let SUPPORTERNAME$(27)="" !:
            let SUPPORTERNAME$(28)="and of course" !:
            let SUPPORTERNAME$(29)="Gordon Dye and Gary Hoff for their" !:
            let SUPPORTERNAME$(30)="" !:
            let SUPPORTERNAME$(31)="hard work and dedication to the Business Rules language," !:
            let SUPPORTERNAME$(32)="which has kept us all in business doing what we love."
49242       let SUPPORTERNAME$(33)="" !:
            let SUPPORTERNAME$(34)="Without Business Rules, there would be no ScreenIO." !:
            let SUPPORTERNAME$(35)=" " !:
            let SUPPORTERNAME$(36)=""
49244 ! 
49246 ! 
49248       let SMOOTHSCROLL=FN43
49250       execute "CONFIG ATTRIBUTE [SUPPORTERS] ,font=Arial:Large:Slant"
49252       open #(ABOUT:=FNGETFILENUMBER) : "srow=9,scol=26,rows=21,cols=60,FONT.LABELS=Comic Sans MS:bold:slant,Border=S", display,outin 
49254       print #ABOUT, fields "1,2,CC 58,[SUPPORTERS]" : "Special Thanks to all the early adopters of ScreenIO"
49256       print #ABOUT, fields "21,2,CC 58,[SUPPORTERS]" : "Without you, this would never have been possible."
49258 ! 
49260       let DISPLAYFROM=1
49262 ! .  ! let SuppressNames=1
49264 ! 
49266       do 
49268          if COUNTER=0 then 
49270             let COUNTER=20
49272             let NAMEINDEX+=1
49274             if NAMEINDEX=37 then 
49276 ! .           ! End of the list. Pause, then restart.
49278                let FNPAUSE(2,X$,FUNCTION)
49280                let NAMEINDEX=1
49282                let DISPLAYFROM=1
49284                let INCREMENT=0
49286                let SUPPRESSNAMES=7
49288             end if 
49290             if SUPPRESSNAMES then let SUPPRESSNAMES-=1
49292          end if 
49294          if SMOOTHSCROLL then let COUNTER-=1 else let COUNTER-=10
49296 ! 
49298          if COUNTER=0 then 
49300             if DISPLAYFROM<=UDIM(SUPPORTEROUT$) AND SUPPORTEROUT$(DISPLAYFROM)><"" then 
49302                if MOD(DISPLAYFROM,2)=1 then ! Scrunch up together at the top
49304                   let INCREMENT-=1
49306                   let COUNTER+=10
49308                end if 
49310                let DISPLAYFROM+=1
49312             end if 
49314          end if 
49316 ! 
49318          if DISPLAYFROM>8 then 
49320             let DISPLAYFROM=1
49322             let INCREMENT=0
49324 ! .        ! End of page. Pause, set SuppressNames to clear, and cont.
49326             let FNPAUSE(2,X$,FUNCTION)
49328             let SUPPRESSNAMES=UDIM(MAT SUPPORTEROUT$)
49330          end if 
49332 ! 
49334 ! .     ! Calculate the specs
49336          for I=4 to 18 step 2
49338             let SUPPORTERSPEC$((I/2)-1)=STR$(I+INCREMENT+(COUNTER/10))&",1,CC 60"
49340          next I
49342 ! 
49344 ! .     ! Calculate the names
49346          mat SUPPORTEROUT$=("")
49348          if NAMEINDEX<=8 then 
49350             mat SUPPORTEROUT$(8-NAMEINDEX+1:8)=SUPPORTERNAME$(1:NAMEINDEX)
49352          else 
49354             mat SUPPORTEROUT$(1:8)=SUPPORTERNAME$(NAMEINDEX-8+1:NAMEINDEX)
49356          end if 
49358 ! 
49360 ! .     ! Apply SuppresssNames to clear screen of prev. page
49362          for INDEX=1 to UDIM(MAT SUPPORTEROUT$)
49364             if INDEX<=SUPPRESSNAMES then 
49366                let SUPPORTEROUT$(INDEX)=""
49368             end if 
49370          next INDEX
49372 ! 
49374 ! .     ! Print
49376 ! .     ! print #About, fields "1,1,N 3;2,1,N 3" : DisplayFrom,Increment   ! Debug output
49378          print #ABOUT, fields MAT SUPPORTERSPEC$(DISPLAYFROM:UDIM(MAT SUPPORTEROUT$)) : MAT SUPPORTEROUT$(DISPLAYFROM:UDIM(MAT SUPPORTEROUT$))
49380 ! 
49382 ! .     ! Pause
49384          if FUNCTION><99 AND UNHEX$(X$)><"6300" AND X$><" " then 
49386             if SMOOTHSCROLL then 
49388                let FNPAUSE(.05,X$,FUNCTION)
49390             else 
49392                let FNPAUSE(.5,X$,FUNCTION)
49394             end if 
49396          end if 
49398 ! 
49400 ! .     ! Erase
49402          if ~SMOOTHSCROLL then 
49404             mat SUPPORTEROUT$=("")
49406             print #ABOUT, fields MAT SUPPORTERSPEC$(DISPLAYFROM:UDIM(MAT SUPPORTEROUT$)) : MAT SUPPORTEROUT$(DISPLAYFROM:UDIM(MAT SUPPORTEROUT$))
49408          end if 
49410 ! 
49412 ! .     ! Loop
49414       loop UNTIL FUNCTION=99 OR FUNCTION=93 OR UNHEX$(X$)="6300" OR X$=" "  !Press Esc or space bar
49416       close #ABOUT: 
49418    fnend 
49420 ! 
49422    def FNPAUSE(HOWLONG;&THEKEY$,&FUNCTION,___,LOOPING)
49424       do 
49426          let SLEEP(.05)
49428          let X$=KSTAT$
49430          let FUNCTION=FKEY
49432          let LOOPING+=.05
49434       loop UNTIL LOOPING>=HOWLONG OR FUNCTION=99 OR UNHEX$(X$)="6300"
49436    fnend 
49438 ! 
49440 Oktoproceed: !   ***** Ask The User If They Are Sure  They Want  To Proceed
49442    def FNOKTOPROCEED(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,CHOICE,YES,NO,CANCEL)
49444       if (~FNCHECKSCREENARRAYS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)) then 
49446          let YES=2 : let NO=3 : let CANCEL=4  !Msgbox Return Constants
49448          let CHOICE=MSGBOX("Warning: If you proceed you will overwrite all changes. Would you like to save your changes first?","Save Changes?","Ync","QST")
49450          if CHOICE = YES then ! #Select# Choice #Case# Yes
49452             if FNWRITESCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
49454                let FNOKTOPROCEED=1
49456             else 
49458                let FNOKTOPROCEED=0
49460             end if 
49462          else if CHOICE = NO then ! #Case# No
49464             let FNOKTOPROCEED=1
49466          else if CHOICE = CANCEL then ! #Case# Cancel
49468             let FNOKTOPROCEED=0
49470          else ! #Case Else#
49472             let FNOKTOPROCEED=0
49474          end if                       !#End Select#
49476       else 
49478          let FNOKTOPROCEED=1
49480       end if 
49482    fnend 
49484 ! 
49486    dim P_SCREENIO$(1)*255,P_SCREENIO(1), P_CONTROLNAME$(1)*50, P_FIELDNAME$(1)*50, P_DESCRIPTION$(1)*255, P_VPOSITION(1), P_HPOSITION(1), P_FIELDTYPE$(1)*8, P_SPECWIDTH(1), P_WIDTH(1), P_HEIGHT(1), P_TRUEVALUE$(1)*60, P_FALSEVALUE$(1)*60, P_FUNCTION$(1)*255, P_PICTURE$(1)*255, P_PARENT$(1)*20, P_FGCOLOR$(1)*6, P_BGCOLOR$(1)*6, P_JUSTIFY$(1)*1, P_ATTR$(1)*128, P_MULTISELECT(1),P_GRIDLINES(1), P_PROTECTED(1), P_INVISIBLE(1), P_TOOLTIP$(1)*1000,P_CNVRTIN$(1)*255,P_CNVRTOUT$(1)*255, P_USERDATA$(1)*255
49488 ! 
49490 Preservescreenarrays: !  Preserves The State Of The Screen Arrays
49492    def FNPRESERVESCREENARRAYS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
49494 ! 
49496       mat P_SCREENIO$(UDIM(MAT SCREENIO$)) = SCREENIO$ !:
            mat P_SCREENIO(UDIM(MAT SCREENIO)) = SCREENIO !:
            mat P_CONTROLNAME$(UDIM(MAT CONTROLNAME$)) = CONTROLNAME$ !:
            mat P_FIELDNAME$(UDIM(MAT FIELDNAME$)) = FIELDNAME$ !:
            mat P_DESCRIPTION$(UDIM(MAT DESCRIPTION$)) = DESCRIPTION$ !:
            mat P_VPOSITION(UDIM(MAT VPOSITION)) = VPOSITION !:
            mat P_HPOSITION(UDIM(MAT HPOSITION)) = HPOSITION !:
            mat P_FIELDTYPE$(UDIM(MAT FIELDTYPE$)) = FIELDTYPE$ !:
            mat P_SPECWIDTH(UDIM(MAT SPECWIDTH)) = SPECWIDTH !:
            mat P_WIDTH(UDIM(MAT WIDTH)) = WIDTH !:
            mat P_HEIGHT(UDIM(MAT HEIGHT)) = HEIGHT
49498       mat P_TRUEVALUE$(UDIM(MAT TRUEVALUE$)) = TRUEVALUE$ !:
            mat P_FALSEVALUE$(UDIM(MAT FALSEVALUE$)) = FALSEVALUE$ !:
            mat P_FUNCTION$(UDIM(MAT FUNCTION$)) = FUNCTION$ !:
            mat P_PICTURE$(UDIM(MAT PICTURE$)) = PICTURE$ !:
            mat P_PARENT$(UDIM(MAT PARENT$)) = PARENT$ !:
            mat P_FGCOLOR$(UDIM(MAT FGCOLOR$)) = FGCOLOR$ !:
            mat P_BGCOLOR$(UDIM(MAT BGCOLOR$)) = BGCOLOR$ !:
            mat P_JUSTIFY$(UDIM(MAT JUSTIFY$)) = JUSTIFY$ !:
            mat P_ATTR$(UDIM(MAT ATTR$)) = ATTR$ !:
            mat P_PROTECTED(UDIM(MAT PROTECTED)) = PROTECTED !:
            mat P_INVISIBLE(UDIM(MAT INVISIBLE)) = INVISIBLE
49500       mat P_TOOLTIP$(UDIM(MAT TOOLTIP$)) = TOOLTIP$ !:
            mat P_CNVRTIN$(UDIM(MAT CNVRTIN$)) = CNVRTIN$ !:
            mat P_CNVRTOUT$(UDIM(MAT CNVRTOUT$)) = CNVRTOUT$ !:
            mat P_MULTISELECT(UDIM(MAT MULTISELECT)) = MULTISELECT !:
            mat P_GRIDLINES(UDIM(MAT GRIDLINES)) = GRIDLINES !:
            mat P_USERDATA$(UDIM(MAT USERDATA$)) = USERDATA$
49502    fnend 
49504 ! 
49506 Checkscreenarrays: !  Check The State Of The Screen Arrays
49508    def FNCHECKSCREENARRAYS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,FAILED)
49510 ! 
49512       let FAILED=FAILED OR (~FNSAMEAS(MAT SCREENIO$,MAT P_SCREENIO$))
49514       let FAILED=FAILED OR (~FNSAMEA(MAT SCREENIO,MAT P_SCREENIO))
49516       let FAILED=FAILED OR (~FNSAMEAS(MAT CONTROLNAME$,MAT P_CONTROLNAME$))
49518       let FAILED=FAILED OR (~FNSAMEAS(MAT FIELDNAME$,MAT P_FIELDNAME$))
49520       let FAILED=FAILED OR (~FNSAMEAS(MAT DESCRIPTION$,MAT P_DESCRIPTION$))
49522       let FAILED=FAILED OR (~FNSAMEA(MAT VPOSITION,MAT P_VPOSITION))
49524       let FAILED=FAILED OR (~FNSAMEA(MAT HPOSITION,MAT P_HPOSITION))
49526       let FAILED=FAILED OR (~FNSAMEAS(MAT FIELDTYPE$,MAT P_FIELDTYPE$))
49528       let FAILED=FAILED OR (~FNSAMEA(MAT SPECWIDTH,MAT P_SPECWIDTH))
49530       let FAILED=FAILED OR (~FNSAMEA(MAT WIDTH,MAT P_WIDTH))
49532       let FAILED=FAILED OR (~FNSAMEA(MAT HEIGHT,MAT P_HEIGHT))
49534       let FAILED=FAILED OR (~FNSAMEAS(MAT TRUEVALUE$,MAT P_TRUEVALUE$))
49536       let FAILED=FAILED OR (~FNSAMEAS(MAT FALSEVALUE$,MAT P_FALSEVALUE$))
49538       let FAILED=FAILED OR (~FNSAMEAS(MAT FUNCTION$,MAT P_FUNCTION$))
49540       let FAILED=FAILED OR (~FNSAMEAS(MAT PICTURE$,MAT P_PICTURE$))
49542       let FAILED=FAILED OR (~FNSAMEAS(MAT PARENT$,MAT P_PARENT$))
49544       let FAILED=FAILED OR (~FNSAMEAS(MAT FGCOLOR$,MAT P_FGCOLOR$))
49546       let FAILED=FAILED OR (~FNSAMEAS(MAT BGCOLOR$,MAT P_BGCOLOR$))
49548       let FAILED=FAILED OR (~FNSAMEAS(MAT JUSTIFY$,MAT P_JUSTIFY$))
49550       let FAILED=FAILED OR (~FNSAMEAS(MAT ATTR$,MAT P_ATTR$))
49552       let FAILED=FAILED OR (~FNSAMEA(MAT PROTECTED,MAT P_PROTECTED))
49554       let FAILED=FAILED OR (~FNSAMEA(MAT PROTECTED,MAT P_PROTECTED))
49556       let FAILED=FAILED OR (~FNSAMEAS(MAT TOOLTIP$,MAT P_TOOLTIP$))
49558       let FAILED=FAILED OR (~FNSAMEAS(MAT CNVRTIN$,MAT P_CNVRTIN$))
49560       let FAILED=FAILED OR (~FNSAMEAS(MAT CNVRTOUT$,MAT P_CNVRTOUT$))
49562       let FAILED=FAILED OR (~FNSAMEA(MAT MULTISELECT,MAT P_MULTISELECT))
49564       let FAILED=FAILED OR (~FNSAMEA(MAT GRIDLINES,MAT P_GRIDLINES))
49566       let FAILED=FAILED OR (~FNSAMEAS(MAT USERDATA$,MAT P_USERDATA$))
49568       let FNCHECKSCREENARRAYS=(~FAILED)
49570    fnend 
49572 ! 
49574 ! .! Change the width without marking the screen data as changed.
49576    def FNCHANGESPECWIDTH(INDEX,WIDTH)
49578       let SPECWIDTH(INDEX)=WIDTH
49580       if UDIM(MAT SPECWIDTH)=UDIM(MAT P_SPECWIDTH) then 
49582          let P_SPECWIDTH(INDEX)=WIDTH
49584       end if 
49586 ! .   ! if the sizes dont match then we're changed anyway.
49588       if UDIM(MAT SPECWIDTH)=UDIM(MAT UNDO_SPECWIDTH) then 
49590          let UNDO_SPECWIDTH(INDEX)=WIDTH
49592       end if 
49594    fnend 
49596 ! 
49598    dim UNDO_SCREENIO$(1)*255,UNDO_SCREENIO(1)
49600    dim UNDO_CONTROLNAME$(1)*50, UNDO_FIELDNAME$(1)*50, UNDO_DESCRIPTION$(1)*255
49602    dim UNDO_VPOSITION(1), UNDO_HPOSITION(1), UNDO_FIELDTYPE$(1)*8, UNDO_SPECWIDTH(1), UNDO_WIDTH(1), UNDO_HEIGHT(1)
49604    dim UNDO_TRUEVALUE$(1)*60, UNDO_FALSEVALUE$(1)*60
49606    dim UNDO_FUNCTION$(1)*255, UNDO_PICTURE$(1)*255, UNDO_PARENT$(1)*20
49608    dim UNDO_FGCOLOR$(1)*6, UNDO_BGCOLOR$(1)*6, UNDO_JUSTIFY$(1)*1, UNDO_ATTR$(1)*128, UNDO_MULTISELECT(1), UNDO_GRIDLINES(1)
49610    dim UNDO_PROTECTED(1), UNDO_INVISIBLE(1), UNDO_TOOLTIP$(1)*1000,UNDO_CNVRTIN$(1)*255,UNDO_CNVRTOUT$(1)*255, UNDO_USERDATA$(1)*255
49612 ! 
49614    def FNPRESERVEUNDO(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
49616       mat UNDO_SCREENIO$(UDIM(MAT SCREENIO$)) = SCREENIO$
49618       mat UNDO_SCREENIO(UDIM(MAT SCREENIO)) = SCREENIO
49620       mat UNDO_CONTROLNAME$(UDIM(MAT CONTROLNAME$)) = CONTROLNAME$
49622       mat UNDO_FIELDNAME$(UDIM(MAT FIELDNAME$)) = FIELDNAME$
49624       mat UNDO_DESCRIPTION$(UDIM(MAT DESCRIPTION$)) = DESCRIPTION$
49626       mat UNDO_VPOSITION(UDIM(MAT VPOSITION)) = VPOSITION
49628       mat UNDO_HPOSITION(UDIM(MAT HPOSITION)) = HPOSITION
49630       mat UNDO_FIELDTYPE$(UDIM(MAT FIELDTYPE$)) = FIELDTYPE$
49632       mat UNDO_SPECWIDTH(UDIM(MAT SPECWIDTH)) = SPECWIDTH
49634       mat UNDO_WIDTH(UDIM(MAT WIDTH)) = WIDTH
49636       mat UNDO_HEIGHT(UDIM(MAT HEIGHT)) = HEIGHT
49638       mat UNDO_TRUEVALUE$(UDIM(MAT TRUEVALUE$)) = TRUEVALUE$
49640       mat UNDO_FALSEVALUE$(UDIM(MAT FALSEVALUE$)) = FALSEVALUE$
49642       mat UNDO_FUNCTION$(UDIM(MAT FUNCTION$)) = FUNCTION$
49644       mat UNDO_PICTURE$(UDIM(MAT PICTURE$)) = PICTURE$
49646       mat UNDO_PARENT$(UDIM(MAT PARENT$)) = PARENT$
49648       mat UNDO_FGCOLOR$(UDIM(MAT FGCOLOR$)) = FGCOLOR$
49650       mat UNDO_BGCOLOR$(UDIM(MAT BGCOLOR$)) = BGCOLOR$
49652       mat UNDO_JUSTIFY$(UDIM(MAT JUSTIFY$)) = JUSTIFY$
49654       mat UNDO_ATTR$(UDIM(MAT ATTR$)) = ATTR$
49656       mat UNDO_PROTECTED(UDIM(MAT PROTECTED)) = PROTECTED
49658       mat UNDO_INVISIBLE(UDIM(MAT INVISIBLE)) = INVISIBLE
49660       mat UNDO_TOOLTIP$(UDIM(MAT TOOLTIP$)) = TOOLTIP$
49662       mat UNDO_CNVRTIN$(UDIM(MAT CNVRTIN$)) = CNVRTIN$
49664       mat UNDO_CNVRTOUT$(UDIM(MAT CNVRTOUT$)) = CNVRTOUT$
49666       mat UNDO_MULTISELECT(UDIM(MAT MULTISELECT)) = MULTISELECT
49668       mat UNDO_GRIDLINES(UDIM(MAT GRIDLINES)) = GRIDLINES
49670       mat UNDO_USERDATA$(UDIM(MAT USERDATA$)) = USERDATA$
49672    fnend 
49674 ! 
49676    def FNCHECKUNDO(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,FAILED)
49678       let FAILED=FAILED OR (~FNSAMEAS(MAT SCREENIO$,MAT UNDO_SCREENIO$))
49680       let FAILED=FAILED OR (~FNSAMEA(MAT SCREENIO,MAT UNDO_SCREENIO))
49682       let FAILED=FAILED OR (~FNSAMEAS(MAT CONTROLNAME$,MAT UNDO_CONTROLNAME$))
49684       let FAILED=FAILED OR (~FNSAMEAS(MAT FIELDNAME$,MAT UNDO_FIELDNAME$))
49686       let FAILED=FAILED OR (~FNSAMEAS(MAT DESCRIPTION$,MAT UNDO_DESCRIPTION$))
49688       let FAILED=FAILED OR (~FNSAMEA(MAT VPOSITION,MAT UNDO_VPOSITION))
49690       let FAILED=FAILED OR (~FNSAMEA(MAT HPOSITION,MAT UNDO_HPOSITION))
49692       let FAILED=FAILED OR (~FNSAMEAS(MAT FIELDTYPE$,MAT UNDO_FIELDTYPE$))
49694       let FAILED=FAILED OR (~FNSAMEA(MAT SPECWIDTH,MAT UNDO_SPECWIDTH))
49696       let FAILED=FAILED OR (~FNSAMEA(MAT WIDTH,MAT UNDO_WIDTH))
49698       let FAILED=FAILED OR (~FNSAMEA(MAT HEIGHT,MAT UNDO_HEIGHT))
49700       let FAILED=FAILED OR (~FNSAMEAS(MAT TRUEVALUE$,MAT UNDO_TRUEVALUE$))
49702       let FAILED=FAILED OR (~FNSAMEAS(MAT FALSEVALUE$,MAT UNDO_FALSEVALUE$))
49704       let FAILED=FAILED OR (~FNSAMEAS(MAT FUNCTION$,MAT UNDO_FUNCTION$))
49706       let FAILED=FAILED OR (~FNSAMEAS(MAT PICTURE$,MAT UNDO_PICTURE$))
49708       let FAILED=FAILED OR (~FNSAMEAS(MAT PARENT$,MAT UNDO_PARENT$))
49710       let FAILED=FAILED OR (~FNSAMEAS(MAT FGCOLOR$,MAT UNDO_FGCOLOR$))
49712       let FAILED=FAILED OR (~FNSAMEAS(MAT BGCOLOR$,MAT UNDO_BGCOLOR$))
49714       let FAILED=FAILED OR (~FNSAMEAS(MAT JUSTIFY$,MAT UNDO_JUSTIFY$))
49716       let FAILED=FAILED OR (~FNSAMEAS(MAT ATTR$,MAT UNDO_ATTR$))
49718       let FAILED=FAILED OR (~FNSAMEA(MAT PROTECTED,MAT UNDO_PROTECTED))
49720       let FAILED=FAILED OR (~FNSAMEA(MAT PROTECTED,MAT UNDO_PROTECTED))
49722       let FAILED=FAILED OR (~FNSAMEAS(MAT TOOLTIP$,MAT UNDO_TOOLTIP$))
49724       let FAILED=FAILED OR (~FNSAMEAS(MAT CNVRTIN$,MAT UNDO_CNVRTIN$))
49726       let FAILED=FAILED OR (~FNSAMEAS(MAT CNVRTOUT$,MAT UNDO_CNVRTOUT$))
49728       let FAILED=FAILED OR (~FNSAMEA(MAT MULTISELECT,MAT UNDO_MULTISELECT))
49730       let FAILED=FAILED OR (~FNSAMEA(MAT GRIDLINES,MAT UNDO_GRIDLINES))
49732       let FAILED=FAILED OR (~FNSAMEAS(MAT USERDATA$,MAT UNDO_USERDATA$))
49734       let FNCHECKUNDO=(~FAILED)
49736    fnend 
49738 ! 
49740 ! .! This function checks the Created By and Modified By lists to determine if this ScreenIO operation
49742 ! .!  is worked on by more then one programmer or by just one.
49744    def FNMULTIPROGRAMMERS(MAT CLIST$,MAT MLIST$;___,INDEX,MULTIPROGRAMMERS,PROGRAMMER$*30)
49746       for INDEX=1 to UDIM(MAT CLIST$)
49748          if TRIM$(CLIST$(INDEX))><"" then 
49750             if TRIM$(PROGRAMMER$)="" then let PROGRAMMER$=CLIST$(INDEX)
49752             if TRIM$(LWRC$(PROGRAMMER$))><TRIM$(LWRC$(CLIST$(INDEX))) then 
49754                let MULTIPROGRAMMERS=1
49756                let INDEX=UDIM(MAT CLIST$)+1  !Exit the for loop
49758             end if 
49760          end if 
49762       next INDEX
49764       if ~MULTIPROGRAMMERS then 
49766          for INDEX=1 to UDIM(MAT MLIST$)
49768             if TRIM$(MLIST$(INDEX))><"" then 
49770                if TRIM$(PROGRAMMER$)="" then let PROGRAMMER$=MLIST$(INDEX)
49772                if TRIM$(LWRC$(PROGRAMMER$))><TRIM$(LWRC$(MLIST$(INDEX))) then 
49774                   let MULTIPROGRAMMERS=1
49776                   let INDEX=UDIM(MAT MLIST$)+1  !Exit the for loop
49778                end if 
49780             end if 
49782          next INDEX
49784       end if 
49786       let FNMULTIPROGRAMMERS=MULTIPROGRAMMERS
49788    fnend 
49790 ! 
49792 ! 
60000 !  #Autonumber# 60000,2
60002 Selectscreen: !  Print Screen Selection Window
60004    def FNSELECTSCREEN$*64(;SELECTOTHERFILES,___,WINDOW,SELECTEDSCREEN$*64,CHOICE,ROWSUB,S$*255,TEMPSCREEN$*255,HELPTEXT$*255,HL$,FILTERBOX$*64,SHOWUSERNAMES)
60006       dim SS_CAPTION$(6),SS_WIDTH(6),SS_SPEC$(6)
60008       dim SS_SCREENCODES$(1),SS_CREATEDATES(1),SS_MODIFYDATES(1),SS_VERSION(1),SS_CREATEUSER$(1)*30,SS_MODIFYUSER$(1)*30,SS_PROJECT$(1)*255,SS_NOTES$(1)*255
60010 ! 
60012       do 
60014          let FNREADALLSCREENCODES(MAT SS_SCREENCODES$,MAT SS_CREATEDATES,MAT SS_MODIFYDATES,MAT SS_VERSION,MAT SS_CREATEUSER$,MAT SS_MODIFYUSER$,MAT SS_PROJECT$,MAT SS_NOTES$)
60016          if UDIM(MAT SS_SCREENCODES$) then 
60018             execute "config keyboard 04 1000"  !Remap Del As Shift F6 (Fkey 16)
60020             execute "config keyboard 0B00 0A0A0A636F6E206B657920636C6561720D"  !Shift F1 Key To "con key clear<CR>"
60022 ! 
60024             let SS_CAPTION$(1)="Screen Code"
60026             let SS_WIDTH(1)=16
60028             let SS_SPEC$(1)="C 18"
60030 ! .        ! let Ss_Spec$(1)="C 18,L"
60032 ! 
60034             let SS_CAPTION$(2)="Project"
60036             let SS_WIDTH(2)=8
60038             let SS_SPEC$(2)="V 255"
60040 ! 
60042             let SS_CAPTION$(3)="Modified"
60044             let SS_CAPTION$(4)="Created"
60046             mat SS_WIDTH(3:4)=(9)
60048             mat SS_SPEC$(3:4)=("DATE(m/dd/ccyy)")
60050 !            mat Ss_Spec$(2:3)=("DATE(m/dd/ccyy),L")
60052 ! 
60054             let SS_CAPTION$(5)="Version"
60056             let SS_WIDTH(5)=5
60058             let SS_SPEC$(5)="N 7"
60060 ! 
60062             let SS_CAPTION$(6)="Notes"
60064             let SS_WIDTH(6)=16
60066             let SS_SPEC$(6)="V 255"
60068 ! 
60070 ! 
60072             if FNMULTIPROGRAMMERS(MAT SS_CREATEUSER$,MAT SS_MODIFYUSER$) then 
60074 ! .           ! Show the User Name columns only for screenio operations worked on by more then 1 programmer.
60076 ! .           !  They just needlessly crowd up the interface on single user systems.
60078                mat SS_CAPTION$(8)
60080                mat SS_WIDTH(8)
60082                mat SS_SPEC$(8)
60084 ! 
60086 ! .           ! Move Notes to the End
60088                let SS_CAPTION$(8)=SS_CAPTION$(6)
60090                let SS_WIDTH(8)=SS_WIDTH(6)
60092                let SS_SPEC$(8)=SS_SPEC$(6)
60094 ! 
60096 ! .           ! Move Vers to the End
60098                let SS_CAPTION$(7)=SS_CAPTION$(5)
60100                let SS_WIDTH(7)=SS_WIDTH(5)
60102                let SS_SPEC$(7)=SS_SPEC$(5)
60104 ! 
60106 ! .           ! Move "Created Date" over a spot
60108                let SS_CAPTION$(5)=SS_CAPTION$(4)
60110                let SS_WIDTH(5)=SS_WIDTH(4)
60112                let SS_SPEC$(5)=SS_SPEC$(4)
60114 ! 
60116 ! 
60118                let SS_CAPTION$(4)="By"
60120                let SS_WIDTH(4)=5
60122                let SS_SPEC$(4)="V 30"
60124 ! 
60126                let SS_CAPTION$(6)="By"
60128                let SS_WIDTH(6)=5
60130                let SS_SPEC$(6)="V 30"
60132 ! 
60134                let SHOWUSERNAMES=1
60136             end if 
60138 ! 
60140             if FN42 then let HL$="4;" else let HL$="3;"
60142 ! 
60144             if UDIM(MAT SS_SCREENCODES$)>23 then let SS_WIDTH(1)-=1
60146             let HELPTEXT$=HL$&"Accept the selection;"&HL$&"Cancel without selecting anything.;"
60148 ! 
60150             open #(WINDOW:=FNGETFILENUMBER): "SROW=3,SCOL=15,ROWS=25,COLS=75,Border=S,Caption=Load File",display,outin 
60152 ! 
60154             print #WINDOW, fields "25,54,CC 9,/W:W,B37;25,65,CC 10,/W:W,B99", help HELPTEXT$ : "Ok","Cancel"
60156             let HELPTEXT$=HL$&"Launch this screen in a new editor window;"
60158             print #WINDOW, fields "25,2,13/CC 15,/W:W,B42", help HELPTEXT$ : "Launch Screen"
60160             if SELECTOTHERFILES then 
60162                let HELPTEXT$=HL$&"Select a program or proc file to run instead of running a screen directly.;"
60164                print #WINDOW, fields "25,17,10/CC 12,/W:W,B43", help HELPTEXT$ : "Select Pgm"
60166             end if 
60168             print #WINDOW, fields "1,1,LIST 23/75,HEADERS,/W:W" : (MAT SS_CAPTION$, MAT SS_WIDTH, MAT SS_SPEC$)
60170 ! 
60172             if SHOWUSERNAMES then 
60174                print #WINDOW, fields "1,1,LIST 23/75,=" : (MAT SS_SCREENCODES$,MAT SS_PROJECT$,MAT SS_MODIFYDATES,MAT SS_MODIFYUSER$,MAT SS_CREATEDATES,MAT SS_CREATEUSER$,MAT SS_VERSION,MAT SS_NOTES$)
60176             else 
60178                print #WINDOW, fields "1,1,LIST 23/75,=" : (MAT SS_SCREENCODES$,MAT SS_PROJECT$,MAT SS_MODIFYDATES,MAT SS_CREATEDATES,MAT SS_VERSION,MAT SS_NOTES$)
60180             end if 
60182 ! 
60184             print #WINDOW, fields "1,1,LIST 23/75,SORT" : 1
60186 ! 
60188             if FN43 AND SETTING_LOAD_FILTER then 
60190                let FILTERBOX$="24,1,FILTER 75,/W:W,1,1,FULLROW,ALL"
60192             else 
60194                let FILTERBOX$="24,1,SEARCH 75,/W:W,1,1"
60196             end if 
60198 ! 
60200             do 
60202 !               do
60204                input #WINDOW, fields FILTERBOX$&";1,1,LIST 23/75,ROWSUB,SELONE,37" : S$,ROWSUB error IGNORE
60206 !               loop while fkey=105 or fkey=106
60208                if ROWSUB then let SELECTEDSCREEN$=SS_SCREENCODES$(ROWSUB)
60210                if FKEY=16 AND TRIM$(SELECTEDSCREEN$)<>"" then 
60212                   let CHOICE=MSGBOX("Are you sure you want to completly delete "&TRIM$(SELECTEDSCREEN$)&" ?","Delete","yN","QST")
60214                   if CHOICE=2 then ! 2 Is Yes
60216                      let FNDELETESCREEN(TRIM$(SELECTEDSCREEN$))
60218                   end if 
60220                end if 
60222                if FKEY=42 AND TRIM$(SELECTEDSCREEN$)<>"" then 
60224                   let FNLAUNCHSCREEN(TRIM$(SELECTEDSCREEN$))
60226                end if 
60228                if FKEY=43 then 
60230                   let TEMPSCREEN$=FNSELECTFILE$
60232                   if TEMPSCREEN$><"" then 
60234                      let SELECTEDSCREEN$="%"&TRIM$(TEMPSCREEN$)(1:63)
60236                   else 
60238                      let FKEY(-1)
60240                   end if 
60242                end if 
60244             loop UNTIL FKEY=99 OR FKEY=93 OR FKEY=37 OR FKEY=43 OR FKEY=0 OR FKEY=201 OR (FKEY=16 AND CHOICE=2)
60246             if FKEY=37 OR FKEY=0 OR FKEY=201 OR FKEY=43 then 
60248                let FNSELECTSCREEN$=SELECTEDSCREEN$
60250             end if 
60252             close #WINDOW: 
60254             execute "config keyboard clear"  !Reset Keyboard After Routine Exits
60256          else 
60258             let MSGBOX("There are no saved screens to load.","Load","ok","INF")
60260          end if 
60262       loop UNTIL FKEY=99 OR FKEY=93 OR FKEY=37 OR FKEY=43 OR FKEY=201 OR FKEY=0 OR UDIM(MAT SS_SCREENCODES$)=0
60264    fnend 
60266 ! 
60268    def FNSELECTFILE$*64(;___,SELECTFILE)
60270       open #(SELECTFILE:=FNGETFILENUMBER): "name=open:\*.*, recl=1023",external,input error IGNORE
60272       if FILE(SELECTFILE)>-1 then 
60274          let FNSELECTFILE$=FILE$(SELECTFILE)(1:64)
60276          close #SELECTFILE: 
60278       end if 
60280    fnend 
60282 ! 
60284 Selectlayout: !  Print Screen Selection Window
60286    def FNSELECTLAYOUT$(CURRENT$;&FUNCTION,___,WINDOW,SELECTEDLAYOUT$,X$,FILTERBOX$*64)
60288 ! 
60290       dim SL_CAPTION$(1),SL_WIDTH(1),SL_SPEC$(1)
60292       dim SL_LAYOUTS$(1)
60294       let FNREADLAYOUTS(MAT SL_LAYOUTS$)
60296       if UDIM(MAT SL_LAYOUTS$) then 
60298          if FN43 AND SETTING_LOAD_FILTER then 
60300             let FILTERBOX$="23,1,30/FILTER 18,/W:W,1,1,FULLROW,ALL"
60302          else 
60304             let FILTERBOX$="23,1,30/SEARCH 18,/W:W,1,1"
60306          end if 
60308 ! 
60310          open #(WINDOW:=FNGETFILENUMBER): "SROW=4,SCOL=35,ROWS=24,COLS=30,Border=S,Caption=Select Layout",display,outin 
60312          let SL_CAPTION$(1)="File Layout"
60314          let SL_WIDTH(1)=30
60316          let SL_SPEC$(1)="CC 18"
60318          if UDIM(MAT SL_LAYOUTS$)>23 then let SS_WIDTH(1)-=1
60320          print #WINDOW, fields "24,2,CC 8,/W:W,B37;24,11,CC 8,/W:W,B40;24,20,CC 8,/W:W,B99" : "Ok","Clear","Cancel"
60322          print #WINDOW, fields "1,1,LIST 22/30,HEADERS,/W:W" : (MAT SL_CAPTION$, MAT SL_WIDTH, MAT SL_SPEC$)
60324          print #WINDOW, fields "1,1,LIST 22/30,=" : (MAT SL_LAYOUTS$)
60326          print #WINDOW, fields "1,1,LIST 22/30,SORT" : 1
60328          do 
60330             input #WINDOW, fields FILTERBOX$&";1,1,LIST 22/30,ROW,SELONE,37" : X$, SELECTEDLAYOUT$
60332          loop UNTIL FKEY=99 OR FKEY=37 OR FKEY=0 OR FKEY=201 OR FKEY=40 OR ((FKEY>1100) AND (FKEY<1699)) OR (FKEY=98) OR (FKEY=93) OR (FKEY=44) OR (FKEY=19)
60334          if FKEY = 37 OR FKEY = 0 OR FKEY = 201 then ! #Select# Fkey #Case# 37 # 0 # 201
60336             let FNSELECTLAYOUT$=SELECTEDLAYOUT$
60338          else if FKEY = 40 then ! #Case# 40
60340             let FNSELECTLAYOUT$=""
60342          else ! #Case Else#
60344             let FNSELECTLAYOUT$=CURRENT$
60346          end if                       !#End Select#
60348          close #WINDOW: 
60350          if ((FKEY>1100) AND (FKEY<1699)) OR (FKEY=98) OR (FKEY=93) OR (FKEY=44) OR (FKEY=19) then 
60352             let FUNCTION=FKEY
60354          end if 
60356       else 
60358          let MSGBOX("There are no file layouts found.","Select","ok","INF")
60360       end if 
60362 ! 
60364    fnend 
60366 ! 
60368    dim SE_CAPSPEC$(1)*40
60370    dim SE_DESCR$(1)*40
60372    dim SE_BUTSPEC$(1)*40
60374    dim SE_BUTTEXT$(1)
60376    dim SE_INSPEC$(1)*30
60378    dim SE_INTTIP$(1)*255
60380 ! 
60382 ! 
60384    dim SE_SSUBS$(1)*25
60386    dim SE_NSUBS$(1)*25
60388    dim SE_SSPEC$(1)*20
60390    dim SE_NSPEC$(1)*20
60392    dim SE_SDESCR$(1)*40
60394    dim SE_NDESCR$(1)*40
60396    dim SE_PREFIX$
60398 ! 
60400 Selectevents: ! Opens A Child Window To Select Event Handler Functions
60402    def FNSELECTEVENTS(MAT SCREENIO$, MAT SCREENIO;&FUNCTION,___,WINDOW,EVENTSUB)
60404 ! 
60406       if (UDIM(MAT SE_CAPSPEC$)<>(1+SI_EXITFN-SI_ENTERFN)) then 
60408 ! .      ! Initialize Events Window
60410          let FNREADLAYOUTARRAYS("screenio",SE_PREFIX$,MAT SE_SSUBS$,MAT SE_NSUBS$,MAT SE_SSPEC$,MAT SE_NSPEC$,MAT SE_SDESCR$,MAT SE_NDESCR$)
60412          mat SE_CAPSPEC$(1+SI_EXITFN-SI_ENTERFN)
60414          mat SE_DESCR$(1+SI_EXITFN-SI_ENTERFN)
60416          mat SE_BUTSPEC$(1+SI_EXITFN-SI_ENTERFN)
60418          mat SE_BUTTEXT$(1+SI_EXITFN-SI_ENTERFN)
60420          mat SE_INSPEC$(1+SI_EXITFN-SI_ENTERFN)
60422          mat SE_INTTIP$(1+SI_EXITFN-SI_ENTERFN)
60424 ! 
60426          for EVENTSUB=SI_ENTERFN to SI_EXITFN
60428             let SE_CAPSPEC$(1+EVENTSUB-SI_ENTERFN)=STR$(1+EVENTSUB-SI_ENTERFN)&",1,20/CR 25"
60430             let SE_DESCR$(1+EVENTSUB-SI_ENTERFN)=SE_SDESCR$(EVENTSUB)(1:24)&":"
60432             let SE_BUTSPEC$(1+EVENTSUB-SI_ENTERFN)=STR$(1+EVENTSUB-SI_ENTERFN)&",56,CC 4,/W:W,B"&STR$(31+EVENTSUB-SI_ENTERFN)
60434             let SE_BUTTEXT$(1+EVENTSUB-SI_ENTERFN)="Edit"
60436             let SE_INSPEC$(1+EVENTSUB-SI_ENTERFN)=STR$(1+EVENTSUB-SI_ENTERFN)&",22,32/V 255,/W:#FFFF77"
60438             let SE_INTTIP$(1+EVENTSUB-SI_ENTERFN)=TRIM$(SE_SDESCR$(EVENTSUB))&" event function. The Screen Level Event functions run when various Screen Level Events are triggered. See the documentation at http://www.brwiki.com keyword ""ScreenIO"" for more details."
60440          next EVENTSUB
60442       end if 
60444 ! 
60446       let FNFIXTOOLTIPS(MAT SE_INTTIP$)
60448 ! 
60450       open #(WINDOW:=FNGETFILENUMBER): "SROW=10,SCOL=26,ROWS="&STR$(1+SI_EXITFN-SI_ENTERFN)&",COLS=60,Border=S,Caption=Configure Event Handlers",display,outin 
60452       print #WINDOW, fields MAT SE_CAPSPEC$ : MAT SE_DESCR$
60454       print #WINDOW, fields MAT SE_BUTSPEC$ : MAT SE_BUTTEXT$
60456 ! 
60458       do 
60460          rinput #WINDOW, fields MAT SE_INSPEC$, help MAT SE_INTTIP$ : MAT SCREENIO$(SI_ENTERFN:SI_EXITFN)
60462          let FUNCTION=FKEY
60464 ! 
60466          if FUNCTION>30 AND FUNCTION<(32+SI_EXITFN-SI_ENTERFN) then 
60468             let EVENTSUB=SI_ENTERFN+FKEY-31
60470             if LEN(TRIM$(SCREENIO$(EVENTSUB))) AND EXISTS(FNCUSTOMFILENAMEOF$(SCREENIO$(EVENTSUB))) then 
60472                let FNEDITCUSTOMFUNCTION(SCREENIO$(EVENTSUB))
60474             else 
60476                let SCREENIO$(EVENTSUB)=FNSELECTFUNCTIONDIALOG$(SCREENIO$(EVENTSUB),FUNCTION,1000+EVENTSUB)
60478             end if 
60480          end if 
60482       loop UNTIL FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR ((FUNCTION>1100) AND (FUNCTION<1699)) OR FUNCTION=44 OR FUNCTION=19
60484 ! 
60486       if WINDOW AND FILE(WINDOW)>-1 then close #WINDOW: 
60488 ! 
60490    fnend 
60492 ! 
60494    dim DEBUGOUTTTIP$(1)*255
60496    dim DEBUGINTTIP$(5)*255
60498 ! 
60500 Configuredebug: ! Opens A Child Window To Configure The Debug Command
60502    def FNCONFIGUREDEBUG(MAT SCREENIO$, MAT SCREENIO;&FUNCTION,___,WINDOW,ROUTINENAME$*64,NEWSCREEN$*64,RECORD$)
60504       open #(WINDOW:=FNGETFILENUMBER): "SROW=11,SCOL=31,ROWS=6,COLS=50,Border=S,Caption=Configure Debug Command",display,outin 
60506       print #WINDOW, fields "1,1,16/CR 20;2,1,16/CR 20;3,1,16/CR 20;4,1,16/CR 20;5,1,16/CR 20;6,1,16/CR 20" : "Launch Screen:","Key$:","ParentKey$:","Record:","Path:","mat PassedData:"
60508 ! 
60510       let DEBUGOUTTTIP$(1)="Select the screen to run when testing this screen."
60512       let DEBUGINTTIP$(1)="Enter the value to pass in for Key$ when testing."
60514       let DEBUGINTTIP$(2)="Enter the value to pass in for ParentKey$ when testing."
60516       let DEBUGINTTIP$(3)="Enter the value to pass in for Record when testing."
60518       let DEBUGINTTIP$(4)="Enter the optional alternate data path to use when testing. See the fileio documentation for more details on this parameter. If you don't know what its for, you don't need it."
60520       let DEBUGINTTIP$(5)="Enter the values to use for mat PassedData$ when testing, seperated by commas."
60522 ! 
60524       let FNFIXTOOLTIPS(MAT DEBUGOUTTTIP$)
60526       let FNFIXTOOLTIPS(MAT DEBUGINTTIP$)
60528 ! 
60530       do 
60532          if TRIM$(SCREENIO$(SI_DEBUGSCREEN))="" then 
60534             let ROUTINENAME$="Self"
60536          else 
60538             let ROUTINENAME$=TRIM$(SCREENIO$(SI_DEBUGSCREEN))
60540          end if 
60542 ! 
60544          let RECORD$=STR$(SCREENIO(SI_DEBUGRECORD))
60546 ! 
60548          print #WINDOW, fields "1,20,17/CC 64,/W:W,B31", help MAT DEBUGOUTTTIP$ : ROUTINENAME$
60550          rinput #WINDOW, fields "2,18,21/V 255,/W:#FFFF77;3,18,21/V 255,/W:#FFFF77;4,18,21/V 18,/W:#FFFF77;5,18,21/V 255,/W:#FFFF77;6,18,21/V 255,/W:#FFFF77", help MAT DEBUGINTTIP$ : SCREENIO$(SI_DEBUGKEY),SCREENIO$(SI_DEBUGPARENTKEY),RECORD$,SCREENIO$(SI_DEBUGPATH), SCREENIO$(SI_DEBUGPASSED)
60552          let SCREENIO(SI_DEBUGRECORD)=VAL(RECORD$) conv IGNORE
60554          let FUNCTION=FKEY
60556 ! 
60558          if FUNCTION=31 then 
60560 ! .         !Select the screen to use
60562             let NEWSCREEN$=FNSELECTSCREEN$(1)
60564             if NEWSCREEN$<>"" then 
60566                if LWRC$(TRIM$(NEWSCREEN$))=LWRC$(TRIM$(SCREENIO$(SI_SCREENCODE))) then 
60568                   let ROUTINENAME$="Self"
60570                   let SCREENIO$(SI_DEBUGSCREEN)=""
60572                else 
60574                   let ROUTINENAME$=SCREENIO$(SI_DEBUGSCREEN)=TRIM$(NEWSCREEN$)
60576                end if 
60578             end if 
60580          end if 
60582       loop UNTIL FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR ((FUNCTION>1100) AND (FUNCTION<1699)) OR FUNCTION=44 OR FUNCTION=19
60584 ! 
60586       close #WINDOW: 
60588 ! 
60590    fnend 
60592 ! 
60594 Configureprotected: ! Configure The Appearance of Protected Controls
60596    def FNCONFIGUREPROTECTED(MAT SCREENIO$, MAT SCREENIO;&FUNCTION,___,WINDOW)
60598       open #(WINDOW:=FNGETFILENUMBER): "SROW=11,SCOL=36,ROWS=10,COLS=40,Border=S,Caption=Configure Protected Style Attribute",display,outin 
60600       print #WINDOW, fields "1,1,17/CR 20;2,1,17/CR 20;3,1,17/CR 20;5,1,17/CR 20;6,1,17/CR 20;7,1,17/CR 20;9,1,17/CR 20;10,1,17/CR 20" : "Protected Text:","Protected Checkbox:","Protected Button:","Other Changes Color:","My Changes Color:","Lock Message Color:","Active Color:","UserData:"
60602 ! 
60604       do 
60606          rinput #WINDOW, fields "1,19,21/V 255,/W:#FFFF77;2,19,21/V 255,/W:#FFFF77;3,19,21/V 255,/W:#FFFF77;5,19,21/V 255,/W:#FFFF77;6,19,21/V 255,/W:#FFFF77;7,19,21/V 255,/W:#FFFF77;9,19,21/V 255,/W:#FFFF77;10,19,21/V 255,/W:#FFFF77" : MAT SCREENIO$(SI_PROTECTEDTEXT:SI_PROTECTEDBUTTON),MAT SCREENIO$(SI_OTHERCHANGES:SI_ACTIVECOLOR),SCREENIO$(SI_USERDATA)
60608          let FUNCTION=FKEY
60610       loop UNTIL FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR ((FUNCTION>1100) AND (FUNCTION<1699)) OR FUNCTION=44 OR FUNCTION=19
60612       close #WINDOW: 
