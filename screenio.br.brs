39485 Addcurrentlistchld: ! Add The Current Field As A Listview Child
39486    def FNADDCURRENTLISTCHLD(PARENT$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;NAME$*50,DESCRIPTION$*255,TYPE$*30,DATESPEC$*64,___,INDEX,NOFIELD)
39487       if NAME$="" AND DESCRIPTION$="" AND TYPE$="" then 
39488          if FNGETFIELDSCOUNT then 
39489             if ~FNREADFIELDS(NAME$,DESCRIPTION$,TYPE$,DATESPEC$) then 
39490                let NOFIELD=1
39491             end if 
39492          else 
39493             let NOFIELD=1
39494          end if 
39495       end if 
39496       if ~NOFIELD then 
39497          let INDEX=FNADDEMPTYFIELD(MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)
39498          let FIELDTYPE$(INDEX)="LISTCHLD"
39499          let CONTROLNAME$(INDEX)="Field_"&TRIM$(NAME$)(1:44)
39500          let DESCRIPTION$(INDEX)=TRIM$(DESCRIPTION$)
39501          let FIELDNAME$(INDEX)=TRIM$(NAME$)
39502          let SPECWIDTH(INDEX)=FNDISPLAYLENGTH(TYPE$)
39503          let WIDTH(INDEX)=MIN(SPECWIDTH(INDEX),40)
39504          let PARENT$(INDEX)=PARENT$
39505          if LEN(TRIM$(DATESPEC$)) then 
39506 ! .        ! Then let dateSpec$ = the default DateFormatDisplay from ScreenIO.ini.
39507             let CNVRTIN$(INDEX)="DATE("&SETTING_DATEFORMATDISPLAY$&")"
39508             if ~POS(LWRC$(DATESPEC$),"julian") then 
39509                let CNVRTOUT$(INDEX)="DATE("&DATESPEC$&")"
39510             end if 
39511          end if 
39512 ! 
39513          let FNADDCURRENTLISTCHLD=INDEX
39514       end if 
39515    fnend 
39516 ! 
39517 Generateuniquelvname: ! Generate A Unique Name For A Lv
39518    def FNGENERATEUNIQUELVNAME$(MAT PARENT$;PREFIX$,___,INDEX,TEST)
39519       if ~LEN(PREFIX$) then let PREFIX$="LV"
39520       do 
39521       loop UNTIL (SRCH(MAT PARENT$,PREFIX$&STR$(INDEX:=INDEX+1))<1)
39522       let FNGENERATEUNIQUELVNAME$=PREFIX$&STR$(INDEX)
39523    fnend 
39524 ! 
39525 Setsearchlistview: ! Point The Search Box To A Listview Control
39526    def FNSETSEARCHLISTVIEW(INDEX,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;MOVE,___,CHILDINDEX)
39527       let PARENT$(INDEX)=PARENT$(LISTVIEWINDEX)
39528       if MOVE then 
39529          let WIDTH(INDEX)=WIDTH(LISTVIEWINDEX)-2
39530          let HPOSITION(INDEX)=HPOSITION(LISTVIEWINDEX)+2
39531          let VPOSITION(INDEX)=MAX(1,VPOSITION(LISTVIEWINDEX)-1)  !Default Searchbox To Top
39532 ! .   !   let Vposition(Index)=Vposition(Listviewindex)+Height(listviewindex)
39533       end if 
39534       for CHILDINDEX=1 to UDIM(MAT FIELDTYPE$)
39535          if FIELDTYPE$(CHILDINDEX)="LISTCHLD" AND PARENT$(CHILDINDEX)=PARENT$(LISTVIEWINDEX) then 
39536             let SPECWIDTH(INDEX)=MAX(SPECWIDTH(INDEX),SPECWIDTH(CHILDINDEX))
39537          end if 
39538       next CHILDINDEX
39539    fnend 
39540 ! 
39541    dim CENTERSPEC$(11)*64,CENTERTEXT$(11)*64
39542 ! 
39543    def FNCHANGECONTROLTYPE(MAT SCREENIO$,MAT SCREENIO,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,KEY$,FUNCTION,INSTR,INDEX,FIELDTYPE$,CHANGED,_CONTROL,_TYPE)
39544 ! 
39545       if ~FNCONTROLCANSWITCH(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then let CONTROL=0
39546 ! 
39547       for INDEX=1 to 8
39548          let CENTERSPEC$(INDEX)=STR$(INDEX)&",1,CC 24"
39549       next INDEX
39550       let CENTERSPEC$(9)="10,1,24/C 40"
39551       let CENTERSPEC$(10)="11,1,24/C 40"
39552       let CENTERSPEC$(11)="13,7,CC 12,/W:W,B17"
39553 ! 
39554       mat CENTERTEXT$=("")
39555       let CENTERTEXT$(1)="Click on the Control"
39556       let CENTERTEXT$(2)="that you want to change"
39557       let CENTERTEXT$(3)=""
39558       let CENTERTEXT$(4)="Then, click on the"
39559       let CENTERTEXT$(5)="button in the toolbox"
39560       let CENTERTEXT$(6)="for the control type"
39561       let CENTERTEXT$(7)="you want to change it to"
39562       let CENTERTEXT$(8)="or press ESC to cancel"
39563 ! 
39564       let CENTERTEXT$(9)="Control:"
39565       let CENTERTEXT$(10)="Type:"
39566 ! 
39567       let CENTERTEXT$(11)="Convert"
39568 ! 
39569       let _CONTROL=9
39570       let _TYPE=10
39571 ! 
39572       let FNCHANGEFORCEVISIBILITY(0)
39573       open #(INSTR:=FNGETFILENUMBER) : "SROW=3,SCOL=3,ROWS=13,COLS=24,Border=S,Caption=Change Control",display,outin 
39574       print #INSTR, fields MAT CENTERSPEC$ : MAT CENTERTEXT$
39575 ! 
39576       do 
39577          if CONTROL then 
39578             let CENTERTEXT$(_CONTROL)="Control: "&FNCONTROLDESCRIPTION$(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,1)(1:32)
39579          else 
39580             let CENTERTEXT$(_CONTROL)="Control: None"
39581          end if 
39582          let CENTERTEXT$(_TYPE)="Type: "&FIELDTYPE$
39583 ! 
39584          print #INSTR, fields MAT CENTERSPEC$ : MAT CENTERTEXT$
39585 ! 
39586          input #0, fields "1,2,C 1,AEX" : KEY$
39587          let FUNCTION=FKEY
39588 ! 
39589          if FUNCTION>=1400 AND FUNCTION<1500 then !  Process Button
39590             let FIELDTYPE$=FNFIELDTYPECANSWITCH$(FNREADBUTTON$(FUNCTION))
39591          end if 
39592 ! 
39593          if FUNCTION>=1500 AND FUNCTION<=1500+UDIM(MAT CONTROLNAME$) then 
39594             if FNCONTROLCANSWITCH(FUNCTION-1500,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
39595                let CONTROL=FUNCTION-1500
39596             end if 
39597          end if 
39598 ! 
39599          if FUNCTION=17 then 
39600 ! .        ! Switch the control type
39601             if FNSWITCHCONTROL(CONTROL,FIELDTYPE$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
39602                let CHANGED=1
39603             end if 
39604          end if 
39605 ! 
39606       loop UNTIL FUNCTION=99 OR FUNCTION=93 OR FUNCTION=44 OR FUNCTION=19 OR CHANGED OR FUNCTION>=1100 AND FUNCTION<1400
39607 ! 
39608       close #INSTR: 
39609    fnend 
39610 ! 
39611    def FNFIELDTYPECANSWITCH$(BUTTONTEXT$)
39612       if LWRC$(BUTTONTEXT$) = "field" OR LWRC$(BUTTONTEXT$) = "text box" then ! #Select# lwrc$(ButtonText$) #Case# "field" # "text box"
39613          let FNFIELDTYPECANSWITCH$="C"
39614       else if LWRC$(BUTTONTEXT$) = "caption" then ! #Case# "caption"
39615          let FNFIELDTYPECANSWITCH$="caption"
39616       else if LWRC$(BUTTONTEXT$) = "check box" then ! #Case# "check box"
39617          let FNFIELDTYPECANSWITCH$="check"
39618       else if LWRC$(BUTTONTEXT$) = "combo box" then ! #Case# "combo box"
39619          let FNFIELDTYPECANSWITCH$="combo"
39620       else if LWRC$(BUTTONTEXT$) = "button" then ! #Case# "button"
39621          let FNFIELDTYPECANSWITCH$="button"
39622       else if LWRC$(BUTTONTEXT$) = "picture" then ! #Case# "picture"
39623          let FNFIELDTYPECANSWITCH$="P"
39624       end if                          !#End Select#
39625    fnend 
39626 ! 
39627    def FNCONTROLCANSWITCH(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
39628       if CONTROL AND CONTROL<=UDIM(MAT FIELDTYPE$) then 
39629          if LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "c" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "caption" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "check" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "combo" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "button" OR LWRC$(TRIM$(FIELDTYPE$(CONTROL))) = "p" then ! #Select# lwrc$(trim$(FieldType$(Control))) #Case# "c" # "caption" # "check" # "combo" # "button" # "p"
39630             let FNCONTROLCANSWITCH=1
39631          end if                       !#End Select#
39632       end if 
39633    fnend 
39634 ! 
39635    def FNSOURCETYPE(FIELDTYPE$)
39636       if LWRC$(TRIM$(FIELDTYPE$)) = "c" OR LWRC$(TRIM$(FIELDTYPE$)) = "combo" then ! #Select# lwrc$(trim$(FieldType$)) #Case# "c" # "combo"
39637          let FNSOURCETYPE=1
39638       else ! #Case Else#
39639          let FNSOURCETYPE=0
39640       end if                          !#End Select#
39641    fnend 
39642 ! 
39643    def FNSWITCHCONTROL(CONTROL,TARGETTYPE$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,SOURCETYPE,TARGETTYPE,RELATEDINDEX,NEWDESCRIPTION)
39644       if CONTROL AND LEN(TRIM$(TARGETTYPE$)) then 
39645          if FNCONTROLCANSWITCH(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
39646 ! .        ! Need to fill in the details of how this happens when control types
39647 ! .        !  aren't purely compatible
39648 ! 
39649 ! .        ! In Sourcetype 2 Fields, Description is a hardcoded value; in Sourcetype 1 fields, description is a link to another field.
39650             let SOURCETYPE=FNSOURCETYPE(FIELDTYPE$(CONTROL))
39651             let TARGETTYPE=FNSOURCETYPE(TARGETTYPE$)
39652 ! 
39653 ! .        ! if we change from C spec to Checkbox or Radio Button spec, then
39654 ! .        !  we need to read description from related control and delete related control.
39655             if LWRC$(TRIM$(TARGETTYPE$))=="check" then 
39656 ! .           ! if its a source type that has related controls, and if there's a related control.
39657                if (RELATEDINDEX:=FNFINDRELATEDCONTROL(CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)) then 
39658 ! .              ! if related control is a caption
39659                   if LWRC$(TRIM$(FIELDTYPE$(RELATEDINDEX)))="caption" then 
39660                      let DESCRIPTION$(CONTROL)=TRIM$(DESCRIPTION$(RELATEDINDEX))
39661                      if DESCRIPTION$(CONTROL)(LEN(DESCRIPTION$(CONTROL)):LEN(DESCRIPTION$(CONTROL)))=":" then 
39662                         let DESCRIPTION$(CONTROL)(LEN(DESCRIPTION$(CONTROL)):LEN(DESCRIPTION$(CONTROL)))=""
39663                      end if 
39664 ! 
39665                      let FNDELETECONTROL(RELATEDINDEX,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)  !Delete related control
39666                      let NEWDESCRIPTION=1
39667                   end if 
39668                end if 
39669             end if 
39670 ! 
39671 ! .        ! If we change from one target type and another, have to erase the Description$ value
39672             if SOURCETYPE><TARGETTYPE AND ~NEWDESCRIPTION then 
39673                let DESCRIPTION$(CONTROL)=""
39674             end if 
39675 ! 
39676 ! 
39677 ! 
39678 ! .        ! We switch the actual control type here
39679             let FIELDTYPE$(CONTROL)=TARGETTYPE$
39680             let FNSWITCHCONTROL=1
39681          end if 
39682       end if 
39683    fnend 
39684 ! 
