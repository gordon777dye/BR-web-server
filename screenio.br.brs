33700 Generateoaspecs: ! Generate The Specs Based On Control Type)
33702    def FNGENERATEOASPECS(TYPE$,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33704       let FNRESETOASPECS(MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33706 ! 
33708       if TRIM$(LWRC$(TYPE$)) = "c" then ! #Select# Trim$(Lwrc$(Type$))   #Case#  "c"
33710          let FNADDOASPEC("Name:",SF_CONTROLNAME,50,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33712          let FNADDOASPEC("Field:",SF_FIELDNAME,50,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33714          let FNADDOASPEC("Data Width:",-1*SF_SPECWIDTH,3,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33716          let FNADDOASPEC("Caption Field:",SF_DESCRIPTION,60,MAT OAS_CAPTIONSPEC$, MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33718          let FNADDOASPEC("Attributes:",SF_ATTR,128,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33720          let FNADDOASPEC("Validation:",SF_FUNCTION,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33722          let FNADDOASPEC("Foreground Color:",SF_FGCOLOR,6,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33724          let FNADDOASPEC("Background Color:",SF_BGCOLOR,6,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33726          let FNADDOASPEC("Justification Spec:",SF_JUSTIFY,2,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33728          let FNADDOASPEC("Tooltip Text:",SF_TOOLTIP,1000,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33730          let FNADDOASPEC("Conversion:",SF_CNVRTIN,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33732          let FNADDOASPEC("Disk Date Format:",SF_CNVRTOUT,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33734          let FNADDOASPEC("User Data:",SF_USERDATA,255,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33736          let FNADDOASPEC("Protected:",-1*SF_PROTECTED,1,MAT OAS_CAPTIONSPEC$,MAT OAS_CAPTIONDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_TOOLTIP$,MAT OAS_SUBS,MAT OAS_BUTTONS)
