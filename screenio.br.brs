33126                               end if 
33128                            end if 
33130                         end if 
33132 ! 
33134                         if FGCOLORINDEX>0 then let TEMP_FGCOLOR$=OAS_DATA$(FGCOLORINDEX) else let TEMP_FGCOLOR$="W"
33136                         if BGCOLORINDEX>0 then let TEMP_BGCOLOR$=OAS_DATA$(BGCOLORINDEX) else let TEMP_BGCOLOR$="W"
33138 ! 
33140                         let FNADJUSTSPECCOLOR(OAS_SPEC$(FIELD),OAS_DATA$(FIELD))
33142                         print #WINDOW, fields OAS_SPEC$(FIELD) : OAS_DATA$(FIELD)  !Update Button Color
33144 ! 
33146                         let FNDRAWCONTROL(WEDITOR,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,0,TEMP_FGCOLOR$,TEMP_BGCOLOR$)  !Update Control
33148                      end if 
33150 ! 
33152                   else if OAS_SUBS(FIELD) = SF_FUNCTION OR OAS_SUBS(FIELD) = SF_CNVRTIN OR OAS_SUBS(FIELD) = SF_CNVRTOUT then ! #Case# Sf_Function # Sf_Cnvrtin # Sf_Cnvrtout
33154                      if LEN(TRIM$(OAS_DATA$(FIELD))) AND EXISTS(FNCUSTOMFILENAMEOF$(OAS_DATA$(FIELD))) then 
33156                         let FNEDITCUSTOMFUNCTION(OAS_DATA$(FIELD))
33158                      else 
33160                         let OAS_DATA$(FIELD)=FNSELECTFUNCTIONDIALOG$(OAS_DATA$(FIELD),FUNCTION,2000+OAS_SUBS(FIELD),FNSUBTYPE(FIELDTYPE$(CONTROL)))
33162                      end if 
33164 ! 
33166                   else if OAS_SUBS(FIELD) = SF_PICTURE then ! #Case# Sf_Picture
33168                      if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="filter" then 
33170                         let OAS_DATA$(FIELD)=FNSELECTFILTERTARGET$(OAS_DATA$(FIELD),CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33172                      else 
33174 ! .                    ! if Fnclientserver then let Csopenstring$="@:"
33176                         open #(FILENUMBER:=FNGETFILENUMBER): "name=open:"&CSOPENSTRING$&"*.gif;*.jpg;*.bmp;*.ico;*.png, recl=1024", external, input error IGNORE
33178                         if FILE(FILENUMBER)=0 then 
33180                            let OAS_DATA$(FIELD)=FILE$(FILENUMBER)
33182 ! 
33184                            let PICTURE$(CONTROL)=OAS_DATA$(FIELD)  !Update Picture
33186                            let FNDRAWCONTROL(WEDITOR,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33188                         end if 
33190                         if FILE(FILENUMBER)>-1 then close #FILENUMBER: 
33192                      end if 
33194 ! 
33196                   else if OAS_SUBS(FIELD) = SF_PARENT then ! #Case# Sf_Parent
33198                      if (LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="search") OR (LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="filter") then 
33200                         let LISTVIEWINDEX=SRCH(MAT FIELDTYPE$,"LISTVIEW")
33202                         if LISTVIEWINDEX>0 then 
33204                            let FNSETSEARCHLISTVIEW(CONTROL,LISTVIEWINDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33206                            let OAS_DATA$(FIELD)=PARENT$(CONTROL)
33208                            let SPECWIDTHINDEX=SRCH(MAT OAS_SUBS,-1*SF_SPECWIDTH)
33210                            if SPECWIDTHINDEX>0 then 
33212                               let OAS_DATA$(SPECWIDTHINDEX)=STR$(SPECWIDTH(CONTROL))
33214                            end if 
33216                            let FNDRAWCONTROL(WEDITOR,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)  !Update Control
33218                         end if 
33220                      end if 
33222 ! 
33224                   else if OAS_SUBS(FIELD) = SF_FIELDNAME then ! #Case# Sf_FieldName
33226                      if LWRC$(TRIM$(FIELDTYPE$(CONTROL)))="screen" then 
33228                         let SCREEN$=FNSELECTSCREEN$
33230                         if TRIM$(SCREEN$)<>"" then 
33232                            let FIELDNAME$(CONTROL)=SCREEN$
33234                            let OAS_DATA$(FIELD)=SCREEN$
33236                            let FNREADCHILDSCREENSIZE(CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33238                            let FUNCTION=1500+CONTROL
33240                         end if 
33242 ! 
33244                         let FNDRAWCONTROL(WEDITOR,CONTROL,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)  !Update Control
33246                      end if 
33248 ! .!
33250                   end if              !#End Select#
33252                   let FNCHANGEFORCEVISIBILITY(0)
33254                end if 
33256 ! .!
33258             loop UNTIL FUNCTION>1100 OR FUNCTION=99 OR FUNCTION=98 OR FUNCTION=93 OR FUNCTION=44 OR FUNCTION=19
33260             let FNCOPYBACKOASINPUTSPEC(MAT OAS_INPUTSPEC$,MAT OAS_INPUTDATA$,MAT OAS_SPEC$,MAT OAS_DATA$,MAT OAS_SUBS,MAT OAS_BUTTONS)
33262             let FNSCREENTOOBJECT(CONTROL,MAT OAS_SUBS,MAT OAS_DATA$,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33264             if WINDOW AND FILE(WINDOW)>-1 then close #WINDOW: 
33266             let FNPREFORMEDITORINPUT=FUNCTION
33268          else 
33270             let MODE=0
33272          end if 
33274       else 
33276          let MODE=0                   !Reset Mode To Default For Invalid Control Number
33278       end if 
33280    fnend 
33282 ! 
33284    dim SF_TARGETFIELD$(1)*64
33286    dim SF_FILTERTYPE$(3)
33288 ! 
33290    dim SF_SPEC$(3)*64, SF_DATA$(3)*64
33292    def FNSELECTFILTERTARGET$*255(TARGETSTRING$*255,CONTROL,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,INDEX,COUNT,WINDOW,SAVETARGET$*255)
33294       open #(WINDOW:=FNGETFILENUMBER): "srow=10,scol=30,rows=7,cols=40,border=S",display,outin 
33296       print #WINDOW, fields "1,1,CC 30;3,1,CR 15;4,1,CR 15;7,18,CC 10,/W:W,B55;7,29,CC 10,/W:W,B99" : "Select Target Field","Field: ","Filter Type: ","Ok","Cancel"
33298 ! 
33300       let TARGETSTRING$=UPRC$(TARGETSTRING$)
33302       let SAVETARGET$=TARGETSTRING$
33304 ! 
33306       if LEN(TRIM$(PARENT$(CONTROL))) then 
33308          let COUNT=FNCOUNTCOLUMNS(PARENT$(CONTROL),MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
33310       end if 
33312       mat SF_TARGETFIELD$(COUNT+1)
33314       let SF_TARGETFIELD$(1)="0 - All"
33316       for INDEX=1 to COUNT
33318          let SF_TARGETFIELD$(INDEX+1)=STR$(INDEX)
33320       next INDEX
33322 ! 
33324       let SF_FILTERTYPE$(1)="LEADING"
33326       let SF_FILTERTYPE$(2)="WORD"
33328       let SF_FILTERTYPE$(3)="ALL"
33330 ! 
33332       print #WINDOW, fields "3,16,15/COMBO 64,=,SELECT" : MAT SF_TARGETFIELD$
33334       print #WINDOW, fields "4,16,COMBO 15,=,SELECT" : MAT SF_FILTERTYPE$
33336 ! 
33338       let SF_SPEC$(1)="3,16,15/COMBO 64,/W:W,SELECT"
33340       let SF_SPEC$(2)="4,16,COMBO 15,/W:W,SELECT"
33342       let SF_SPEC$(3)="5,14,CHECK 15"
33344 ! 
33346       if POS(TARGETSTRING$,",") then 
33348          if LWRC$(TARGETSTRING$)(1:4)="full" then 
33350             let SF_DATA$(1)="0"
33352          else 
33354             let SF_DATA$(1)=STR$(INT(MAX(FNRETURNVALUE(TARGETSTRING$(1:POS(TARGETSTRING$,",")-1)),0)))
33356          end if 
33358          let TARGETSTRING$(1:POS(TARGETSTRING$,","))=""
33360          if SF_DATA$(1)="0" then let SF_DATA$(1)="0 - All"
33362       else 
33364          let SF_DATA$(1)=STR$(INT(MAX(FNRETURNVALUE(TARGETSTRING$),0)))
33366          let TARGETSTRING$=""
33368       end if 
33370 ! 
33372       if POS(TARGETSTRING$,",") then 
33374          let SF_DATA$(2)=TARGETSTRING$(1:POS(TARGETSTRING$,",")-1)
33376          let TARGETSTRING$(1:POS(TARGETSTRING$,","))=""
33378 ! 
33380          if SF_DATA$(2)<>"LEADING" AND SF_DATA$(2)<>"WORD" AND SF_DATA$(2)<>"ALL" then 
33382             let SF_DATA$(2)="ALL"
33384          end if 
33386       else 
33388          let SF_DATA$(2)="ALL"
33390          let TARGETSTRING$=""
33392       end if 
33394 ! 
33396       if LEN(TARGETSTRING$) then 
33398          let SF_DATA$(3)="^Case Sensitive"
33400       else 
33402          let SF_DATA$(3)="Case Sensitive"
33404       end if 
33406 ! 
33408       do 
33410          rinput #WINDOW, fields MAT SF_SPEC$ : MAT SF_DATA$
33412          if SF_DATA$(1)(1:1)="0" then let SF_DATA$(1)="0"
33414          let SF_DATA$(1)=STR$(INT(MAX(0,FNRETURNVALUE(SF_DATA$(1)))))  !Enforce its a positive integer
33416       loop UNTIL FKEY=55 OR FKEY=99 OR FKEY=93
33418 ! 
33420       close #WINDOW: 
33422 ! 
33424       if FKEY=55 then 
33426          if SF_DATA$(1)="0" then let SAVETARGET$="FULLROW" else let SAVETARGET$=SF_DATA$(1)
33428          let SAVETARGET$=SAVETARGET$&","&SF_DATA$(2)
33430          if SF_DATA$(3)(1:1)="^" then let SAVETARGET$=SAVETARGET$&",CASE"
33432       end if 
33434       let FNSELECTFILTERTARGET$=SAVETARGET$
33436    fnend 
33438 ! 
33440    dim CF_TARGET$(1)*255
33442    def FNCLEANFILTER(&TARGET$;___,INDEX)
33444       let TARGET$=UPRC$(TARGET$)
33446 ! 
33448       let STR2MAT(TARGET$,MAT CF_TARGET$,",")
33450       mat CF_TARGET$(3)
33452 ! 
33454       for INDEX=1 to UDIM(MAT CF_TARGET$)
33456          let CF_TARGET$(INDEX)=TRIM$(CF_TARGET$(INDEX))
33458       next INDEX
33460 ! 
33462       if LWRC$(CF_TARGET$(1))(1:4)="full" then 
33464          let CF_TARGET$(1)="0"
33466       else 
33468          let CF_TARGET$(1)=STR$(INT(MAX(0,FNRETURNVALUE(CF_TARGET$(1)))))
33470       end if 
33472 ! 
33474       if CF_TARGET$(2)<>"LEADING" AND CF_TARGET$(2)<>"WORD" AND CF_TARGET$(2)<>"ALL" then 
33476          let CF_TARGET$(2)="ALL"
33478       end if 
33480 ! 
33482       if TRIM$(CF_TARGET$(3))><"" then 
33484          let CF_TARGET$(3)="CASE"
33486       end if 
33488 ! 
33490       if VAL(CF_TARGET$(1))=0 then 
33492          let CF_TARGET$(1)="FULLROW"
33494       end if 
33496 ! 
33498       let MAT2STR(MAT CF_TARGET$,TARGET$,",")
33500    fnend 
33502 ! 
33504    def FNFUNCTIONEDITSPEC$*80(SPEC$*80,INDEX;___,ROW,COL,LENGTH)
33506       let ROW=VAL(SPEC$(1:POS(SPEC$,",")-1))
33508       let SPEC$(1:POS(SPEC$,","))=""
33510       let COL=VAL(SPEC$(1:POS(SPEC$,",")-1))
33512       let SPEC$(1:POS(SPEC$,","))=""
33514       if POS(SPEC$(1:4),"/") then 
33516          let LENGTH=VAL(SPEC$(1:POS(SPEC$,"/")-1)) conv IGNORE
33518       else 
33520          let LENGTH=VAL(SPEC$(3:POS(SPEC$,",")-1)) conv IGNORE
33522       end if 
33524 ! 
33526       let FNFUNCTIONEDITSPEC$=STR$(ROW)&","&STR$(COL+LENGTH+1)&",4/CC 6,/W:W,B"&STR$(1000+INDEX)
33528    fnend 
