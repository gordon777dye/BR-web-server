60616 ! 
60618 ! 
60620 Trytoclose: !  Function Closes A Window If It Was Open
60622    def FNTRYTOCLOSE(WINDOWNUMBER)
60624       if WINDOWNUMBER then 
60626          if FILE(WINDOWNUMBER)<>-1 then 
60628             close #WINDOWNUMBER: 
60630          end if 
60632          let WINDOWNUMBER=0
60634       end if 
60636    fnend 
60638 ! 
60640 Filetoscreen: !  Converts Given File To String Based On Passed Subscripts
60642    def FNFILETOSCREEN(MAT F$,MAT F,MAT SCREEN$,MAT SUBS;___,_I)
60644       for _I=1 to UDIM(MAT SUBS)
60646          if SUBS(_I) >0 then 
60648             let SCREEN$(_I)=F$(SUBS(_I))
60650          else if SUBS(_I) < 0 then 
60652             if ABS(SUBS(_I))=SI_BORDER OR ABS(SUBS(_I))=SI_SCREENIOLOCKING OR ABS(SUBS(_I))=SI_SCREENIOMERGE then 
60654                if F(ABS(SUBS(_I))) then 
60656                   let SCREEN$(_I)="^"
60658                else 
60660                   let SCREEN$(_I)=""
60662                end if 
60664             else 
60666                let SCREEN$(_I)=STR$(F(ABS(SUBS(_I))))
60668             end if 
60670          end if 
60672       next _I
60674    fnend 
60676 ! 
60678 Screentofile: !  Converts Given File To String Based On Passed Subscripts
60680    def FNSCREENTOFILE(MAT F$,MAT F,MAT SCREEN$,MAT SUBS;___,_I)
60682       for _I=1 to UDIM(MAT SUBS)
60684          if SUBS(_I) >0 then 
60686             let F$(SUBS(_I))=SCREEN$(_I)
60688          else if SUBS(_I) < 0 then 
60690             if ABS(SUBS(_I))=SI_BORDER OR ABS(SUBS(_I))=SI_SCREENIOLOCKING OR ABS(SUBS(_I))=SI_SCREENIOMERGE then 
60692                if SCREEN$(_I)(1:1)="^" then 
60694                   let F(ABS(SUBS(_I)))=1
60696                else 
60698                   let F(ABS(SUBS(_I)))=0
60700                end if 
60702             else 
60704                let F(ABS(SUBS(_I)))=VAL(SCREEN$(_I)) conv IGNORE
60706             end if 
60708          end if 
60710       next _I
60712    fnend 
60714 ! 
60716 Sameas: !   ***** Compares Two String Arrays Returning True If Same
60718    def FNSAMEAS(MAT A$,MAT B$;___,FAILED,INDEX)
60720       if UDIM(MAT A$)=UDIM(MAT B$) then 
60722          for INDEX=1 to UDIM(MAT A$)
60724             if TRIM$(A$(INDEX))<>TRIM$(B$(INDEX)) then let FAILED=1
60726          next INDEX
60728          let FNSAMEAS=(~(FAILED))
60730       end if 
60732    fnend 
60734 ! 
60736 Samea: !   ***** Compares  Two Number Arrays Returning True If Same
60738    def FNSAMEA(MAT A,MAT B;___,FAILED,INDEX)
60740       if UDIM(MAT A)=UDIM(MAT B) then 
60742          for INDEX=1 to UDIM(MAT A)
60744             if A(INDEX)<>B(INDEX) then let FAILED=1
60746          next INDEX
60748          let FNSAMEA=(~(FAILED))
60750       end if 
60752    fnend 
60754 ! 
60756 Searchclosely: !   ***** Searches Mat A$ Looking For A Partial Match To B$ And Optionally C$ (Case Insensitive)
60758    def FNSEARCHCLOSELY(MAT A$,B$;C$,___,INDEX,FOUND)
60760       for INDEX=1 to UDIM(MAT A$)
60762          if TRIM$(C$)="" then 
60764             if POS(LWRC$(A$(INDEX)),LWRC$(B$)) then let FOUND=INDEX
60766          else 
60768             if POS(LWRC$(A$(INDEX)),LWRC$(B$)) AND POS(LWRC$(A$(INDEX)),LWRC$(C$)) then let FOUND=INDEX
60770          end if 
60772       next INDEX
60774       let FNSEARCHCLOSELY=FOUND
60776    fnend 
60778 ! 
60780 Testattributes: !  Tests The User Attributes
60782    def FNTESTATTRIBUTES(ATTRIBUTES$*255,VPOS,HPOS;___,WEDITOR)
60784       let FNCHANGEFORCEVISIBILITY(0)
60786       open #(WEDITOR:=FNGETFILENUMBER): "SROW=" & STR$(VPOS) & ", SCOL=" & STR$(HPOS) & ", ROWS=1, COLS=1, " & SCREENIO$(SI_ATTRIBUTES), display, outin error IGNORE
60788       if FILE(WEDITOR)=-1 then 
60790          let FNTESTATTRIBUTES=0
60792       else 
60794          let FNTESTATTRIBUTES=1
60796          close #WEDITOR: 
60798       end if 
60800    fnend 
60802 ! 
60804    dim PRESERVENONGUI$*10000
60806    dim PRESERVENONGUIROWS
60808    dim PRESERVENONGUICOLS
60810 ! 
60812 Preservenongui: ! Preserve the Non Gui Window
60814    def FNPRESERVENONGUI
60816       let FNREADSCREENSIZE(PRESERVENONGUIROWS,PRESERVENONGUICOLS,0)
60818       input #0, fields "1,1,C "&STR$(PRESERVENONGUIROWS*PRESERVENONGUICOLS)&",G" : PRESERVENONGUI$
60820       execute "config gui on"
