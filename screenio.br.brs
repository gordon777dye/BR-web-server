35238 ! 
35239 Exportscreen: ! Exports The Screen To A User Selected File
35240    def FNEXPORTSCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,FEXPORTFILE,INDEX,CSOPENSTRING$)
35241       open #(FEXPORTFILE:=FNGETFILENUMBER): "name=save:"&CSOPENSTRING$&"*.sio,new,recl="&STR$(MAX(RLN(FSCREENIO),RLN(FSCREENFLD))),internal,output,sequential error IGNORE
35242       if FILE(FEXPORTFILE)=0 then 
35243          let FNWRITEEXPORT(FEXPORTFILE,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35244 ! 
35245          close #FEXPORTFILE: 
35246          let FNEXPORTSCREEN=1
35247       end if 
35248    fnend 
35249 ! 
35250    def FNWRITEBACKUP(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,FILENAME$*255,INDEX)
35251       if ~EXISTS("screen\backup") then 
35252          execute "mkdir screen\backup" error IGNORE
35253       end if 
35254 ! 
35255       let FILENAME$=UPRC$(TRIM$(SCREENIO$(SI_SCREENCODE)))
35256       let INDEX=0
35257       do WHILE (INDEX+=1)<=LEN(FILENAME$)
35258          if ~POS("ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890",FILENAME$(INDEX:INDEX)) then 
35259             let FILENAME$(INDEX:INDEX)=""
35260             let INDEX-=1
35261          end if 
35262       loop 
35263 ! 
35264       open #(BACKUPFILE:=FNGETFILENUMBER): "name=screen\backup\"&LWRC$(FILENAME$)&".sio,replace,recl="&STR$(MAX(RLN(FSCREENIO),RLN(FSCREENFLD))),internal,output,sequential error IGNORE
35265       if FILE(BACKUPFILE)=0 then 
35266          let FNWRITEEXPORT(BACKUPFILE,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35267          close #BACKUPFILE: error IGNORE
35268          let FNWRITEBACKUP=1
35269       end if 
35270    fnend 
35271 ! 
35272    def FNWRITEEXPORT(FEXPORTFILE,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,TARGETVERSION,INDEX)
35273 ! .  ! Record Version of Save
35274       let TARGETVERSION=VERSION(FSCREENIO)+VERSION(FSCREENFLD)
35275       let VERSION(FEXPORTFILE,TARGETVERSION)
35276 ! 
35277       write #FEXPORTFILE, using FORM$(FSCREENIO) : MAT SCREENIO$, MAT SCREENIO
35278       for INDEX=1 to UDIM(MAT CONTROLNAME$)
35279          let FNBUILDSCREENFLD(SCREENIO$(SI_SCREENCODE),MAT SCREENFLD$,MAT SCREENFLD,INDEX,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35280          write #FEXPORTFILE, using FORM$(FSCREENFLD) : MAT SCREENFLD$, MAT SCREENFLD
35281       next INDEX
35282    fnend 
35283 ! 
35284    dim FIO$(1)*1023,FIO(1),MAPS(1),MAPN(1)
35285 ! 
35286    def FNIMPORTRECORDVERSION(F,MAT T$,MAT T;DETAILS)
35287       let FNSETIMPORTDETAILS(F,MAT FIO$,MAT FIO,MAT MAPS,MAT MAPN,MAT T$,MAT T,MAT FORM$,DETAILS)
35288 ! 
35289       read #F, using FORM$(F) : MAT FIO$,MAT FIO error IGNORE
35290       if FILE(F)=0 then 
35291          let FNAPPLYMAPPING(MAT FIO$,MAT FIO,MAT T$,MAT T,MAT MAPS,MAT MAPN)
35292          let FNIMPORTRECORDVERSION=1
35293       end if 
35294    fnend 
35295 ! 
35296    def FNAPPLYMAPPING(MAT F$,MAT F,MAT T$,MAT T,MAT MS,MAT MN;___,INDEX)
35297       for INDEX=1 to UDIM(MAT F$)
35298          if MS(INDEX)>0 then 
35299             let T$(MS(INDEX))=F$(INDEX)
35300          end if 
35301       next INDEX
35302       for INDEX=1 to UDIM(MAT F)
35303          if MN(INDEX)>0 then 
35304             let T(MN(INDEX))=F(INDEX)
35305          end if 
35306       next INDEX
35307    fnend 
35308 ! 
35309    def FNSETIMPORTDETAILS(F,MAT F$,MAT F,MAT MAPS,MAT MAPN,MAT T$,MAT T,MAT FORM$;DETAILS,___,INDEX)
35310 ! 
35311       if VERSION(F)=VERSION(FSCREENFLD)+VERSION(FSCREENIO) then 
35312 ! .     ! Current Version - just take it all from ScreenIO and ScreenFlds
35313          mat F$(UDIM(MAT T$))
35314          mat F(UDIM(MAT T))
35315 ! 
35316          mat MAPS(UDIM(MAT F$))
35317          mat MAPN(UDIM(MAT F))
35318 ! 
35319 ! .     ! Current Version. Just set 1:1 mapping here.
35320          for INDEX=1 to UDIM(MAT MAPS)
35321             let MAPS(INDEX)=INDEX
35322          next INDEX
35323          for INDEX=1 to UDIM(MAT MAPN)
35324             let MAPN(INDEX)=INDEX
35325          next INDEX
35326 ! 
35327          mat FORM$(MAX(UDIM(MAT FORM$),F))  !Make room in forms array
35328          if ~DETAILS then 
35329             let FORM$(F)=FORM$(FSCREENIO)
35330          else 
35331             let FORM$(F)=FORM$(FSCREENFLD)
35332          end if 
35333       else 
35334          if ~DETAILS then 
35335 ! .        ! ScreenIO File Versions
35336             if VERSION(F) = 35 then ! #Select# Version(F) #Case# 35
35337 ! .           ! Version 35, current as of 5/5/2019
35338 ! .           ! Header - ScreenIO Record
35339                mat F$(37) : mat F(12)
35340 ! 
35341                mat MAPS(UDIM(MAT F$))
35342                mat MAPN(UDIM(MAT F))
35343 ! 
35344                mat FORM$(MAX(UDIM(MAT FORM$),F))  !Make room in forms array
35345                let FORM$(F)="form V 18,V 60,POS 82,V 255,V 60,2*C 6,V 18,13*V 255,POS 3743,V 80,POS 3825,V 255,POS 4086,2*V 30,POS 4148,V 64,2*V 255,POS 4725,5*V 255,POS 6002,5*V 255,POS 79,B 1,BH 2,POS 3742,B 1,POS 3823,BH 2,POS 4080,2*BH 3,POS 4146,2*B 1,POS 4722,BH 3,POS 6000,2*B 1,POS 7277,BH 4"
35346                let FORM$(F)=CFORM$(FORM$(F))
35347 ! 
35348                let MAPS(1)=SI_SCREENCODE !:
                     let MAPS(2)=SI_CAPTION !:
                     let MAPS(3)=SI_ATTRIBUTES !:
                     let MAPS(4)=SI_PICTURE !:
                     let MAPS(5)=SI_FGCOLOR !:
                     let MAPS(6)=SI_BGCOLOR !:
                     let MAPS(7)=SI_FILELAY !:
                     let MAPS(8)=SI_ENTERFN !:
                     let MAPS(9)=SI_INITFN !:
                     let MAPS(10)=SI_READFN !:
                     let MAPS(11)=SI_LOADFN !:
                     let MAPS(12)=SI_WRITEFN !:
                     let MAPS(13)=SI_WAITFN
35349                let MAPS(14)=SI_LOCKEDFN !:
                     let MAPS(15)=SI_MERGEFN !:
                     let MAPS(16)=SI_LOOPFN !:
                     let MAPS(17)=SI_NOKEYFN !:
                     let MAPS(18)=SI_PRELISTVIEWFN !:
                     let MAPS(19)=SI_POSTLISTVIEWFN !:
                     let MAPS(20)=SI_EXITFN !:
                     let MAPS(21)=SI_WINDCAP !:
                     let MAPS(22)=SI_INPUTATTR !:
                     let MAPS(23)=SI_CREATEUSER !:
                     let MAPS(24)=SI_MODIFYUSER !:
                     let MAPS(25)=SI_DEBUGSCREEN !:
                     let MAPS(26)=SI_DEBUGKEY
35350                let MAPS(27)=SI_DEBUGPARENTKEY !:
                     let MAPS(28)=SI_DEBUGPATH !:
                     let MAPS(29)=SI_DEBUGPASSED !:
                     let MAPS(30)=SI_PROTECTEDTEXT !:
                     let MAPS(31)=SI_PROTECTEDCHECK !:
                     let MAPS(32)=SI_PROTECTEDBUTTON !:
                     let MAPS(33)=SI_OTHERCHANGES !:
                     let MAPS(34)=SI_MYCHANGES !:
                     let MAPS(35)=SI_LOCKWINDOW !:
                     let MAPS(36)=SI_ACTIVECOLOR !:
                     let MAPS(37)=SI_USERDATA
35351 ! 
35352                let MAPN(1)=SI_VSIZE !:
                     let MAPN(2)=SI_HSIZE !:
                     let MAPN(3)=SI_BORDER !:
                     let MAPN(4)=SI_WAITTIME !:
                     let MAPN(5)=SI_CREATEDATE !:
                     let MAPN(6)=SI_MODIFYDATE !:
                     let MAPN(7)=SI_READINDEX !:
                     let MAPN(8)=SI_RETURNINDEX !:
                     let MAPN(9)=SI_DEBUGRECORD !:
                     let MAPN(10)=SI_SCREENIOLOCKING !:
                     let MAPN(11)=SI_SCREENIOMERGE !:
                     let MAPN(12)=SI_VERSION
35353             else if VERSION(F) = 0 then ! #Case# 0
35354 ! .           ! Legacy Cases, Importing from backups saved Prior to May 2019. We only support the most recent one. Prior to that imports won't be compatible importing into future versions.
35355 ! .           ! Header - ScreenIO Record
35356                mat F$(35) : mat F(12)
35357 ! 
35358                mat MAPS(UDIM(MAT F$))
35359                mat MAPN(UDIM(MAT F))
35360 ! 
35361                mat FORM$(MAX(UDIM(MAT FORM$),F))  !Make room in forms array
35362                let FORM$(F)="form V 18,V 60,POS 82,V 255,V 60,2*C 6,V 18,13*V 255,POS 3743,V 80,POS 3825,V 255,POS 4088,V 64,2*V 255,POS 4665,5*V 255,POS 5942,5*V 255,POS 79,B 1,BH 2,POS 3742,B 1,POS 3823,BH 2,POS 4080,2*BH 3,2*B 1,POS 4662,BH 3,POS 5940,2*B 1,POS 7217,BH 4"
35363                let FORM$(F)=CFORM$(FORM$(F))
35364 ! 
35365                let MAPS(1)=SI_SCREENCODE !:
                     let MAPS(2)=SI_CAPTION !:
                     let MAPS(3)=SI_ATTRIBUTES !:
                     let MAPS(4)=SI_PICTURE !:
                     let MAPS(5)=SI_FGCOLOR !:
                     let MAPS(6)=SI_BGCOLOR !:
                     let MAPS(7)=SI_FILELAY !:
                     let MAPS(8)=SI_ENTERFN !:
                     let MAPS(9)=SI_INITFN !:
                     let MAPS(10)=SI_READFN !:
                     let MAPS(11)=SI_LOADFN !:
                     let MAPS(12)=SI_WRITEFN !:
                     let MAPS(13)=SI_WAITFN !:
                     let MAPS(14)=SI_LOCKEDFN !:
                     let MAPS(15)=SI_MERGEFN !:
                     let MAPS(16)=SI_LOOPFN !:
                     let MAPS(17)=SI_NOKEYFN
35366                let MAPS(18)=SI_PRELISTVIEWFN !:
                     let MAPS(19)=SI_POSTLISTVIEWFN !:
                     let MAPS(20)=SI_EXITFN !:
                     let MAPS(21)=SI_WINDCAP !:
                     let MAPS(22)=SI_INPUTATTR !:
                     let MAPS(23)=SI_DEBUGSCREEN !:
                     let MAPS(24)=SI_DEBUGKEY !:
                     let MAPS(25)=SI_DEBUGPARENTKEY !:
                     let MAPS(26)=SI_DEBUGPATH !:
                     let MAPS(27)=SI_DEBUGPASSED !:
                     let MAPS(28)=SI_PROTECTEDTEXT !:
                     let MAPS(29)=SI_PROTECTEDCHECK !:
                     let MAPS(30)=SI_PROTECTEDBUTTON !:
                     let MAPS(31)=SI_OTHERCHANGES !:
                     let MAPS(32)=SI_MYCHANGES !:
                     let MAPS(33)=SI_LOCKWINDOW
35367                let MAPS(34)=SI_ACTIVECOLOR !:
                     let MAPS(35)=SI_USERDATA
35368 ! 
35369                let MAPN(1)=SI_VSIZE !:
                     let MAPN(2)=SI_HSIZE !:
                     let MAPN(3)=SI_BORDER !:
                     let MAPN(4)=SI_WAITTIME !:
                     let MAPN(5)=SI_CREATEDATE !:
                     let MAPN(6)=SI_MODIFYDATE !:
                     let MAPN(7)=SI_READINDEX !:
                     let MAPN(8)=SI_RETURNINDEX !:
                     let MAPN(9)=SI_DEBUGRECORD !:
                     let MAPN(10)=SI_SCREENIOLOCKING !:
                     let MAPN(11)=SI_SCREENIOMERGE !:
                     let MAPN(12)=SI_VERSION
35370             end if                    !#End Select#
35371          else 
35372 ! .        ! Details - Screen Flds File
35373 ! 
35374             if VERSION(F) = 35 OR VERSION(F) = 0 then ! #Select# Version(F) #Case# 35 # 0
35375 ! .           ! Version 35 and Legacy Version 0 are the same, Screen Flds file is the same for both of these versions.
35376                mat F$(18) : mat F(9)
35377 ! 
35378                mat MAPS(UDIM(MAT F$))
35379                mat MAPN(UDIM(MAT F))
35380 ! 
35381                mat FORM$(MAX(UDIM(MAT FORM$),F))  !Make room in forms array
35382                let FORM$(F)="form V 18,2*V 50,V 255,POS 377,V 8,POS 390,2*V 60,2*V 255,V 20,2*C 6,C 1,V 128,POS 1183,3*V 255,POS 1949,V 255,POS 374,B 1,BH 2,POS 385,2*BH 2,B 1,POS 1181,2*B 1,POS 1948,B 1,POS 2204,B 1"
35383                let FORM$(F)=CFORM$(FORM$(F))
35384 ! 
35385                let MAPS(1)=SF_SCREENCODE !:
                     let MAPS(2)=SF_CONTROLNAME !:
                     let MAPS(3)=SF_FIELDNAME !:
                     let MAPS(4)=SF_DESCRIPTION !:
                     let MAPS(5)=SF_FIELDTYPE !:
                     let MAPS(6)=SF_TRUEVALUE !:
                     let MAPS(7)=SF_FALSEVALUE !:
                     let MAPS(8)=SF_FUNCTION !:
                     let MAPS(9)=SF_PICTURE
35386                let MAPS(10)=SF_PARENT !:
                     let MAPS(11)=SF_FGCOLOR !:
                     let MAPS(12)=SF_BGCOLOR !:
                     let MAPS(13)=SF_JUSTIFY !:
                     let MAPS(14)=SF_ATTR !:
                     let MAPS(15)=SF_TOOLTIP !:
                     let MAPS(16)=SF_CNVRTIN !:
                     let MAPS(17)=SF_CNVRTOUT !:
                     let MAPS(18)=SF_USERDATA
35387 ! 
35388                let MAPN(1)=SF_VPOSITION !:
                     let MAPN(2)=SF_HPOSITION !:
                     let MAPN(3)=SF_SPECWIDTH !:
                     let MAPN(4)=SF_WIDTH !:
                     let MAPN(5)=SF_HEIGHT !:
                     let MAPN(6)=SF_PROTECTED !:
                     let MAPN(7)=SF_INVISIBLE !:
                     let MAPN(8)=SF_MULTISELECT !:
                     let MAPN(9)=SF_GRIDLINES
35389             end if                    !#End Select#
35390          end if 
35391       end if 
35392    fnend 
35393 ! 
35394 Importscreen: ! Imports The Screen From A User Selected File
35395    def FNIMPORTSCREEN(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,FIMPORTFILE,INDEX,CSOPENSTRING$)
35396 ! .  ! if Fnclientserver then let Csopenstring$="@:"
35397       open #(FIMPORTFILE:=FNGETFILENUMBER): "name=open:"&CSOPENSTRING$&"*.sio",internal,input,sequential error IGNORE
35398       if FILE(FIMPORTFILE)=0 then 
35399 ! .     ! We need to check Version(fImportFile). If it matches the current version, we use the subs and sizes for standard ScreenIO.
35400 ! .     !  if its an older version, we need to load the subs and sizes for that version.
35401          let FNIMPORTRECORDVERSION(FIMPORTFILE,MAT SCREENIO$,MAT SCREENIO)
35402 ! .     ! read #Fimportfile, using Form$(Fscreenio), release: Mat Screenio$, Mat Screenio error IGNORE
35403 ! 
35404          let FNRESIZECONTROLARRAYS(0, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35405 ! 
35406          do WHILE FILE(FIMPORTFILE)=0
35407 ! .        ! read #Fimportfile, using Form$(Fscreenfld), release: Mat Screenfld$, Mat Screenfld eof IGNORE
35408 ! .        ! if File(Fimportfile)=0 then
35409             if FNIMPORTRECORDVERSION(FIMPORTFILE,MAT SCREENFLD$,MAT SCREENFLD,1) then 
35410                let INDEX=UDIM(MAT CONTROLNAME$)+1
35411                let FNRESIZECONTROLARRAYS(INDEX, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35412 ! 
35413                let CONTROLNAME$(INDEX)=SCREENFLD$(SF_CONTROLNAME) !:
                     let FIELDNAME$(INDEX)=SCREENFLD$(SF_FIELDNAME) !:
                     let DESCRIPTION$(INDEX)=SCREENFLD$(SF_DESCRIPTION) !:
                     let VPOSITION(INDEX)=SCREENFLD(SF_VPOSITION) !:
                     let HPOSITION(INDEX)=SCREENFLD(SF_HPOSITION) !:
                     let FIELDTYPE$(INDEX)=SCREENFLD$(SF_FIELDTYPE) !:
                     let SPECWIDTH(INDEX)=SCREENFLD(SF_SPECWIDTH) !:
                     let WIDTH(INDEX)=SCREENFLD(SF_WIDTH) !:
                     let HEIGHT(INDEX)=SCREENFLD(SF_HEIGHT) !:
                     let TRUEVALUE$(INDEX)=SCREENFLD$(SF_TRUEVALUE) !:
                     let FALSEVALUE$(INDEX)=SCREENFLD$(SF_FALSEVALUE) !:
                     let FUNCTION$(INDEX)=SCREENFLD$(SF_FUNCTION) !:
                     let PICTURE$(INDEX)=SCREENFLD$(SF_PICTURE)
35414                let PARENT$(INDEX)=SCREENFLD$(SF_PARENT) !:
                     let FGCOLOR$(INDEX)=SCREENFLD$(SF_FGCOLOR) !:
                     let BGCOLOR$(INDEX)=SCREENFLD$(SF_BGCOLOR) !:
                     let JUSTIFY$(INDEX)=SCREENFLD$(SF_JUSTIFY) !:
                     let ATTR$(INDEX)=SCREENFLD$(SF_ATTR) !:
                     let PROTECTED(INDEX)=SCREENFLD(SF_PROTECTED) !:
                     let INVISIBLE(INDEX)=SCREENFLD(SF_INVISIBLE) !:
                     let TOOLTIP$(INDEX)=SCREENFLD$(SF_TOOLTIP) !:
                     let CNVRTIN$(INDEX)=SCREENFLD$(SF_CNVRTIN) !:
                     let CNVRTOUT$(INDEX)=SCREENFLD$(SF_CNVRTOUT) !:
                     let MULTISELECT(INDEX)=SCREENFLD(SF_MULTISELECT) !:
                     let GRIDLINES(INDEX)=SCREENFLD(SF_GRIDLINES) !:
                     let USERDATA$(INDEX)=SCREENFLD$(SF_USERDATA)
35415             end if 
35416          loop 
35417 ! 
35418          close #FIMPORTFILE: 
35419          let FNIMPORTSCREEN=1
35420       end if 
35421    fnend 
35422 ! 
35423 Recompileallscreens: ! Recompiles Every Screen
35424    def FNRECOMPILEALLSCREENS(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;___,SAVESCREENCODE$,INDEX,TIME,FILENAME$)
35425       dim TEMPSCREENLIST$(1),TEMPCREATEDATE(1),TEMPMODIFYDATE(1),TEMPVERSION(1),TEMPCREATEUSER$(1)*30,TEMPMODIFYUSER$(1)*30,TEMPPROJECT$(1)*255,TEMPNOTES$(1)*255
35426       dim FAILEDLIST$*2047
35427       let SAVESCREENCODE$=STATIC_SCREENNAME$
35428       let FNREADALLSCREENCODES(MAT TEMPSCREENLIST$,MAT TEMPCREATEDATE,MAT TEMPMODIFYDATE,MAT TEMPVERSION,MAT TEMPCREATEUSER$,MAT TEMPMODIFYUSER$,MAT TEMPPROJECT$,MAT TEMPNOTES$)
35429 ! 
35430       if EXISTS("compile[SESSION].$$$") then 
35431          execute "free compile[SESSION].$$$"
35432       end if 
35433 ! 
35434       let FAILEDLIST$=""
35435       for INDEX=1 to UDIM(MAT TEMPSCREENLIST$)
35436          if FNREADSCREEN(TEMPSCREENLIST$(INDEX),MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES) then 
35437             let FNCOMPILEHELPERLIBRARY(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,FILENAME$)
35438             let FNWAITFORFILE(FAILEDLIST$,LWRC$(TRIM$(TEMPSCREENLIST$(INDEX))),FILENAME$)
35439          end if 
35440       next INDEX
35441 ! 
35442       if LEN(FAILEDLIST$) then 
35443          let MSGBOX("The following screens took a long time and may have had errors:"&CHR$(13)&CHR$(13)&FAILEDLIST$(3:9999))
35444       end if 
35445 ! 
35446       let FNREADSCREEN(SAVESCREENCODE$,MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES)
35447    fnend 
35448 ! 
35449    def FNWAITFORFILE(&FAILEDLIST$,SCREEN$;&FILENAME$,___,TIME,WINDOW,KY$,TRY,X)
35450       if FILENAME$="" then let FILENAME$="compile"&SESSION$&".$$$"
35451       do WHILE EXISTS(FILENAME$)
35452          let SLEEP(.1)
35453          let TIME+=1
35454          if TIME>20 then 
35455             let FAILEDLIST$=FAILEDLIST$&", "&SCREEN$
35456             open #(WINDOW:=FNGETFILENUMBER): "srow=14,scol=45,rows=3,cols=30,n=/#FFFFFF:#FF0000", display, outin 
35457             print #WINDOW, fields "1,1,90/C 120,S" : "We're sorry. The compile process appears to be stuck. Close the open window or press the Space Bar to continue."
35458             do WHILE KSTAT$<>""       !Clear Keyboard Buffer
35459             loop 
35460             do WHILE EXISTS(FILENAME$)
35461                let SLEEP(.1)
35462                let KY$=KSTAT$
35463                if KY$=" " then 
35464                   let TRY+=1
35465                   if TRY=1 then 
35466                      execute "free "&FILENAME$ error IGNORE
35467                      if EXISTS(FILENAME$) then 
35468                         print #WINDOW, fields "1,1,90/C 120,S" : "The file is locked. Please close any BR windows or press Space again to force it."
35469                      end if 
35470                   else if TRY=2 then 
35471                      do WHILE EXISTS(FILENAME$)
35472                         let X+=1
35473                         let FILENAME$="compile"&SESSION$&"-"&STR$(X)&".$$$"
35474                      loop 
35475                   end if 
35476                end if 
35477             loop 
35478             close #WINDOW: 
35479          end if 
35480       loop 
35481    fnend 
35482 ! 
35483 Compilehelperlibrary: ! Compiles The Helper Library For The Screen
35484    def FNCOMPILEHELPERLIBRARY(MAT SCREENIO$,MAT SCREENIO,MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;FILENAME$,WAITFORCOMPLETE,___,DUMMY$*255,SPECIALFUNCTION$*255,SPECIALFUNCCALL$*255,INDEX,FILENUMBER,ELSEIF$,LIBRARY$*80,FUNCCALL$*255,LONGSTRING$*800,FUNCTION$*255,LONGSTRING2$*800,DEBUGSCREEN$*64,PATHINFO$*511,DEBUGEXT$)
35485 ! 
35486       if FILENAME$="" then let FILENAME$="compile"&SESSION$&".$$$"
35487 ! 
35488       dim ALREADYSETFUNCTIONS$(1)*255
35489       mat ALREADYSETFUNCTIONS$(0)
35490       dim NEWINCLUDEFUNCTIONS$(1)*255
35491       mat NEWINCLUDEFUNCTIONS$(0)
35492 ! 
35493       let FNCHECKHELPERLIBFOLDER
35494 ! .   ! Create new display file or replace it
35495       open #(FILENUMBER:=FNGETFILENUMBER) : "name="&SETTING_SCREENFOLDER$&"\"&TRIM$(SCREENIO$(SI_SCREENCODE))&".brs, recl=800, replace",display,output 
35496 ! 
35497 ! .   ! Print heading to it
35498       let FNSETLINENUMBER(10,10,FILENUMBER)
35499       let FNPRINTLINE("! "&SETTING_SCREENFOLDER$&"\"&LWRC$(TRIM$(SCREENIO$(SI_SCREENCODE)))&".br")
35500       let FNPRINTLINE("! ScreenIO Generated Helper Library for "&UPRC$(TRIM$(SCREENIO$(SI_SCREENCODE)))&" screen")
35501       let FNPRINTLINE("! Copyright 2008 by Sage AX")
35502       let FNPRINTLINE("! ")
35503       let FNPRINTLINE("! Compiled On: "&DATE$("mm/dd/ccyy"))
35504       let FNPRINTLINE("! Version: "&STR$(SCREENIO(SI_VERSION)))
35505       let FNPRINTLINE("! ")
35506       let FNPRINTLINE('! ')
35507       let FNPRINTLINE('! ')
35508 ! 
35509 ! .   ! Dim Helper Library Variables
35510       let FNSETLINENUMBER(300,10)
35511       let FNPRINTLINE('! ')
35512       let FNPRINTLINE('   option retain')
35513       let FNPRINTLINE('   dim FileIOLinkageSet')
35514       let FNPRINTLINE('   dim Ret$*255')
35515       let FNPRINTLINE('   dim PassedData$(1)*255')
35516       let FNUNPACKPDATA$(MAT PDATA$,SCREENIO$(SI_DEBUGPASSED))
35517       let FNPRINTLINE('   mat PassedData$('&STR$(UDIM(MAT PDATA$))&')')
35518       let FNSETLINENUMBER(400,1)
35519       for INDEX=1 to UDIM(MAT PDATA$)
35520          let FNPRINTLINE('   let PassedData$('&STR$(INDEX)&')="'&SREP$(PDATA$(INDEX),"""","""""")&'"')
35521       next INDEX
35522 ! 
35523       let FNSETLINENUMBER(600,10)
35524       if LEN(TRIM$(SCREENIO$(SI_DEBUGPATH))) then 
35525          let FNPRINTLINE('   dim MyF$(1)*255')
35526          let FNPRINTLINE('   dim MyF(1)')
35527          let PATHINFO$=",0,mat MyF$,mat MyF,"""&TRIM$(SCREENIO$(SI_DEBUGPATH))&""""
35528       end if 
35529 ! 
35530       let FNPRINTLINE('! ')
35531 ! 
35532 ! .   ! Print Main Routine (Links to screen, runs it)
35533       let FNSETLINENUMBER(1000,10)
35534       let FNPRINTLINE('Main: ! If you run me as a program, I run the '&LWRC$(TRIM$(SCREENIO$(SI_SCREENCODE)))& ' screen')
35535       let FNPRINTLINE('   library "'&SETTING_SCREENIOPATH$&'" : fnfm$')
35536 ! 
35537       if LEN(TRIM$(SCREENIO$(SI_DEBUGSCREEN))) then 
35538          let DEBUGSCREEN$=LWRC$(TRIM$(SCREENIO$(SI_DEBUGSCREEN)))
35539       else 
35540          let DEBUGSCREEN$=LWRC$(TRIM$(SCREENIO$(SI_SCREENCODE)))
35541       end if 
35542 ! 
35543       if DEBUGSCREEN$(1:1)="%" then 
35544          let FNPRINTLINE('   let Key$="'&SREP$(SCREENIO$(SI_DEBUGKEY),"""","""""")&'"')
35545          let FNPRINTLINE('   let ParentKey$="'&SREP$(SCREENIO$(SI_DEBUGPARENTKEY),"""","""""")&'"')
35546          let FNPRINTLINE('   let Record='&STR$(SCREENIO(SI_DEBUGRECORD)))
35547          let FNPRINTLINE('   let Path$="'&SREP$(SCREENIO$(SI_DEBUGPATH),"""","""""")&'"')
35548          let FNPRINTLINE('   let ScreenCode$="'&TRIM$(SCREENIO$(SI_SCREENCODE))&'"')
35549          if POS(LWRC$(DEBUGSCREEN$),".br") OR POS(LWRC$(DEBUGSCREEN$),".wb") then 
35550             let FNPRINTLINE('   chain "'&DEBUGSCREEN$(2:99)&'",mat PassedData$,Key$,ParentKey$,Record,Path$,ScreenCode$')
