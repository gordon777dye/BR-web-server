42005 !  ======================= Debug Window ======================
42010 !  = These Variables Are Used Only In Debug Window Functions =
42015 !  ===========================================================
42020    dim DEBUGHEADINGS$(3),DEBUGWIDTHS(3), DEBUGSPEC$(3)
42025    dim DEBUGOBJECT(1) ,DEBUGFIELD(1) ,DEBUGMESSAGE$(1)*255
42030    dim DEBUGCLEAROBJECT(1),DEBUGCLEARFIELD(1),DEBUGCLEARMESSAGE$(1)*255
42035 ! 
42040    dim DEBUG_START(1), DEBUG_END(1), DEBUG_COLOR$(1)
42045 ! 
42050 !  Parallel accumulator so validation results are readable headlessly (no GUI window needed) -
42055 !  added for fnCheckScreenErrors, see COMPILESCREEN's neighbor below
42060    dim DEBUGERROR_OBJECT(0), DEBUGERROR_FIELD(0), DEBUGERROR_MESSAGE$(0)*255, DEBUGERROR_TYPE(0)
42065 ! 
42070 Opendebugwindow: !  Open Debug Window,  Set  "Static" Variables
42075    def FNOPENDEBUGWINDOW(SCREENVSIZE,SCREENHSIZE,TOOLBARWIDTH,DEBUGMAXHEIGHT,TOPOFSPACE;___,WINDOWVPOSITION,WINDOWHPOSITION)
42080 ! 
42085       let STATIC_DEBUGVSIZE=MIN(SCREENVSIZE-TOPOFSPACE,DEBUGMAXHEIGHT)
42090       let WINDOWVPOSITION=SCREENVSIZE-STATIC_DEBUGVSIZE
42095 ! 
42100       let WINDOWHPOSITION=TOOLBARWIDTH+4
42105       let STATIC_DEBUGHSIZE=SCREENHSIZE-WINDOWHPOSITION
42110 ! 
42115       open #(STATIC_WDEBUG:=FNGETFILENUMBER): "SROW=" & STR$(WINDOWVPOSITION) & ", SCOL=" & STR$(WINDOWHPOSITION) & ",   ROWS=" & STR$(STATIC_DEBUGVSIZE) & ",   COLS="& STR$(STATIC_DEBUGHSIZE)&",   Border=S,   Caption=Debug", display, outin 
42120 ! 
42125    fnend 
42130 ! 
42135 Paintdebugwindow: !  Puts  The Listview In The Debug Window
42140    def FNPAINTDEBUGWINDOW
42145 ! 
42150       let DEBUGHEADINGS$(1)="Object"  !Hidden Field
42155       let DEBUGWIDTHS(1)=0
42160       let DEBUGSPEC$(1)="N 5"
42165       let DEBUGHEADINGS$(2)="Field"   !Hidden Field
42170       let DEBUGWIDTHS(2)=0
42175       let DEBUGSPEC$(2)="N 5"
42180       let DEBUGHEADINGS$(3)="To Do:   "
42185       let DEBUGWIDTHS(3)=76
42190       let DEBUGSPEC$(3)="CC 255"
42195 ! 
42200       let DB_WARNING=1
42205       let DB_ERROR=2
42210 ! 
42215       let STATIC_DEBUGLISTVIEW$="1,1,LIST "&STR$(STATIC_DEBUGVSIZE)&"/"&STR$(STATIC_DEBUGHSIZE)
42220 ! 
42225       print #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$&",HEADERS,/W:W,1200" : (MAT DEBUGHEADINGS$, MAT DEBUGWIDTHS, MAT DEBUGSPEC$)
42230       let FNCLEARDEBUGLISTVIEW
42235    fnend 
42240 ! 
42245 Colordebugactive: !  Colors  The Debug Window Yellow If Its Active
42250    def FNCOLORDEBUGACTIVE(;ACTIVE,_,ROWCOUNT)
42255 ! 
42260       if ACTIVE then 
42265          if STATIC_DEBUGACTIVE then ! Do Nothing
42270          else 
42275             let STATIC_DEBUGACTIVE=1
42280             input #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ & ",ROWCNT,ALL,NOWAIT" : ROWCOUNT
42285             if ROWCOUNT then 
42290 ! 
42295                let DEBUG_START(1)=1
42300                let DEBUG_END(1)=ROWCOUNT
42305                let DEBUG_COLOR$(1)="/#000000:#FFFF77"
42310                print #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ & ",ATTR" : (MAT DEBUG_START, MAT DEBUG_END, MAT DEBUG_COLOR$)
42315             end if 
42320          end if 
42325       else 
42330          if STATIC_DEBUGACTIVE then 
42335             let STATIC_DEBUGACTIVE=0
42340             input #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ & ",ROWCNT,ALL,NOWAIT" : ROWCOUNT
42345             if ROWCOUNT then 
42350                let DEBUG_START(1)=1
42355                let DEBUG_END(1)=ROWCOUNT
42360                let DEBUG_COLOR$(1)="/#000000:#FFFFFF"
42365                print #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ & ",ATTR" : (MAT DEBUG_START, MAT DEBUG_END, MAT DEBUG_COLOR$)
42370             end if 
42375          end if 
42380       end if 
42385    fnend 
42390 ! 
42395 Cleardebuglistview: !   Clear The Debug List  View
42400    def FNCLEARDEBUGLISTVIEW
42405       mat DEBUGCLEAROBJECT(0) : mat DEBUGCLEARFIELD(0) : mat DEBUGCLEARMESSAGE$(0)
42410       mat DEBUGERROR_OBJECT(0) : mat DEBUGERROR_FIELD(0) : mat DEBUGERROR_MESSAGE$(0) : mat DEBUGERROR_TYPE(0)
42415       if STATIC_WDEBUG<>0 AND FILE(STATIC_WDEBUG)<>-1 then 
42420          print #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ &",=,1200" : (MAT DEBUGCLEAROBJECT, MAT DEBUGCLEARFIELD, MAT DEBUGCLEARMESSAGE$)
42425       end if 
42430    fnend 
42435 ! 
42440 Printtodebuglistview: !  Prints Items To The Debug Listview
42445    def FNPRINTTODEBUGLISTVIEW(OBJECT,FIELD,MESSAGE$*255,ERRTYPE;___,POPULATE$)
42450 ! 
42455       mat DEBUGERROR_OBJECT(UDIM(MAT DEBUGERROR_OBJECT)+1)
42460       mat DEBUGERROR_FIELD(UDIM(MAT DEBUGERROR_FIELD)+1)
42465       mat DEBUGERROR_MESSAGE$(UDIM(MAT DEBUGERROR_MESSAGE$)+1)
42470       mat DEBUGERROR_TYPE(UDIM(MAT DEBUGERROR_TYPE)+1)
42475       let DEBUGERROR_OBJECT(UDIM(MAT DEBUGERROR_OBJECT))=OBJECT
42480       let DEBUGERROR_FIELD(UDIM(MAT DEBUGERROR_FIELD))=FIELD
42485       let DEBUGERROR_MESSAGE$(UDIM(MAT DEBUGERROR_MESSAGE$))=MESSAGE$
42490       let DEBUGERROR_TYPE(UDIM(MAT DEBUGERROR_TYPE))=ERRTYPE
42495 ! 
42500       if STATIC_WDEBUG<>0 AND FILE(STATIC_WDEBUG)<>-1 then 
42505          if CLEAR then 
42510             let POPULATE$=",="
42515          else 
42520             let POPULATE$=",+"
42525          end if 
42530 ! 
42535          let DEBUGOBJECT(1)=OBJECT
42540          let DEBUGFIELD(1)=FIELD
42545          let DEBUGMESSAGE$(1)=MESSAGE$
42550 ! 
42555          print #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ & POPULATE$ & ",1200" : (MAT DEBUGOBJECT, MAT DEBUGFIELD, MAT DEBUGMESSAGE$)
42560          input #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ & ",ROWCNT,ALL,NOWAIT" : ROWCOUNT
42565 ! 
42570          let DEBUG_START(1)=ROWCOUNT
42575          let DEBUG_END(1)=ROWCOUNT
42580 ! 
42585          if ERRTYPE = DB_WARNING then ! #Select# Errtype #Case# Db_Warning
42590             let DEBUG_COLOR$(1)="/#0033FF"
42595          else if ERRTYPE = DB_ERROR then ! #Case# Db_Error
42600             let DEBUG_COLOR$(1)="/#AA0000"
42605          else ! #Case Else#
42610             let DEBUG_COLOR$(1)="/#000000"
42615          end if                       !#End Select#
42620 ! 
42625          if STATIC_DEBUGACTIVE then 
42630             let DEBUG_COLOR$(1)=DEBUG_COLOR$(1) & ":#FFFF77"
42635          else 
42640             let DEBUG_COLOR$(1)=DEBUG_COLOR$(1) & ":#FFFFFF"
42645          end if 
42650 ! 
42655          print #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$ & ",ATTR,1200" : (MAT DEBUG_START, MAT DEBUG_END, MAT DEBUG_COLOR$)
42660       end if 
42665 ! 
42670    fnend 
42675 ! 
42680 Readdebug: !  Reads The Debug Listview To Return The Last Thing The User Clicked On
42685    def FNREADDEBUG(&OBJECT;&FIELD,&MESSAGE$)
42690       input #STATIC_WDEBUG, fields STATIC_DEBUGLISTVIEW$&",ROW,SEL,NOWAIT" : (MAT DEBUGOBJECT, MAT DEBUGFIELD, MAT DEBUGMESSAGE$)
42695 ! 
42700       let OBJECT=DEBUGOBJECT(1)
42705       let FIELD=DEBUGFIELD(1)
42710       let MESSAGE$=DEBUGMESSAGE$(1) soflow IGNORE
42715 ! 
42720    fnend 
