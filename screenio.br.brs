48338             if EXISTS("screen\oldscreenfld.key") then execute "free screen\oldscreenfld.key"
48340             if EXISTS("screen\oldscreenfld.ky2") then execute "free screen\oldscreenfld.ky2"
48342             execute "copy screen\screenfld.dat screen\temp.dat -d"
48344             execute "rename screen\screenfld.dat screen\oldscreenfld.dat"
48346             execute "rename screen\temp.dat screen\screenfld.dat"
48348             execute "rename screen\screenfld.key screen\oldscreenfld.key"
48350             execute "rename screen\screenfld.ky2 screen\oldscreenfld.ky2"
48352             let FNUPDATEFILE("screenfld")
48354             let FNOPENSCREENFILES(MAT SCREENIO$,MAT SCREENIO)
48356             let FNPROCESSWINDOWSMENU=MENUPURGE
48358          end if 
48360 ! 
48362       else if LWRC$(MENU$) = "test" then ! #Case# "test"
