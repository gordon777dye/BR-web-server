01000 Main: ! If you run me as a program, I run the customerlisttest screen
01010    library "screenio" : fnfm$
01020    let Ret$=fnfm$("customerlisttest","",0,0,"",0,0,0,0)
01030    if len(trim$(Ret$)) then
01040       print Ret$
01050    end if
01060    if fkey=93 then execute "system"
01070    stop
