90574 ! 
90576    def FNPUSH$(MAT ARRAY$;ALTSTACK,WIPE)
90578       if ALTSTACK=1 then 
90580          let FNPUSH$=FNPUSHARRAY$(MAT ARRAY$,MAT UNDOSTACK$,MAT UNDOLONGSTACK$)
90582       else if ALTSTACK=2 then 
90584          let FNPUSH$=FNPUSHARRAY$(MAT ARRAY$,MAT SCREENDATA$,MAT SCREENLONGDATA$)
90586       else 
90588          let FNPUSH$=FNPUSHARRAY$(MAT ARRAY$,MAT STACK$,MAT LONGSTACK$)
90590       end if 
90592       if WIPE then 
90594          mat ARRAY$(0)
90596       end if 
90598    fnend 
90600    def FNPOP$(MAT ARRAY$;ALTSTACK)
90602       if ALTSTACK=1 then 
90604          let FNPOP$=FNPOPARRAY$(MAT ARRAY$,MAT UNDOSTACK$,MAT UNDOLONGSTACK$)
90606       else if ALTSTACK=2 then 
90608          if UDIM(MAT SCREENDATA$) then 
90610             let FNPOP$=FNPOPARRAY$(MAT ARRAY$,MAT SCREENDATA$,MAT SCREENLONGDATA$)
90612          else 
90614             let FNPOPERRORMESSAGE
90616          end if 
90618       else 
90620          let FNPOP$=FNPOPARRAY$(MAT ARRAY$,MAT STACK$,MAT LONGSTACK$)
90622       end if 
90624    fnend 
90626    def FNPUSH(MAT ARRAY;ALTSTACK,WIPE)
90628       if ALTSTACK=1 then 
90630          let FNPUSH=FNPUSHARRAY(MAT ARRAY,MAT UNDOSTACK)
90632       else if ALTSTACK=2 then 
90634          let FNPUSH=FNPUSHARRAY(MAT ARRAY,MAT SCREENDATA)
90636       else 
90638          let FNPUSH=FNPUSHARRAY(MAT ARRAY,MAT STACK)
90640       end if 
90642       if WIPE then 
90644          mat ARRAY(0)
90646       end if 
90648    fnend 
90650    def FNPOP(MAT ARRAY;ALTSTACK)
90652       if ALTSTACK=1 then 
90654          let FNPOP=FNPOPARRAY(MAT ARRAY,MAT UNDOSTACK)
90656       else if ALTSTACK=2 then 
90658          if UDIM(MAT SCREENDATA) then 
90660             let FNPOP=FNPOPARRAY(MAT ARRAY,MAT SCREENDATA)
90662          else 
90664             let FNPOPERRORMESSAGE
90666          end if 
90668       else 
90670          let FNPOP=FNPOPARRAY(MAT ARRAY,MAT STACK)
90672       end if 
90674    fnend 
90676 ! 
90678    def FNPOPERRORMESSAGE
90680       print "Error. Unable to unpack the stack when calling a Custom Screen Function."
90682       print "If this error happens after updating ScreenIO, then you need to recompile"
90684       print "all your screens for the upgrade. Choose File -> Recompile All Screens"
90686       pause 
90688    fnend 
90690 ! 
90692    dim PUSHVALUE$(1)*2047,PUSHVALUE(1)
90694    def FNPUSHVALUE$(&VAR$;ALTSTACK,WIPE)
90696       mat PUSHVALUE$(1)
90698       let PUSHVALUE$(1)=VAR$
90700       let FNPUSH$(MAT PUSHVALUE$,ALTSTACK,WIPE)
90702       if WIPE then let VAR$=""
90704    fnend 
90706    def FNPOPVALUE$(&VAR$;ALTSTACK)
90708       let FNPOP$(MAT PUSHVALUE$,ALTSTACK)
90710       let VAR$=PUSHVALUE$(1)
90712    fnend 
90714    def FNPUSHVALUE(&VAR;ALTSTACK,WIPE)
90716       mat PUSHVALUE(1)
90718       let PUSHVALUE(1)=VAR
90720       let FNPUSH(MAT PUSHVALUE,ALTSTACK,WIPE)
90722       if WIPE then let VAR=0
90724    fnend 
90726    def FNPOPVALUE(&VAR;ALTSTACK)
90728       let FNPOP(MAT PUSHVALUE,ALTSTACK)
90730       let VAR=PUSHVALUE(1)
90732    fnend 
90734 ! 
90736    dim PUSHWORKARRAY$(1)*4000
90738    def FNPUSHARRAY$(MAT ARRAY$,MAT STACK$,MAT LONGSTACK$;___,STARTINDEX,ENDINDEX,SIZE,INDEX)
90740       mat PUSHWORKARRAY$(UDIM(MAT ARRAY$))=ARRAY$
90742       for INDEX=1 to UDIM(MAT PUSHWORKARRAY$)
90744          if LEN(PUSHWORKARRAY$(INDEX))>255 then 
90746             mat LONGSTACK$(UDIM(MAT LONGSTACK$)+1)
90748             let LONGSTACK$(UDIM(MAT LONGSTACK$))=PUSHWORKARRAY$(INDEX)
90750             let PUSHWORKARRAY$(INDEX)="[[[loNgsTaCk]]]"
90752          end if 
90754       next INDEX
90756 ! 
90758       let STARTINDEX=UDIM(MAT STACK$)+1
90760       let SIZE=UDIM(MAT PUSHWORKARRAY$)
90762       let ENDINDEX=STARTINDEX+SIZE-1
90764       mat STACK$(ENDINDEX+1)
90766       if SIZE then 
90768          mat STACK$(STARTINDEX:ENDINDEX)=PUSHWORKARRAY$
90770       end if 
90772       let STACK$(ENDINDEX+1)=STR$(SIZE)
90774    fnend 
90776    def FNPOPARRAY$(MAT ARRAY$,MAT STACK$,MAT LONGSTACK$;___,STARTINDEX,ENDINDEX,SIZE,INDEX)
90778       let ENDINDEX=UDIM(MAT STACK$)-1
90780       let SIZE=VAL(STACK$(ENDINDEX+1))
90782       let STARTINDEX=ENDINDEX-SIZE+1
90784       mat ARRAY$(SIZE)
90786       if SIZE then 
90788          mat ARRAY$=STACK$(STARTINDEX:ENDINDEX)
90790       end if 
90792       mat STACK$(STARTINDEX-1)
90794 ! 
90796       for INDEX=UDIM(MAT ARRAY$) to 1 step -1
90798          if ARRAY$(INDEX)="[[[loNgsTaCk]]]" then 
90800             let ARRAY$(INDEX)=LONGSTACK$(UDIM(MAT LONGSTACK$))
90802             mat LONGSTACK$(UDIM(MAT LONGSTACK$)-1)
90804          end if 
90806       next INDEX
90808    fnend 
90810    def FNPUSHARRAY(MAT ARRAY,MAT STACK;___,STARTINDEX,ENDINDEX,SIZE)
90812       let STARTINDEX=UDIM(MAT STACK)+1
90814       let SIZE=UDIM(MAT ARRAY)
90816       let ENDINDEX=STARTINDEX+SIZE-1
90818       mat STACK(ENDINDEX+1)
90820       if SIZE then 
90822          mat STACK(STARTINDEX:ENDINDEX)=ARRAY
90824       end if 
90826       let STACK(ENDINDEX+1)=SIZE
90828    fnend 
90830    def FNPOPARRAY(MAT ARRAY,MAT STACK;___,STARTINDEX,ENDINDEX,SIZE)
90832       let ENDINDEX=UDIM(MAT STACK)-1
90834       let SIZE=STACK(ENDINDEX+1)
90836       let STARTINDEX=ENDINDEX-SIZE+1
90838       mat ARRAY(SIZE)
90840       if SIZE then 
90842          mat ARRAY=STACK(STARTINDEX:ENDINDEX)
90844       end if 
90846       mat STACK(STARTINDEX-1)
90848    fnend 
