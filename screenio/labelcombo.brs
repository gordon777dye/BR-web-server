89600 ! 
90130 Pack: ! Pack Data Functions
90132 ! 
90134    dim SCREENDATA$(1)*255
90136    dim SCREENLONGDATA$(1)*2047
90138    dim SCREENDATA(1)
90140 ! 
90142 ! .! AltStack:
90144 ! .!  0 - Regular Stack - This is used when loading a screen from inside another screen.
90146 ! .!  1 - Undo Stack - This is used when tracking undo history while editing a screen
90148 ! .!  2 - Custom Function Parameter Stack - This is used to pass the bulk of screen data into your helper library in 2 simple variables.
90150 ! .!
90152    def FNPUSHDATA(;ALTSTACK,WIPE)
90154       if ALTSTACK<>2 then 
90156          let FNPUSH$(MAT PASSEDINF$,ALTSTACK,WIPE)
90158          let FNPUSH(MAT PASSEDINF,ALTSTACK,WIPE)
90160          let FNPUSH$(MAT S$,ALTSTACK,WIPE)
90162          let FNPUSH$(MAT F$,ALTSTACK,WIPE)
90164          let FNPUSH(MAT F,ALTSTACK,WIPE)
90166 ! 
90168          let FNPUSH$(MAT FIELDSSSUBS$,ALTSTACK,WIPE)
90170          let FNPUSH$(MAT FIELDSNSUBS$,ALTSTACK,WIPE)
90172 ! 
90174          let FNPUSH$(MAT SCREENSUBS$,ALTSTACK,WIPE)
90176          let FNPUSH$(MAT FORM$,ALTSTACK,WIPE)
90178          let FNPUSH(MAT S_SUBS,ALTSTACK,WIPE)
90180          let FNPUSHVALUE$(TEMPDATA$,ALTSTACK,WIPE)
90182 ! 
90184          let FNPUSH$(MAT TEMP_S_SPEC$,ALTSTACK,WIPE)
90186          let FNPUSH(MAT OLD_DATA,ALTSTACK,WIPE)
90188          let FNPUSH$(MAT RLV_SAVEREADDATA$,ALTSTACK,WIPE)
90190       end if 
90192 ! 
90194       let FNPUSH$(MAT FIELDSSDESCRIPTION$,ALTSTACK,WIPE)
90196       let FNPUSH$(MAT FIELDSNDESCRIPTION$,ALTSTACK,WIPE)
90198       let FNPUSH$(MAT FIELDSSSPEC$,ALTSTACK,WIPE)
90200       let FNPUSH$(MAT FIELDSNSPEC$,ALTSTACK,WIPE)
90202       let FNPUSH$(MAT FIELDSSDATESPEC$,ALTSTACK,WIPE)
90204       let FNPUSH$(MAT FIELDSNDATESPEC$,ALTSTACK,WIPE)
90206 ! 
90208       let FNPUSH(MAT SELECTEDRECORDS,ALTSTACK,WIPE)
90210       let FNPUSH$(MAT SELECTEDKEYS$,ALTSTACK,WIPE)
90212       let FNPUSH(MAT VISIBLERECORDS,ALTSTACK,WIPE)
90214       let FNPUSH$(MAT VISIBLEKEYS$,ALTSTACK,WIPE)
90216       let FNPUSH$(MAT SAVE_S$,ALTSTACK,WIPE)
90218       let FNPUSH(MAT SAVE_F,ALTSTACK,WIPE)
90220       let FNPUSH$(MAT SAVE_F$,ALTSTACK,WIPE)
90222 ! 
90224       let FNPUSH(MAT SAVE_S_SUBS,ALTSTACK,WIPE)
90226       let FNPUSH$(MAT SAVE_S_DATA$,ALTSTACK,WIPE)
90228       let FNPUSH(MAT CHANGED_S_SUBS,ALTSTACK,WIPE)
90230       let FNPUSH$(MAT CHANGED_S_DATA$,ALTSTACK,WIPE)
90232       let FNPUSH(MAT OTHER_S_SUBS,ALTSTACK,WIPE)
90234       let FNPUSH$(MAT OTHER_S_DATA$,ALTSTACK,WIPE)
90236       let FNPUSH(MAT OTHERCHANGED_S_SUBS,ALTSTACK,WIPE)
90238       let FNPUSH$(MAT OTHERCHANGED_S_DATA$,ALTSTACK,WIPE)
90240       let FNPUSH(MAT READ_F,ALTSTACK,WIPE)
90242       let FNPUSH$(MAT READ_F$,ALTSTACK,WIPE)
90244       let FNPUSH$(MAT CONTROLSPEC$,ALTSTACK,WIPE)
90246 ! 
90248       let FNPUSHSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ALTSTACK,WIPE)
90250    fnend 
90252    def FNPOPDATA(;ALTSTACK)
90254       let FNPOPSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES,ALTSTACK)
90256 ! 
90258       let FNPOP$(MAT CONTROLSPEC$,ALTSTACK)
90260       let FNPOP$(MAT READ_F$,ALTSTACK)
90262       let FNPOP(MAT READ_F,ALTSTACK)
90264       let FNPOP$(MAT OTHERCHANGED_S_DATA$,ALTSTACK)
90266       let FNPOP(MAT OTHERCHANGED_S_SUBS,ALTSTACK)
90268       let FNPOP$(MAT OTHER_S_DATA$,ALTSTACK)
90270       let FNPOP(MAT OTHER_S_SUBS,ALTSTACK)
90272       let FNPOP$(MAT CHANGED_S_DATA$,ALTSTACK)
90274       let FNPOP(MAT CHANGED_S_SUBS,ALTSTACK)
90276       let FNPOP$(MAT SAVE_S_DATA$,ALTSTACK)
90278       let FNPOP(MAT SAVE_S_SUBS,ALTSTACK)
90280 ! 
90282       let FNPOP$(MAT SAVE_F$,ALTSTACK)
90284       let FNPOP(MAT SAVE_F,ALTSTACK)
90286       let FNPOP$(MAT SAVE_S$,ALTSTACK)
90288       let FNPOP$(MAT VISIBLEKEYS$,ALTSTACK)
90290       let FNPOP(MAT VISIBLERECORDS,ALTSTACK)
90292       let FNPOP$(MAT SELECTEDKEYS$,ALTSTACK)
90294       let FNPOP(MAT SELECTEDRECORDS,ALTSTACK)
90296 ! 
90298       let FNPOP$(MAT FIELDSNDATESPEC$,ALTSTACK)
90300       let FNPOP$(MAT FIELDSSDATESPEC$,ALTSTACK)
90302       let FNPOP$(MAT FIELDSNSPEC$,ALTSTACK)
90304       let FNPOP$(MAT FIELDSSSPEC$,ALTSTACK)
90306       let FNPOP$(MAT FIELDSNDESCRIPTION$,ALTSTACK)
90308       let FNPOP$(MAT FIELDSSDESCRIPTION$,ALTSTACK)
90310 ! 
90312       if ALTSTACK<>2 then 
90314          let FNPOP$(MAT RLV_SAVEREADDATA$,ALTSTACK)
90316          let FNPOP(MAT OLD_DATA,ALTSTACK)
90318          let FNPOP$(MAT TEMP_S_SPEC$,ALTSTACK)
90320 ! 
90322          let FNPOPVALUE$(TEMPDATA$,ALTSTACK)
90324          let FNPOP(MAT S_SUBS,ALTSTACK)
90326          let FNPOP$(MAT FORM$,ALTSTACK)
90328          let FNPOP$(MAT SCREENSUBS$,ALTSTACK)
90330 ! 
90332          let FNPOP$(MAT FIELDSNSUBS$,ALTSTACK)
90334          let FNPOP$(MAT FIELDSSSUBS$,ALTSTACK)
90336 ! 
90338          let FNPOP(MAT F,ALTSTACK)
90340          let FNPOP$(MAT F$,ALTSTACK)
90342          let FNPOP$(MAT S$,ALTSTACK)
90344          let FNPOP(MAT PASSEDINF,ALTSTACK)
90346          let FNPOP$(MAT PASSEDINF$,ALTSTACK)
90348       end if 
90350    fnend 
90352 ! 
90354    def FNPUSHSCREEN(MAT SCREENIO$, MAT SCREENIO, MAT CONTROLNAME$,MAT FIELDNAME$,MAT DESCRIPTION$,MAT VPOSITION,MAT HPOSITION,MAT FIELDTYPE$,MAT SPECWIDTH,MAT WIDTH,MAT HEIGHT,MAT TRUEVALUE$,MAT FALSEVALUE$,MAT FUNCTION$,MAT PICTURE$,MAT PARENT$,MAT FGCOLOR$,MAT BGCOLOR$,MAT JUSTIFY$, MAT ATTR$, MAT PROTECTED, MAT INVISIBLE, MAT TOOLTIP$, MAT CNVRTIN$, MAT CNVRTOUT$, MAT MULTISELECT, MAT USERDATA$, MAT GRIDLINES;ALTSTACK,WIPE,___,STACK1,STACK2,STACK3)
90356 ! 
90358       if ALTSTACK=1 then 
90360          let STACK1=UDIM(MAT UNDOSTACK$)
90362          let STACK2=UDIM(MAT UNDOLONGSTACK$)
90364          let STACK3=UDIM(MAT UNDOSTACK)
90366       end if 
90368 ! 
90370       if ALTSTACK<>2 then 
90372          let FNPUSH$(MAT CONTROLNAME$,ALTSTACK,WIPE)
90374          let FNPUSH$(MAT FIELDNAME$,ALTSTACK,WIPE)
90376          let FNPUSH$(MAT FUNCTION$,ALTSTACK,WIPE)
90378          let FNPUSH$(MAT CNVRTIN$,ALTSTACK,WIPE)
90380          let FNPUSH(MAT SPECWIDTH,ALTSTACK,WIPE)
90382       end if 
90384 ! 
90386       let FNPUSH$(MAT SCREENIO$,ALTSTACK,WIPE)
90388       let FNPUSH(MAT SCREENIO,ALTSTACK,WIPE)
90390       let FNPUSH$(MAT DESCRIPTION$,ALTSTACK,WIPE)
90392       let FNPUSH(MAT VPOSITION,ALTSTACK,WIPE)
90394       let FNPUSH(MAT HPOSITION,ALTSTACK,WIPE)
90396       let FNPUSH$(MAT FIELDTYPE$,ALTSTACK,WIPE)
90398       let FNPUSH(MAT WIDTH,ALTSTACK,WIPE)
90400       let FNPUSH(MAT HEIGHT,ALTSTACK,WIPE)
