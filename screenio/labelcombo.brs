01000 Main: ! If you run me as a program, I run the labelcombo screen
01010    library "screenio" : FNFM$
01020    let RET$=FNFM$("labelcombo","",0,0,"",0,0,0,0,MAT PASSEDDATA$)
01030    if LEN(TRIM$(RET$)) then 
01040       print RET$
01050    end if 
01060    if FKEY=93 then execute "system"
01070    stop 
01080 ! 
