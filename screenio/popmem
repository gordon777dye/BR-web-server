90736     DIM PUSHWORKARRAY$(1)*4000
90738     DEF FNPUSHARRAY$(MAT ARRAY$,MAT STACK$,MAT LONGSTACK$;___,STARTINDEX,ENDINDEX,SIZE,INDEX)
90740        MAT PUSHWORKARRAY$(UDIM(MAT ARRAY$))=ARRAY$
90742        FOR INDEX=1 TO UDIM(MAT PUSHWORKARRAY$)
90744           IF LEN(PUSHWORKARRAY$(INDEX))>255 THEN 
90746              MAT LONGSTACK$(UDIM(MAT LONGSTACK$)+1)
90748              LET LONGSTACK$(UDIM(MAT LONGSTACK$))=PUSHWORKARRAY$(INDEX)
90750              LET PUSHWORKARRAY$(INDEX)="[[[loNgsTaCk]]]"
90752           END IF 
90754        NEXT INDEX
90756 ! 
90758        LET STARTINDEX=UDIM(MAT STACK$)+1
90760        LET SIZE=UDIM(MAT PUSHWORKARRAY$)
90762        LET ENDINDEX=STARTINDEX+SIZE-1
90764        MAT STACK$(ENDINDEX+1)
90766        IF SIZE THEN 
90768           MAT STACK$(STARTINDEX:ENDINDEX)=PUSHWORKARRAY$
90770        END IF 
90772        LET STACK$(ENDINDEX+1)=STR$(SIZE)
90774     FNEND 
90776     DEF FNPOPARRAY$(MAT ARRAY$,MAT STACK$,MAT LONGSTACK$;___,STARTINDEX,ENDINDEX,SIZE,INDEX)
90778        LET ENDINDEX=UDIM(MAT STACK$)-1
90780        LET SIZE=VAL(STACK$(ENDINDEX+1))
90782        LET STARTINDEX=ENDINDEX-SIZE+1
90784        MAT ARRAY$(SIZE)
90786        IF SIZE THEN 
90788           MAT ARRAY$=STACK$(STARTINDEX:ENDINDEX)
90790        END IF 
90792        MAT STACK$(STARTINDEX-1)
90794 ! 
90796        FOR INDEX=UDIM(MAT ARRAY$) TO 1 STEP -1
90798           IF ARRAY$(INDEX)="[[[loNgsTaCk]]]" THEN 
90800              LET ARRAY$(INDEX)=LONGSTACK$(UDIM(MAT LONGSTACK$))
90802              MAT LONGSTACK$(UDIM(MAT LONGSTACK$)-1)
90804           END IF 
90806        NEXT INDEX
90808     FNEND 
90810     DEF FNPUSHARRAY(MAT ARRAY,MAT STACK;___,STARTINDEX,ENDINDEX,SIZE)
90812        LET STARTINDEX=UDIM(MAT STACK)+1
90814        LET SIZE=UDIM(MAT ARRAY)
90816        LET ENDINDEX=STARTINDEX+SIZE-1
90818        MAT STACK(ENDINDEX+1)
90820        IF SIZE THEN 
90822           MAT STACK(STARTINDEX:ENDINDEX)=ARRAY
90824        END IF 
90826        LET STACK(ENDINDEX+1)=SIZE
90828     FNEND 
90830     DEF FNPOPARRAY(MAT ARRAY,MAT STACK;___,STARTINDEX,ENDINDEX,SIZE)
90832        LET ENDINDEX=UDIM(MAT STACK)-1
90834        LET SIZE=STACK(ENDINDEX+1)
90836        LET STARTINDEX=ENDINDEX-SIZE+1
90838        MAT ARRAY(SIZE)
90840        IF SIZE THEN 
90842           MAT ARRAY=STACK(STARTINDEX:ENDINDEX)
90844        END IF 
90846        MAT STACK(STARTINDEX-1)
